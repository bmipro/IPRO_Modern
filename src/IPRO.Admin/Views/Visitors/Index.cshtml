@model IPRO.DataAccess.PlatformVisitorReport
@{
  ViewData["Title"] = "Visitors";
  var change = Model.PreviousViews == 0
    ? (Model.TotalViews == 0 ? 0m : 100m)
    : Math.Round((Model.TotalViews - Model.PreviousViews) * 100m / Model.PreviousViews, 1);
  var maxDay = Model.Daily.Count == 0 ? 0 : Model.Daily.Max(d => d.Views);
  // 537: a sign-up's time is on the report's clock; the label says which one, as the header does.
  var zoneLabel = IPRO.Admin.Infrastructure.AdminClock.Label(ViewBag.Zone as string);
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
  <div>
    <h4 class="fw-bold"><i class="fas fa-chart-line me-2 text-warning"></i>Visitors</h4>
    <div class="text-muted">Visits to the platform's own public pages &mdash; the home page, the accountants and mortgage pages and the registration page &mdash; and where they came from.</div>
  </div>
  <div class="btn-group" role="group" aria-label="Period">
    @foreach (var days in new[] { 7, 30, 90 })
    {
      <a class="btn btn-sm @(Model.PeriodDays == days ? "btn-primary" : "btn-outline-primary")" href="/Reports/Visitors?days=@days">@days days</a>
    }
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-3"><div class="card border-0 shadow-sm text-center p-4"><div class="display-5 fw-bold text-primary">@Model.TotalViews.ToString("N0")</div><div class="text-muted">Page views</div><div class="small @(change >= 0 ? "text-success" : "text-danger")">@(change >= 0 ? "+" : "")@change% vs the previous @Model.PeriodDays days</div></div></div>
  <div class="col-md-3"><div class="card border-0 shadow-sm text-center p-4"><div class="display-5 fw-bold text-info">@Model.UniqueVisitors.ToString("N0")</div><div class="text-muted">Visitors</div><div class="small text-muted">counted without cookies; the count resets monthly</div></div></div>
  <div class="col-md-3"><div class="card border-0 shadow-sm text-center p-4"><div class="display-5 fw-bold text-success">@Model.SignUps.ToString("N0")</div><div class="text-muted">Sign-ups</div><div class="small text-muted">through the public registration form</div></div></div>
  <div class="col-md-3"><div class="card border-0 shadow-sm text-center p-4"><div class="display-5 fw-bold text-secondary">@Model.SignUpsWithOrigin.ToString("N0")</div><div class="text-muted">Sign-ups from a known source</div><div class="small text-muted">a campaign tag or a referring site</div></div></div>
</div>

<div class="row g-3 mb-4">
  <div class="col-lg-7">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-white fw-bold">By day</div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead><tr><th>Date</th><th style="width:45%"></th><th class="text-end">Views</th><th class="text-end">Visitors</th></tr></thead>
            <tbody>
            @foreach (var day in Model.Daily)
            {
              var width = maxDay == 0 ? 0 : (int)Math.Round(day.Views * 100.0 / maxDay);
              <tr>
                <td class="fw-semibold">@day.Date.ToString("ddd, MMM d")</td>
                <td><div class="bg-primary bg-opacity-25 rounded" style="height:10px;width:@(width)%"></div></td>
                <td class="text-end">@day.Views.ToString("N0")</td>
                <td class="text-end">@day.Visitors.ToString("N0")</td>
              </tr>
            }
            @if (Model.Daily.Count == 0)
            {
              <tr><td colspan="4" class="text-center text-muted py-4">No visits in this period.</td></tr>
            }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-5">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-white fw-bold">Sign-ups by origin</div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead><tr><th>Origin</th><th class="text-end">Sign-ups</th></tr></thead>
            <tbody>
            @* 537: the count opens the names -- who signed up from this origin, newest first, each linked
               to the adviser's record. The origin was always stored against the adviser (512). A native
               details element, like Website Templates' "Advanced template metadata": it opens with no
               script, by mouse or keyboard. *@
            @foreach (var row in Model.SignUpsByOrigin)
            {
              <tr>
                <td colspan="2" class="p-0">
                  <details>
                    <summary class="d-flex justify-content-between align-items-center gap-3 p-2" style="cursor:pointer" title="Show who signed up">
                      <span class="fw-semibold text-break">@row.Label</span>
                      <span class="fw-bold text-primary text-decoration-underline flex-shrink-0">@row.SignUps.ToString("N0")</span>
                    </summary>
                    <ul class="list-unstyled mb-0 px-3 py-2 bg-light small border-top">
                      @foreach (var who in row.Who.Take(50))
                      {
                        <li class="py-1">
                          @* The name; the email when there is no name; the account number when there is neither. *@
                          <a class="fw-semibold" href="/Agents/Details/@who.AgentUserId">@(who.Name.Length > 0 ? who.Name : who.Email.Length > 0 ? who.Email : $"Adviser {who.AgentUserId}")</a>
                          @if (who.Company.Length > 0) { <span>&middot; @who.Company</span> }
                          @* The email once: it is already the link when there is no name. *@
                          @if (who.Name.Length > 0 && who.Email.Length > 0) { <span class="text-muted">&middot; @who.Email</span> }
                          @if (who.Package.Length > 0) { <span class="text-muted">&middot; @who.Package</span> }
                          <div class="text-muted">
                            Signed up @who.SignedUpAt.ToString("MMM d, yyyy h:mm tt") @zoneLabel
                            @if (who.LandedOn.Length > 0)
                            {
                              <span>&middot; landed on @who.LandedOn</span>
                            }
                          </div>
                        </li>
                      }
                      @if (row.Who.Count > 50)
                      {
                        <li class="py-1 text-muted">...and @(row.Who.Count - 50) more.</li>
                      }
                    </ul>
                  </details>
                </td>
              </tr>
            }
            @if (Model.SignUpsByOrigin.Count == 0)
            {
              <tr><td colspan="2" class="text-center text-muted py-4">No sign-ups in this period.</td></tr>
            }
            </tbody>
          </table>
        </div>
      </div>
      <div class="card-footer bg-white small text-muted">A sign-up is placed by the most recent visit, within the month, by the same visitor that came from a campaign or a referring site. Click a number to see who signed up.</div>
    </div>
  </div>
</div>

@{
  var breakdowns = new (string Title, string First, IReadOnlyList<IPRO.DataAccess.PlatformVisitorBreakdown> Rows)[]
  {
    ("By campaign", "Campaign (source / medium / campaign)", Model.ByCampaign),
    ("By referring site", "Referrer", Model.ByReferrer),
    ("By page", "Page", Model.ByPage),
    ("By name", "Name the visitor used", Model.ByHost),
  };
}
<div class="row g-3 mb-4">
  @foreach (var (title, first, rows) in breakdowns)
  {
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white fw-bold">@title</div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table align-middle mb-0">
              <thead><tr><th>@first</th><th class="text-end">Views</th><th class="text-end">Visitors</th></tr></thead>
              <tbody>
              @foreach (var row in rows)
              {
                <tr><td class="fw-semibold text-break">@row.Label</td><td class="text-end">@row.Views.ToString("N0")</td><td class="text-end">@row.Visitors.ToString("N0")</td></tr>
              }
              @if (rows.Count == 0)
              {
                <tr><td colspan="3" class="text-center text-muted py-4">No data in this period.</td></tr>
              }
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  }
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body small text-muted">
    <div class="fw-bold text-dark mb-1">How to see which post brought a visitor</div>
    Add tags to the link you post, and they show up here under <em>By campaign</em>:
    <code>https://www.iproadvisers.com/?utm_source=linkedin&amp;utm_medium=social&amp;utm_campaign=launch</code>.
    Visitors are counted without cookies: a one-way hashed identifier that changes every month, no address kept, Do Not Track honoured,
    crawlers and link previews skipped. Visits by anyone signed in are not counted; the portal is not counted.
  </div>
</div>
