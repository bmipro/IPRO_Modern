@model IEnumerable<IPRO.Entities.WebsiteStarterForm>
@{
  ViewData["Title"] = "Starter Forms";
  var groups = Model.GroupBy(f => f.BusinessType).OrderBy(g => g.Key);
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-4">
  <div><h3 class="fw-bold mb-1"><i class="fas fa-rectangle-list me-2 text-primary"></i>Starter Forms</h3><div class="text-muted">Ready-to-use form templates agents can adopt, by business type.</div></div>
  <a href="/WebsiteStarterForms/Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>New Starter Form</a>
</div>

<div class="alert alert-info border-0 shadow-sm">When an agent adopts a template, it's copied into a real, independent form they own. Editing or deactivating a record here does not change any agent's already-adopted copy.</div>

@foreach (var group in groups)
{
  <section class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3"><strong>@group.Key</strong></div>
    <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Order</th><th>Title</th><th>Description</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>
    @foreach (var form in group.OrderBy(f => f.SortOrder))
    {
      <tr>
        <td>@form.SortOrder</td>
        <td><strong>@form.Title</strong></td>
        <td class="text-muted small">@form.Description</td>
        <td><span class="badge @(form.IsActive ? "bg-success" : "bg-secondary")">@(form.IsActive ? "Active" : "Inactive")</span></td>
        <td class="text-end">
          <div class="d-flex justify-content-end gap-1">
            <a href="/WebsiteStarterForms/Edit/@form.Id" class="btn btn-sm btn-outline-primary"><i class="fas fa-pen me-1"></i>Edit</a>
            @if (form.IsActive)
            {
              <form method="post" action="/WebsiteStarterForms/Deactivate/@form.Id">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-secondary">Deactivate</button></form>
            }
            else
            {
              <form method="post" action="/WebsiteStarterForms/Restore/@form.Id">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-success">Restore</button></form>
            }
            <form method="post" action="/WebsiteStarterForms/Delete/@form.Id" onsubmit="return confirm('Delete this starter form? Agents who already adopted a copy are unaffected.');">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button></form>
          </div>
        </td>
      </tr>
    }
    </tbody></table></div>
  </section>
}
