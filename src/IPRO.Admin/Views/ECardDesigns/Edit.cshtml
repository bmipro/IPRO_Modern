@model IPRO.Entities.ECardDesign
@{
    var isNew = Model.Id == 0;
    var webBaseUrl = ViewBag.WebBaseUrl as string ?? string.Empty;
    ViewData["Title"] = isNew ? "New E-Card Design" : $"Edit {Model.Name}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-2"><li class="breadcrumb-item"><a href="/ECardDesigns">E-Card Designs</a></li><li class="breadcrumb-item active">@(isNew ? "New" : Model.Name)</li></ol>
    </nav>
    <h4 class="fw-bold mb-0">@(isNew ? "New E-Card Design" : Model.Name)</h4>
  </div>
</div>

<form method="post" action="/ECardDesigns/Edit" enctype="multipart/form-data">
  @Html.AntiForgeryToken()
  <input type="hidden" asp-for="Id" />
  <input type="hidden" asp-for="ImageUrl" />
  <input type="hidden" asp-for="Width" />
  <input type="hidden" asp-for="Height" />

  <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

  <div class="row g-4">
    <div class="col-lg-7">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h6 class="fw-bold mb-3">Card kind</h6>
          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <div class="kind-option">
                <input class="form-check-input" type="radio" asp-for="Kind" id="kindImage" value="image" />
                <label class="form-check-label" for="kindImage"><strong>Artwork</strong><span>An illustration you upload.</span></label>
              </div>
            </div>
            <div class="col-md-6">
              <div class="kind-option">
                <input class="form-check-input" type="radio" asp-for="Kind" id="kindGenerated" value="generated" />
                <label class="form-check-label" for="kindGenerated"><strong>Simple</strong><span>A colour panel with an emoji.</span></label>
              </div>
            </div>
          </div>

          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold">Occasion</label>
              <input asp-for="Occasion" class="form-control" list="occasionList" placeholder="e.g. Hanukkah" />
              <datalist id="occasionList">
                <option value="Simple"></option><option value="Birthday"></option><option value="Anniversary"></option>
                <option value="Halloween"></option><option value="Christmas"></option><option value="Easter"></option>
                <option value="Thanksgiving"></option><option value="Canada Day"></option><option value="Norooz"></option>
                <option value="Eid al-Adha"></option><option value="Hanukkah"></option><option value="Passover"></option>
              </datalist>
              <div class="form-text">Groups the design in the agent's picker.</div>
              <span asp-validation-for="Occasion" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Design name</label>
              <input asp-for="Name" class="form-control" placeholder="e.g. Menorah at dusk" />
              <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Key</label>
              <input asp-for="Key" class="form-control" placeholder="left blank, derived from occasion + name" />
              <div class="form-text">Permanent. Sent cards find their artwork through this.</div>
              <span asp-validation-for="Key" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
              <label class="form-label fw-semibold">Order</label>
              <input asp-for="SortOrder" class="form-control" type="number" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
              <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                <label asp-for="IsActive" class="form-check-label">Offer to agents</label>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="card border-0 shadow-sm mb-4" id="artworkCard">
        <div class="card-body p-4">
          <h6 class="fw-bold mb-3">Artwork</h6>
          @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
          {
            <img src="@Model.AbsoluteImageUrl(webBaseUrl)" alt="" class="mb-3" style="max-width:100%;max-height:220px;border-radius:8px;" />
          }
          <input type="file" name="artwork" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp" />
          <div class="form-text">JPG, PNG, GIF or WebP, up to 8 MB. Upload a new file to replace what's there.</div>
          <span class="text-danger small">@Html.ValidationMessage("artwork")</span>
        </div>
      </div>

      <div class="card border-0 shadow-sm mb-4" id="generatedCard">
        <div class="card-body p-4">
          <h6 class="fw-bold mb-3">Panel</h6>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold">Colour</label>
              <input asp-for="Accent" class="form-control" placeholder="#1e3a8a" />
              <div class="form-text">The gradient runs from the agent's own accent to this.</div>
              <span asp-validation-for="Accent" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Emoji</label>
              <input asp-for="Emoji" class="form-control" placeholder="🕎" />
              <span asp-validation-for="Emoji" class="text-danger small"></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h6 class="fw-bold mb-3">Default greeting</h6>
          <div class="mb-3">
            <label class="form-label fw-semibold">Headline</label>
            <input asp-for="DefaultHeaderText" class="form-control" maxlength="200" />
            <div class="form-text">Fills the agent's subject line when they pick this design.</div>
          </div>
          <div>
            <label class="form-label fw-semibold">Message</label>
            <textarea asp-for="DefaultMessage" class="form-control" rows="4" maxlength="600"></textarea>
            <div class="form-text">Agents can replace this before sending.</div>
          </div>
        </div>
      </div>

      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h6 class="fw-bold mb-2">Greeting background</h6>
          <div class="form-check">
            <input asp-for="IsDark" class="form-check-input" type="checkbox" />
            <label asp-for="IsDark" class="form-check-label">Dark</label>
          </div>
          <div class="form-text mt-2">
            The greeting sits below the card face on its own solid ground, never over the picture.
            Match this to the artwork — dark for a night scene, light for pale artwork — so the card
            reads as one object.
          </div>
        </div>
      </div>

      <button type="submit" class="btn btn-primary w-100"><i class="fas fa-save me-1"></i>Save design</button>
      <a href="/ECardDesigns" class="btn btn-link w-100 mt-2">Cancel</a>
    </div>
  </div>
</form>

<style>
  .kind-option { border: 1px solid #dbe5f2; border-radius: 12px; padding: 14px 16px; display: grid; grid-template-columns: auto minmax(0,1fr); column-gap: 10px; align-items: start; }
  .kind-option label { display: flex; flex-direction: column; gap: 2px; }
  .kind-option span { color: #64748b; font-size: .875rem; }
</style>

<script nonce="@Context.GetCspNonce()">
(function () {
  var image = document.getElementById('kindImage');
  var generated = document.getElementById('kindGenerated');
  var artworkCard = document.getElementById('artworkCard');
  var generatedCard = document.getElementById('generatedCard');

  function sync() {
    artworkCard.style.display = image.checked ? '' : 'none';
    generatedCard.style.display = generated.checked ? '' : 'none';
  }
  image.addEventListener('change', sync);
  generated.addEventListener('change', sync);
  sync();
})();
</script>
