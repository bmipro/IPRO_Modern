@model IEnumerable<IPRO.Entities.ECardDesign>
@{
    ViewData["Title"] = "E-Card Designs";
    // Seeded artwork is served by the agent portal, not by admin -- resolve against that host.
    var webBaseUrl = ViewBag.WebBaseUrl as string ?? string.Empty;
    var activeCount = ViewBag.ActiveCount as int? ?? Model.Count(d => d.IsActive);
}

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="fw-bold mb-1"><i class="fas fa-gift me-2 text-primary"></i>E-Card Designs</h4>
    <div class="text-muted">The card library agents pick from. Grouped by occasion in their picker.</div>
    <div class="small text-muted mt-1"><strong>@Model.Count()</strong> design(s), <strong>@activeCount</strong> offered to agents.</div>
  </div>
  <a href="/ECardDesigns/Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>New Design</a>
</div>

@if (!Model.Any())
{
  <div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5">
      <i class="fas fa-gift fa-3x text-muted opacity-25 mb-3 d-block"></i>
      <h5 class="fw-bold">No card designs yet</h5>
      <p class="text-muted">Agents can't send an e-card until at least one design is active.</p>
      <a href="/ECardDesigns/Create" class="btn btn-primary">Add the first design</a>
    </div>
  </div>
}
else
{
  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead>
          <tr>
            <th>Design</th>
            <th>Occasion</th>
            <th>Default greeting</th>
            <th>Order</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
        @foreach (var design in Model)
        {
          <tr>
            <td>
              <div class="d-flex align-items-center gap-2">
                @if (design.IsArtwork && !string.IsNullOrWhiteSpace(design.ImageUrl))
                {
                  <img src="@design.AbsoluteImageUrl(webBaseUrl)" alt="" style="width:64px;height:48px;object-fit:cover;border-radius:4px;" />
                }
                else
                {
                  <span style="display:inline-flex;align-items:center;justify-content:center;width:64px;height:48px;border-radius:4px;font-size:22px;line-height:1;background:linear-gradient(135deg,#1457d9 0%,@(string.IsNullOrWhiteSpace(design.Accent) ? "#5b8def" : design.Accent) 100%);">@design.Emoji</span>
                }
                <div>
                  <div class="fw-bold">@design.Name</div>
                  <div class="small text-muted"><code>@design.Key</code></div>
                </div>
              </div>
            </td>
            <td>@design.Occasion</td>
            <td class="small text-muted" style="max-width:280px;">@design.DefaultHeaderText</td>
            <td>@design.SortOrder</td>
            <td><span class="badge @(design.IsActive ? "bg-success" : "bg-secondary")">@(design.IsActive ? "Active" : "Retired")</span></td>
            <td class="text-end text-nowrap">
              <a href="/ECardDesigns/Edit/@design.Id" class="btn btn-sm btn-outline-primary">Edit</a>
              @if (design.IsActive)
              {
                <form method="post" action="/ECardDesigns/Deactivate/@design.Id" class="d-inline">
                  @Html.AntiForgeryToken()
                  <button class="btn btn-sm btn-outline-warning" type="submit" title="Stop offering this design to agents"><i class="fas fa-eye-slash"></i></button>
                </form>
              }
              else
              {
                <form method="post" action="/ECardDesigns/Restore/@design.Id" class="d-inline">
                  @Html.AntiForgeryToken()
                  <button class="btn btn-sm btn-outline-success" type="submit" title="Offer this design again"><i class="fas fa-eye"></i></button>
                </form>
              }
            </td>
          </tr>
        }
        </tbody>
      </table>
    </div>
  </div>

  <p class="text-muted small mt-3 mb-0">
    <i class="fas fa-info-circle me-1"></i>
    Designs are retired, never deleted — every e-card an agent has already sent looks up its artwork
    by key, so removing one would blank the picture in their history.
  </p>
}
