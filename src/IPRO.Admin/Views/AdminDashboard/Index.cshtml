@{ ViewData["Title"] = "Dashboard"; }

@if (ViewBag.AiUsageLow == true)
{
  <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center gap-2 mb-4">
    <i class="fas fa-robot"></i>
    <div>
      <strong>AI credits running low</strong> — estimated @(((decimal)ViewBag.AiRemainingPercent).ToString("0"))% of your funded Anthropic balance remains.
      <a href="/AiUsage" class="alert-link">Top up or review usage</a>.
    </div>
  </div>
}

@{
    // 453: support requests come before everything else on this page.
    var openTickets = ViewData["OpenTickets"] as System.Collections.Generic.List<IPRO.Entities.SupportTicket> ?? new System.Collections.Generic.List<IPRO.Entities.SupportTicket>();
    var openTicketCount = ViewData["OpenTicketCount"] is int oc ? oc : 0;
    var awaitingReplyCount = ViewData["AwaitingReplyCount"] is int ac ? ac : 0;
}
<div class="card border-0 shadow-sm mb-4 @(awaitingReplyCount > 0 ? "border-start border-4 border-danger" : "")">
  <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <i class="fas fa-life-ring me-2 text-primary"></i><strong>Support requests</strong>
      <span class="badge @(awaitingReplyCount > 0 ? "bg-danger" : "bg-secondary") ms-2">@awaitingReplyCount awaiting reply</span>
      <span class="text-muted small ms-2">@openTicketCount open</span>
    </div>
    <a class="btn btn-sm btn-outline-primary" href="/SupportTickets">All tickets</a>
  </div>
  @if (openTickets.Count == 0)
  {
    <div class="card-body text-muted small">No open support requests.</div>
  }
  else
  {
    <div class="table-responsive">
      <table class="table table-sm mb-0 align-middle">
        <thead class="table-light">
          <tr><th>Ticket</th><th>Agent</th><th>Status</th><th>Last message</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var t in openTickets)
        {
          var age = DateTime.UtcNow - t.LastMessageAt;
          var ageLabel = age.TotalMinutes < 60 ? $"{Math.Max(0, (int)age.TotalMinutes)} min ago"
                       : age.TotalHours < 48 ? $"{(int)age.TotalHours} h ago"
                       : $"{(int)age.TotalDays} days ago";
          <tr class="@(t.HasUnreadForAdmin ? "fw-semibold" : "")">
            <td>
              <a href="/SupportTickets/Details/@t.Id">#@t.Id @t.Subject</a>
              @if (t.HasUnreadForAdmin)
              {
                <span class="badge bg-danger-subtle text-danger ms-1">awaiting reply</span>
              }
            </td>
            <td>@t.AgentUser?.FirstName @t.AgentUser?.LastName</td>
            <td><span class="badge bg-light text-dark">@t.Status</span></td>
            <td class="text-muted small">@ageLabel</td>
            <td class="text-end"><a class="btn btn-sm btn-primary" href="/SupportTickets/Details/@t.Id">Open</a></td>
          </tr>
        }
        </tbody>
      </table>
    </div>
  }
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="icon-box bg-primary bg-opacity-10 text-primary"><i class="fas fa-users"></i></div>
                <div>
                    <div class="display-6 fw-bold lh-1">@ViewBag.TotalAgents</div>
                    <div class="text-muted small mt-1">Total Agents</div>
                    <div class="text-success small">@ViewBag.ActiveAgents active</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="icon-box bg-success bg-opacity-10 text-success"><i class="fas fa-credit-card"></i></div>
                <div>
                    <div class="display-6 fw-bold lh-1">@ViewBag.ActiveSubs</div>
                    <div class="text-muted small mt-1">Active Subscriptions</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="icon-box bg-warning bg-opacity-10 text-warning"><i class="fas fa-dollar-sign"></i></div>
                <div>
                    <div class="display-6 fw-bold lh-1">$@String.Format("{0:N0}", ViewBag.MonthRevenue)</div>
                    <div class="text-muted small mt-1">Revenue (30 days)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card h-100">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="icon-box bg-info bg-opacity-10 text-info"><i class="fas fa-address-book"></i></div>
                <div>
                    <div class="display-6 fw-bold lh-1">@ViewBag.TotalClients</div>
                    <div class="text-muted small mt-1">Total Clients</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="fas fa-users me-2 text-primary"></i>Recent Agents</h6>
                    <a href="/Agents" class="btn btn-sm btn-primary"><i class="fas fa-users me-1"></i>Manage All Agents</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead><tr><th>Agent</th><th>Domain</th><th>Joined</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
                        <tbody>
                        @foreach (var a in (ViewBag.RecentAgents as IEnumerable<IPRO.Entities.AgentUser> ?? []))
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@a.FirstName @a.LastName</div>
                                    <small class="text-muted">@a.UserName - @a.Email</small>
                                </td>
                                <td><small class="text-muted">@(a.DomainName ?? "-")</small></td>
                                <td><small class="text-muted">@a.CreatedAt.ToString("MMM d, yyyy")</small></td>
                                <td>
                                    @if (a.IsActive)
                                    { <span class="badge badge-status-active rounded-pill">Active</span> }
                                    else
                                    { <span class="badge badge-status-inactive rounded-pill">Inactive</span> }
                                </td>
                                <td>
                                    <div class="d-flex gap-1 justify-content-end">
                                        <a href="/Agents/Details/@a.Id" class="btn btn-sm btn-outline-primary" title="View"><i class="fas fa-eye"></i></a>
                                        <a href="/Agents/Edit/@a.Id" class="btn btn-sm btn-outline-secondary" title="Edit"><i class="fas fa-pen"></i></a>
                                        <form asp-controller="Agents" asp-action="ResetPassword" asp-route-id="@a.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-dark js-confirm-submit" title="Reset password" data-confirm-message="Reset @a.UserName password to their last name and force password change?"><i class="fas fa-key"></i></button>
                                        </form>
                                        <form asp-controller="Agents" asp-action="Delete" asp-route-id="@a.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger js-confirm-submit" title="Delete" data-confirm-message="Delete @a.UserName permanently? This cannot be undone."><i class="fas fa-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!((ViewBag.RecentAgents as IEnumerable<IPRO.Entities.AgentUser> ?? []).Any()))
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">No agents found</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3"><i class="fas fa-receipt me-2 text-success"></i>Recent Invoices</h6>
                @foreach (var inv in (ViewBag.RecentInvoices as IEnumerable<IPRO.Entities.Invoice> ?? []))
                {
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <div>
                            <div class="small fw-semibold">@inv.InvoiceNumber</div>
                            <div class="text-muted" style="font-size:.75rem">@inv.IssuedAt.ToString("MMM d")</div>
                        </div>
                        <div class="fw-bold text-success">$@inv.Total.ToString("N2")</div>
                    </div>
                }
                <div class="mt-3"><a href="/Reports/Revenue" class="btn btn-sm btn-outline-success">Revenue Report</a></div>
            </div>
        </div>
    </div>
</div>
