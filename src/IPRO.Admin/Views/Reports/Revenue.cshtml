@model List<IPRO.Entities.Invoice>
@using IPRO.DataAccess
@using IPRO.Admin.Models
@{
    ViewData["Title"] = "Revenue";
    var agents = (Dictionary<int, IPRO.Entities.AgentUser>)ViewBag.Agents;
    // 600 (2026-10-24): the ledger is the invoices AND the credit notes (refunds marked Refunded, Refer a Friend
    // rewards paid), credit notes negative; the totals, the months and the tax by region net them.
    var rows = (List<RevenueLedgerRow>)ViewBag.LedgerRows;
    var taxByRegion = (List<RevenueTaxRegion>)ViewBag.TaxByRegion;
    var chartMonths = (List<RevenueMonth>)ViewBag.ChartMonths;
    decimal paidTotal = ViewBag.PaidTotal, creditNotesTotal = ViewBag.CreditNotesTotal, netTotal = ViewBag.NetTotal;
    int creditNoteCount = ViewBag.CreditNoteCount;
    DateTime from = ViewBag.From, to = ViewBag.To;
    string query = ViewBag.Query;
    string sort = ViewBag.Sort, dir = ViewBag.Dir;

    // Column-header sort links keep the current filter and flip direction on the active column.
    string SortUrl(string column)
    {
        var nextDir = sort == column && dir == "desc" ? "asc" : sort == column ? "desc" : column == "date" ? "desc" : "asc";
        return $"/Reports/Revenue?from={from:yyyy-MM-dd}&to={to:yyyy-MM-dd}&q={Uri.EscapeDataString(query)}&sort={column}&dir={nextDir}";
    }
    // Active column: one solid arrow showing the current direction. Inactive sortable column: a
    // dimmed pair, so it's visible at a glance that the header is clickable (owner request).
    string SortArrow(string column) => sort == column ? (dir == "asc" ? "▲" : "▼") : "";
    var totalDays = (to - from).TotalDays;
    // "-$339.00": the sign before the dollar, so a credit note reads as money going back.
    string Money(decimal amount) => (amount < 0 ? "-$" : "$") + Math.Abs(amount).ToString("#,0.00", System.Globalization.CultureInfo.InvariantCulture);
    string ChartNumber(decimal amount) => amount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <h4 class="fw-bold mb-0"><i class="fas fa-dollar-sign me-2 text-success"></i>Revenue</h4>
  <div class="d-flex gap-2 align-items-center">
    @foreach (var m in new[] { 3, 6, 12 })
    {
      var isCurrent = string.IsNullOrEmpty(query) && Math.Abs(totalDays - (DateTime.UtcNow.Date - DateTime.UtcNow.AddMonths(-m).Date).TotalDays) < 2;
      <a href="/Reports/Revenue?from=@DateTime.UtcNow.AddMonths(-m).ToString("yyyy-MM-dd")&to=@DateTime.UtcNow.ToString("yyyy-MM-dd")"
         class="btn btn-sm @(isCurrent ? "btn-primary" : "btn-outline-secondary")">@m months</a>
    }
    <a class="btn btn-sm btn-outline-success"
       href="/Reports/InvoicesCsv?from=@from.ToString("yyyy-MM-dd")&to=@to.ToString("yyyy-MM-dd")&q=@Uri.EscapeDataString(query)">
      <i class="fas fa-file-csv me-1"></i>Export CSV
    </a>
  </div>
</div>

<form method="get" action="/Reports/Revenue" class="row g-2 align-items-end mb-4">
  <div class="col-auto">
    <label class="form-label small mb-1">From</label>
    <input type="date" name="from" value="@from.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
  </div>
  <div class="col-auto">
    <label class="form-label small mb-1">To</label>
    <input type="date" name="to" value="@to.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
  </div>
  <div class="col-auto">
    <label class="form-label small mb-1">Search</label>
    <input type="text" name="q" value="@query" placeholder="Invoice or credit note #, name, email, transaction"
           class="form-control form-control-sm" style="min-width:260px;" />
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-sm btn-primary">Filter</button>
  </div>
  <input type="hidden" name="sort" value="@sort" />
  <input type="hidden" name="dir" value="@dir" />
</form>

<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="card h-100"><div class="card-body">
      <div class="text-muted small text-uppercase">Invoiced (paid)</div>
      <div class="h5 mb-0">@Money(paidTotal)</div>
      <div class="text-muted small mb-2">@ViewBag.PaidCount paid, @ViewBag.UnpaidCount unpaid</div>
      <div class="text-muted small text-uppercase">Credit notes</div>
      <div class="h5 mb-0 text-danger">@Money(creditNotesTotal)</div>
      <div class="text-muted small mb-2">@creditNoteCount refunds and referral rewards</div>
      <div class="text-muted small text-uppercase">Net revenue</div>
      <div class="h3 mb-0 text-success">@Money(netTotal)</div>
      <div class="text-muted small">selected period</div>
    </div></div>
  </div>
  <div class="col-md-9">
    <div class="card h-100">
      <div class="card-header py-2 small fw-bold">Revenue by month (paid invoices less credit notes, selected period)</div>
      <div class="card-body py-2">
        <canvas id="revenueChart" height="70"></canvas>
        @if (chartMonths.Count > 0)
        {
          <div class="table-responsive mt-2">
            <table class="table table-sm small mb-0">
              <thead><tr><th>Month</th><th class="text-end">Invoiced</th><th class="text-end">Credit notes</th><th class="text-end">Net</th></tr></thead>
              <tbody>
              @foreach (var month in chartMonths)
              {
                <tr>
                  <td>@month.Label</td>
                  <td class="text-end">@Money(month.Invoiced)</td>
                  <td class="text-end @(month.CreditNotes < 0 ? "text-danger" : "")">@Money(month.CreditNotes)</td>
                  <td class="text-end fw-bold">@Money(month.Net)</td>
                </tr>
              }
              </tbody>
            </table>
          </div>
        }
      </div>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header py-2 small fw-bold">Tax collected by region (paid invoices less credit notes, selected period)</div>
  @if (taxByRegion.Count == 0)
  {
    <div class="card-body text-muted small">No tax collected in this period.</div>
  }
  else
  {
    <div class="table-responsive">
      <table class="table table-sm mb-0">
        <thead><tr><th>Region</th><th class="text-end">Taxable amount</th><th class="text-end">Tax collected</th><th class="text-end">Tax credited back</th><th class="text-end">Net tax</th></tr></thead>
        <tbody>
        @foreach (var row in taxByRegion)
        {
          <tr>
            <td>@row.Region</td>
            <td class="text-end">@Money(row.Taxable)</td>
            <td class="text-end">@Money(row.Collected)</td>
            <td class="text-end @(row.Credited < 0 ? "text-danger" : "")">@Money(row.Credited)</td>
            <td class="text-end fw-bold">@Money(row.NetTax)</td>
          </tr>
        }
        </tbody>
      </table>
    </div>
  }
</div>

<p class="text-muted small">
  The permanent ledger: every invoice ever issued, including agents deleted since, and every credit note -- a refund
  marked Refunded in Refunds, or a Refer a Friend reward paid -- as its own row with negative amounts. Each invoice
  carries its own bill-to snapshot, so copies can be reprinted at any time without the agent's account.
</p>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Number</th>
          @* word@(expr), not word@expr -- Razor's email-address heuristic renders the latter as
             literal text when @ directly follows a word character. *@
          <th><a href="@SortUrl("date")" class="text-decoration-none text-dark">Date @(SortArrow("date"))@if (sort != "date") { <span class="opacity-25">▲▼</span> }</a></th>
          <th>Bill to</th><th>Account</th>
          <th><a href="@SortUrl("package")" class="text-decoration-none text-dark">Package @(SortArrow("package"))@if (sort != "package") { <span class="opacity-25">▲▼</span> }</a></th>
          <th class="text-end">Subtotal</th><th class="text-end">Tax</th><th class="text-end">Total</th>
          <th>Status</th><th></th>
        </tr>
      </thead>
      <tbody>
      @if (rows.Count == 0)
      {
        <tr><td colspan="10" class="text-muted text-center py-4">No invoices or credit notes in this period.</td></tr>
      }
      @foreach (var r in rows)
      {
        var agent = agents.TryGetValue(r.AgentUserId, out var a) ? a : null;
        <tr class="@(r.IsCreditNote ? "table-danger" : "")">
          <td class="fw-bold">
            @r.Number
            @if (r.IsCreditNote)
            {
              <small class="d-block fw-normal text-muted">@r.CreditKind@(string.IsNullOrEmpty(r.CreditsInvoice) ? "" : ", credits " + r.CreditsInvoice)</small>
            }
          </td>
          <td><small>@AgentLocalTime.FromUtc(r.IssuedAt, agent?.TimeZone ?? r.AdviserTimeZone).ToString("MMM d, yyyy")</small></td>
          <td>
            @(string.IsNullOrWhiteSpace(r.BillToName) ? (agent?.UserName ?? "(unknown)") : r.BillToName)
            @if (!string.IsNullOrWhiteSpace(r.BillToCompany)) { <small class="text-muted d-block">@r.BillToCompany</small> }
          </td>
          <td>
            @if (agent == null)
            {
              <span class="badge bg-secondary" title="The account was deleted; the record is retained.">deleted</span>
            }
            else
            {
              <a href="/Agents/Details/@agent.Id">@agent.UserName</a>
            }
          </td>
          <td><small>@r.Package</small></td>
          <td class="text-end">@Money(r.SubTotal)</td>
          <td class="text-end"><small>@Money(r.Tax) @r.TaxRegion</small></td>
          <td class="text-end fw-bold">@Money(r.Total)</td>
          <td>
            @if (r.IsCreditNote) { <span class="badge bg-danger">Credit note</span> }
            else if (r.Paid) { <span class="badge bg-success">Paid</span> }
            else { <span class="badge bg-warning text-dark">Unpaid</span> }
          </td>
          <td><a class="btn btn-sm btn-outline-secondary" href="@r.ViewUrl">View / Print</a></td>
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>

@section Scripts {
<script nonce="@Context.GetCspNonce()">
const labels   = [@Html.Raw(string.Join(",", chartMonths.Select(m => $"'{m.Label}'")))];
const invoiced = [@Html.Raw(string.Join(",", chartMonths.Select(m => ChartNumber(m.Invoiced))))];
const credited = [@Html.Raw(string.Join(",", chartMonths.Select(m => ChartNumber(m.CreditNotes))))];
const net      = [@Html.Raw(string.Join(",", chartMonths.Select(m => ChartNumber(m.Net))))];
new Chart(document.getElementById('revenueChart'), {
  data: {
    labels,
    datasets: [
      { type: 'bar', label: 'Invoiced (CAD)', data: invoiced, backgroundColor: 'rgba(37,99,235,0.7)', borderRadius: 6 },
      { type: 'bar', label: 'Credit notes (CAD)', data: credited, backgroundColor: 'rgba(220,38,38,0.7)', borderRadius: 6 },
      { type: 'line', label: 'Net (CAD)', data: net, borderColor: 'rgba(22,163,74,1)', backgroundColor: 'rgba(22,163,74,1)', tension: 0.2 }
    ]
  },
  options: { responsive: true, plugins: { legend: { display: true } }, scales: { y: { beginAtZero: true, ticks: { callback: v => (v < 0 ? '-$' : '$') + Math.abs(v).toLocaleString() } } } }
});
</script>
}
