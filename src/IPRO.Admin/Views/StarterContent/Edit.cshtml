@model IPRO.Admin.Models.StarterPageEditViewModel
@{
  var starterPage = Model.Page;
  var isNew = starterPage.Id == 0;
  ViewData["Title"] = isNew ? "Create Starter Page" : $"Edit Starter Page: {starterPage.Title}";
  var imagePool = ViewBag.ImagePool as List<string> ?? new List<string>();
}

<div class="mb-4"><div class="small text-muted mb-1"><a href="/StarterContent">Starter Content</a> / @(isNew ? "Create" : "Edit")</div><h3 class="fw-bold mb-1">@ViewData["Title"]</h3><div class="text-muted">Business type content takes priority over the generic All set. A package-specific page takes priority over an all-package page.</div></div>

<form method="post" action="/StarterContent/SavePage" class="card border-0 shadow-sm mb-4">
  @Html.AntiForgeryToken()<input type="hidden" name="id" value="@starterPage.Id" />
  <div class="card-body p-4"><div class="row g-3">
    <div class="col-md-4"><label class="form-label fw-semibold">Business Type</label><input name="businessType" value="@starterPage.BusinessType" class="form-control" placeholder="All or Insurance / Financial" required /></div>
    <div class="col-md-4"><label class="form-label fw-semibold">Package Override</label><select name="billingRuleId" class="form-select"><option value="">All packages</option>@foreach(var package in Model.Packages){<option value="@package.Id" selected="@(starterPage.BillingRuleId == package.Id)">@package.PackageName</option>}</select></div>
    <div class="col-md-4"><label class="form-label fw-semibold">Page Title</label><input name="title" value="@starterPage.Title" class="form-control" required /></div>
    <div class="col-md-4"><label class="form-label fw-semibold">Page Address</label><input name="slug" value="@starterPage.Slug" class="form-control" placeholder="about or services" /><div class="form-text">The public page link, such as /about or /services.</div></div>
    <div class="col-md-4"><label class="form-label fw-semibold">Navigation Label</label><input name="navigationLabel" value="@starterPage.NavigationLabel" class="form-control" /></div>
    <div class="col-md-4"><label class="form-label fw-semibold">SEO Title</label><input name="metaTitle" value="@starterPage.MetaTitle" class="form-control" /></div>
    <div class="col-12"><label class="form-label fw-semibold">SEO Description</label><input name="metaDescription" value="@starterPage.MetaDescription" maxlength="320" class="form-control" /></div>
    <div class="col-12 d-flex gap-4"><div class="form-check form-switch"><input name="isHomePage" value="true" type="checkbox" class="form-check-input" checked="@starterPage.IsHomePage" /><label class="form-check-label">Home page</label></div><div class="form-check form-switch"><input name="showInNavigation" value="true" type="checkbox" class="form-check-input" checked="@starterPage.ShowInNavigation" /><label class="form-check-label">Show in navigation</label></div><div class="form-check form-switch"><input name="isActive" value="true" type="checkbox" class="form-check-input" checked="@starterPage.IsActive" /><label class="form-check-label">Active</label></div></div>
  </div></div>
  <div class="card-footer bg-white border-0 px-4 pb-4"><button class="btn btn-primary"><i class="fas fa-save me-1"></i>Save Starter Page</button></div>
</form>

@if (!isNew)
{
  <div class="d-flex justify-content-between align-items-center gap-3 mb-3"><div><h4 class="fw-bold mb-1">Starter Blocks</h4><div class="text-muted small">These blocks are copied into the agent's editable page.</div></div><form method="post" action="/StarterContent/AddBlock" class="d-flex gap-2">@Html.AntiForgeryToken()<input type="hidden" name="pageId" value="@starterPage.Id" /><select name="blockType" class="form-select">@foreach(var type in Model.BlockTypes){<option value="@type">@System.Text.RegularExpressions.Regex.Replace(type, "([a-z])([A-Z])", "$1 $2")</option>}</select><button class="btn btn-primary text-nowrap"><i class="fas fa-plus me-1"></i>Add Block</button></form></div>
  @foreach (var block in starterPage.Blocks.OrderBy(b => b.SortOrder))
  {
    <section class="card border-0 shadow-sm mb-3"><div class="card-header bg-white d-flex justify-content-between align-items-center"><div><span class="badge bg-primary-subtle text-primary me-2">@System.Text.RegularExpressions.Regex.Replace(block.BlockType, "([a-z])([A-Z])", "$1 $2")</span><strong>@block.Heading</strong></div><form method="post" action="/StarterContent/DeleteBlock/@block.Id">@Html.AntiForgeryToken()<button class="js-confirm-submit btn btn-sm btn-outline-danger" data-confirm-message="Remove this starter block?"><i class="fas fa-trash"></i></button></form></div><form method="post" action="/StarterContent/UpdateBlock" class="card-body p-4">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@block.Id" /><div class="row g-3"><div class="col-md-6"><label class="form-label fw-semibold">Heading</label><input name="heading" value="@block.Heading" class="form-control" /></div><div class="col-md-6"><label class="form-label fw-semibold">Supporting Line</label><input name="subheading" value="@block.Subheading" class="form-control" /></div><div class="col-12"><label class="form-label fw-semibold">Body / Items</label><textarea name="body" rows="4" class="form-control">@block.Body</textarea></div><div class="col-md-6"><label class="form-label fw-semibold">Image</label><div class="d-flex gap-2 align-items-start"><img src="@(string.IsNullOrWhiteSpace(block.ImageUrl) ? "data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" : block.ImageUrl)" alt="" class="js-starter-thumb border rounded bg-light" style="width:64px;height:64px;object-fit:cover;@(string.IsNullOrWhiteSpace(block.ImageUrl) ? "opacity:.35" : "")" /><div class="flex-grow-1"><input name="imageUrl" value="@block.ImageUrl" class="form-control js-starter-image-url" placeholder="Upload below, choose from the library, or paste a URL" /><div class="form-text">Saved with the block when you press Save Block.</div></div></div>@if (imagePool.Count > 0){<details class="mt-2"><summary class="small text-primary" style="cursor:pointer">Choose from the starter image library (@imagePool.Count)</summary><div class="d-flex flex-wrap gap-2 mt-2 p-2 border rounded bg-light" style="max-height:190px;overflow-y:auto">@foreach (var poolUrl in imagePool){<img src="@poolUrl" alt="" title="@poolUrl" data-url="@poolUrl" class="js-starter-pick border rounded bg-white" style="width:58px;height:58px;object-fit:cover;cursor:pointer" />}</div><div class="form-text">Click an image to use it, then press Save Block.</div></details>}</div><div class="col-md-3"><label class="form-label fw-semibold">Button Text</label><input name="buttonText" value="@block.ButtonText" class="form-control" /></div><div class="col-md-3"><label class="form-label fw-semibold">Button Link</label><input name="buttonUrl" value="@block.ButtonUrl" class="form-control" /></div><div class="col-12 d-flex justify-content-between"><div class="form-check form-switch"><input name="isVisible" value="true" type="checkbox" class="form-check-input" checked="@block.IsVisible" /><label class="form-check-label">Visible</label></div><button class="btn btn-outline-primary"><i class="fas fa-save me-1"></i>Save Block</button></div></div></form><form method="post" action="/StarterContent/UploadBlockImage" enctype="multipart/form-data" class="card-body pt-0 px-4 pb-4">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@block.Id" /><label class="form-label fw-semibold small text-muted">Upload a new image for this block</label><div class="input-group input-group-sm"><input type="file" name="image" accept="image/jpeg,image/png,image/gif,image/webp" class="form-control" required /><button class="btn btn-outline-secondary"><i class="fas fa-upload me-1"></i>Upload &amp; apply</button></div><div class="form-text">JPG, PNG, GIF or WebP, up to 8 MB. Uploading saves the image onto this block immediately and adds it to the library above.</div></form></section>
  }
}

@* The library picker only fills in the text box; nothing is saved until Save Block is pressed, so a
   misclick is harmless. Inline handlers are dropped by the CSP, hence the nonce script. *@
<script nonce="@Context.GetCspNonce()">
  document.querySelectorAll('.js-starter-pick').forEach(function (thumb) {
    thumb.addEventListener('click', function () {
      var card = thumb.closest('section');
      if (!card) return;
      var field = card.querySelector('.js-starter-image-url');
      var preview = card.querySelector('.js-starter-thumb');
      if (field) field.value = thumb.dataset.url || '';
      if (preview) { preview.src = thumb.dataset.url || ''; preview.style.opacity = '1'; }
      card.querySelectorAll('.js-starter-pick').forEach(function (other) {
        other.classList.remove('border-primary', 'border-3');
      });
      thumb.classList.add('border-primary', 'border-3');
    });
  });
</script>
