@model IEnumerable<IPRO.Entities.TrialInviteCodeRedemption>
@{
    var code = (IPRO.Entities.TrialInviteCode)ViewBag.Code;
    ViewData["Title"] = $"Redemptions - {code.Code}";
    var agents = (ViewBag.Agents as Dictionary<int, IPRO.Entities.AgentUser>) ?? new Dictionary<int, IPRO.Entities.AgentUser>();
}

<nav aria-label="breadcrumb">
  <ol class="breadcrumb"><li class="breadcrumb-item"><a href="/TrialInviteCodes">Trial Invite Codes</a></li><li class="breadcrumb-item active">@code.Code Redemptions</li></ol>
</nav>

<div class="mb-4">
  <h4 class="fw-bold mb-1"><i class="fas fa-envelope-open-text me-2 text-primary"></i>@code.Code Redemptions</h4>
  <div class="text-muted">@code.RedemptionCount total@(code.MaxRedemptions.HasValue ? $" of {code.MaxRedemptions} allowed" : "")</div>
</div>

<div class="card border-0 shadow-sm">
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead><tr><th>Agent</th><th>Email</th><th>Trial Ends</th><th>Redeemed</th></tr></thead>
      <tbody>
      @if (!Model.Any())
      {
        <tr><td colspan="4" class="text-muted p-3">No redemptions yet.</td></tr>
      }
      @foreach (var r in Model)
      {
        var agent = agents.TryGetValue(r.AgentUserId, out var a) ? a : null;
        var agentName = agent == null ? $"Agent #{r.AgentUserId}" : $"{agent.FirstName} {agent.LastName}";
        <tr>
          <td>@agentName</td>
          <td>@(agent?.Email ?? "-")</td>
          <td>@(agent?.TrialEndsAt?.ToString("MMM d, yyyy") ?? "-")</td>
          <td class="small text-muted">@r.RedeemedAt.ToString("MMM d, yyyy h:mm tt")</td>
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>
