@model IPRO.Entities.TrialInviteCode
@{
    ViewData["Title"] = Model.Id == 0 ? "New Trial Invite Code" : "Edit Trial Invite Code";
    var packages = (ViewBag.Packages as IEnumerable<IPRO.Entities.BillingRule>) ?? Enumerable.Empty<IPRO.Entities.BillingRule>();
}

<nav aria-label="breadcrumb">
  <ol class="breadcrumb"><li class="breadcrumb-item"><a href="/TrialInviteCodes">Trial Invite Codes</a></li><li class="breadcrumb-item active">@(Model.Id == 0 ? "New" : Model.Code)</li></ol>
</nav>

<div class="card border-0 shadow-sm" style="max-width:720px">
  <div class="card-body p-4">
    <form method="post" action="/TrialInviteCodes/Edit">
      @Html.AntiForgeryToken()
      <input type="hidden" asp-for="Id" />
      <input type="hidden" asp-for="CreatedAt" />
      <input type="hidden" asp-for="RedemptionCount" />
      <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label fw-semibold">Code</label>
          <input asp-for="Code" class="form-control text-uppercase" placeholder="WELCOME14" />
          <span asp-validation-for="Code" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
          <label class="form-label fw-semibold">Description</label>
          <input asp-for="Description" class="form-control" placeholder="For internal reference, e.g. who this is for" />
        </div>

        <div class="col-12">
          <label class="form-label fw-semibold">Trial Package</label>
          <select asp-for="BillingRuleId" class="form-select">
            <option value="">Choose a trial package</option>
            @foreach (var package in packages)
            {
              <option value="@package.Id">@package.PackageName@(package.TrialDurationDays.HasValue ? $" ({package.TrialDurationDays} days)" : "")</option>
            }
          </select>
          <span asp-validation-for="BillingRuleId" class="text-danger small"></span>
          @if (!packages.Any())
          {
            <div class="form-text text-danger">No trial packages exist yet. Create one from <a href="/Packages">Packages</a> first (check "This is a trial package").</div>
          }
        </div>

        <div class="col-md-4">
          <div class="form-check form-switch mt-4">
            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
            <label asp-for="IsActive" class="form-check-label">Active</label>
          </div>
        </div>
        <div class="col-md-4">
          <label class="form-label fw-semibold">Valid Until</label>
          <input asp-for="ExpiresAt" type="date" class="form-control" />
          <div class="form-text">When the invitation link itself stops working. Blank = never.</div>
        </div>
        <div class="col-md-4">
          <label class="form-label fw-semibold">Max Redemptions</label>
          <input asp-for="MaxRedemptions" type="number" min="1" class="form-control" placeholder="Blank = unlimited" />
          <div class="form-text">How many different people can use this link.</div>
        </div>
      </div>

      <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary px-4">Save Invite Code</button>
        <a href="/TrialInviteCodes" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
