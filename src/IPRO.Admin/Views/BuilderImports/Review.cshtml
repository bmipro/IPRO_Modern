@model IPRO.Admin.Models.BuilderImportReviewViewModel
@using IPRO.Business.SiteImport
@using IPRO.Entities
@{
    ViewData["Title"] = $"Review a Template Builder package: {Model.Agent.UserName}";
    var business = string.IsNullOrWhiteSpace(Model.Agent.CompanyName) ? $"{Model.Agent.FirstName} {Model.Agent.LastName}" : Model.Agent.CompanyName;
    var plan = Model.Plan;
    string Names(IEnumerable<string> types) => string.Join(", ", types.Select(WebsiteBlockTypes.DisplayName));
    string Size(long bytes) => bytes < 1024 * 1024 ? $"{Math.Max(1, bytes / 1024)} KB" : (bytes / 1024.0 / 1024.0).ToString("0.0") + " MB";
    var created = Model.Images.Where(i => i.Created).ToList();
    var linked = Model.Images.Count - created.Count;
    var blocked = plan == null || plan.Problems.Count > 0;
    var live = Model.Website.IsPublished;
}

<div class="mb-4">
    <nav aria-label="breadcrumb"><ol class="breadcrumb mb-1">
        <li class="breadcrumb-item"><a href="/Agents">Agents</a></li>
        <li class="breadcrumb-item"><a href="/Agents/Details/@Model.Agent.Id">@Model.Agent.UserName</a></li>
        <li class="breadcrumb-item"><a href="/BuilderImports?agentId=@Model.Agent.Id">Template Builder</a></li>
        <li class="breadcrumb-item active">Review</li>
    </ol></nav>
    <h4 class="fw-bold mb-1"><i class="fas fa-list-check me-2 text-primary"></i>Review "@Model.Import.FileName"</h4>
    <div class="text-muted">For @business. The package passed the export contract. <strong>Nothing on the site has changed yet.</strong></div>
</div>

@if (plan == null)
{
    <section class="card border-0 shadow-sm mb-4 border-start border-4 border-danger">
        <div class="card-header bg-white py-3"><strong class="text-danger">This package can no longer be brought in</strong>
            <div class="text-muted small">It passed when it was uploaded; a rule the site decides has changed since. Drop it and upload a corrected package.</div></div>
        <ul class="list-group list-group-flush">
            @foreach (var problem in Model.Package.Problems)
            {
                <li class="list-group-item"><strong>@problem.Where:</strong> @problem.Message <span class="text-muted small">(contract section @problem.Rule)</span></li>
            }
        </ul>
    </section>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="text-muted small text-uppercase">The package</div>
            <div class="fs-5 fw-bold">@Model.Import.PageCount page@(Model.Import.PageCount == 1 ? "" : "s"), @Model.Import.BlockCount section@(Model.Import.BlockCount == 1 ? "" : "s")</div>
            <div class="text-muted small">"@Model.Import.TemplateName", uploaded by @Model.Import.UploadedBy</div>
        </div></div></div>
        <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="text-muted small text-uppercase">Images</div>
            <div class="fs-5 fw-bold">@created.Count new@(created.Count > 0 ? $" ({Size(created.Sum(i => i.Bytes))})" : "")@(linked > 0 ? $", {linked} from an earlier package" : "")</div>
            <div class="text-muted small">New images are already in the customer's media library. Dropping the package takes the unused ones back out.</div>
        </div></div></div>
        <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="text-muted small text-uppercase">Logo</div>
            <div class="fs-5 fw-bold">
                @switch (plan.Logo)
                {
                    case LogoChange.Set: <text>The package's logo is set</text> break;
                    case LogoChange.Replaced: <text>Replaced by the package's logo</text> break;
                    case LogoChange.Removed: <text>Removed</text> break;
                    default: <text>Stays as it is</text> break;
                }
            </div>
            <div class="text-muted small">@(plan.Logo == LogoChange.Unchanged && string.IsNullOrEmpty(Model.Package.Template?.LogoRef) ? "The package has no logo, so it says nothing about the site's." : "The site's header shows it on every page.")</div>
        </div></div></div>
    </div>

    @if (plan.Problems.Count > 0)
    {
        <div class="alert alert-danger border-0 shadow-sm">
            <strong><i class="fas fa-triangle-exclamation me-1"></i>It cannot be brought in as chosen:</strong>
            <ul class="mb-0 mt-1">@foreach (var problem in plan.Problems) { <li>@problem</li> }</ul>
        </div>
    }

    <form method="post" asp-action="Apply" asp-route-id="@Model.Import.Id">
        @Html.AntiForgeryToken()
        <section class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3"><strong>What happens to each page</strong>
                <div class="text-muted small">"Look" opens the page as it would be, in the customer's own design, in a new tab. The look works for an hour; its menu links are not live, so open each page from this list.</div></div>
            <div class="table-responsive"><table class="table align-middle mb-0">
                <thead><tr><th style="width:24%">Page</th><th>What happens</th><th style="width:26%">Sections afterwards</th><th class="text-end" style="width:9%"></th></tr></thead>
                <tbody>
                @foreach (var item in plan.Pages)
                {
                    var pg = item.Page;
                    <tr class="@(item.Change == PageChange.Removed ? "table-danger" : "")">
                        <td><strong>@pg.Title</strong>@if (pg.IsHomePage) { <span class="badge bg-light text-muted ms-1">Home</span> }
                            <div class="text-muted small">/@(pg.IsHomePage ? "" : pg.Slug)</div></td>
                        <td>
                            @switch (item.Change)
                            {
                                case PageChange.Added:
                                    <span class="badge bg-success">New page</span>
                                    <div class="small text-muted mt-1">Published and shown in the menu, like any new page.</div>
                                    break;
                                case PageChange.Replaced:
                                    <span class="badge bg-primary">Replaced</span>
                                    <div class="small text-muted mt-1">Its @item.SectionsBefore.Count section@(item.SectionsBefore.Count == 1 ? "" : "s") give way to the package's. Its search title and description, and whether it is published and in the menu, stay as they are.</div>
                                    @if (item.SectionsLost.Count > 0)
                                    {
                                        <div class="small text-danger mt-1"><i class="fas fa-triangle-exclamation me-1"></i>The builder cannot carry these, so they go: <strong>@Names(item.SectionsLost)</strong>. Add them again in the page editor afterwards.</div>
                                    }
                                    break;
                                case PageChange.Kept:
                                    <span class="badge bg-light text-muted">Stays as it is</span>
                                    <div class="form-check mt-1"><input class="form-check-input" type="checkbox" name="without" value="@pg.Id" id="without-@pg.Id" />
                                        <label class="form-check-label small" for="without-@pg.Id">Remove this page (it is not in the package)</label></div>
                                    break;
                                default:
                                    <span class="badge bg-danger">Will be removed</span>
                                    <div class="form-check mt-1"><input class="form-check-input" type="checkbox" name="without" value="@pg.Id" id="without-@pg.Id" checked />
                                        <label class="form-check-label small" for="without-@pg.Id">Remove this page</label></div>
                                    @if (item.SectionsBefore.Count > 0) { <div class="small text-muted mt-1">With its sections: @Names(item.SectionsBefore).</div> }
                                    break;
                            }
                        </td>
                        <td class="small">@(item.Change == PageChange.Removed ? "-" : Names(pg.Blocks.OrderBy(b => b.SortOrder).Select(b => b.BlockType)))</td>
                        <td class="text-end">
                            @if (item.Change != PageChange.Removed && !blocked)
                            {
                                <a class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener" href="@(Model.LookAddress + Uri.EscapeDataString(pg.Slug))"><i class="fas fa-eye me-1"></i>Look</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table></div>
        </section>

        <section class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3"><strong>The design</strong></div>
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label" for="design">The site's design after it is brought in</label>
                        <select class="form-select" id="design" name="design">
                            <option value="">Leave it as it is (@(Model.Current?.Name ?? "the current design"))</option>
                            @foreach (var design in Model.Designs.Where(d => d.Id != Model.Website.TemplateId))
                            {
                                <option value="@design.Id" selected="@(Model.Design == design.Id)">Switch to @design.Name@(Model.BuiltFor?.Id == design.Id ? " (the package was built for this one)" : "")</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 text-muted small">
                        The package was built with the "@Model.Import.Theme" design in mind@(Model.BuiltFor != null && Model.BuiltFor.Id == Model.Website.TemplateId ? ", which is the design this site uses." : ".") Colours and fonts are the site's own (My Website) and do not come from the builder.
                    </div>
                </div>
            </div>
        </section>

        <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
            <button type="submit" formaction="/BuilderImports/Choose/@Model.Import.Id" class="btn btn-outline-primary"><i class="fas fa-rotate me-1"></i>Update the looks with these choices</button>
            <button type="submit" class="btn btn-success js-confirm-submit" disabled="@blocked"
                    data-confirm-message="@(live
                        ? "Bring this package into the site now? The site is PUBLISHED: visitors see the change at once. The site as it is now is kept and can be put back."
                        : "Bring this package into the site now? The site is not published, so visitors see nothing yet. The site as it is now is kept and can be put back.")">
                <i class="fas fa-file-import me-1"></i>Bring it in
            </button>
            <span class="text-muted small">@(live ? "This site is published: bringing it in is live at once." : "This site is not published yet.") The site as it is now is kept, so it can be put back.</span>
        </div>
    </form>
}

<form asp-action="Discard" asp-route-id="@Model.Import.Id" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-sm btn-outline-secondary js-confirm-submit" data-confirm-message="Drop this package? The site was never changed by it. The images it added that nothing uses are removed from the media library.">Drop this package</button>
</form>
