@model IPRO.Admin.Models.BuilderImportReviewViewModel
@using IPRO.Business.SiteImport
@using IPRO.Entities
@{
    ViewData["Title"] = $"Review a Template Builder package: {Model.Agent.UserName}";
    var business = string.IsNullOrWhiteSpace(Model.Agent.CompanyName) ? $"{Model.Agent.FirstName} {Model.Agent.LastName}" : Model.Agent.CompanyName.TrimEnd('.');
    var plan = Model.Plan;
    string Names(IEnumerable<string> types) => string.Join(", ", types.Select(WebsiteBlockTypes.DisplayName));
    string Size(long bytes) => bytes < 1024 * 1024 ? $"{Math.Max(1, bytes / 1024)} KB" : (bytes / 1024.0 / 1024.0).ToString("0.0") + " MB";
    var created = Model.Images.Where(i => i.Created).ToList();
    var linked = Model.Images.Count - created.Count;
    var blocked = plan == null || plan.Problems.Count > 0;
    var live = Model.Website.IsPublished;
    // 581: whether a page removed in the builder could be one of the package's new pages.
    var anyNewPage = plan != null && plan.Pages.Any(p => p.Change == PageChange.Added);
    // 581: which page a page of the package at a new address is, as the operator said or else as the
    // plan reads it: what its choice shows (a choice the plan could not honour stays shown, beside the problem).
    int ChosenRow(PlannedPage item) => Model.Moved.TryGetValue(item.Page.Slug, out var said) ? said : item.IsMoved ? item.Page.Id : 0;
    string When(DateTime utc) => IPRO.Admin.Infrastructure.AdminClock.Format(utc, Model.Zone);
}

<div class="mb-4">
    <nav aria-label="breadcrumb"><ol class="breadcrumb mb-1">
        <li class="breadcrumb-item"><a href="/Agents">Agents</a></li>
        <li class="breadcrumb-item"><a href="/Agents/Details/@Model.Agent.Id">@Model.Agent.UserName</a></li>
        <li class="breadcrumb-item"><a href="/BuilderImports?agentId=@Model.Agent.Id">Template Builder</a></li>
        <li class="breadcrumb-item active">Review</li>
    </ol></nav>
    <h4 class="fw-bold mb-1"><i class="fas fa-list-check me-2 text-primary"></i>Review "@Model.Import.FileName"</h4>
    <div class="text-muted">For @business. The package passed the export contract. <strong>Nothing on the site has changed yet.</strong></div>
    @if (Model.Handover != null)
    {
        <div class="alert alert-info border-0 shadow-sm mt-3 mb-0"><i class="fas fa-right-left me-1"></i>This is the <strong>return</strong> of the site handed to the builder on @When(Model.Handover.IssuedAt) by @Model.Handover.IssuedBy. A page that did not come back was removed in the builder; a page made in iPro since then is kept.</div>
    }
</div>

@if (plan == null)
{
    <section class="card border-0 shadow-sm mb-4 border-start border-4 border-danger">
        <div class="card-header bg-white py-3"><strong class="text-danger">This package can no longer be brought in</strong>
            <div class="text-muted small">It passed when it was uploaded; a rule the site decides has changed since. Drop it and upload a corrected package.</div></div>
        <ul class="list-group list-group-flush">
            @foreach (var problem in Model.Package.Problems)
            {
                <li class="list-group-item"><strong>@problem.Where:</strong> @problem.Message <span class="text-muted small">(contract section @problem.Rule)</span></li>
            }
        </ul>
    </section>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="text-muted small text-uppercase">The package</div>
            <div class="fs-5 fw-bold">@Model.Import.PageCount page@(Model.Import.PageCount == 1 ? "" : "s"), @Model.Import.BlockCount section@(Model.Import.BlockCount == 1 ? "" : "s")</div>
            <div class="text-muted small">"@Model.Import.TemplateName", uploaded by @Model.Import.UploadedBy</div>
        </div></div></div>
        <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="text-muted small text-uppercase">Images</div>
            <div class="fs-5 fw-bold">@created.Count new@(created.Count > 0 ? $" ({Size(created.Sum(i => i.Bytes))})" : "")@(linked > 0 ? $", {linked} from an earlier package" : "")</div>
            <div class="text-muted small">New images are already in the customer's media library. Dropping the package takes the unused ones back out.</div>
        </div></div></div>
        <div class="col-md-4"><div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="text-muted small text-uppercase">Logo</div>
            <div class="fs-5 fw-bold">
                @switch (plan.Logo)
                {
                    case LogoChange.Set: <text>The package's logo is set</text> break;
                    case LogoChange.Replaced: <text>Replaced by the package's logo</text> break;
                    case LogoChange.Removed: <text>Removed</text> break;
                    default: <text>Stays as it is</text> break;
                }
            </div>
            <div class="text-muted small">@(plan.Logo == LogoChange.Unchanged && string.IsNullOrEmpty(Model.Package.Template?.LogoRef) ? "The package has no logo, so it says nothing about the site's." : "The site's header shows it on every page, and the customer's invoices and documents print it.")</div>
            @if (plan.LogoChangedSinceHandover)
            {
                <div class="small text-danger mt-1"><i class="fas fa-triangle-exclamation me-1"></i><strong>The logo was changed in iPro after the hand-over.</strong> The package carries the one from before; bringing it in puts that one back.</div>
            }
        </div></div></div>
    </div>

    @if (plan.Problems.Count > 0)
    {
        <div class="alert alert-danger border-0 shadow-sm">
            <strong><i class="fas fa-triangle-exclamation me-1"></i>It cannot be brought in as chosen:</strong>
            <ul class="mb-0 mt-1">@foreach (var problem in plan.Problems) { <li>@problem</li> }</ul>
        </div>
    }

    <form method="post" asp-action="Apply" asp-route-id="@Model.Import.Id">
        @Html.AntiForgeryToken()
        <section class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3"><strong>What happens to each page</strong>
                <div class="text-muted small">"Look" opens the page as it would be, in the customer's own design, in a new tab. The look works for an hour; its menu links are not live, so open each page from this list.</div></div>
            <div class="table-responsive"><table class="table align-middle mb-0">
                <thead><tr><th style="width:24%">Page</th><th>What happens</th><th style="width:26%">Sections afterwards</th><th class="text-end" style="width:9%"></th></tr></thead>
                <tbody>
                @foreach (var item in plan.Pages)
                {
                    var pg = item.Page;
                    <tr class="@(item.Change == PageChange.Removed ? "table-danger" : "")">
                        <td><strong>@pg.Title</strong>@if (pg.IsHomePage) { <span class="badge bg-light text-muted ms-1">Home</span> }
                            <div class="text-muted small">/@(pg.IsHomePage ? "" : pg.Slug)</div></td>
                        <td>
                            @switch (item.Change)
                            {
                                case PageChange.Added:
                                    <span class="badge bg-success">New page</span>
                                    <div class="small text-muted mt-1">Published and shown in the menu, like any new page.</div>
                                    break;
                                case PageChange.Replaced:
                                    @if (item.IsMoved)
                                    {
                                        @* 581: a page the designer gave a new address, on the row of the page it was. *@
                                        <span class="badge bg-primary">Moved</span>
                                        <div class="small text-muted mt-1">This is the page that was at /@item.MovedFrom, at a new address. @(item.MovedBy switch
                                            {
                                                MoveMatch.ShortenedLabel => "iPro knows it by the shortened menu label the builder was given for that page.",
                                                MoveMatch.SameTitle => "iPro takes it for that page because it has that page's title, and no other page does. If that is wrong, choose \"No: a new page\" below.",
                                                MoveMatch.SameMenuLabel => "iPro takes it for that page because it has that page's menu label, and no other page does. If that is wrong, choose \"No: a new page\" below.",
                                                _ => "You said so below."
                                            }) It keeps that page's place: its search title and description, whether it is published and in the menu, its language, its old addresses and its visits. Its @item.SectionsBefore.Count section@(item.SectionsBefore.Count == 1 ? "" : "s") give@(item.SectionsBefore.Count == 1 ? "s" : "") way to the package's.</div>
                                        @foreach (var note in item.MoveNotes)
                                        {
                                            <div class="small mt-1" style="color:#8a5a00"><i class="fas fa-circle-info me-1"></i>@note</div>
                                        }
                                        @if (item.OldAddressKept)
                                        {
                                            <div class="small text-success mt-1"><i class="fas fa-check me-1"></i>Links to /@item.MovedFrom keep arriving: they are sent on to /@pg.Slug.</div>
                                        }
                                        else
                                        {
                                            <div class="small text-danger mt-1"><i class="fas fa-triangle-exclamation me-1"></i>@item.OldAddressNote</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">Replaced</span>
                                        <div class="small text-muted mt-1">Its @item.SectionsBefore.Count section@(item.SectionsBefore.Count == 1 ? "" : "s") give@(item.SectionsBefore.Count == 1 ? "s" : "") way to the package's. Its search title and description, and whether it is published and in the menu, stay as they are.</div>
                                    }
                                    @if (item.ChangedSinceHandover)
                                    {
                                        <div class="small text-danger mt-1"><i class="fas fa-triangle-exclamation me-1"></i><strong>Changed in iPro after the hand-over.</strong> What the customer changed on this page since then is replaced by the package's version@(item.LabelKept ? ", apart from its menu label, which stays as the site has it" : "").</div>
                                    }
                                    break;
                                case PageChange.Kept:
                                    <span class="badge bg-light text-muted">Stays as it is</span>
                                    @if (Model.Keep.Contains(pg.Id))
                                    {
                                        @* Removed in the builder and kept here: the choice travels with the form. *@
                                        <div class="form-check mt-1"><input class="form-check-input" type="checkbox" name="keep" value="@pg.Id" id="keep-@pg.Id" checked />
                                            <label class="form-check-label small" for="keep-@pg.Id">Keep this page (it was removed in the builder)</label></div>
                                    }
                                    else
                                    {
                                        <div class="form-check mt-1"><input class="form-check-input" type="checkbox" name="without" value="@pg.Id" id="without-@pg.Id" />
                                            <label class="form-check-label small" for="without-@pg.Id">Remove this page (@(Model.Handover != null ? "it was made in iPro after the hand-over" : "it is not in the package"))</label></div>
                                    }
                                    break;
                                case PageChange.Removed when item.RemovedInBuilder:
                                    <span class="badge bg-danger">Removed in the builder</span>
                                    <div class="form-check mt-1"><input class="form-check-input" type="checkbox" name="keep" value="@pg.Id" id="keep-@pg.Id" />
                                        <label class="form-check-label small" for="keep-@pg.Id">Keep this page after all</label></div>
                                    @if (item.SectionsBefore.Count > 0) { <div class="small text-muted mt-1">With its sections: @Names(item.SectionsBefore).</div> }
                                    @foreach (var line in item.SettingsLost) { <div class="small text-danger mt-1">@line</div> }
                                    @if (anyNewPage)
                                    {
                                        @* Every page removed in the builder is one a page at a new address can be (a MoveCandidate). *@
                                        <div class="small text-muted mt-1"><i class="fas fa-circle-info me-1"></i>If one of the package's new pages is this page at a new address, choose it on that page's line: it then keeps all of this, and links to /@pg.Slug keep arriving.</div>
                                    }
                                    @if (item.ChangedSinceHandover)
                                    {
                                        <div class="small text-danger mt-1"><i class="fas fa-triangle-exclamation me-1"></i><strong>Changed in iPro after the hand-over.</strong> The customer worked on this page since then; removing it loses that work. Tick "Keep this page after all" if in doubt.</div>
                                    }
                                    break;
                                default:
                                    <span class="badge bg-danger">Will be removed</span>
                                    <div class="form-check mt-1"><input class="form-check-input" type="checkbox" name="without" value="@pg.Id" id="without-@pg.Id" checked />
                                        <label class="form-check-label small" for="without-@pg.Id">Remove this page</label></div>
                                    @if (item.SectionsBefore.Count > 0) { <div class="small text-muted mt-1">With its sections: @Names(item.SectionsBefore).</div> }
                                    @foreach (var line in item.SettingsLost) { <div class="small text-danger mt-1">@line</div> }
                                    break;
                            }
                            @* 581: a new page, or one taken for a page of the site at a new address, can be said to be which page it is. *@
                            @if ((item.Change == PageChange.Added || item.IsMoved) && !pg.IsHomePage && plan.MoveCandidates.Count > 0)
                            {
                                var chosenRow = ChosenRow(item);
                                <div class="mt-2">
                                    <label class="form-label small mb-1" for="moved-@pg.Slug">Is this a page of the site at a new address?</label>
                                    <select class="form-select form-select-sm" id="moved-@pg.Slug" name="moved">
                                        <option value="@(pg.Slug):0">No: a new page</option>
                                        @foreach (var candidate in plan.MoveCandidates)
                                        {
                                            <option value="@(pg.Slug):@candidate.RowId" selected="@(chosenRow == candidate.RowId)">Yes: "@candidate.Title", which was at /@candidate.Slug</option>
                                        }
                                    </select>
                                    <div class="small text-muted mt-1">The page it is keeps its search title and description, whether it is published and in the menu, its language and its old addresses, and links to its address keep arriving. After changing this, press "Update this page and the looks with these choices".</div>
                                </div>
                            }
                            @* 577: a menu label the builder was given shortened, and what becomes of it. *@
                            @if (item.LabelSent.Length > 0)
                            {
                                <div class="small text-muted mt-1"><i class="fas fa-circle-info me-1"></i>@(item.LabelKept
                                    ? $"Menu label: the builder showed it shortened, as \"{item.LabelSent}\". It came back unchanged, so the page keeps its own: \"{pg.NavigationLabel}\"."
                                    : pg.NavigationLabel != item.LabelSent
                                    ? $"Menu label: the builder showed it shortened, as \"{item.LabelSent}\", and the designer changed it to \"{pg.NavigationLabel}\". The menu shows that from now on."
                                    : $"Menu label: the builder showed it shortened, as \"{item.LabelSent}\". The page has no menu label of its own on the site, so the menu shows this one from now on; change it on the customer's Website Menu screen if it should read otherwise.")</div>
                            }
                            @* 576: each section of this page that the package does not bring back, with the choice to keep it. *@
                            @foreach (var going in item.SectionsGoing)
                            {
                                var why = going.RemovedInBuilder ? "was removed in the builder"
                                    : Model.Handover != null ? "is on the site but not in the package"
                                    : "is not in the package (a site built from scratch cannot bring one)";
                                <div class="form-check mt-1">
                                    <input class="form-check-input" type="checkbox" name="sections" value="@going.BlockId" id="section-@going.BlockId" checked="@going.Kept" />
                                    <label class="form-check-label small" for="section-@going.BlockId">
                                        <span class="@(going.Kept ? "text-success" : "text-danger")"><i class="fas @(going.Kept ? "fa-check" : "fa-triangle-exclamation") me-1"></i><strong>@SiteImportPlan.Named(going.BlockType, going.Title)</strong> @why@(going.Kept ? ", and is kept as the site has it: it goes to the end of this page." : ", so it goes.")</span>
                                        @(going.Kept ? "Clear the box to let it go." : "Tick the box to keep it at the end of this page.")
                                    </label>
                                </div>
                            }
                            @* 576: what the designer did with a locked box that the list of sections does not show. *@
                            @foreach (var note in item.BoxNotes)
                            {
                                <div class="small mt-1" style="color:#8a5a00"><i class="fas fa-circle-info me-1"></i>@note</div>
                            }
                        </td>
                        <td class="small">@(item.Change == PageChange.Removed ? "-" : Names(pg.Blocks.OrderBy(b => b.SortOrder).Select(b => b.BlockType)))</td>
                        <td class="text-end">
                            @if (item.Change != PageChange.Removed && !blocked)
                            {
                                <a class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener" href="@(Model.LookAddress + Uri.EscapeDataString(pg.Slug))"><i class="fas fa-eye me-1"></i>Look</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table></div>
            @* 581: a page kept after all and then chosen for a page at a new address has no tick box while
               it is that page; its tick travels on, so that undoing the choice keeps it again. *@
            @foreach (var keptId in Model.Keep.Where(id => !plan.Pages.Any(p => p.Page.Id == id && (p.Change is PageChange.Kept or PageChange.Removed))))
            {
                <input type="hidden" name="keep" value="@keptId" />
            }
        </section>

        <section class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3"><strong>The design</strong></div>
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label" for="design">The site's design after it is brought in</label>
                        <select class="form-select" id="design" name="design">
                            <option value="">Leave it as it is (@(Model.Current?.Name ?? "the current design"))</option>
                            @foreach (var design in Model.Designs.Where(d => d.Id != Model.Website.TemplateId))
                            {
                                <option value="@design.Id" selected="@(Model.Design == design.Id)">Switch to @design.Name@(Model.BuiltFor?.Id == design.Id ? " (the package was built for this one)" : "")</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 text-muted small">
                        The package was built with the "@Model.Import.Theme" design in mind@(Model.BuiltFor != null && Model.BuiltFor.Id == Model.Website.TemplateId ? ", which is the design this site uses." : ".") Colours and fonts are the site's own (My Website) and do not come from the builder.
                    </div>
                </div>
            </div>
        </section>

        <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
            <button type="submit" formaction="/BuilderImports/Choose/@Model.Import.Id" class="btn btn-outline-primary"><i class="fas fa-rotate me-1"></i>Update this page and the looks with these choices</button>
            @* 574: what this screen shows, as one value. "Bring it in" refuses if the site has changed since. *@
            <input type="hidden" name="plan" value="@(plan?.Fingerprint)" />
            <button type="submit" class="btn btn-success js-confirm-submit" disabled="@blocked"
                    data-confirm-message="@(live
                        ? "Bring this package into the site now? The site is PUBLISHED: visitors see the change at once. The site as it is now is kept and can be put back."
                        : "Bring this package into the site now? The site is not published, so visitors see nothing yet. The site as it is now is kept and can be put back.")">
                <i class="fas fa-file-import me-1"></i>Bring it in
            </button>
            <span class="text-muted small">@(live ? "This site is published: bringing it in is live at once." : "This site is not published yet.") The site as it is now is kept, so it can be put back. After ticking or clearing a box above, press "Update this page and the looks with these choices" first: "Bring it in" does only what this page shows.</span>
        </div>
    </form>
}

<form asp-action="Discard" asp-route-id="@Model.Import.Id" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-sm btn-outline-secondary js-confirm-submit" data-confirm-message="Drop this package? The site was never changed by it. The images it added that nothing uses are removed from the media library.">Drop this package</button>
</form>
