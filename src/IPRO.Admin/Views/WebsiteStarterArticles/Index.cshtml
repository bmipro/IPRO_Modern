@model IEnumerable<IPRO.Entities.WebsiteStarterArticle>
@{
  ViewData["Title"] = "Starter Articles";
  var groups = Model.GroupBy(a => new { a.BusinessType, Category = a.Category ?? "(uncategorized)" })
      .OrderBy(g => g.Key.BusinessType).ThenBy(g => g.Key.Category);
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-4">
  <div><h3 class="fw-bold mb-1"><i class="fas fa-book-open me-2 text-primary"></i>Starter Articles</h3><div class="text-muted">The Resources articles new agents receive, by business type and category.</div></div>
  <a href="/WebsiteStarterArticles/Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>New Starter Article</a>
</div>

<div class="alert alert-info border-0 shadow-sm">Articles are copied to an agent's own Resources page the first time their site is provisioned (new signups, or an existing agent who has no Resources page yet). Editing or deactivating a record here does not change any agent's already-provisioned copy &mdash; each one becomes a real, independent Article the moment it's copied over.</div>

@foreach (var group in groups)
{
  <section class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3"><strong>@group.Key.BusinessType</strong><span class="text-muted ms-2">@group.Key.Category</span></div>
    <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Order</th><th>Title</th><th>Summary</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>
    @foreach (var article in group.OrderBy(a => a.SortOrder))
    {
      <tr>
        <td>@article.SortOrder</td>
        <td><strong>@article.Title</strong></td>
        <td class="text-muted small">@article.Summary</td>
        <td><span class="badge @(article.IsActive ? "bg-success" : "bg-secondary")">@(article.IsActive ? "Active" : "Inactive")</span></td>
        <td class="text-end">
          <div class="d-flex justify-content-end gap-1">
            <a href="/WebsiteStarterArticles/Edit/@article.Id" class="btn btn-sm btn-outline-primary"><i class="fas fa-pen me-1"></i>Edit</a>
            @if (article.IsActive)
            {
              <form method="post" action="/WebsiteStarterArticles/Deactivate/@article.Id">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-secondary">Deactivate</button></form>
            }
            else
            {
              <form method="post" action="/WebsiteStarterArticles/Restore/@article.Id">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-success">Restore</button></form>
            }
            <form method="post" action="/WebsiteStarterArticles/Delete/@article.Id">@Html.AntiForgeryToken()<button class="js-confirm-submit btn btn-sm btn-outline-danger" data-confirm-message="Delete this starter article? Agents who already have a copy are unaffected."><i class="fas fa-trash"></i></button></form>
          </div>
        </td>
      </tr>
    }
    </tbody></table></div>
  </section>
}
