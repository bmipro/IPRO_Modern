@model IPRO.Admin.Models.PackageEditViewModel
@{
  ViewData["Title"] = "Edit Package";
  var websiteTemplates = ViewBag.WebsiteTemplates as IEnumerable<IPRO.Entities.WebsiteTemplate> ?? Enumerable.Empty<IPRO.Entities.WebsiteTemplate>();
}

<div class="mb-4">
  <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/Packages">Packages</a></li><li class="breadcrumb-item active">Edit</li></ol></nav>
  <h4 class="fw-bold">Edit Package: @Model.PackageName</h4>
</div>

<div class="row"><div class="col-12">
<div class="card border-0 shadow-sm">
<div class="card-body p-4">
<form asp-action="Edit" method="post">
  @Html.AntiForgeryToken()
  <input type="hidden" asp-for="Id"/>
  <div asp-validation-summary="All" class="text-danger mb-3"></div>
  <div class="row g-3 mb-3">
    <div class="col-lg-6"><label class="form-label fw-semibold">Package Name <span class="text-danger">*</span></label><input asp-for="PackageName" class="form-control" required/></div>
    <div class="col-lg-6"><label class="form-label fw-semibold">Description</label><input asp-for="Description" class="form-control"/></div>
  </div>
  <div class="row g-3 mb-3">
    <div class="col-md-4"><label class="form-label fw-semibold">Monthly Recurring ($)</label><input asp-for="MonthlyPrice" type="number" step="0.01" class="form-control" required/></div>
    <div class="col-md-4"><label class="form-label fw-semibold">Annual Recurring ($)</label><input asp-for="AnnualPrice" type="number" step="0.01" class="form-control"/></div>
    <div class="col-md-4"><label class="form-label fw-semibold">One-time Setup Fee ($)</label><input asp-for="SetupFee" type="number" step="0.01" class="form-control"/></div>
  </div>
  <div class="row g-3 mb-3">
    <div class="col-12">
      <div class="border rounded p-3 bg-light">
        <div class="form-check">
          <input asp-for="SetupFeeWaived" class="form-check-input" type="checkbox"/>
          <label asp-for="SetupFeeWaived" class="form-check-label fw-semibold">Waive the setup fee on this package</label>
        </div>
        <div class="small text-muted mt-1">
          The public pricing page shows the fee struck through with <strong>$0</strong>, and new subscribers on
          this package are genuinely not charged it &mdash; the advertised figure and the PayPal charge come
          from the same setting, so they cannot disagree. Waive it only on the packages you want people to
          choose, so the saving is a reason to move up a tier.
        </div>
        <div class="row g-2 mt-2">
          <div class="col-md-4">
            <label asp-for="SetupFeeWaivedUntil" class="form-label small fw-semibold mb-1">Waived until (optional)</label>
            <input asp-for="SetupFeeWaivedUntil" type="date" class="form-control"/>
            <div class="form-text">Leave blank to run until you switch it off. The waiver lapses on its own at the end of this day.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <input type="hidden" asp-for="QuarterlyPrice" value="0"/>
  <input type="hidden" asp-for="MaxClients"/>
  <div class="row g-3 mb-3">
    <div class="col-md-6"><label class="form-label fw-semibold">Max Newsletters/year</label><input asp-for="MaxNewsletters" type="number" class="form-control" placeholder="blank if not limited"/></div>
    <div class="col-md-6">
      <label class="form-label fw-semibold">Default Website Template</label>
      <select asp-for="DefaultWebsiteTemplateId" class="form-select">
        <option value="">Use global default template</option>
        @foreach (var template in websiteTemplates)
        {
          <option value="@template.Id">@template.Name@(template.IsDefault ? " (global default)" : "")</option>
        }
      </select>
      <div class="form-text">New agent websites on this package will start with this template.</div>
    </div>
  </div>
  <div class="row g-3 mb-3">
    <div class="col-md-6"><label class="form-label fw-semibold">PayPal Monthly Plan ID</label><input asp-for="PayPalMonthlyPlanId" class="form-control"/></div>
    <div class="col-md-6"><label class="form-label fw-semibold">PayPal Annual Plan ID</label><input asp-for="PayPalAnnualPlanId" class="form-control"/></div>
  </div>
  @{
    // 422b: a PayPal plan's price is FROZEN at creation. Editing the price here changes what the
    // site advertises and what invoices record, but subscribers keep being charged the plan's old
    // figure until the plans are re-synced -- so the first invoice after an un-synced price change
    // records an amount that was never charged.
    var monthlyDiverges = Model.PayPalMonthlyPlanPrice.HasValue
        && Model.PayPalMonthlyPlanPrice.Value != Model.MonthlyPrice
        && !string.IsNullOrWhiteSpace(Model.PayPalMonthlyPlanId);
    var annualDiverges = Model.PayPalAnnualPlanPrice.HasValue && Model.AnnualPrice.HasValue
        && Model.PayPalAnnualPlanPrice.Value != Model.AnnualPrice.Value
        && !string.IsNullOrWhiteSpace(Model.PayPalAnnualPlanId);
    var priceUnrecorded = (!Model.PayPalMonthlyPlanPrice.HasValue && !string.IsNullOrWhiteSpace(Model.PayPalMonthlyPlanId))
        || (!Model.PayPalAnnualPlanPrice.HasValue && !string.IsNullOrWhiteSpace(Model.PayPalAnnualPlanId));
  }
  @if (monthlyDiverges || annualDiverges)
  {
    <div class="alert alert-danger mb-4">
      <div class="fw-bold"><i class="fas fa-triangle-exclamation me-2"></i>This package's price no longer matches its live PayPal plan</div>
      <div class="small mt-1">
        @if (monthlyDiverges) { <div>Monthly: package says <strong>@Model.MonthlyPrice.ToString("C")</strong>, but the PayPal plan charges <strong>@Model.PayPalMonthlyPlanPrice!.Value.ToString("C")</strong>.</div> }
        @if (annualDiverges) { <div>Annual: package says <strong>@Model.AnnualPrice!.Value.ToString("C")</strong>, but the PayPal plan charges <strong>@Model.PayPalAnnualPlanPrice!.Value.ToString("C")</strong>.</div> }
        <div class="mt-1">Subscribers are charged the <strong>plan</strong> figure, while the pricing page and invoices show the package figure &mdash; the books will record amounts that were never charged. Press <strong>Create / Replace PayPal Plans</strong> below to bring them back in line.</div>
      </div>
    </div>
  }
  else if (priceUnrecorded)
  {
    <div class="alert alert-warning mb-4 small">
      <i class="fas fa-circle-info me-2"></i>The price this package's PayPal plan was created at wasn't recorded
      (the plan predates price tracking). If you've changed prices since the last sync, subscribers are still
      charged the old figure &mdash; re-sync once to be safe; the price will be recorded from then on.
    </div>
  }
  <div class="alert alert-light border d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <div class="fw-bold mb-1"><i class="fab fa-paypal me-2 text-primary"></i>PayPal recurring plans</div>
      <div class="small text-muted">Save package price changes first, then sync. Sync creates new PayPal plans and stores the returned plan IDs for future subscribers.</div>
      <div class="small mt-2">
        <span class="badge @(string.IsNullOrWhiteSpace(Model.PayPalMonthlyPlanId) ? "bg-secondary" : "bg-success") me-1">
          Monthly @(string.IsNullOrWhiteSpace(Model.PayPalMonthlyPlanId) ? "missing" : "connected")
        </span>
        <span class="badge @(string.IsNullOrWhiteSpace(Model.PayPalAnnualPlanId) ? "bg-secondary" : "bg-success")">
          Annual @(string.IsNullOrWhiteSpace(Model.PayPalAnnualPlanId) ? "missing" : "connected")
        </span>
      </div>
    </div>
    <button type="submit" form="sync-paypal-plans-form" class="btn btn-outline-primary">
      <i class="fas fa-sync-alt me-1"></i>Create / Replace PayPal Plans
    </button>
  </div>
  <div class="form-check form-switch mb-3">
    <input asp-for="IsActive" class="form-check-input" type="checkbox"/>
    <label asp-for="IsActive" class="form-check-label fw-semibold">Package is active</label>
  </div>

  <div class="card border-0 bg-light mb-4">
    <div class="card-body">
      <div class="form-check form-switch mb-3">
        <input asp-for="IsTrialPackage" class="form-check-input" type="checkbox" id="isTrialPackageToggle"/>
        <label asp-for="IsTrialPackage" class="form-check-label fw-semibold">This is a trial package</label>
      </div>
      <div id="trialFieldsGroup" class="row g-3" style="display:@(Model.IsTrialPackage ? "flex" : "none")">
        <div class="col-md-4">
          <label asp-for="TrialDurationDays" class="form-label small fw-semibold text-muted">Trial length (days)</label>
          <input asp-for="TrialDurationDays" class="form-control" type="number" min="1" placeholder="14"/>
        </div>
        <div class="col-md-8">
          <label asp-for="TrialReminderDayOffsets" class="form-label small fw-semibold text-muted">Reminder emails (days before expiry, comma-separated)</label>
          <input asp-for="TrialReminderDayOffsets" class="form-control" placeholder="7,3,1"/>
        </div>
        <div class="col-12">
          <small class="text-muted">Reachable only via an invitation code from <a href="/TrialInviteCodes">Trial Invite Codes</a> - never shown in the normal self-serve registration dropdown.</small>
        </div>
      </div>
    </div>
  </div>

  @await Html.PartialAsync("_PackageFeaturesEditor", Model.Features)

  <div class="d-flex gap-2">
    <button type="submit" class="btn btn-primary px-4"><i class="fas fa-save me-1"></i>Save Changes</button>
    <a href="/Packages" class="btn btn-outline-secondary">Cancel</a>
  </div>
</form>
<form id="sync-paypal-plans-form" asp-action="SyncPayPalPlans" asp-route-id="@Model.Id" method="post">
  @Html.AntiForgeryToken()
</form>
</div></div>
</div></div>

@section Scripts {
<script nonce="@Context.GetCspNonce()">
(function () {
  var toggle = document.getElementById('isTrialPackageToggle');
  var group = document.getElementById('trialFieldsGroup');
  if (!toggle || !group) return;
  toggle.addEventListener('change', function () {
    group.style.display = toggle.checked ? 'flex' : 'none';
  });
})();
</script>
}
