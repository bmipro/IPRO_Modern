@model IPRO.Admin.Models.CompanyDetailsViewModel
@using IPRO.DataAccess
@{
    ViewData["Title"] = "Company Details";
    var preview = ViewBag.Preview as BillingCompanyDetails;
    var hasSavedRow = ViewBag.HasSavedRow as bool? ?? false;
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
  <div>
    <h4 class="fw-bold mb-1"><i class="fas fa-building me-2 text-primary"></i>Company Details</h4>
    <p class="text-muted mb-0">The supplier as it appears on every invoice to an adviser, on the paid-invoice email and on the Revenue print view. A field left blank keeps the value the application settings supply.</p>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-7">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <form asp-action="Index" method="post">
          @Html.AntiForgeryToken()
          <div asp-validation-summary="All" class="text-danger mb-3"></div>

          <div class="mb-3">
            <label asp-for="Name" class="form-label fw-semibold"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger small"></span>
          </div>

          <div class="mb-3">
            <label asp-for="AddressLine1" class="form-label fw-semibold"></label>
            <input asp-for="AddressLine1" class="form-control" placeholder="Street address" />
          </div>
          <div class="mb-3">
            <label asp-for="AddressLine2" class="form-label fw-semibold"></label>
            <input asp-for="AddressLine2" class="form-control" placeholder="Suite, floor or unit" />
          </div>
          <div class="row g-3 mb-3">
            <div class="col-md-5">
              <label asp-for="City" class="form-label fw-semibold"></label>
              <input asp-for="City" class="form-control" />
            </div>
            <div class="col-md-3">
              <label asp-for="Province" class="form-label fw-semibold"></label>
              <input asp-for="Province" class="form-control" placeholder="ON" />
            </div>
            <div class="col-md-4">
              <label asp-for="PostalCode" class="form-label fw-semibold"></label>
              <input asp-for="PostalCode" class="form-control" />
            </div>
          </div>
          <div class="mb-3">
            <label asp-for="Country" class="form-label fw-semibold"></label>
            <input asp-for="Country" class="form-control" placeholder="Canada" />
          </div>

          <div class="mb-3">
            <label asp-for="TaxRegistrationNumber" class="form-label fw-semibold"></label>
            <input asp-for="TaxRegistrationNumber" class="form-control" placeholder="Business number followed by RT0001" />
            <div class="form-text">Printed as "GST/HST registration no." on every invoice. Leave it blank and no such line is printed.</div>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label asp-for="Email" class="form-label fw-semibold"></label>
              <input asp-for="Email" class="form-control" />
              <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
              <label asp-for="Website" class="form-label fw-semibold"></label>
              <input asp-for="Website" class="form-control" placeholder="www.iProAdvisers.com" />
            </div>
          </div>

          <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-primary px-4"><i class="fas fa-save me-1"></i>Save Company Details</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <h6 class="fw-bold text-uppercase text-muted small mb-3">What invoices print now</h6>
        @if (preview != null)
        {
          <div class="fw-bold">@preview.Name</div>
          @foreach (var line in preview.AddressLines)
          {
            <div>@line</div>
          }
          @if (!string.IsNullOrWhiteSpace(preview.TaxRegistrationNumber))
          {
            <div>GST/HST registration no. @preview.TaxRegistrationNumber</div>
          }
          else
          {
            <div class="text-muted fst-italic">No GST/HST registration number: the line is left off.</div>
          }
          <div class="mt-2 text-muted small">@IPRO.Email.BrandText.WithCapitals(preview.Website) &nbsp;|&nbsp; @IPRO.Email.BrandText.WithCapitals(preview.Email)</div>
        }
        <hr />
        @if (!hasSavedRow)
        {
          <p class="text-muted small">Nothing has been saved here yet: the values above come from the application settings. The one-line address in the settings keeps printing until an address is saved on this page.</p>
        }
        <p class="text-muted small mb-0">Saved values apply at once to every invoice, including invoices already issued: the supplier block is read when an invoice is shown, not frozen on it. The customer's bill-to block is the snapshot frozen at issue time.</p>
      </div>
    </div>
  </div>
</div>
