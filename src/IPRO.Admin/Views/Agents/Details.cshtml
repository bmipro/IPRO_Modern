@model IPRO.Entities.AgentUser
@{
    ViewData["Title"] = $"Agent: {Model.UserName}";
    // 518: every time on this page in the platform's zone (Admin:TimeZone), the clock the header shows.
    var zone = ViewBag.Zone as string;
    string LocalDate(DateTime utc) => IPRO.DataAccess.AgentLocalTime.FromUtc(utc, zone).ToString("MMM d, yyyy");
    string LocalTime(DateTime utc) => IPRO.Admin.Infrastructure.AdminClock.Format(utc, zone);

    // 583: SuperAdmin clears a sign-in lock; disabled, not hidden, for support admins (the owner's standing rule).
    // A <form> is a tag helper here, so the function is async (MVC1006).
    async Task UnlockButton(string kind, int accountId)
    {
        <form action="/Agents/UnlockSignIn/@Model.Id" method="post" class="d-inline ms-1">
            @Html.AntiForgeryToken()
            <input type="hidden" name="kind" value="@kind" />
            <input type="hidden" name="accountId" value="@accountId" />
            @if (User.HasClaim("Role", IPRO.Entities.AdminRoles.SuperAdmin))
            {
                <button type="submit" class="btn btn-sm btn-outline-danger py-0"><i class="fas fa-lock-open me-1"></i>Unlock</button>
            }
            else
            {
                <button type="button" class="btn btn-sm btn-outline-danger py-0" disabled title="SuperAdmin only: lets them sign in again now"><i class="fas fa-lock-open me-1"></i>Unlock</button>
            }
        </form>
    }
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-1"><li class="breadcrumb-item"><a href="/Agents">Agents</a></li><li class="breadcrumb-item active">@Model.UserName</li></ol></nav>
        <h4 class="fw-bold mb-0">@Model.FirstName @Model.LastName
            <span class="badge bg-light text-muted fw-normal ms-1">#@Model.Id</span>
            @if (Model.IsActive) { <span class="badge badge-status-active ms-2">Active</span> }
            else { <span class="badge badge-status-inactive ms-2">Inactive</span> }
        </h4>
    </div>
    <div class="d-flex gap-2">
        <a href="/Agents/Edit/@Model.Id" class="btn btn-primary"><i class="fas fa-pen me-1"></i>Edit</a>
        <form asp-action="ResetPassword" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-dark js-confirm-submit" data-confirm-message="Reset @Model.UserName's password to a new random temporary password and force a change at next sign-in? The temporary password is emailed to the agent."><i class="fas fa-key me-1"></i>Reset Password</button>
        </form>
        @* Pre-launch audit (2026-08-30): this rendered unconditionally while the rebuild actions
           below correctly gate on the SuperAdmin claim, so a Support admin saw a live button
           that signs an agent AND their whole team out instantly. Gated to match, and the server
           action carries [Authorize(Policy = "SuperAdmin")] so hiding the button is not the only
           defence. *@
        @if (User.HasClaim("Role", IPRO.Entities.AdminRoles.SuperAdmin))
        {
            @if (Model.IsActive)
            {
                <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning js-confirm-submit" data-confirm-message="Deactivate this agent?"><i class="fas fa-ban me-1"></i>Deactivate</button>
                </form>
            }
            else
            {
                <form asp-action="Activate" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success"><i class="fas fa-check me-1"></i>Activate</button>
                </form>
            }
        }
        @* 571: bring a site in from the Template Builder. Replaces a customer's pages, so SuperAdmin
           only; disabled, not hidden, for support admins (the owner's standing rule). *@
        @if (User.HasClaim("Role", IPRO.Entities.AdminRoles.SuperAdmin))
        {
            <a href="/BuilderImports?agentId=@Model.Id" class="btn btn-outline-secondary"><i class="fas fa-file-import me-1"></i>Template Builder</a>
        }
        else
        {
            <button type="button" class="btn btn-outline-secondary" disabled title="SuperAdmin only: brings a site in from the Template Builder and replaces the customer's pages"><i class="fas fa-file-import me-1"></i>Template Builder</button>
        }
        <form asp-action="RebuildResources" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            @if (User.HasClaim("Role", IPRO.Entities.AdminRoles.SuperAdmin))
            {
                <button type="submit" class="btn btn-outline-secondary js-confirm-submit" data-confirm-message="This DELETES the agent's current Resources pages, including any content blocks they customised on those pages — that customisation is lost and cannot be recovered. Their articles are kept and reused when the section rebuilds with the three-level menu. Continue?"><i class="fas fa-sitemap me-1"></i>Rebuild Resources</button>
            }
            else
            {
                <button type="submit" class="btn btn-outline-secondary" disabled title="SuperAdmin only — deletes the agent's customised Resources pages"><i class="fas fa-sitemap me-1"></i>Rebuild Resources</button>
            }
        </form>
        <form asp-action="RebuildRequestMeeting" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            @if (User.HasClaim("Role", IPRO.Entities.AdminRoles.SuperAdmin))
            {
                @* M2: the old confirm said "their edits intact" while the action RemoveRanges every
                   block on the page -- only the FORM is reused. Name the loss, like Rebuild
                   Resources does. Disabled (not hidden) for support admins so they still see what
                   the toolbox contains -- the owner's standing rule. *@
                <button type="submit" class="btn btn-outline-secondary js-confirm-submit" data-confirm-message="This DELETES every content block currently on the agent's Request Meeting page — any customisation there is lost and cannot be recovered. The page is rebuilt around their business type's meeting-request form (a form they already own is reused, so FORM edits survive; PAGE content does not). Live immediately. Continue?"><i class="fas fa-calendar-check me-1"></i>Rebuild Request Meeting</button>
            }
            else
            {
                <button type="submit" class="btn btn-outline-secondary" disabled title="SuperAdmin only — deletes the blocks on the agent's Request Meeting page"><i class="fas fa-calendar-check me-1"></i>Rebuild Request Meeting</button>
            }
        </form>
        @* 584: replaces every page with the starter pack of the agent's current business type. It opens
           a confirm screen that says what goes and what comes; nothing is written until the username is
           typed there. Disabled, not hidden, for support admins (the owner's standing rule). *@
        @if (User.HasClaim("Role", IPRO.Entities.AdminRoles.SuperAdmin))
        {
            <a href="/Agents/StartAgain/@Model.Id" class="btn btn-outline-secondary"><i class="fas fa-arrows-rotate me-1"></i>Start the website again</a>
        }
        else
        {
            <button type="button" class="btn btn-outline-secondary" disabled title="SuperAdmin only: replaces every page of the agent's website with the starter pages of their business type"><i class="fas fa-arrows-rotate me-1"></i>Start the website again</button>
        }
        <a asp-action="ErasurePreview" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><i class="fas fa-list-check me-1"></i>Preview Erasure</a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger js-confirm-submit" data-confirm-message="Delete @Model.UserName permanently? This erases every row and uploaded file they own and cancels their PayPal subscription. This cannot be undone. Use Preview Erasure first to see exactly what goes."><i class="fas fa-trash me-1"></i>Delete</button>
        </form>
    </div>
</div>

@{
    var detailsWarnings = ViewBag.DetailsWarnings as IEnumerable<string> ?? Enumerable.Empty<string>();
    var billings = (ViewBag.Billings as IEnumerable<IPRO.Entities.Billing> ?? Enumerable.Empty<IPRO.Entities.Billing>()).ToList();
    var subscriptionChanges = (ViewBag.SubscriptionChanges as IEnumerable<IPRO.Entities.SubscriptionChange> ?? Enumerable.Empty<IPRO.Entities.SubscriptionChange>()).ToList();
    var agentDomainGuides = ViewBag.DomainGuides as List<IPRO.Admin.Models.AgentDomainViewModel> ?? new List<IPRO.Admin.Models.AgentDomainViewModel>();   // 595
    var packageLookup = ViewBag.PackageLookup as IDictionary<int, IPRO.Entities.BillingRule> ?? new Dictionary<int, IPRO.Entities.BillingRule>();
    var openInvoices = (ViewBag.OpenInvoices as IEnumerable<IPRO.Entities.Invoice> ?? Enumerable.Empty<IPRO.Entities.Invoice>()).ToList();
    var failedPaymentInvoices = (ViewBag.FailedPaymentInvoices as IEnumerable<IPRO.Entities.Invoice> ?? Enumerable.Empty<IPRO.Entities.Invoice>()).ToList();
    var billingLogs = (ViewBag.BillingLogs as IEnumerable<IPRO.Entities.OperateLog> ?? Enumerable.Empty<IPRO.Entities.OperateLog>()).ToList();
    var lockedTeamMembers = ViewBag.LockedTeamMembers as List<IPRO.Entities.TeamMember> ?? new List<IPRO.Entities.TeamMember>();
    var lockedClients = ViewBag.LockedClients as List<IPRO.Entities.Client> ?? new List<IPRO.Entities.Client>();
    var paidInvoiceEmailLogs = billingLogs
        .Where(l => l.Action == "InvoiceEmail" || l.Action == "InvoiceEmailFailed")
        .ToList();

    (string Label, string Css, string Detail) GetInvoiceEmailStatus(IPRO.Entities.Invoice invoice)
    {
        var failed = paidInvoiceEmailLogs.FirstOrDefault(l =>
            l.Action == "InvoiceEmailFailed" &&
            l.Description.StartsWith($"Invoice:{invoice.Id}:", StringComparison.OrdinalIgnoreCase));
        if (failed != null)
        {
            return ("Email failed", "bg-danger", LocalTime(failed.CreatedAt));
        }

        var sent = paidInvoiceEmailLogs.FirstOrDefault(l =>
            l.Action == "InvoiceEmail" &&
            l.Description == $"Invoice:{invoice.Id}");
        if (sent != null)
        {
            return ("Emailed", "bg-success", LocalTime(sent.CreatedAt));
        }

        return ("Not emailed", "bg-secondary", "");
    }
}
@{
    var startedAgain = ViewBag.StartedAgain as IPRO.Entities.WebsiteBuilderImport;
    var startedAgainPages = ViewBag.StartedAgainPages is int keptPages ? keptPages : 0;
}
@if (startedAgain != null)
{
    @* 584: the undo of "Start the website again", while it is the site's newest change of pages. *@
    <div class="alert alert-info border-0 shadow-sm d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <div>
            <div class="fw-semibold"><i class="fas fa-arrows-rotate me-1"></i>This website was started again from the @startedAgain.TemplateName@(startedAgain.AppliedAt.HasValue ? $" on {LocalTime(startedAgain.AppliedAt.Value)}" : "") by @startedAgain.AppliedBy.</div>
            @if (startedAgainPages == 0)
            {
                <div class="small">It had no pages before, so there is nothing to put back.</div>
            }
            else
            {
                <div class="small">The @startedAgainPages page@(startedAgainPages == 1 ? "" : "s") it had before are kept. Putting them back removes the @startedAgain.PageCount starter page@(startedAgain.PageCount == 1 ? "" : "s") and any change made to the pages since; the logo, design and business type stay as they are now.</div>
            }
        </div>
        @if (startedAgainPages > 0)
        {
        <form asp-action="PutBackStartAgain" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="importId" value="@startedAgain.Id" />
            @if (User.HasClaim("Role", IPRO.Entities.AdminRoles.SuperAdmin))
            {
                <button type="submit" class="btn btn-outline-danger js-confirm-submit" data-confirm-message="Put back the @startedAgainPages page@(startedAgainPages == 1 ? "" : "s") @Model.UserName's website had before it was started again? The @startedAgain.PageCount starter page@(startedAgain.PageCount == 1 ? "" : "s") it has now are DELETED, with any change made to the pages since then. Articles the start-again took off the website go back on it, and those it added or published come off it (they stay in Articles). The meeting form it added stays in Forms; the logo, design and business type stay as they are."><i class="fas fa-rotate-left me-1"></i>Put the previous pages back</button>
            }
            else
            {
                <button type="submit" class="btn btn-outline-danger" disabled title="SuperAdmin only: replaces the website's pages with the ones it had before it was started again"><i class="fas fa-rotate-left me-1"></i>Put the previous pages back</button>
            }
        </form>
        }
    </div>
}
@if (detailsWarnings.Any())
{
    <div class="alert alert-warning border-0 shadow-sm">
        <div class="fw-semibold mb-1"><i class="fas fa-triangle-exclamation me-1"></i>Some related data could not be loaded.</div>
        @foreach (var warning in detailsWarnings)
        {
            <div class="small">@warning</div>
        }
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="text-muted small text-uppercase fw-bold">Active Subscription</div>
                <div class="fs-4 fw-bold @(ViewBag.Subscription != null ? "text-success" : "text-danger")">@(ViewBag.Subscription != null ? "Yes" : "No")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="text-muted small text-uppercase fw-bold">Open Invoices</div>
                <div class="fs-4 fw-bold @(openInvoices.Any() ? "text-warning" : "text-success")">@openInvoices.Count</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="text-muted small text-uppercase fw-bold">Failed Payments</div>
                <div class="fs-4 fw-bold @(failedPaymentInvoices.Any() ? "text-danger" : "text-success")">@failedPaymentInvoices.Count</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="text-muted small text-uppercase fw-bold">Billing Events</div>
                <div class="fs-4 fw-bold text-primary">@billingLogs.Count</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3 text-muted text-uppercase" style="font-size:.75rem;letter-spacing:.08em">Profile</h6>
                <dl class="row mb-0" style="font-size:.9rem">
                    <dt class="col-5 text-muted">Username</dt><dd class="col-7">@Model.UserName</dd>
                    <dt class="col-5 text-muted">Email</dt><dd class="col-7">@Model.Email</dd>
                    <dt class="col-5 text-muted">Name</dt><dd class="col-7">@Model.FirstName @Model.LastName</dd>
                    <dt class="col-5 text-muted">Designation</dt><dd class="col-7">@(string.IsNullOrWhiteSpace(Model.Designation) ? "-" : Model.Designation)</dd>
                    @* 584: the starter pack "Start the website again" uses. *@
                    <dt class="col-5 text-muted">Business type</dt><dd class="col-7">@(string.IsNullOrWhiteSpace(Model.BusinessType) ? "-" : Model.BusinessType)</dd>
                    <dt class="col-5 text-muted">Domain</dt><dd class="col-7"><span class="text-primary">@(string.IsNullOrWhiteSpace(Model.DomainName) ? "-" : Model.DomainName)</span></dd>
                    @* 522: the package's name, as the Agents list has said since 518; "Package 3" told the owner nothing. *@
                    <dt class="col-5 text-muted">Package</dt><dd class="col-7">@(packageLookup.TryGetValue(Model.PackageId, out var profilePackage) ? profilePackage.PackageName : $"Package {Model.PackageId}")</dd>
                    <dt class="col-5 text-muted">Password Change</dt><dd class="col-7">@(Model.MustChangePassword ? "Required" : "Not required")</dd>
                    <dt class="col-5 text-muted">Promotion</dt><dd class="col-7">@(string.IsNullOrWhiteSpace(Model.PromotionCode) ? "-" : Model.PromotionCode)</dd>
                    <dt class="col-5 text-muted">Joined</dt><dd class="col-7">@LocalDate(Model.CreatedAt)</dd>
                    <dt class="col-5 text-muted">Last Login</dt><dd class="col-7">@(Model.LastLoginAt.HasValue ? LocalTime(Model.LastLoginAt.Value) : "Never")</dd>
                    @* 583: 5 wrong passwords in a row lock sign-in for 15 minutes; a new password unlocks it too. *@
                    <dt class="col-5 text-muted">Sign-in</dt>
                    <dd class="col-7">
                        @if (IPRO.DataAccess.SignInLockout.IsLocked(Model.SignInLockedUntil, DateTime.UtcNow))
                        {
                            <span class="text-danger"><i class="fas fa-lock me-1"></i>Locked until @LocalTime(Model.SignInLockedUntil!.Value) (5 wrong passwords in a row)</span>
                            await UnlockButton("Adviser", 0);
                        }
                        else
                        {
                            <span>Not locked@(Model.FailedSignInCount > 0 ? $"; {Model.FailedSignInCount} wrong password{(Model.FailedSignInCount == 1 ? "" : "s")} since the last sign-in" : "")</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
        @* 595: the agent's custom domains, each with the step its guide on My Website is on (DomainSetupGuide), so the
           owner can say "you are on step 2" on the phone. The full list is under Domains. *@
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-2"><i class="fas fa-route me-2 text-primary"></i>Custom domains</h6>
                @if (agentDomainGuides.Count == 0)
                {
                    <div class="text-muted small">No custom domains.</div>
                }
                <ul class="list-unstyled mb-0 small">
                    @foreach (var item in agentDomainGuides)
                    {
                        var guide = item.Guide!;
                        var currentStep = guide.Steps.FirstOrDefault(s => s.Number == guide.CurrentStep);
                        <li class="mb-2">
                            <div class="fw-semibold text-break">@item.Domain.DomainName</div>
                            <span class="badge @(guide.Refusal != null ? "bg-danger" : guide.Live ? "bg-success" : "bg-primary")">@(guide.Refusal != null ? "Refused" : guide.Live ? "Live" : $"Step {guide.CurrentStep} of 4")</span>
                            <span>@guide.Heading</span>
                            @if (currentStep != null && currentStep.Seen.Length > 0)
                            {
                                <div class="text-muted">What iPro sees: @currentStep.Seen</div>
                            }
                            @if (guide.CaaName != null)
                            {
                                <div class="text-danger">CAA records at @guide.CaaName keep the padlock out.</div>
                            }
                            @if (guide.MailAtRisk || guide.MailBroken)
                            {
                                <div class="text-danger">@guide.MailNote</div>
                            }
                        </li>
                    }
                </ul>
                <a class="small" href="/Domains">All domains</a>
            </div>
        </div>
        @if (lockedTeamMembers.Count > 0 || lockedClients.Count > 0)
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-2"><i class="fas fa-lock me-2 text-danger"></i>Locked sign-ins</h6>
                    <div class="text-muted small mb-2">5 wrong passwords in a row lock a sign-in for 15 minutes.</div>
                    <ul class="list-unstyled mb-0 small">
                        @foreach (var member in lockedTeamMembers)
                        {
                            <li class="mb-2">Team member @member.FullName (@member.Email), until @LocalTime(member.SignInLockedUntil!.Value) @{ await UnlockButton("TeamMember", member.Id); }</li>
                        }
                        @foreach (var client in lockedClients)
                        {
                            <li class="mb-2">Client portal: @client.FirstName @client.LastName (@client.Email), until @LocalTime(client.SignInLockedUntil!.Value) @{ await UnlockButton("Client", client.Id); }</li>
                        }
                    </ul>
                </div>
            </div>
        }
        <div class="row g-2">
            <div class="col-6"><div class="card border-0 shadow-sm text-center p-3"><div class="fs-3 fw-bold text-info">@ViewBag.ClientCount</div><div class="text-muted small">Clients</div></div></div>
            <div class="col-6"><div class="card border-0 shadow-sm text-center p-3"><div class="fs-3 fw-bold @(ViewBag.Subscription != null ? "text-success" : "text-danger")"><i class="fas @(ViewBag.Subscription != null ? "fa-check-circle" : "fa-times-circle")"></i></div><div class="text-muted small">Subscription</div></div></div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body p-4">
                @{
                    var activeBilling = ViewBag.Subscription as IPRO.Entities.Billing;
                    var activePackage = activeBilling != null && packageLookup.TryGetValue(activeBilling.BillingRuleId, out var activePkg) ? activePkg : null;
                    var failedPayments = failedPaymentInvoices;
                    // 503: the same number the agent's own Billing page shows (see NextCharge).
                    var nextCharge = ViewBag.NextCharge as IPRO.Billing.NextCharge;
                }
                <h6 class="fw-bold mb-3"><i class="fas fa-credit-card me-2 text-primary"></i>Billing Status</h6>
                @if (activeBilling != null)
                {
                    <div class="alert alert-success border-0">
                        <div class="fw-bold">Current package: @(activePackage?.PackageName ?? $"Package {activeBilling.BillingRuleId}")</div>
                        <div class="small">Next billing: @(activeBilling.NextBillingDate?.ToString("MMM d, yyyy") ?? "-") - $@((nextCharge?.Amount ?? activeBilling.Amount).ToString("N2")) @activeBilling.Currency / @activeBilling.Period</div>
                        @if (nextCharge is { DiscountedCyclesLeft: > 0, RegularAmount: not null })
                        {
                            <div class="small text-muted">Promotional price: @nextCharge.DiscountedCyclesLeft more at this price, then $@nextCharge.RegularAmount.Value.ToString("N2").</div>
                        }
                        else if (nextCharge?.PromotionEnded == true)
                        {
                            <div class="small text-muted">The promotional price is used up; this is the regular price (the stored amount, $@activeBilling.Amount.ToString("N2"), catches up with the first full-price payment).</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(activeBilling.PayPalSubscriptionId))
                        {
                            <div class="small font-monospace mt-1">PayPal subscription: @activeBilling.PayPalSubscriptionId</div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-warning border-0">No active subscription.</div>
                }
                @if (failedPayments.Any())
                {
                    <div class="alert alert-danger border-0">
                        <div class="fw-bold mb-1">Failed payment attention needed</div>
                        @foreach (var failed in failedPayments.Take(3))
                        {
                            <div class="small">@failed.InvoiceNumber - $@failed.Total.ToString("N2") @failed.Currency - @LocalDate(failed.IssuedAt)</div>
                        }
                    </div>
                }
                <h6 class="fw-bold mb-3"><i class="fas fa-address-card me-2 text-primary"></i>Registration Details</h6>
                <dl class="row mb-0" style="font-size:.9rem">
                    <dt class="col-md-3 text-muted">Company</dt><dd class="col-md-9">@(string.IsNullOrWhiteSpace(Model.CompanyName) ? "-" : Model.CompanyName)</dd>
                    <dt class="col-md-3 text-muted">Address</dt><dd class="col-md-9">@(string.IsNullOrWhiteSpace(Model.CompanyAddress) ? "-" : Model.CompanyAddress)</dd>
                    <dt class="col-md-3 text-muted">City</dt><dd class="col-md-9">@(string.IsNullOrWhiteSpace(Model.City) ? "-" : Model.City)</dd>
                    <dt class="col-md-3 text-muted">Province/State</dt><dd class="col-md-9">@(string.IsNullOrWhiteSpace(Model.Province) ? "-" : Model.Province)</dd>
                    <dt class="col-md-3 text-muted">Postal Code</dt><dd class="col-md-9">@(string.IsNullOrWhiteSpace(Model.PostalCode) ? "-" : Model.PostalCode)</dd>
                    <dt class="col-md-3 text-muted">Country</dt><dd class="col-md-9">@(string.IsNullOrWhiteSpace(Model.Country) ? "-" : Model.Country)</dd>
                    <dt class="col-md-3 text-muted">Time Zone</dt><dd class="col-md-9">@(string.IsNullOrWhiteSpace(Model.TimeZone) ? "-" : Model.TimeZone)</dd>
                    <dt class="col-md-3 text-muted">Business Type</dt><dd class="col-md-9">@(string.IsNullOrWhiteSpace(Model.BusinessType) ? "-" : Model.BusinessType)</dd>
                    <dt class="col-md-3 text-muted">Business Phone</dt><dd class="col-md-9">@(string.IsNullOrWhiteSpace(Model.Phone) ? "-" : Model.Phone)</dd>
                    <dt class="col-md-3 text-muted">Fax</dt><dd class="col-md-9">@(string.IsNullOrWhiteSpace(Model.BusinessFax) ? "-" : Model.BusinessFax)</dd>
                    <dt class="col-md-3 text-muted">Mobile Phone</dt><dd class="col-md-9">@(string.IsNullOrWhiteSpace(Model.CellPhone) ? "-" : Model.CellPhone)</dd>
                    <dt class="col-md-3 text-muted">Terms Accepted</dt><dd class="col-md-9">@(Model.TermsAcceptedAt.HasValue ? LocalTime(Model.TermsAcceptedAt.Value) : "-")</dd>
                    <dt class="col-md-3 text-muted">Registration IP</dt>
                    <dd class="col-md-9">
                        @if (string.IsNullOrWhiteSpace(Model.RegistrationIpAddress))
                        {
                            @:-
                        }
                        else
                        {
                            var lookupIp = Model.RegistrationIpAddress.StartsWith("::ffff:", StringComparison.OrdinalIgnoreCase)
                                ? Model.RegistrationIpAddress["::ffff:".Length..]
                                : Model.RegistrationIpAddress;
                            <a href="https://ipinfo.io/@lookupIp" target="_blank" rel="noopener noreferrer">@Model.RegistrationIpAddress <i class="fas fa-external-link-alt ms-1 small"></i></a>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3"><i class="fas fa-receipt me-2 text-success"></i>Invoices</h6>
                @{ var invoices = ViewBag.Invoices as IEnumerable<IPRO.Entities.Invoice>; }
                @if (invoices != null && invoices.Any())
                {
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Invoice #</th><th>Date</th><th>Amount</th><th>Status</th><th>Email</th><th>PayPal</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var inv in invoices)
                        {
                            var emailStatus = GetInvoiceEmailStatus(inv);
                            <tr>
                                <td class="small">@inv.InvoiceNumber</td>
                                <td class="small text-muted">@LocalDate(inv.IssuedAt)</td>
                                <td class="fw-semibold text-success">$@inv.Total.ToString("N2")</td>
                                <td><span class="badge @(inv.IsPaid ? "bg-success" : inv.Billing?.Status == IPRO.Entities.BillingStatus.Failed ? "bg-danger" : "bg-warning text-dark")">@(inv.IsPaid ? "Paid" : inv.Billing?.Status == IPRO.Entities.BillingStatus.Failed ? "Failed" : "Unpaid")</span></td>
                                <td>
                                    <span class="badge @emailStatus.Css">@emailStatus.Label</span>
                                    @if (!string.IsNullOrWhiteSpace(emailStatus.Detail))
                                    {
                                        <div class="small text-muted">@emailStatus.Detail</div>
                                    }
                                </td>
                                <td class="small font-monospace text-muted">@(string.IsNullOrWhiteSpace(inv.PayPalTransactionId) ? "-" : inv.PayPalTransactionId)</td>
                                <td class="text-end">
                                    @if (inv.IsPaid)
                                    {
                                        <form asp-action="EmailInvoice" asp-route-id="@Model.Id" asp-route-invoiceId="@inv.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-envelope me-1"></i>Email
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                else { <p class="text-muted mb-0">No invoices yet.</p> }
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3"><i class="fas fa-rotate me-2 text-info"></i>Subscription History</h6>
                @if (billings.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead><tr><th>Package</th><th>Status</th><th>Period</th><th>Amount</th><th>Started</th><th>Next/Cancelled</th><th>PayPal Subscription</th></tr></thead>
                            <tbody>
                            @foreach (var billing in billings)
                            {
                                var packageName = packageLookup.TryGetValue(billing.BillingRuleId, out var pkg) ? pkg.PackageName : $"Package {billing.BillingRuleId}";
                                <tr>
                                    <td class="fw-semibold">@packageName</td>
                                    <td><span class="badge @(billing.Status == IPRO.Entities.BillingStatus.Active ? "bg-success" : billing.Status == IPRO.Entities.BillingStatus.Pending ? "bg-warning text-dark" : billing.Status == IPRO.Entities.BillingStatus.Failed ? "bg-danger" : "bg-secondary")">@billing.Status</span></td>
                                    <td>@billing.Period</td>
                                    <td>$@billing.Amount.ToString("N2") @billing.Currency</td>
                                    <td class="small">@billing.StartDate.ToString("MMM d, yyyy")</td>
                                    <td class="small text-muted">@(billing.CancelledAt.HasValue ? LocalDate(billing.CancelledAt.Value) : (billing.NextBillingDate?.ToString("MMM d, yyyy") ?? "-"))</td>
                                    <td class="small font-monospace text-muted">@(string.IsNullOrWhiteSpace(billing.PayPalSubscriptionId) ? "-" : billing.PayPalSubscriptionId)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                else { <p class="text-muted mb-0">No billing history yet.</p> }
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3"><i class="fas fa-clock-rotate-left me-2 text-warning"></i>Retry / Change History</h6>
                @if (subscriptionChanges.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead><tr><th>Type</th><th>Status</th><th>Requested Package</th><th>Amount Due</th><th>Effective</th><th>Created</th></tr></thead>
                            <tbody>
                            @foreach (var change in subscriptionChanges)
                            {
                                var requestedName = packageLookup.TryGetValue(change.RequestedBillingRuleId, out var pkg) ? pkg.PackageName : $"Package {change.RequestedBillingRuleId}";
                                <tr>
                                    <td>@change.ChangeType</td>
                                    <td><span class="badge @(change.Status == IPRO.Entities.SubscriptionChangeStatus.Applied ? "bg-success" : change.Status == IPRO.Entities.SubscriptionChangeStatus.Pending ? "bg-warning text-dark" : "bg-secondary")">@change.Status</span></td>
                                    <td>@requestedName</td>
                                    <td>$@change.AmountDue.ToString("N2") @change.Currency</td>
                                    <td class="small">@change.EffectiveDate.ToString("MMM d, yyyy")</td>
                                    <td class="small text-muted">@LocalTime(change.CreatedAt)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                else { <p class="text-muted mb-0">No subscription changes or retries yet.</p> }
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3"><i class="fas fa-envelope-open-text me-2 text-primary"></i>Billing Email & Payment Events</h6>
                @if (billingLogs.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead><tr><th>Time</th><th>Action</th><th>Details</th></tr></thead>
                            <tbody>
                            @foreach (var log in billingLogs)
                            {
                                var isFailure = log.Action.Contains("Failed", StringComparison.OrdinalIgnoreCase) || log.Description.Contains("PAYPAL_FAILED", StringComparison.OrdinalIgnoreCase);
                                <tr>
                                    <td class="small text-muted">@LocalTime(log.CreatedAt)</td>
                                    <td><span class="badge @(isFailure ? "bg-danger" : "bg-success")">@log.Action</span></td>
                                    <td class="small text-muted">@log.Description</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No billing email or payment events recorded yet.</p>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3"><i class="fas fa-history me-2 text-secondary"></i>Activity Log</h6>
                @{ var logs = ViewBag.Logs as IEnumerable<IPRO.Entities.OperateLog>; }
                @if (logs != null && logs.Any())
                {
                    <div style="max-height:250px;overflow-y:auto;">
                    @foreach (var log in logs)
                    {
                        <div class="d-flex gap-3 py-2 border-bottom">
                            <div class="text-muted" style="font-size:.75rem;white-space:nowrap;min-width:80px;">@IPRO.DataAccess.AgentLocalTime.FromUtc(log.CreatedAt, zone).ToString("MMM d HH:mm")</div>
                            <div>
                                <span class="badge bg-light text-dark me-1">@log.Module</span>
                                <span style="font-size:.85rem">@log.Description</span>
                            </div>
                        </div>
                    }
                    </div>
                }
                else { <p class="text-muted mb-0">No activity logged.</p> }
            </div>
        </div>
    </div>
</div>
