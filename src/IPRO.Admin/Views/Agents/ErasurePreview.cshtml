@model IPRO.DataAccess.AgentErasureReport
@{
    var agent = (IPRO.Entities.AgentUser)ViewBag.Agent;
    ViewData["Title"] = $"Data erasure preview - {agent.UserName}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Data erasure preview</h1>
    <a asp-action="Details" asp-route-id="@agent.Id" class="btn btn-outline-secondary btn-sm">Back to agent</a>
</div>

<div class="alert alert-secondary">
    Everything below belongs to <strong>@agent.UserName</strong> (id @agent.Id, @agent.Email) and would be
    removed permanently if this agent is deleted. Nothing on this page changes anything &mdash; it runs the
    same predicates the deletion uses, counted instead of executed.
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small text-uppercase">Database rows</div>
            <div class="h2 mb-0">@Model.TotalRows</div>
            <div class="text-muted small">across @Model.TableCount tables</div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small text-uppercase">Uploaded files</div>
            <div class="h2 mb-0">@Model.Blobs.Count</div>
            <div class="text-muted small">logo, photo, media, documents, gallery</div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small text-uppercase">Shared files kept</div>
            <div class="h2 mb-0">@Model.SharedBlobsKept.Count</div>
            <div class="text-muted small">starter library artwork, left in place</div>
        </div></div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">Rows by table</div>
    @if (Model.Tables.Count == 0)
    {
        <div class="card-body text-muted">This agent has no data in any tracked table.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead><tr><th>Table</th><th class="text-end">Rows</th></tr></thead>
                <tbody>
                @foreach (var line in Model.Tables.OrderByDescending(l => l.Rows))
                {
                    <tr>
                        <td><code>@line.Table</code></td>
                        <td class="text-end">@line.Rows</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="card mb-4">
    <div class="card-header">Uploaded files that would be deleted</div>
    @if (Model.Blobs.Count == 0)
    {
        <div class="card-body text-muted">This agent has not uploaded any files.</div>
    }
    else
    {
        <ul class="list-group list-group-flush">
            @foreach (var url in Model.Blobs)
            {
                <li class="list-group-item small text-break">@url</li>
            }
        </ul>
    }
</div>

@if (Model.SharedBlobsKept.Count > 0)
{
    <div class="card mb-4 border-info">
        <div class="card-header bg-info-subtle">Shared library files &mdash; referenced by this agent but NOT deleted</div>
        <div class="card-body pb-0">
            <p class="small text-muted">
                Starter provisioning copies shared artwork URLs into each agent's own rows. These files belong to the
                starter library and stay, so deleting this agent cannot break content for anyone else.
            </p>
        </div>
        <ul class="list-group list-group-flush">
            @foreach (var url in Model.SharedBlobsKept)
            {
                <li class="list-group-item small text-break">@url</li>
            }
        </ul>
    </div>
}

@if (Model.RetainedFinancial.Count > 0)
{
    <div class="card mb-4 border-success">
        <div class="card-header bg-success-subtle">Financial records &mdash; retained, NOT deleted</div>
        <div class="card-body pb-0">
            <p class="small text-muted mb-2">
                Invoices are the business's accounting records (CRA expects them kept for six years) and each
                carries its own bill-to snapshot, so they stay printable from
                <a href="/Reports/Invoices">Reports &rarr; Invoices</a> after the agent is gone. The Revenue
                Report keeps reading them too, so deleting an agent no longer rewrites past revenue.
            </p>
        </div>
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead><tr><th>Table</th><th class="text-end">Rows kept</th></tr></thead>
                <tbody>
                @foreach (var line in Model.RetainedFinancial.OrderByDescending(l => l.Rows))
                {
                    <tr>
                        <td><code>@line.Table</code></td>
                        <td class="text-end">@line.Rows</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="alert alert-warning">
    <strong>Not covered by this preview:</strong> the agent's PayPal subscription (cancelled automatically at
    deletion &mdash; deletion is refused if the cancellation fails). Background jobs already queued for this agent will find no rows and stop on their own.
</div>

<div class="card border-danger">
    <div class="card-header bg-danger-subtle">Delete this agent</div>
    <div class="card-body">
        <form asp-action="Delete" asp-route-id="@agent.Id" method="post">
            @Html.AntiForgeryToken()
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="eraseFinancialRecords" value="true" id="eraseFinancial" />
                <label class="form-check-label" for="eraseFinancial">
                    Also erase the financial records above
                    <span class="text-danger fw-bold">&mdash; QA/test agents only.</span>
                    <span class="d-block small text-muted">
                        For a real customer leave this UNCHECKED: erasing their invoices destroys the business's own
                        accounting record and removes their revenue from the Revenue Report retroactively.
                    </span>
                </label>
            </div>
            <button type="submit" class="btn btn-danger js-confirm-submit"
                    data-confirm-message="Permanently delete @agent.UserName and everything in the preview above? This cannot be undone.">
                <i class="fas fa-trash me-1"></i>Delete agent permanently
            </button>
        </form>
    </div>
</div>
