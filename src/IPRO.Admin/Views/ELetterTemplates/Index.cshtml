@model IEnumerable<IPRO.Entities.ELetterTemplate>
@{
    ViewData["Title"] = "E-Letter Templates";
}

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="fw-bold mb-1"><i class="fas fa-file-lines me-2 text-primary"></i>E-Letter Templates</h4>
    <div class="text-muted">Starting points agents pick from when writing a letter to clients.</div>
  </div>
  <a href="/ELetterTemplates/Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>New Template</a>
</div>

@if (!Model.Any())
{
  <div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5">
      <i class="fas fa-file-lines fa-3x text-muted opacity-25 mb-3 d-block"></i>
      <h5 class="fw-bold">No letter templates yet</h5>
      <p class="text-muted">Agents open the composer with a blank letter until you add one.</p>
      <a href="/ELetterTemplates/Create" class="btn btn-primary">Add the first template</a>
    </div>
  </div>
}
else
{
  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead>
          <tr>
            <th>Template</th>
            <th>Subject</th>
            <th>Order</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
        @foreach (var template in Model)
        {
          <tr>
            <td>
              <div class="fw-bold">@template.Name</div>
              <div class="small text-muted">@template.Description</div>
              <div class="small text-muted"><code>@template.Key</code></div>
            </td>
            <td class="small">@template.Subject</td>
            <td>@template.SortOrder</td>
            <td><span class="badge @(template.IsActive ? "bg-success" : "bg-secondary")">@(template.IsActive ? "Active" : "Retired")</span></td>
            <td class="text-end text-nowrap">
              <a href="/ELetterTemplates/Edit/@template.Id" class="btn btn-sm btn-outline-primary">Edit</a>
              @if (template.IsActive)
              {
                <form method="post" action="/ELetterTemplates/Deactivate/@template.Id" class="d-inline">
                  @Html.AntiForgeryToken()
                  <button class="btn btn-sm btn-outline-warning" type="submit" title="Stop offering this template to agents"><i class="fas fa-eye-slash"></i></button>
                </form>
              }
              else
              {
                <form method="post" action="/ELetterTemplates/Restore/@template.Id" class="d-inline">
                  @Html.AntiForgeryToken()
                  <button class="btn btn-sm btn-outline-success" type="submit" title="Offer this template again"><i class="fas fa-eye"></i></button>
                </form>
              }
            </td>
          </tr>
        }
        </tbody>
      </table>
    </div>
  </div>

  <p class="text-muted small mt-3 mb-0">
    <i class="fas fa-info-circle me-1"></i>
    Editing a template changes what the next agent starts from. Letters already written keep their
    own copy of the wording and are never rewritten.
  </p>
}
