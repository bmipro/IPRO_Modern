@{
    ViewData["Title"] = "Billing & Subscription";
    var packageList = ((ViewBag.Packages as IEnumerable<IPRO.Entities.BillingRule>) ?? Enumerable.Empty<IPRO.Entities.BillingRule>())
        .OrderBy(GetPackageRank)
        .ThenBy(p => p.MonthlyPrice <= 0 ? decimal.MaxValue : p.MonthlyPrice)
        .ToList();
    var subscription = ViewBag.Subscription as IPRO.Entities.Billing;
    var pendingChange = ViewBag.PendingChange as IPRO.Entities.SubscriptionChange;
    var invoices = ViewBag.Invoices as IEnumerable<IPRO.Entities.Invoice>;
    var allFeatures = ((ViewBag.PackageFeatures as IEnumerable<IPRO.Entities.PackageFeature>) ?? Enumerable.Empty<IPRO.Entities.PackageFeature>()).ToList();
    var featureRows = allFeatures
        .GroupBy(f => f.FeatureCode)
        .Select(g => g.OrderBy(f => f.SortOrder).First())
        .OrderBy(f => f.SortOrder)
        .ThenBy(f => f.FeatureName)
        .ToList();
    // Resolving what the agent already has (current/pending/unpaid) uses the UNFILTERED package
    // list -- ViewBag.Packages intentionally hides retired-from-sale packages (IsHiddenTestPackage)
    // from browsing, but an existing subscriber's own package must always resolve regardless.
    var allPackageList = (ViewBag.AllPackages as IEnumerable<IPRO.Entities.BillingRule>) ?? packageList;
    var currentPackage = subscription == null ? null : allPackageList.FirstOrDefault(p => p.Id == subscription.BillingRuleId);
    var pendingPackage = pendingChange == null ? null : allPackageList.FirstOrDefault(p => p.Id == pendingChange.RequestedBillingRuleId);
    var unpaidInvoices = (invoices ?? Enumerable.Empty<IPRO.Entities.Invoice>())
        .Where(i => !i.IsPaid &&
            i.Billing?.Status == IPRO.Entities.BillingStatus.Pending &&
            allPackageList.Any(p => p.Id == i.Billing.BillingRuleId))
        .OrderByDescending(i => i.IssuedAt)
        .ToList();
    var isAccessGated = ViewBag.IsAccessGated as bool? ?? false;
    var trialEndsAt = ViewBag.TrialEndsAt as DateTime?;
    var pendingDowngradeCompletionPackage = ViewBag.PendingDowngradeCompletionPackage as IPRO.Entities.BillingRule;
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
  <div>
    <h2 class="fw-bold mb-1"><i class="fas fa-credit-card me-2 text-primary"></i>Billing &amp; Subscription</h2>
    <p class="text-muted mb-0">Choose your package, compare included functions, and upgrade or downgrade when your needs change.</p>
  </div>
</div>

@if (isAccessGated && pendingDowngradeCompletionPackage != null)
{
  var completionPeriod = ViewBag.PendingDowngradeCompletionPeriod as IPRO.Entities.BillingPeriod?;
  <div class="alert alert-warning border-0 shadow-sm mb-4 d-flex align-items-center gap-3">
    <i class="fas fa-arrow-down fa-2x"></i>
    <div>
      <div class="fw-bold">Your plan change to @pendingDowngradeCompletionPackage.PackageName is ready to finish</div>
      <small>
        Your previous subscription has been cancelled. Choose @pendingDowngradeCompletionPackage.PackageName below
        @(completionPeriod == IPRO.Entities.BillingPeriod.Annually ? "with annual billing" : "with monthly billing")
        (the term you originally chose) and subscribe to restore full access. No setup fee applies &mdash; you already
        paid it when you first joined.
      </small>
    </div>
  </div>
}
else if (isAccessGated)
{
  <div class="alert alert-danger border-0 shadow-sm mb-4 d-flex align-items-center gap-3">
    <i class="fas fa-lock fa-2x"></i>
    <div>
      <div class="fw-bold">Your access is currently limited to this page</div>
      <small>
        @(trialEndsAt.HasValue
            ? $"Your trial ended {trialEndsAt.Value:MMMM d, yyyy}. "
            : "")Choose a package below and subscribe to restore full access to your portal.
      </small>
    </div>
  </div>
}
else if (subscription == null && trialEndsAt.HasValue)
{
  <div class="alert alert-info border-0 shadow-sm mb-4 d-flex align-items-center gap-3">
    <i class="fas fa-hourglass-half fa-2x"></i>
    <div>
      <div class="fw-bold">Trial active until @trialEndsAt.Value.ToString("MMMM d, yyyy")</div>
      <small>Subscribe any time before then to keep uninterrupted access.</small>
    </div>
  </div>
}

@if (subscription != null && currentPackage != null)
{
  <div class="alert alert-success border-0 shadow-sm mb-4 d-flex align-items-center gap-3">
    <i class="fas fa-check-circle fa-2x"></i>
    <div class="flex-grow-1">
      <div class="fw-bold">Current package: @currentPackage.PackageName</div>
      @* Amount is the package price BEFORE tax; the actual charge adds the agent's provincial rate
         (13% HST in Ontario, and so on). Saying "plus applicable taxes" is honest without having to
         resolve the agent's province on every page render, and avoids the surprise of a banner
         promising $90.00 while PayPal takes $101.70. *@
      <small>Next billing: @(subscription.NextBillingDate?.ToString("MMMM d, yyyy") ?? "-") - $@subscription.Amount.ToString("N2") @subscription.Currency plus applicable taxes</small>
    </div>
    <form asp-action="CancelSubscription" method="post">
      @Html.AntiForgeryToken()
      <button type="submit" class="btn btn-outline-danger btn-sm js-confirm-submit" data-confirm-message="Cancel your subscription? Billing stops immediately and you keep access until the end of what you have already paid for. If you are partway through a prepaid year, any refund you qualify for is calculated automatically and shown after you cancel. IMPORTANT: please download or print copies of your invoices from the Invoice History below BEFORE your access ends - once your account is closed and later removed, you will no longer be able to sign in to retrieve them.">Cancel Subscription</button>
    </form>
  </div>
}

@if (pendingChange != null && pendingPackage != null)
{
  <div class="alert alert-info border-0 shadow-sm mb-4 d-flex align-items-center gap-3">
    <i class="fas @(pendingChange.AmountDue > 0 ? "fa-hourglass-half" : "fa-calendar-check") fa-2x"></i>
    <div class="flex-grow-1">
      <div class="fw-bold">@(pendingChange.AmountDue > 0 ? "Payment pending" : "Scheduled package change")</div>
      <small>
        @if (pendingChange.AmountDue > 0)
        {
          @:Your @pendingChange.ChangeType.ToString().ToLowerInvariant() to @pendingPackage.PackageName is waiting for payment.
        }
        else
        {
          @:Your change to @pendingPackage.PackageName (@(pendingChange.Period == IPRO.Entities.BillingPeriod.Annually ? "annual" : "monthly") billing) will take effect on @pendingChange.EffectiveDate.ToString("MMMM d, yyyy").
        }
      </small>
    </div>
    @if (pendingChange.AmountDue <= 0 && pendingChange.ChangeType == IPRO.Entities.SubscriptionChangeType.Downgrade)
    {
      <form asp-action="CancelScheduledChange" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-secondary btn-sm js-confirm-submit" data-confirm-message="Cancel this scheduled plan change? Your current package and billing will continue unchanged.">Keep My Current Plan</button>
      </form>
    }
  </div>
}
else if (subscription == null)
{
  <div class="alert alert-warning border-0 shadow-sm mb-4">
    <i class="fas fa-exclamation-triangle me-2"></i>
    <strong>No active subscription.</strong> Choose a package below to activate your website.
  </div>
}
else if (currentPackage == null)
{
  <div class="alert alert-warning border-0 shadow-sm mb-4">
    <i class="fas fa-exclamation-triangle me-2"></i>
    <strong>Your current package is no longer available.</strong> Please choose an active package or contact support.
  </div>
}

@if (unpaidInvoices.Any())
{
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
      <h5 class="fw-bold mb-3"><i class="fas fa-receipt me-2 text-warning"></i>Unpaid Checkout</h5>
      <p class="text-muted mb-3">You have a checkout that was started but not completed. You can continue payment or cancel it and choose a plan again.</p>
      @foreach (var invoice in unpaidInvoices)
      {
        var invoicePackage = allPackageList.FirstOrDefault(p => p.Id == invoice.Billing.BillingRuleId);
        <div class="border rounded-3 p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
          <div>
            <div class="fw-bold">@invoicePackage?.PackageName</div>
            <small class="text-muted">@invoice.InvoiceNumber - $@invoice.Total.ToString("N2") @invoice.Currency</small>
          </div>
          <div class="d-flex gap-2">
            <form asp-action="ResumePayment" method="post">
              @Html.AntiForgeryToken()
              <input type="hidden" name="invoiceId" value="@invoice.Id"/>
              <button type="submit" class="btn btn-primary btn-sm">Continue Payment</button>
            </form>
            <form asp-action="CancelPendingPayment" method="post">
              @Html.AntiForgeryToken()
              <input type="hidden" name="invoiceId" value="@invoice.Id"/>
              <button type="submit" class="btn btn-outline-secondary btn-sm js-confirm-submit" data-confirm-message="Cancel this pending checkout?">Cancel Checkout</button>
            </form>
          </div>
        </div>
      }
    </div>
  </div>
}

@if (packageList.Any())
{
  @* Feature rows collapse (owner request 2026-08-13): with a live subscription the agent mostly
     comes here for invoices, and 40 function rows pushed Invoice History off the screen. The
     package cards with prices and upgrade buttons STAY visible either way -- only the function
     list folds. Default: collapsed once subscribed, expanded while still choosing a plan. *@
  <div class="card border-0 shadow-sm mb-5">
    <div class="table-responsive">
      <table class="table package-comparison align-middle mb-0 @(subscription != null ? "features-hidden" : "")" id="packageComparison">
        <thead>
          <tr>
            <th class="feature-col">
              <button type="button" id="toggleFeatureRows" class="feature-toggle" aria-expanded="@(subscription != null ? "false" : "true")" aria-controls="featureRowsBody">
                <div class="fs-5 fw-bold">Compare and Upgrade Packages <i class="fas fa-chevron-down toggle-chevron"></i></div>
                <div class="text-muted fw-normal small">Functions included by plan &mdash; click to show or hide the full list</div>
              </button>
            </th>
            @foreach (var pkg in packageList)
            {
              var isCurrent = subscription?.BillingRuleId == pkg.Id;
              var isPending = pendingChange?.RequestedBillingRuleId == pkg.Id;
              var isContactPackage = pkg.MonthlyPrice <= 0;
              <th class="text-center package-col @(isCurrent ? "current-package" : "")">
                @if (isCurrent)
                {
                  <span class="badge bg-primary mb-2">Current Plan</span>
                }
                @if (isPending)
                {
                  <span class="badge bg-info text-dark mb-2 ms-1">Scheduled</span>
                }
                <div class="h5 fw-bold mb-1">@pkg.PackageName</div>
                @if (isContactPackage)
                {
                  <div class="h4 text-primary fw-bold my-2">Contact Us</div>
                }
                else
                {
                  <div class="display-6 text-primary fw-bold my-2">$@pkg.MonthlyPrice.ToString("N0")<span class="fs-6 text-muted fw-normal">/mo</span></div>
                  <div class="small text-muted">@(pkg.AnnualPrice > 0 ? $"${pkg.AnnualPrice:N0} annually" : "Annual billing not set")</div>
                  @* Same reasoning as the next-billing banner: these are pre-tax prices, and the
                     agent is choosing an upgrade from here. *@
                  <div class="small text-muted">plus applicable taxes</div>
                }
                <div class="mt-3">
                  @{
                    var actionText = GetActionText(pkg, currentPackage, subscription);
                  }
                  @if (isCurrent)
                  {
                    <form asp-action="Subscribe" method="post" class="d-grid gap-2">
                      @Html.AntiForgeryToken()
                      <input type="hidden" name="billingRuleId" value="@pkg.Id"/>
                      <button type="button" class="btn btn-outline-secondary btn-sm w-100" disabled>Current Plan</button>
                      @* Term switch: the service schedules it for the end of the paid period, like a
                         downgrade -- without this button the same-package branch was unreachable and
                         switching billing terms was impossible product-wide (2026-08-16 review).
                         Hidden while ANY change is pending: clicking it would silently destroy the
                         scheduled change via CancelPendingChangesAsync (UX-TERMSWITCH, 2026-08-17). *@
                      @if (pendingChange != null)
                      {
                        <div class="small text-muted mt-1">Term switching is unavailable while your scheduled plan change is pending.</div>
                      }
                      else if (subscription?.Period == IPRO.Entities.BillingPeriod.Monthly && pkg.AnnualPrice > 0)
                      {
                        <button type="submit" name="period" value="Annually" class="btn btn-outline-primary btn-sm w-100 js-confirm-submit" data-confirm-message="Switch to annual billing? The change takes effect when your current billing period ends; you will re-approve the new term at PayPal.">Switch to Annual Billing</button>
                      }
                      else if (subscription?.Period == IPRO.Entities.BillingPeriod.Annually && pkg.MonthlyPrice > 0)
                      {
                        <button type="submit" name="period" value="Monthly" class="btn btn-outline-primary btn-sm w-100 js-confirm-submit" data-confirm-message="Switch to monthly billing? The change takes effect when your current billing period ends; you will re-approve the new term at PayPal.">Switch to Monthly Billing</button>
                      }
                    </form>
                  }
                  else if (isPending)
                  {
                    <button class="btn btn-outline-secondary btn-sm w-100" disabled>Scheduled</button>
                  }
                  else if (isContactPackage)
                  {
                    <a href="mailto:support@iproadvisers.com?subject=Broker%20Package%20Inquiry" class="btn btn-outline-primary btn-sm w-100">Contact Us</a>
                  }
                  else
                  {
                    var completionPeriodForCard = ViewBag.PendingDowngradeCompletionPeriod as IPRO.Entities.BillingPeriod?;
                      var isCompletionCard = pendingDowngradeCompletionPackage?.Id == pkg.Id && completionPeriodForCard != null;
                      // DOCS/22 Offer-Both: annual subscribers downgrading get the choice -- keep the
                      // current package to the paid-through date (defer, the default), or switch now
                      // and turn the unused value into free time on the new package (convert).
                      var offerConvert = actionText == "Downgrade"
                                         && subscription?.Period == IPRO.Entities.BillingPeriod.Annually
                                         && subscription.NextBillingDate.HasValue
                                         && subscription.NextBillingDate.Value > DateTime.UtcNow
                                         && pkg.MonthlyPrice > 0;
                      var convertMonthsLabel = "";
                      if (offerConvert)
                      {
                        var fraction = (decimal)Math.Clamp((subscription!.NextBillingDate!.Value - DateTime.UtcNow).TotalDays / 365.0, 0.0, 1.0);
                        var estDays = IPRO.Billing.PrepaidValue.CreditDays(Math.Round(subscription.Amount * fraction, 2), pkg.MonthlyPrice);
                        var estMonths = Math.Max(1, (int)Math.Round(estDays / 30.4));
                        convertMonthsLabel = $"~{estMonths} month{(estMonths == 1 ? "" : "s")}";
                      }
                    <form asp-action="Subscribe" method="post" class="d-grid gap-2">
                      @Html.AntiForgeryToken()
                      <input type="hidden" name="billingRuleId" value="@pkg.Id"/>
                      @if (isCompletionCard)
                      {
                        @* UX-TERMAPPLY: the banner promises "the term you originally chose" -- so the
                           stored term leads, and the other is offered honestly as a change of mind. *@
                        var storedTerm = completionPeriodForCard!.Value.ToString();
                        var otherTerm = completionPeriodForCard == IPRO.Entities.BillingPeriod.Annually ? "Monthly" : "Annually";
                        <button type="submit" name="period" value="@storedTerm" class="btn btn-primary btn-sm w-100">Subscribe @storedTerm (as scheduled)</button>
                        @if (otherTerm != "Annually" || pkg.AnnualPrice > 0)
                        {
                          <button type="submit" name="period" value="@otherTerm" class="btn btn-outline-secondary btn-sm w-100">Switch to @otherTerm instead</button>
                        }
                      }
                      else
                      {
                        <button type="submit" name="period" value="Monthly" class="btn btn-primary btn-sm w-100">@actionText Monthly@(offerConvert ? " — at period end" : "")</button>
                        @if (pkg.AnnualPrice > 0)
                        {
                          <button type="submit" name="period" value="Annually" class="btn btn-outline-primary btn-sm w-100">@actionText Annually@(offerConvert ? " — at period end" : "")</button>
                        }
                      }
                    </form>
                    @if (!isCompletionCard && offerConvert)
                    {
                      @* Its own form so the framework generates the action URL (host-aware; never a
                         hardcoded path -- the WEB-H-1 lesson) and the mode travels as a hidden field. *@
                      <form asp-action="Subscribe" method="post" class="d-grid mt-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="billingRuleId" value="@pkg.Id"/>
                        <input type="hidden" name="period" value="Monthly"/>
                        <input type="hidden" name="downgradeMode" value="convert"/>
                        <button type="submit" class="btn btn-outline-success btn-sm w-100 js-confirm-submit"
                                data-confirm-message="Switch to @pkg.PackageName now? Your unused prepaid value becomes about @convertMonthsLabel of free @pkg.PackageName, and monthly billing at $@pkg.MonthlyPrice.ToString("N0") plus tax starts only after the free time ends. You will approve the new subscription at PayPal (no charge today).">
                          Switch now + @convertMonthsLabel free
                        </button>
                      </form>
                    }
                  }
                </div>
              </th>
            }
          </tr>
        </thead>
        <tbody id="featureRowsBody">
          @foreach (var feature in featureRows)
          {
            <tr>
              <td class="feature-name">@feature.FeatureName</td>
              @foreach (var pkg in packageList)
              {
                var packageFeature = allFeatures.FirstOrDefault(f => f.BillingRuleId == pkg.Id && f.FeatureCode == feature.FeatureCode);
                <td class="text-center">
                  @RenderFeatureValue(packageFeature)
                </td>
              }
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
}
else
{
  <div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5 text-muted">
      No active billing packages are available yet.
    </div>
  </div>
}

@if (invoices != null && invoices.Any())
{
  <h5 class="fw-bold mb-3">Invoice History</h5>
  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead><tr><th>Invoice #</th><th>Date</th><th>Items</th><th>Subtotal</th><th>Tax</th><th>Total</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var inv in invoices)
        {
          var invoiceStatus = GetInvoiceStatus(inv);
          <tr>
            <td class="fw-semibold small">@inv.InvoiceNumber</td>
            <td><small class="text-muted">@IPRO.Web.Infrastructure.AgentTimeZoneHelper.FromUtc(inv.IssuedAt, ViewBag.AgentTimeZone as string).ToString("MMM d, yyyy")</small></td>
            <td>
              @if (inv.LineItems?.Any() == true)
              {
                <ul class="list-unstyled mb-0 small">
                  @foreach (var item in inv.LineItems.OrderBy(i => i.SortOrder))
                  {
                    <li class="d-flex justify-content-between gap-3">
                      <span>@item.Description</span>
                      <span>$@item.Amount.ToString("N2")</span>
                    </li>
                  }
                </ul>
              }
              else
              {
                <small class="text-muted">Subscription charge</small>
              }
            </td>
            <td>$@inv.SubTotal.ToString("N2")</td>
            <td>
              $@inv.TaxAmount.ToString("N2")
              @if (!string.IsNullOrWhiteSpace(inv.TaxRegion))
              {
                <small class="text-muted d-block">@inv.TaxRegion @(inv.TaxRate > 0 ? inv.TaxRate.ToString("P3") : "")</small>
              }
            </td>
            <td class="fw-bold">$@inv.Total.ToString("N2") <small class="text-muted">@inv.Currency</small></td>
            <td><span class="badge @invoiceStatus.CssClass">@invoiceStatus.Text</span></td>
            <td class="text-end">
              <a asp-action="Invoice" asp-route-id="@inv.Id" class="btn btn-sm btn-outline-secondary me-1" target="_blank">Print/PDF</a>
              @if (!inv.IsPaid && inv.Billing?.Status == IPRO.Entities.BillingStatus.Pending)
              {
                <form asp-action="ResumePayment" method="post" class="d-inline">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="invoiceId" value="@inv.Id"/>
                  <button type="submit" class="btn btn-sm btn-outline-primary">Pay</button>
                </form>
              }
            </td>
          </tr>
        }
        </tbody>
      </table>
    </div>
  </div>
}

<style>
  .package-comparison th,
  .package-comparison td { border-color: #e5e7eb; }
  .package-comparison thead th { background: #f8fafc; vertical-align: top; }
  .package-comparison tbody tr:nth-child(odd) td { background: #f9fafb; }
  .package-comparison .feature-col { min-width: 280px; width: 30%; }
  .package-comparison .package-col { min-width: 220px; }
  .package-comparison .feature-name { font-weight: 600; color: #1f2937; }
  .package-comparison .current-package { background: #eff6ff !important; box-shadow: inset 0 3px 0 #2563eb; }
  .package-comparison .feature-check { color: #16a34a; font-size: 1.15rem; }
  .package-comparison .feature-miss { color: #dc2626; font-size: 1.15rem; }

  /* Collapsible function list: only the tbody folds; the package cards with prices and
     upgrade buttons stay visible. Toggled by the heading button (CSP-safe, no inline JS). */
  .package-comparison.features-hidden tbody { display: none; }
  .feature-toggle { background: none; border: 0; padding: 0; text-align: left; width: 100%; cursor: pointer; color: inherit; }
  .feature-toggle:hover .fs-5 { color: #2563eb; }
  .feature-toggle .toggle-chevron { font-size: .7em; vertical-align: middle; margin-left: 6px; transition: transform .2s; color: #2563eb; }
  .package-comparison.features-hidden .toggle-chevron { transform: rotate(-90deg); }
</style>

<script nonce="@Context.GetCspNonce()">
(function () {
  var table = document.getElementById('packageComparison');
  var button = document.getElementById('toggleFeatureRows');
  if (!table || !button) return;
  button.addEventListener('click', function () {
    var hidden = table.classList.toggle('features-hidden');
    button.setAttribute('aria-expanded', hidden ? 'false' : 'true');
  });
})();
</script>

@functions {
    private static int GetPackageRank(IPRO.Entities.BillingRule package) => package.PackageName switch
    {
        "IPro Silver" => 1,
        "IPro Gold" => 2,
        "IPro Platinum" => 3,
        "Broker Package" => 4,
        _ => 50
    };

    private static string GetActionText(IPRO.Entities.BillingRule package, IPRO.Entities.BillingRule? currentPackage, IPRO.Entities.Billing? subscription)
    {
        if (subscription == null || currentPackage == null)
        {
            return "Subscribe";
        }

        if (package.Id == currentPackage.Id)
        {
            return "Current Plan";
        }

        if (package.MonthlyPrice > currentPackage.MonthlyPrice)
        {
            return "Upgrade";
        }

        return "Downgrade";
    }

    private Microsoft.AspNetCore.Html.IHtmlContent RenderFeatureValue(IPRO.Entities.PackageFeature? feature)
    {
        if (feature?.IsIncluded != true)
        {
            return new Microsoft.AspNetCore.Html.HtmlString("<i class=\"fas fa-times feature-miss\"></i>");
        }

        if (!string.IsNullOrWhiteSpace(feature.LimitLabel))
        {
            return new Microsoft.AspNetCore.Html.HtmlString(System.Net.WebUtility.HtmlEncode(feature.LimitLabel));
        }

        if (feature.LimitValue == -1)
        {
            return new Microsoft.AspNetCore.Html.HtmlString("Unlimited");
        }

        if (feature.LimitValue.HasValue)
        {
            return new Microsoft.AspNetCore.Html.HtmlString(feature.LimitValue.Value.ToString("N0"));
        }

        return new Microsoft.AspNetCore.Html.HtmlString("<i class=\"fas fa-check feature-check\"></i>");
    }

    private static (string Text, string CssClass) GetInvoiceStatus(IPRO.Entities.Invoice invoice)
    {
        if (invoice.IsPaid)
        {
            return ("Paid", "bg-success");
        }

        return invoice.Billing?.Status switch
        {
            IPRO.Entities.BillingStatus.Cancelled => ("Cancelled", "bg-secondary"),
            IPRO.Entities.BillingStatus.Failed => ("Failed", "bg-danger"),
            IPRO.Entities.BillingStatus.Pending => ("Pending", "bg-warning text-dark"),
            _ => ("Unpaid", "bg-warning text-dark")
        };
    }

}
