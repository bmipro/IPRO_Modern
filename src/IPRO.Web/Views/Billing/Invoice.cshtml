@model IPRO.Entities.Invoice
@using IPRO.Web.Infrastructure
@{
    Layout = null;
    // 514 (2026-09-22): the customer invoice on the marketing designer's design (invoice-template-v1),
    // bound to the data the system tracks and nothing invented: what the page says is worked out in
    // InvoicePresentation. The supplier's name, address, GST/HST number, email and website come from
    // SuperAdmin -> Company Details (BillingCompanyDetails, the settings as the fallback), never from
    // this file. The bill-to is the snapshot frozen on the invoice at issue time.
    var agent = ViewBag.Agent as IPRO.Entities.AgentUser;
    var package = ViewBag.Package as IPRO.Entities.BillingRule;
    var view = InvoicePresentation.From(Model, agent, package);
    var companyName = ViewBag.CompanyName as string ?? "IPRO Advisers";
    var companyEmail = ViewBag.CompanyEmail as string ?? "billing@iproadvisers.com";
    var companyWebsite = ViewBag.CompanyWebsite as string ?? "www.iProAdvisers.com";
    var taxNumber = ViewBag.CompanyTaxNumber as string ?? "";
    var companyAddressLines = ViewBag.CompanyAddressLines as System.Collections.Generic.IReadOnlyList<string> ?? System.Array.Empty<string>();
    var websiteHref = companyWebsite.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? companyWebsite : "https://" + companyWebsite;
    var currency = Model.Currency;
    string Cell(decimal amount) => (amount < 0 ? "-$" : "$") + Math.Abs(amount).ToString("N2");
    string Money(decimal amount) => Cell(amount) + " " + currency;
}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Invoice @Model.InvoiceNumber</title>
  <link rel="stylesheet" href="~/css/invoice.css" asp-append-version="true" />
</head>
<body>
  <main class="page-shell">
    <nav class="invoice-actions" aria-label="Invoice actions">
      <a class="button button-secondary" href="/Billing">Back to billing</a>
      <button id="printButton" class="button button-primary" type="button">Print / Save PDF</button>
    </nav>

    <article class="invoice" aria-labelledby="invoice-title">
      <header class="invoice-header">
        <div class="brand">
          <div class="logo-plate">
            <img src="/images/ipro-advisers-logo.png" alt="@companyName" />
          </div>
          <div class="supplier">
            <p class="supplier-name">@companyName</p>
            @foreach (var line in companyAddressLines)
            {
              <p>@line</p>
            }
            @if (!string.IsNullOrWhiteSpace(taxNumber))
            {
              <p>GST/HST registration no. @taxNumber</p>
            }
          </div>
        </div>

        <div class="invoice-heading">
          <p class="eyebrow">@view.Eyebrow</p>
          <h1 id="invoice-title">Invoice</h1>
          <span class="status status-@view.StatusClass">@view.StatusText</span>
        </div>
      </header>

      <div class="brand-rule" aria-hidden="true"></div>

      <section class="invoice-summary" aria-label="Invoice summary">
        <dl>
          <div>
            <dt>Invoice number</dt>
            <dd>@Model.InvoiceNumber</dd>
          </div>
          <div>
            <dt>Invoice date</dt>
            <dd>@view.InvoiceDate</dd>
          </div>
          <div>
            <dt>Package</dt>
            <dd>@view.PackageName</dd>
          </div>
          @if (!string.IsNullOrWhiteSpace(view.BillingCycle))
          {
            <div>
              <dt>Billing cycle</dt>
              <dd>@view.BillingCycle</dd>
            </div>
          }
        </dl>
      </section>

      <section class="party-grid">
        <div class="party">
          <h2>Bill to</h2>
          <p class="party-name">@view.BillToName</p>
          @if (!string.IsNullOrWhiteSpace(view.BillToCompany))
          {
            <p>@view.BillToCompany</p>
          }
          @foreach (var line in view.BillToAddressLines)
          {
            <p>@line</p>
          }
          @if (!string.IsNullOrWhiteSpace(view.BillToEmail))
          {
            <p class="muted">@view.BillToEmail</p>
          }
        </div>

        <div class="payment-summary">
          <h2>Payment</h2>
          <dl>
            <div><dt>Status</dt><dd>@view.StatusText</dd></div>
            <div><dt>Method</dt><dd>@view.Method</dd></div>
            @if (!string.IsNullOrWhiteSpace(view.SubscriptionId))
            {
              <div><dt>PayPal subscription</dt><dd class="wrap">@view.SubscriptionId</dd></div>
            }
            @if (!string.IsNullOrWhiteSpace(view.TransactionId))
            {
              <div><dt>PayPal transaction</dt><dd class="wrap">@view.TransactionId</dd></div>
            }
            <div><dt>Currency</dt><dd>@currency</dd></div>
          </dl>
        </div>
      </section>

      <section class="charges" aria-labelledby="charges-title">
        <h2 id="charges-title" class="visually-hidden">Invoice charges</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Description</th>
                <th scope="col">Tax</th>
                <th scope="col">Amount</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var line in view.Lines)
              {
                <tr>
                  <td data-label="Description"><strong>@line.Description</strong></td>
                  <td data-label="Tax">@line.TaxLabel</td>
                  <td data-label="Amount">@Cell(line.Amount)</td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      </section>

      <section class="totals-area">
        <div class="tax-note">
          <h2>Tax summary</h2>
          @if (view.HasTax)
          {
            <p><span>Taxable amount</span><strong>@Money(Model.SubTotal)</strong></p>
            <p><span>@view.TaxLabel</span><strong>@Money(Model.TaxAmount)</strong></p>
          }
          else
          {
            <p><span>No tax was charged on this invoice.</span></p>
          }
          @if (!string.IsNullOrWhiteSpace(taxNumber))
          {
            <p><span>GST/HST registration no.</span><strong>@taxNumber</strong></p>
          }
        </div>

        <dl class="totals">
          <div><dt>Subtotal</dt><dd>@Money(Model.SubTotal)</dd></div>
          <div><dt>@(view.HasTax ? view.TaxLabel : "Tax")</dt><dd>@Money(Model.TaxAmount)</dd></div>
          <div class="total"><dt>Total</dt><dd>@Money(Model.Total)</dd></div>
          @if (view.PaymentReceived > 0)
          {
            <div><dt>Payment received</dt><dd>@Money(-view.PaymentReceived)</dd></div>
          }
          <div class="balance @(view.BalanceDue > 0 ? "owing" : "")"><dt>Balance due</dt><dd>@Money(view.BalanceDue)</dd></div>
        </dl>
      </section>

      <footer class="invoice-footer">
        <p>Thank you for choosing @(companyName)@(companyName.EndsWith(".") ? "" : ".")</p>
        @* 511: the owner's capitals wherever a person reads a brand domain -- display only. *@
        <p>Questions about this invoice? <a href="mailto:@companyEmail">@IPRO.Email.BrandText.WithCapitals(companyEmail)</a> &nbsp;|&nbsp; <a href="@websiteHref">@IPRO.Email.BrandText.WithCapitals(companyWebsite)</a></p>
        <p class="record-note">Please retain this invoice for your records. This invoice was generated electronically.</p>
      </footer>
    </article>
  </main>
  <script nonce="@Context.GetCspNonce()">
document.getElementById('printButton')?.addEventListener('click', () => window.print());
  </script>
</body>
</html>
