@model IEnumerable<IPRO.Entities.ECard>
@{
    ViewData["Title"] = "E-Cards";
    var agentTimeZone = ViewBag.AgentTimeZone as string ?? IPRO.Web.Infrastructure.AgentTimeZoneHelper.DefaultTimeZone;

    string StatusClass(string status) => status switch
    {
        IPRO.Entities.ECardStatuses.Sent => "bg-success-subtle text-success",
        IPRO.Entities.ECardStatuses.Sending => "bg-info-subtle text-info",
        IPRO.Entities.ECardStatuses.Failed => "bg-danger-subtle text-danger",
        _ => "bg-warning-subtle text-warning-emphasis"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-0"><i class="fas fa-gift me-2 text-primary"></i>E-Cards</h2>
    <small class="text-muted">Send a pre-designed occasion card to your clients, with your own contact card attached.</small>
  </div>
  <a href="/portal/ECards/Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Send an E-Card</a>
</div>

@if (!Model.Any())
{
  <div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5">
      <i class="fas fa-gift fa-3x text-muted opacity-25 mb-3 d-block"></i>
      <h5 class="fw-bold">No e-cards sent yet</h5>
      <p class="text-muted">Pick an occasion, write a short message, choose your clients, and send.</p>
      <a href="/portal/ECards/Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Send an E-Card</a>
    </div>
  </div>
}
else
{
  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Occasion</th>
            <th>Subject</th>
            <th>Recipients</th>
            <th>Status</th>
            <th>Scheduled / Sent</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var card in Model)
          {
            <tr>
              @{
                var designs = ViewBag.Designs as IDictionary<string, IPRO.Entities.ECardDesign>;
                IPRO.Entities.ECardDesign? cardTemplate = null;
                designs?.TryGetValue(card.Occasion ?? string.Empty, out cardTemplate);
              }
              <td>
                @if (cardTemplate != null)
                {
                  <span class="d-inline-flex align-items-center gap-2">
                    @if (cardTemplate.IsArtwork)
                    {
                      <img src="@cardTemplate.ImageUrl" alt="" style="width:54px;height:40px;object-fit:cover;border-radius:4px;" />
                    }
                    else
                    {
                      <span style="display:inline-flex;align-items:center;justify-content:center;width:54px;height:40px;border-radius:4px;font-size:20px;line-height:1;background:linear-gradient(135deg,#1457d9 0%,@cardTemplate.Accent 100%);">@cardTemplate.Emoji</span>
                    }
                    <span><span class="fw-semibold">@cardTemplate.Occasion</span><br /><span class="text-muted small">@cardTemplate.Name</span></span>
                  </span>
                }
                else
                {
                  <span class="text-muted">@card.Occasion</span>
                }
              </td>
              <td>@card.Subject</td>
              <td>@card.TotalSent / @card.TotalRecipients sent</td>
              <td><span class="badge @StatusClass(card.Status)">@card.Status</span></td>
              <td class="text-nowrap small text-muted">
                @if (card.SentAt.HasValue)
                {
                  @IPRO.Web.Infrastructure.AgentTimeZoneHelper.FromUtc(card.SentAt.Value, agentTimeZone).ToString("MMM d, yyyy h:mm tt")
                }
                else
                {
                  @IPRO.Web.Infrastructure.AgentTimeZoneHelper.FromUtc(card.ScheduledAt, agentTimeZone).ToString("MMM d, yyyy h:mm tt")
                }
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
}
