@{
    Layout = null;
    var success = ViewBag.Success as bool? == true;
    // EML-1 (audit 2026-11-26): opening the link only asks. Nothing changes until the button is pressed.
    var ask = ViewBag.Ask as bool? == true;
    var email = ViewBag.Email as string ?? "";
    // 533: the page names the adviser's business, as the emails do, and says what the unsubscribe
    // actually did: it stops every marketing email from that business, not one channel.
    var business = ViewBag.Business as string;
    var sender = string.IsNullOrWhiteSpace(business) ? "this sender" : business;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Email preferences</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" rel="stylesheet" />
  <style>
    body {
      min-height: 100vh;
      display: grid;
      place-items: center;
      background: linear-gradient(135deg, #eef4ff, #ffffff);
      color: #172033;
    }
    .preference-card {
      width: min(560px, calc(100vw - 32px));
      border: 0;
      border-radius: 18px;
      box-shadow: 0 24px 60px rgba(15, 23, 42, .12);
    }
  </style>
</head>
<body>
  <main class="card preference-card">
    <div class="card-body p-5 text-center">
      @if (ask)
      {
        <div class="display-6 text-primary mb-3"><i class="fas fa-envelope-open-text" aria-hidden="true"></i></div>
        <h1 class="h3 fw-bold">Unsubscribe from @sender?</h1>
        <p class="text-muted">@(string.IsNullOrWhiteSpace(email) ? "This address" : email) will no longer receive newsletters or other marketing emails from @sender. Nothing has changed yet.</p>
        <form method="post" class="mb-0">
          <input type="hidden" name="confirm" value="1" />
          <button type="submit" class="btn btn-primary btn-lg px-4">Unsubscribe</button>
        </form>
        <p class="small text-muted mt-3 mb-0">Opened this by mistake? Just close the page.</p>
      }
      else if (success)
      {
        <div class="display-6 text-success mb-3"><i class="fas fa-circle-check"></i></div>
        <h1 class="h3 fw-bold">You have been unsubscribed</h1>
        <p class="text-muted mb-0">@email will no longer receive newsletters or other marketing emails from @sender.</p>
      }
      else
      {
        <div class="display-6 text-warning mb-3"><i class="fas fa-triangle-exclamation"></i></div>
        <h1 class="h3 fw-bold">This unsubscribe link is not valid</h1>
        <p class="text-muted mb-0">The link may have been copied incorrectly or may no longer exist.</p>
      }
    </div>
  </main>
</body>
</html>
