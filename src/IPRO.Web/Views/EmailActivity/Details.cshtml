@model IEnumerable<IPRO.Web.Controllers.EmailRecipientRow>
@{
    var send = (IPRO.Web.Controllers.EmailActivityRow)ViewBag.Send;
    ViewData["Title"] = $"{send.TypeLabel} — {send.Subject}";
    var agentTimeZone = ViewBag.AgentTimeZone as string ?? IPRO.Web.Infrastructure.AgentTimeZoneHelper.DefaultTimeZone;
    // 444: is anything injecting open/click tracking right now? Off means Opened/Clicked cannot
    // populate for new sends, so the screen says so rather than showing a dash that reads as "nobody".
    // 488: the platform's own pixel and redirect count; the controller turns this off for invoices.
    var tracking = ViewBag.EngagementTracking as bool? ?? false;
    // 562: an invoice email has no open pixel; the invoice page records each view by the client.
    var isInvoice = send.TypeKey == "invoice";
    var invoiceView = ViewBag.InvoiceView as IPRO.Web.Infrastructure.InvoiceViewInfo;

    string Stamp(DateTime? value) => value.HasValue
        ? IPRO.Web.Infrastructure.AgentTimeZoneHelper.FromUtc(value.Value, agentTimeZone).ToString("MMM d, h:mm tt")
        : "—";

    // The furthest point each recipient reached. Clicked implies opened implies delivered, so the
    // strongest fact is the useful one to show -- a row saying "Delivered" when the client has
    // already clicked a link would be needlessly pessimistic.
    (string Label, string Css) Progress(IPRO.Web.Controllers.EmailRecipientRow r)
    {
        // 538: a complaint is the recipient's act on an email that arrived, not a send that failed.
        if (IPRO.Entities.EmailIssue.IsComplaint(r.Issue)) return ("Reported spam", "bg-danger-subtle text-danger");
        if (!string.IsNullOrWhiteSpace(r.Issue)) return ("Failed", "bg-danger-subtle text-danger");
        if (r.ClickedAt.HasValue) return ("Clicked", "bg-primary-subtle text-primary");
        if (r.OpenedAt.HasValue) return ("Opened", "bg-success-subtle text-success");
        if (isInvoice && invoiceView?.ViewedSinceThisEmail == true) return ("Viewed", "bg-primary-subtle text-primary");
        if (r.DeliveredAt.HasValue) return ("Delivered", "bg-success-subtle text-success");
        if (r.SentAt.HasValue) return ("Sent", "bg-info-subtle text-info");
        return (r.Status, "bg-warning-subtle text-warning-emphasis");
    }

    var delivered = Model.Count(r => r.DeliveredAt.HasValue);
    var opened = Model.Count(r => r.OpenedAt.HasValue);
    var clicked = Model.Count(r => r.ClickedAt.HasValue);
    // 550: a spam report is not a failure -- the email arrived, and it counts as delivered.
    var failed = Model.Count(r => !string.IsNullOrWhiteSpace(r.Issue) && !IPRO.Entities.EmailIssue.IsComplaint(r.Issue));
    var total = Model.Count();

    string Rate(int part) => total == 0 ? "—" : $"{(part * 100.0 / total):0.#}%";
}

<div class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <a href="/portal/EmailActivity" class="text-decoration-none small text-muted d-inline-block mb-1">
      <i class="fas fa-arrow-left me-1"></i>Back to Email Activity
    </a>
    <h2 class="fw-bold mb-0">@send.Subject</h2>
    <small class="text-muted">
      @send.TypeLabel
      @if (!string.IsNullOrWhiteSpace(send.Detail)) { <text> &middot; @send.Detail</text> }
      @if (send.When.HasValue)
      {
        <text> &middot; @IPRO.Web.Infrastructure.AgentTimeZoneHelper.FromUtc(send.When.Value, agentTimeZone).ToString("MMM d, yyyy h:mm tt")</text>
      }
    </small>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-6 col-lg">
    <div class="card border-0 shadow-sm h-100"><div class="card-body">
      <div class="text-muted small text-uppercase">Recipients</div>
      <div class="fs-4 fw-bold">@total</div>
    </div></div>
  </div>
  <div class="col-6 col-lg">
    <div class="card border-0 shadow-sm h-100"><div class="card-body">
      <div class="text-muted small text-uppercase">Delivered</div>
      <div class="fs-4 fw-bold">@delivered <span class="fs-6 fw-normal text-muted">@Rate(delivered)</span></div>
    </div></div>
  </div>
  @if (isInvoice)
  {
    <div class="col-12 col-lg-5">
      <div class="card border-0 shadow-sm h-100"><div class="card-body">
        <div class="text-muted small text-uppercase">Invoice viewed</div>
        <div class="fs-5 fw-bold @(invoiceView?.ViewedSinceThisEmail == true ? "text-success" : "text-muted")">@IPRO.Web.Infrastructure.InvoiceViewText.Describe(invoiceView, value => Stamp(value))</div>
      </div></div>
    </div>
  }
  else
  {
    <div class="col-6 col-lg">
      <div class="card border-0 shadow-sm h-100"><div class="card-body">
        <div class="text-muted small text-uppercase">Opened</div>
        @if (!tracking && opened == 0)
        {
          <div class="fs-5 text-muted">Not tracked</div>
        }
        else
        {
          <div class="fs-4 fw-bold">@opened <span class="fs-6 fw-normal text-muted">@Rate(opened)</span></div>
        }
      </div></div>
    </div>
    <div class="col-6 col-lg">
      <div class="card border-0 shadow-sm h-100"><div class="card-body">
        <div class="text-muted small text-uppercase">Clicked</div>
        @if (!tracking && clicked == 0)
        {
          <div class="fs-5 text-muted">Not tracked</div>
        }
        else
        {
          <div class="fs-4 fw-bold">@clicked <span class="fs-6 fw-normal text-muted">@Rate(clicked)</span></div>
        }
      </div></div>
    </div>
  }
  <div class="col-6 col-lg">
    <div class="card border-0 shadow-sm h-100"><div class="card-body">
      <div class="text-muted small text-uppercase">Failed</div>
      <div class="fs-4 fw-bold @(failed > 0 ? "text-danger" : "")">@failed</div>
    </div></div>
  </div>
</div>

@if (!Model.Any())
{
  <div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5">
      <i class="fas fa-user-slash fa-3x text-muted opacity-25 mb-3 d-block"></i>
      <h5 class="fw-bold">No recipients recorded</h5>
      <p class="text-muted mb-0">This send has no recipient rows. If it was scheduled but has not run yet, results appear here once it goes out.</p>
    </div>
  </div>
}
else
{
  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Recipient</th>
            <th>Email</th>
            <th>Status</th>
            <th>Sent</th>
            <th>Delivered</th>
            @if (isInvoice) { <th>Invoice viewed</th> } else { <th>Opened</th><th>Clicked</th> }
            <th>Issue</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var r in Model)
          {
            var progress = Progress(r);
            <tr>
              <td class="fw-semibold">@(string.IsNullOrWhiteSpace(r.Name) ? "—" : r.Name)</td>
              <td class="small text-muted">@r.Email</td>
              <td><span class="badge @progress.Css">@progress.Label</span></td>
              <td class="small text-muted text-nowrap">@Stamp(r.SentAt)</td>
              <td class="small text-muted text-nowrap">@Stamp(r.DeliveredAt)</td>
              @if (isInvoice)
              {
                <td class="small text-muted">@IPRO.Web.Infrastructure.InvoiceViewText.Describe(invoiceView, value => Stamp(value))</td>
              }
              else
              {
                <td class="small text-muted text-nowrap">@(r.OpenedAt.HasValue || tracking ? Stamp(r.OpenedAt) : "not tracked")</td>
                <td class="small text-muted text-nowrap">@(r.ClickedAt.HasValue || tracking ? Stamp(r.ClickedAt) : "not tracked")</td>
              }
              <td class="small text-danger">@r.Issue</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>

  @* 562: one short line per word on the screen (the owner found the old paragraph confusing). *@
  <ul class="text-muted small mt-3 mb-0 list-unstyled email-activity-notes">
    <li><strong>Delivered</strong>: the receiving mail system confirmed it arrived.</li>
    @if (isInvoice)
    {
      <li><strong>Invoice viewed</strong>: your client opened the invoice itself, from this email or from their client portal.@if (invoiceView != null) { <text> <a href="/portal/ClientInvoices/Details/@invoiceView.InvoiceId">Open @invoiceView.DocumentNumber</a>.</text> }</li>
      <li>Invoice emails do not count opens or clicks. A view of the invoice is the better sign that it was read.</li>
    }
    else
    {
      <li><strong>Opened</strong>: the reader's mail app loaded the pictures in the email. Some apps block pictures, so real opens are usually a little higher.</li>
      <li><strong>Clicked</strong>: a link in the email was followed.</li>
      <li>Opened and Clicked can take a minute or two to appear. Opens in the first minute after sending are not counted: some mail systems load the pictures on arrival, before anyone reads.</li>
      @if (!tracking)
      {
        <li><strong>Opens and clicks are not being counted right now</strong>, so those two stay empty. Delivered is unaffected.</li>
      }
    }
  </ul>
}
