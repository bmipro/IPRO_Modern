@model IEnumerable<IPRO.Web.Controllers.EmailActivityRow>
@using IPRO.Web.Infrastructure
@{
    ViewData["Title"] = "Email Activity";
    var agentTimeZone = ViewBag.AgentTimeZone as string ?? IPRO.Web.Infrastructure.AgentTimeZoneHelper.DefaultTimeZone;
    var filter = ViewBag.Filter as string ?? "all";
    var tracking = ViewBag.EngagementTracking as bool? ?? false;   // 444

    string StatusClass(string status) => status switch
    {
        "Sent" => "bg-success-subtle text-success",
        "Sending" => "bg-info-subtle text-info",
        "In progress" => "bg-info-subtle text-info",   // 493: paused between passes, part sent
        "Failed" => "bg-danger-subtle text-danger",
        _ => "bg-warning-subtle text-warning-emphasis"
    };

    string TypeIcon(string typeKey) => typeKey switch
    {
        "newsletter" => "fa-newspaper",
        "drip" => "fa-bullhorn",
        "ecard" => "fa-gift",
        "eletter" => "fa-file-lines",
        "poll" => "fa-square-poll-vertical",
        "didyouknow" => "fa-lightbulb",
        "invoice" => "fa-file-invoice-dollar",
        _ => "fa-envelope"
    };

    // 565: the period, the tab, the search and the page the list is showing (EmailActivityListing).
    var listing = ViewBag.Listing as EmailActivityListing
        ?? EmailActivityListing.Build(Model, filter, EmailActivityListing.PeriodFor(null), null, 1);

    var tabs = new[]
    {
        ("all", "Everything"),
        (EmailActivityListing.Attention, "Needs attention"),
        ("newsletter", "Newsletters"),
        ("drip", "Campaigns"),
        ("ecard", "E-Cards"),
        ("eletter", "E-Letters"),
        ("poll", "Polls"),
        ("didyouknow", "Did You Know"),
        ("invoice", "Invoices")
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
  <div>
    <h2 class="fw-bold mb-0"><i class="fas fa-chart-line me-2 text-primary"></i>Email Activity</h2>
    <small class="text-muted">What you have sent, and whether it arrived. Click any row for the recipient-by-recipient detail.</small>
  </div>
  @* 565: find an email by its subject or by who received it, within the period and the tab on the screen. *@
  <form method="get" action="/portal/EmailActivity" class="d-flex gap-2" style="flex:1 1 280px;max-width:420px" role="search">
    @if (listing.Type != "all") { <input type="hidden" name="type" value="@listing.Type" /> }
    @if (listing.Period.Key != EmailActivityListing.DefaultPeriod) { <input type="hidden" name="period" value="@listing.Period.Key" /> }
    <input type="search" name="q" value="@listing.Query" class="form-control" maxlength="80" placeholder="Subject or recipient" aria-label="Search by subject or recipient" />
    <button type="submit" class="btn btn-outline-primary text-nowrap"><i class="fas fa-magnifying-glass me-1"></i>Search</button>
  </form>
</div>

@* 565: the list opens on the last 30 days; older mail is one click away, never gone. *@
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
  <span class="text-muted small">Show</span>
  <div class="btn-group btn-group-sm" role="group" aria-label="Period">
    @foreach (var p in EmailActivityListing.Periods)
    {
      <a class="btn @(listing.Period.Key == p.Key ? "btn-primary" : "btn-outline-primary")" href="@listing.Url(period: p.Key)">@p.Label</a>
    }
  </div>
  @if (listing.Query.Length > 0)
  {
    <span class="small text-muted ms-2">Search: <strong class="text-body">@listing.Query</strong></span>
    <a class="small" href="@listing.Url(query: string.Empty)">Clear the search</a>
  }
</div>

<ul class="nav nav-pills mb-3 gap-1">
  @foreach (var (key, label) in tabs)
  {
    var count = listing.CountFor(key);
    var active = listing.Type == key;
    var alarm = key == EmailActivityListing.Attention && count > 0;   // something failed or bounced in this period
    <li class="nav-item">
      <a class="nav-link @(active ? "active" : "")" href="@listing.Url(type: key)">
        @label
        <span class="badge rounded-pill @(active ? "bg-white text-primary" : alarm ? "bg-danger" : "bg-secondary-subtle text-secondary")">@count</span>
      </a>
    </li>
  }
</ul>

@if (!Model.Any())
{
  <div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5">
      @if (listing.Query.Length > 0)
      {
        <i class="fas fa-magnifying-glass fa-3x text-muted opacity-25 mb-3 d-block"></i>
        <h5 class="fw-bold">Nothing from @listing.Period.Words matches &ldquo;@listing.Query&rdquo;</h5>
        <p class="text-muted">The search looks at each email's subject and at the name and address of everyone it went to.</p>
        @if (listing.Period.Days != null) { <a class="btn btn-outline-primary btn-sm me-1" href="@listing.Url(period: "all")">Search all time</a> }
        <a class="btn btn-outline-secondary btn-sm" href="@listing.Url(query: string.Empty)">Clear the search</a>
      }
      else if (listing.Type == EmailActivityListing.Attention)
      {
        <i class="fas fa-circle-check fa-3x text-success opacity-50 mb-3 d-block"></i>
        <h5 class="fw-bold">Nothing needs attention</h5>
        <p class="text-muted mb-0">No email from @listing.Period.Words failed or bounced.</p>
      }
      else
      {
        <i class="fas fa-paper-plane fa-3x text-muted opacity-25 mb-3 d-block"></i>
        <h5 class="fw-bold">@(listing.Period.Days == null ? "Nothing sent yet" : $"Nothing sent in {listing.Period.Words}")</h5>
        <p class="text-muted @(listing.Period.Days == null ? "mb-0" : "")">Once you send a newsletter, e-card, e-letter or poll, it shows up here with its delivery results.</p>
        @if (listing.Period.Days != null) { <a class="btn btn-outline-primary btn-sm" href="@listing.Url(period: "all")">Show all time</a> }
      }
    </div>
  </div>
}
else
{
  <div class="small text-muted mb-2">
    Showing @listing.From&ndash;@listing.To of @listing.Total from @listing.Period.Words@(listing.Query.Length > 0 ? " that match the search" : string.Empty), newest first.
  </div>
  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Type</th>
            <th>Subject</th>
            <th>Status</th>
            <th class="text-end">Recipients</th>
            <th class="text-end">Sent</th>
            <th class="text-end">Delivered</th>
            <th class="text-end">Opened</th>
            <th class="text-end">Failed</th>
            <th>When</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          @foreach (var row in Model)
          {
            <tr>
              <td class="text-nowrap">
                <i class="fas @TypeIcon(row.TypeKey) me-1 text-muted"></i>
                <span class="fw-semibold">@row.TypeLabel</span>
              </td>
              <td>
                <div class="fw-semibold">@row.Subject</div>
                @if (!string.IsNullOrWhiteSpace(row.Detail))
                {
                  <div class="text-muted small">@row.Detail</div>
                }
              </td>
              <td><span class="badge @StatusClass(row.DisplayStatus)">@row.DisplayStatus</span></td>
              <td class="text-end">@row.Recipients</td>
              <td class="text-end">@row.Sent</td>
              <td class="text-end">
                @* Delivered/Opened only exist once the mail provider reports back, which is normally within a
                   minute of sending but is not instant. A dash reads more honestly than a zero for a
                   send that went out seconds ago. *@
                @if (row.Sent == 0) { <span class="text-muted">&mdash;</span> } else { @row.Delivered }
              </td>
              <td class="text-end">
                @* 488: invoice mail is not instrumented (the invoice page records its own views), so its
                   rows keep saying so rather than showing a zero that reads as "nobody opened it". *@
                @* 562: for an invoice the useful fact is whether the client viewed the invoice after this email. *@
                @if (row.TypeKey == "invoice") { <span class="small @(row.Opened > 0 ? "text-success fw-semibold" : "text-muted")">@(row.Sent == 0 ? "\u2014" : row.Opened > 0 ? "invoice viewed" : "not viewed yet")</span> }
                else if (!tracking && row.Opened == 0) { <span class="text-muted small">not tracked</span> }
                else if (row.Sent == 0) { <span class="text-muted">&mdash;</span> }
                else { @row.Opened }
              </td>
              <td class="text-end">
                @if (row.Failed > 0)
                {
                  <span class="text-danger fw-semibold">@row.Failed</span>
                }
                else
                {
                  <span class="text-muted">0</span>
                }
              </td>
              <td class="text-nowrap small text-muted">
                @if (row.When.HasValue)
                {
                  @IPRO.Web.Infrastructure.AgentTimeZoneHelper.FromUtc(row.When.Value, agentTimeZone).ToString("MMM d, yyyy h:mm tt")
                }
                else
                {
                  <span>Not scheduled</span>
                }
              </td>
              <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" href="/portal/EmailActivity/Details/@row.TypeKey/@row.Id">
                  Detail
                </a>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
  @* 565: 25 to a page. *@
  @if (listing.PageCount > 1)
  {
    var first = listing.Page <= 1;
    var last = listing.Page >= listing.PageCount;
    <nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Pages of email activity">
      <a class="btn btn-outline-secondary btn-sm @(first ? "disabled" : "")" href="@listing.Url(page: listing.Page - 1)" aria-disabled="@(first ? "true" : "false")" tabindex="@(first ? "-1" : "0")"><i class="fas fa-chevron-left me-1"></i>Previous</a>
      <span class="small text-muted">Page @listing.Page of @listing.PageCount</span>
      <a class="btn btn-outline-secondary btn-sm @(last ? "disabled" : "")" href="@listing.Url(page: listing.Page + 1)" aria-disabled="@(last ? "true" : "false")" tabindex="@(last ? "-1" : "0")">Next<i class="fas fa-chevron-right ms-1"></i></a>
    </nav>
  }
}
