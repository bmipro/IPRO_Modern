@model IPRO.Entities.ClientInvoice
@using IPRO.Web.Infrastructure
@{
    // 515 (2026-09-22): the adviser's invoice or estimate to a client on the platform invoice's
    // design (514), branded for the ADVISER -- their company, address, phone, email and website logo
    // -- and showing what this document has always tracked: quantity and unit price, due date, paid
    // on and how. What it says is worked out in ClientDocumentPresentation; this file binds it. The
    // agent's tools and the client's actions are exactly as they were.
    var agent = ViewBag.Agent as IPRO.Entities.AgentUser;
    var view = ClientDocumentPresentation.From(Model, agent, ViewBag.LogoUrl as string);
    var docLabel = view.DocumentLabel;
    var isPublicView = ViewBag.IsPublicView as bool? ?? false;
    var canEdit = ViewBag.CanEdit as bool? ?? false;
    var publicUrl = ViewBag.PublicUrl as string;
    var paymentLink = ViewBag.PaymentLink as string;
    var companyName = view.SupplierName;
    var currency = Model.Currency;
    string Cell(decimal amount) => (amount < 0 ? "-$" : "$") + Math.Abs(amount).ToString("N2");
    string Money(decimal amount) => Cell(amount) + " " + currency;
}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@docLabel @Model.DocumentNumber</title>
  <link rel="stylesheet" href="~/css/invoice.css" asp-append-version="true" />
</head>
<body class="client-document">
  <main class="page-shell">
  <div class="toolbar">
    @if (!isPublicView)
    {
      <a class="btn" href="/portal/ClientInvoices">Back to list</a>
      @if (canEdit)
      {
        <a class="btn" href="/portal/ClientInvoices/Edit/@Model.Id">Edit</a>
      }
    }
    <button id="printDocumentButton" class="btn btn-primary">Print / Save PDF</button>
  </div>

  @if (!isPublicView)
  {
    <div class="action-panel">
      <div class="action-card">
        <div class="muted">
          Public link: <a href="@publicUrl" target="_blank">@publicUrl</a>
        </div>
        @{
            // 452: what happened to this document after Send -- the client's views and every email.
            var emailHistory = ViewBag.EmailHistory as System.Collections.Generic.List<IPRO.Entities.ClientInvoiceEmail>;
            string When(DateTime? utc) => utc.HasValue
                ? IPRO.Web.Infrastructure.AgentTimeZoneHelper.FromUtc(utc.Value, agent?.TimeZone).ToString("MMM d, h:mm tt")
                : string.Empty;
        }
        <div class="muted" style="margin-top:8px;font-size:13px">
          @if (Model.ViewCount > 0)
          {
            <div><strong>Viewed by client</strong> @When(Model.LastViewedAt)@(Model.ViewCount > 1 ? $" ({Model.ViewCount} times, first {When(Model.FirstViewedAt)})" : string.Empty)</div>
          }
          else if (Model.SentAt != null)
          {
            <div>Not viewed yet</div>
          }
          @if (emailHistory != null && emailHistory.Count > 0)
          {
            <ul style="margin:6px 0 0;padding-left:18px">
              @foreach (var e in emailHistory)
              {
                var kind = e.Kind == IPRO.Entities.ClientInvoiceEmailKind.Reminder ? "Reminder" : "Email";
                <li>
                  @kind @When(e.SentAt ?? e.CreatedAt) to @e.ToEmail:
                  @if (e.Status == IPRO.Entities.ClientInvoiceEmailStatus.Delivered)
                  {
                    <span style="color:var(--green)">delivered @When(e.DeliveredAt)</span>@(e.OpenedAt != null ? $", opened {When(e.OpenedAt)}" : string.Empty)
                  }
                  else if (e.Status == IPRO.Entities.ClientInvoiceEmailStatus.Bounced)
                  {
                    <span style="color:#b91c1c">bounced@(string.IsNullOrWhiteSpace(e.FailureReason) ? string.Empty : $" ({e.FailureReason})")</span>
                  }
                  else if (e.Status == IPRO.Entities.ClientInvoiceEmailStatus.Failed)
                  {
                    <span style="color:#b91c1c">could not be sent@(string.IsNullOrWhiteSpace(e.FailureReason) ? string.Empty : $" ({e.FailureReason})")</span>
                  }
                  else
                  {
                    <span>accepted by the mail provider, delivery report pending</span>
                  }
                </li>
              }
            </ul>
          }
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          @if (Model.Status == IPRO.Entities.ClientInvoiceStatus.Draft)
          {
            <form method="post" action="/portal/ClientInvoices/Send/@Model.Id">
              @Html.AntiForgeryToken()
              <button type="submit" class="btn btn-success">Send to Client</button>
            </form>
          }
          else if (Model.Status != IPRO.Entities.ClientInvoiceStatus.Void)
          {
            @* 452: a bounced or failed email needs a way back; a paid invoice resends as a copy. *@
            <form method="post" action="/portal/ClientInvoices/Send/@Model.Id">
              @Html.AntiForgeryToken()
              <button type="submit" class="btn">Resend email</button>
            </form>
          }
          @if (Model.DocumentType == IPRO.Entities.ClientInvoiceDocumentType.Invoice && Model.Status is IPRO.Entities.ClientInvoiceStatus.Sent)
          {
            <form method="post" action="/portal/ClientInvoices/MarkPaid/@Model.Id" style="display:flex;gap:6px;align-items:center">
              @Html.AntiForgeryToken()
              <select name="method" class="btn">
                <option value="Online">Paid Online</option>
                <option value="Cheque">Paid by Cheque</option>
                <option value="Cash">Paid by Cash</option>
                <option value="EFT">Paid by EFT</option>
                <option value="Other">Paid (Other)</option>
              </select>
              <button type="submit" class="btn btn-success">Mark Paid</button>
            </form>
          }
          @if (Model.DocumentType == IPRO.Entities.ClientInvoiceDocumentType.Estimate && Model.Status == IPRO.Entities.ClientInvoiceStatus.Approved)
          {
            <form method="post" action="/portal/ClientInvoices/ConvertToInvoice/@Model.Id">
              @Html.AntiForgeryToken()
              <button type="submit" class="btn btn-success">Convert to Invoice</button>
            </form>
          }
          <form method="post" action="/portal/ClientInvoices/Duplicate/@Model.Id">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn">Duplicate</button>
          </form>
          @if (Model.Status is not (IPRO.Entities.ClientInvoiceStatus.Paid or IPRO.Entities.ClientInvoiceStatus.Void))
          {
            <form method="post" action="/portal/ClientInvoices/Void/@Model.Id">
              @Html.AntiForgeryToken()
              <button type="submit" class="btn btn-danger js-confirm-submit" data-confirm-message="Void this document?">Void</button>
            </form>
          }
        </div>
      </div>
    </div>
  }
  else if (Model.DocumentType == IPRO.Entities.ClientInvoiceDocumentType.Estimate && Model.Status == IPRO.Entities.ClientInvoiceStatus.Sent)
  {
    <div class="action-panel">
      <div class="action-card">
        <div class="muted">Please review this estimate and let us know if you'd like to proceed.</div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <form method="post" action="/invoice/@Model.ViewToken/decline">
            <button type="submit" class="btn">Decline</button>
          </form>
          <form method="post" action="/invoice/@Model.ViewToken/approve">
            <button type="submit" class="btn btn-success">Approve</button>
          </form>
        </div>
      </div>
    </div>
  }
  else if (Model.DocumentType == IPRO.Entities.ClientInvoiceDocumentType.Invoice && Model.Status == IPRO.Entities.ClientInvoiceStatus.Sent && !string.IsNullOrWhiteSpace(paymentLink))
  {
    <div class="action-panel">
      <div class="action-card">
        <div class="muted">You can pay online now, or arrange payment another way with @companyName.</div>
        <a class="btn btn-success" href="@paymentLink" target="_blank" rel="noopener">Pay Now</a>
      </div>
    </div>
  }

    <article class="invoice" aria-labelledby="document-title">
      <header class="invoice-header">
        <div class="brand">
          @if (!string.IsNullOrWhiteSpace(view.LogoUrl))
          {
            <div class="logo-plate">
              <img src="@view.LogoUrl" alt="@view.SupplierName" />
            </div>
            <div class="supplier">
              <p class="supplier-name">@view.SupplierName</p>
              @foreach (var line in view.SupplierAddressLines)
              {
                <p>@line</p>
              }
              @if (!string.IsNullOrWhiteSpace(view.SupplierPhone))
              {
                <p>@view.SupplierPhone</p>
              }
              @if (!string.IsNullOrWhiteSpace(view.SupplierEmail))
              {
                <p>@view.SupplierEmail</p>
              }
            </div>
          }
          else
          {
            <p class="wordmark">@view.SupplierName</p>
            <div class="supplier">
              @foreach (var line in view.SupplierAddressLines)
              {
                <p>@line</p>
              }
              @if (!string.IsNullOrWhiteSpace(view.SupplierPhone))
              {
                <p>@view.SupplierPhone</p>
              }
              @if (!string.IsNullOrWhiteSpace(view.SupplierEmail))
              {
                <p>@view.SupplierEmail</p>
              }
            </div>
          }
        </div>

        <div class="invoice-heading">
          <p class="eyebrow">Prepared for @view.BillToName</p>
          <h1 id="document-title">@docLabel</h1>
          <span class="status status-@view.StatusClass">@view.StatusText</span>
        </div>
      </header>

      <div class="brand-rule" aria-hidden="true"></div>

      <section class="invoice-summary" aria-label="@docLabel summary">
        <dl>
          <div>
            <dt>@docLabel number</dt>
            <dd>@Model.DocumentNumber</dd>
          </div>
          <div>
            <dt>Issue date</dt>
            <dd>@view.IssueDate</dd>
          </div>
          @if (!string.IsNullOrWhiteSpace(view.DueDate))
          {
            <div>
              <dt>Due date</dt>
              <dd>@view.DueDate</dd>
            </div>
          }
          @if (!string.IsNullOrWhiteSpace(view.PaidOn))
          {
            <div>
              <dt>Paid on</dt>
              <dd>@view.PaidOn</dd>
            </div>
          }
        </dl>
      </section>

      <section class="party-grid">
        <div class="party">
          <h2>Bill to</h2>
          <p class="party-name">@view.BillToName</p>
          @if (!string.IsNullOrWhiteSpace(view.BillToCompany))
          {
            <p>@view.BillToCompany</p>
          }
          @foreach (var line in view.BillToAddressLines)
          {
            <p>@line</p>
          }
          @if (!string.IsNullOrWhiteSpace(view.BillToEmail))
          {
            <p class="muted">@view.BillToEmail</p>
          }
        </div>

        <div class="payment-summary">
          <h2>@(view.IsEstimate ? "Estimate" : "Payment")</h2>
          <dl>
            <div><dt>Status</dt><dd>@view.StatusText</dd></div>
            @if (!string.IsNullOrWhiteSpace(view.PaidMethod))
            {
              <div><dt>Method</dt><dd>@view.PaidMethod</dd></div>
            }
            @if (!string.IsNullOrWhiteSpace(view.PaidOn))
            {
              <div><dt>Paid on</dt><dd>@view.PaidOn</dd></div>
            }
            <div><dt>Currency</dt><dd>@currency</dd></div>
          </dl>
        </div>
      </section>

      <section class="charges" aria-labelledby="charges-title">
        <h2 id="charges-title" class="visually-hidden">@docLabel lines</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Description</th>
                <th scope="col">Qty</th>
                <th scope="col">Unit price</th>
                <th scope="col">Tax</th>
                <th scope="col">Amount</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var line in view.Lines)
              {
                <tr>
                  <td data-label="Description"><strong>@line.Description</strong></td>
                  <td data-label="Quantity">@line.Quantity.ToString("0.##")</td>
                  <td data-label="Unit price">@Cell(line.UnitPrice)</td>
                  <td data-label="Tax">@line.TaxLabel</td>
                  <td data-label="Amount">@Cell(line.Amount)</td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      </section>

      <section class="totals-area">
        <div class="tax-note">
          <h2>Tax summary</h2>
          @if (view.HasTax)
          {
            <p><span>Taxable amount</span><strong>@Money(Model.SubTotal)</strong></p>
            <p><span>@view.TaxLabel</span><strong>@Money(Model.TaxAmount)</strong></p>
          }
          else
          {
            <p><span>No tax is charged on this @docLabel.ToLowerInvariant().</span></p>
          }
        </div>

        <dl class="totals">
          <div><dt>Subtotal</dt><dd>@Money(Model.SubTotal)</dd></div>
          <div><dt>@(view.HasTax ? view.TaxLabel : "Tax")</dt><dd>@Money(Model.TaxAmount)</dd></div>
          <div class="total"><dt>Total</dt><dd>@Money(Model.Total)</dd></div>
          @if (view.ShowsBalance)
          {
            @if (view.PaymentReceived > 0)
            {
              <div><dt>Payment received</dt><dd>@Money(-view.PaymentReceived)</dd></div>
            }
            <div class="balance @(view.BalanceDue > 0 ? "owing" : "")"><dt>Balance due</dt><dd>@Money(view.BalanceDue)</dd></div>
          }
        </dl>
      </section>

      @if (!string.IsNullOrWhiteSpace(Model.Notes))
      {
        <section class="notes" aria-label="Notes">
          <h2>Notes</h2>
          <p>@Model.Notes</p>
        </section>
      }

      <footer class="invoice-footer">
        <p>Thank you for your business.</p>
        @if (!string.IsNullOrWhiteSpace(view.SupplierEmail) || !string.IsNullOrWhiteSpace(view.SupplierPhone))
        {
          <p>
            Questions about this @docLabel.ToLowerInvariant()?
            @if (!string.IsNullOrWhiteSpace(view.SupplierEmail))
            {
              <a href="mailto:@view.SupplierEmail">@view.SupplierEmail</a>
            }
            @if (!string.IsNullOrWhiteSpace(view.SupplierEmail) && !string.IsNullOrWhiteSpace(view.SupplierPhone))
            {
              <text>&nbsp;|&nbsp;</text>
            }
            @if (!string.IsNullOrWhiteSpace(view.SupplierPhone))
            {
              <span>@view.SupplierPhone</span>
            }
          </p>
        }
        <p class="record-note">Please retain this @docLabel.ToLowerInvariant() for your records. It was generated electronically.</p>
      </footer>
    </article>
  </main>
  <script nonce="@Context.GetCspNonce()">
document.getElementById('printDocumentButton')?.addEventListener('click', () => window.print());
  </script>
</body>
</html>
