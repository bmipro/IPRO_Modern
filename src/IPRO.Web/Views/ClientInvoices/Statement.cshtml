@model IPRO.DataAccess.ClientInvoiceStatement
@{
    ViewData["Title"] = "For your accountant";
    var year = (int)(ViewBag.Year ?? Model.Start.Year);
    var month = ViewBag.Month as int?;
    var quarter = ViewBag.Quarter as int?;
    var periodLabel = ViewBag.PeriodLabel as string ?? $"{Model.Start:MMMM d, yyyy} to {Model.End:MMMM d, yyyy}";
    var company = ViewBag.Company as string ?? string.Empty;
    var query = quarter.HasValue ? $"year={year}&quarter={quarter}" : $"year={year}&month={month ?? Model.Start.Month}";
    string Money(decimal value) => "$" + value.ToString("N2");
    var years = Enumerable.Range(Math.Min(year, DateTime.UtcNow.Year) - 3, 5).ToList();
}

@* 523 (slice 4): the statement for the adviser's accountant -- invoiced in the period (by issue
   date), tax collected by rate, received (by the day the payment landed, in the adviser's zone),
   and what was still owed at the period's end. Printable; a CSV of the rows; Xero's import file. *@
<div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4 d-print-none">
  <div>
    <h2 class="fw-bold mb-1"><i class="fas fa-file-invoice me-2 text-primary"></i>For your accountant</h2>
    <div class="text-muted">What you invoiced, the tax you collected, what came in, and what was still owed, for one month or one quarter.</div>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    <a class="btn btn-outline-secondary" href="/portal/ClientInvoices"><i class="fas fa-arrow-left me-1"></i>All invoices</a>
    <a class="btn btn-outline-secondary" href="/portal/ClientInvoices/ExportStatement?@query"><i class="fas fa-file-csv me-1"></i>Download CSV</a>
    <a class="btn btn-outline-secondary" href="/portal/ClientInvoices/ExportXero?@query" title="Xero's sales-invoice import layout, one row per line item, for the invoices of this period. Check the tax type and the account code on your first import."><i class="fas fa-file-export me-1"></i>Xero file</a>
    <button id="printStatementButton" class="btn btn-primary"><i class="fas fa-print me-1"></i>Print / Save PDF</button>
  </div>
</div>

<form method="get" action="/portal/ClientInvoices/Statement" class="card border-0 shadow-sm mb-4 d-print-none">
  <div class="card-body p-3 d-flex gap-2 flex-wrap align-items-center">
    <span class="text-muted small me-1">Period</span>
    <select class="form-select form-select-sm" style="width:auto" name="month">
      <option value="" selected="@(!month.HasValue)">Quarter</option>
      @for (var m = 1; m <= 12; m++)
      {
        <option value="@m" selected="@(month == m)">@(new DateTime(2000, m, 1).ToString("MMMM"))</option>
      }
    </select>
    <select class="form-select form-select-sm" style="width:auto" name="quarter">
      <option value="" selected="@(!quarter.HasValue)">Month</option>
      @for (var q = 1; q <= 4; q++)
      {
        <option value="@q" selected="@(quarter == q)">Q@(q)</option>
      }
    </select>
    <select class="form-select form-select-sm" style="width:auto" name="year">
      @foreach (var y in years)
      {
        <option value="@y" selected="@(y == year)">@y</option>
      }
    </select>
    <button type="submit" class="btn btn-sm btn-primary">Show</button>
    <span class="text-muted small ms-2">Choose a month, or a quarter; whichever is set on the right wins if both are.</span>
  </div>
</form>

<div class="mb-3">
  <h4 class="fw-bold mb-0">@company</h4>
  <div class="text-muted">Statement for @periodLabel &middot; amounts in @Model.Currency</div>
</div>

<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3">
    <div class="card border-0 shadow-sm h-100"><div class="card-body p-3">
      <div class="text-muted small text-uppercase">Invoiced</div>
      <div class="fs-4 fw-bold">@Money(Model.InvoicedTotal)</div>
      <div class="small text-muted">@Model.Invoiced.Count @(Model.Invoiced.Count == 1 ? "invoice" : "invoices") &middot; before tax @Money(Model.InvoicedSubtotal)</div>
    </div></div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card border-0 shadow-sm h-100"><div class="card-body p-3">
      <div class="text-muted small text-uppercase">Tax collected</div>
      <div class="fs-4 fw-bold">@Money(Model.InvoicedTax)</div>
      <div class="small text-muted">on invoices issued in the period</div>
    </div></div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card border-0 shadow-sm h-100"><div class="card-body p-3">
      <div class="text-muted small text-uppercase">Received</div>
      <div class="fs-4 fw-bold">@Money(Model.ReceivedTotal)</div>
      <div class="small text-muted">@Model.Received.Count @(Model.Received.Count == 1 ? "payment" : "payments") recorded in the period</div>
    </div></div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card border-0 shadow-sm h-100"><div class="card-body p-3">
      <div class="text-muted small text-uppercase">Owed at @Model.End.ToString("MMM d")</div>
      <div class="fs-4 fw-bold @(Model.OwedAtEnd > 0 ? "text-danger" : "text-success")">@Money(Model.OwedAtEnd)</div>
      <div class="small text-muted">@Model.OwedAtEndCount @(Model.OwedAtEndCount == 1 ? "invoice" : "invoices") issued by then and unpaid</div>
    </div></div>
  </div>
</div>

<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-white border-0 pt-4 px-4"><h5 class="fw-bold mb-0">Tax by rate</h5></div>
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead class="table-light"><tr><th>Rate</th><th class="text-end">Invoices</th><th class="text-end">Before tax</th><th class="text-end">Tax</th><th class="text-end">Total</th></tr></thead>
      <tbody>
        @if (!Model.TaxByRate.Any())
        {
          <tr><td colspan="5" class="text-center text-muted py-4">Nothing was invoiced in this period.</td></tr>
        }
        @foreach (var line in Model.TaxByRate)
        {
          <tr>
            <td>@line.Label</td>
            <td class="text-end">@line.Count</td>
            <td class="text-end">@Money(line.Subtotal)</td>
            <td class="text-end">@Money(line.Tax)</td>
            <td class="text-end">@Money(line.Total)</td>
          </tr>
        }
        @if (Model.TaxByRate.Any())
        {
          <tr class="fw-semibold table-light">
            <td>All</td>
            <td class="text-end">@Model.Invoiced.Count</td>
            <td class="text-end">@Money(Model.InvoicedSubtotal)</td>
            <td class="text-end">@Money(Model.InvoicedTax)</td>
            <td class="text-end">@Money(Model.InvoicedTotal)</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-white border-0 pt-4 px-4"><h5 class="fw-bold mb-0">Invoiced in the period</h5></div>
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead class="table-light"><tr><th>#</th><th>Client</th><th>Issued</th><th>Due</th><th>Status</th><th class="text-end">Before tax</th><th>Tax</th><th class="text-end">Tax</th><th class="text-end">Total</th></tr></thead>
      <tbody>
        @if (!Model.Invoiced.Any())
        {
          <tr><td colspan="9" class="text-center text-muted py-4">No invoice was issued in this period.</td></tr>
        }
        @foreach (var row in Model.Invoiced)
        {
          <tr>
            <td><a href="/portal/ClientInvoices/Details/@row.InvoiceId">@row.DocumentNumber</a></td>
            <td>@row.ClientName</td>
            <td>@row.IssueDate.ToString("MMM d, yyyy")</td>
            <td>@(row.DueDate?.ToString("MMM d, yyyy") ?? "-")</td>
            <td>@row.Status</td>
            <td class="text-end">@Money(row.Subtotal)</td>
            <td class="small text-muted">@(row.TaxRate == 0 ? "-" : $"{row.TaxRegion} {row.TaxRate * 100:0.###}%")</td>
            <td class="text-end">@Money(row.Tax)</td>
            <td class="text-end">@Money(row.Total)</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-white border-0 pt-4 px-4"><h5 class="fw-bold mb-0">Received in the period</h5></div>
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead class="table-light"><tr><th>#</th><th>Client</th><th>Issued</th><th>Paid on</th><th>Method</th><th class="text-end">Amount</th></tr></thead>
      <tbody>
        @if (!Model.Received.Any())
        {
          <tr><td colspan="6" class="text-center text-muted py-4">No payment was recorded in this period.</td></tr>
        }
        @foreach (var row in Model.Received)
        {
          <tr>
            <td><a href="/portal/ClientInvoices/Details/@row.InvoiceId">@row.DocumentNumber</a></td>
            <td>@row.ClientName</td>
            <td>@row.IssueDate.ToString("MMM d, yyyy")</td>
            <td>@(row.PaidOn?.ToString("MMM d, yyyy") ?? "-")</td>
            <td>@(row.PaidMethod?.ToString() ?? "-")</td>
            <td class="text-end">@Money(row.Total)</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

<p class="text-muted small d-print-none">"Invoiced" goes by the invoice date; "Received" by the day you recorded the payment; both in your own time zone. Drafts, void documents and estimates are not included. Your accountant decides which basis your return uses.</p>

<script nonce="@Context.GetCspNonce()">
document.getElementById('printStatementButton')?.addEventListener('click', () => window.print());
</script>
