@model IPRO.DataAccess.ClientInvoiceAging
@{
    ViewData["Title"] = "Who owes what";
    var today = ViewBag.Today as DateTime? ?? DateTime.UtcNow.Date;
    var zone = ViewBag.Zone as string;
    string Money(decimal value) => value == 0 ? "-" : "$" + value.ToString("N2");
}

@* 523 (slice 2): the unpaid invoices by client and by how long they are past due, in the
   adviser's own day; each overdue invoice has a one-click reminder (the nightly job's email). *@
<div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
  <div>
    <h2 class="fw-bold mb-1"><i class="fas fa-hourglass-half me-2 text-primary"></i>Who owes what</h2>
    <div class="text-muted">Unpaid invoices by client and by how long they are past due, as of @today.ToString("MMMM d, yyyy").</div>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    <a class="btn btn-outline-secondary" href="/portal/ClientInvoices"><i class="fas fa-arrow-left me-1"></i>All invoices</a>
    <a class="btn btn-outline-primary" href="/portal/ClientInvoices?documentType=invoice&amp;status=overdue"><i class="fas fa-exclamation-circle me-1"></i>Overdue list</a>
  </div>
</div>

<div class="row g-3 mb-3">
  <div class="col-6 col-md-2">
    <div class="card border-0 shadow-sm h-100"><div class="card-body p-3">
      <div class="text-muted small text-uppercase">Current</div>
      <div class="fs-5 fw-bold">@Money(Model.Current)</div>
      <div class="small text-muted">not yet due</div>
    </div></div>
  </div>
  <div class="col-6 col-md-2">
    <div class="card border-0 shadow-sm h-100"><div class="card-body p-3">
      <div class="text-muted small text-uppercase">1-30 days</div>
      <div class="fs-5 fw-bold">@Money(Model.Days1To30)</div>
      <div class="small text-muted">past due</div>
    </div></div>
  </div>
  <div class="col-6 col-md-2">
    <div class="card border-0 shadow-sm h-100"><div class="card-body p-3">
      <div class="text-muted small text-uppercase">31-60 days</div>
      <div class="fs-5 fw-bold">@Money(Model.Days31To60)</div>
      <div class="small text-muted">past due</div>
    </div></div>
  </div>
  <div class="col-6 col-md-2">
    <div class="card border-0 shadow-sm h-100"><div class="card-body p-3">
      <div class="text-muted small text-uppercase">61-90 days</div>
      <div class="fs-5 fw-bold @(Model.Days61To90 > 0 ? "text-danger" : "")">@Money(Model.Days61To90)</div>
      <div class="small text-muted">past due</div>
    </div></div>
  </div>
  <div class="col-6 col-md-2">
    <div class="card border-0 shadow-sm h-100"><div class="card-body p-3">
      <div class="text-muted small text-uppercase">Over 90 days</div>
      <div class="fs-5 fw-bold @(Model.Over90 > 0 ? "text-danger" : "")">@Money(Model.Over90)</div>
      <div class="small text-muted">past due</div>
    </div></div>
  </div>
  <div class="col-6 col-md-2">
    <div class="card border-0 shadow-sm h-100 bg-light"><div class="card-body p-3">
      <div class="text-muted small text-uppercase">Total owed</div>
      <div class="fs-5 fw-bold">$@Model.Total.ToString("N2") <span class="fs-6 fw-normal text-muted">@Model.Currency</span></div>
      <div class="small text-muted">@Model.InvoiceCount @(Model.InvoiceCount == 1 ? "invoice" : "invoices")</div>
    </div></div>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Client</th>
          <th class="text-end">Current</th>
          <th class="text-end">1-30</th>
          <th class="text-end">31-60</th>
          <th class="text-end">61-90</th>
          <th class="text-end">Over 90</th>
          <th class="text-end">Total</th>
        </tr>
      </thead>
      <tbody>
        @if (!Model.Rows.Any())
        {
          <tr><td colspan="7" class="text-center text-muted py-4">Nothing is owed: every invoice is paid, or none has been sent yet.</td></tr>
        }
        @foreach (var row in Model.Rows)
        {
          <tr class="fw-semibold">
            <td>
              <a href="/portal/ClientInvoices?documentType=invoice&amp;clientId=@row.ClientId">@row.ClientName</a>
              <span class="text-muted small fw-normal ms-1">@row.Invoices.Count @(row.Invoices.Count == 1 ? "invoice" : "invoices")</span>
            </td>
            <td class="text-end">@Money(row.Current)</td>
            <td class="text-end">@Money(row.Days1To30)</td>
            <td class="text-end">@Money(row.Days31To60)</td>
            <td class="text-end @(row.Days61To90 > 0 ? "text-danger" : "")">@Money(row.Days61To90)</td>
            <td class="text-end @(row.Over90 > 0 ? "text-danger" : "")">@Money(row.Over90)</td>
            <td class="text-end">$@row.Total.ToString("N2")</td>
          </tr>
          @foreach (var item in row.Invoices)
          {
            <tr class="small">
              <td colspan="6" class="ps-4 text-muted">
                <a href="/portal/ClientInvoices/Details/@item.InvoiceId">@item.DocumentNumber</a>
                &middot; $@item.Total.ToString("N2")
                &middot; @(item.DueDate.HasValue ? "due " + item.DueDate.Value.ToString("MMM d, yyyy") : "no due date")
                @if (item.IsOverdue)
                {
                  <span class="badge bg-danger-subtle text-danger ms-1">@item.DaysPastDue @(item.DaysPastDue == 1 ? "day" : "days") past due</span>
                }
                @if (item.LastReminderSentAt.HasValue)
                {
                  <span class="ms-1">&middot; last reminder @IPRO.Web.Infrastructure.AgentTimeZoneHelper.FromUtc(item.LastReminderSentAt.Value, zone).ToString("MMM d")</span>
                }
              </td>
              <td class="text-end">
                @if (item.IsOverdue && string.IsNullOrWhiteSpace(row.ClientEmail))
                {
                  <button type="button" class="btn btn-outline-secondary btn-sm" disabled title="No email address on file for this client">Send reminder</button>
                }
                else if (item.IsOverdue)
                {
                  <form method="post" action="/portal/ClientInvoices/Remind/@item.InvoiceId" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnTo" value="aging" />
                    <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fas fa-bell me-1"></i>Send reminder</button>
                  </form>
                }
              </td>
            </tr>
          }
        }
      </tbody>
    </table>
  </div>
</div>
