@{
    ViewData["Title"] = "Write a Letter";
    var templates = (ViewBag.Templates as IEnumerable<IPRO.Entities.ELetterTemplate>) ?? Enumerable.Empty<IPRO.Entities.ELetterTemplate>();
    var mergeFields = (ViewBag.MergeFields as IEnumerable<IPRO.Business.Services.MergeFieldResolver.MergeField>) ?? Enumerable.Empty<IPRO.Business.Services.MergeFieldResolver.MergeField>();
    var clients = (ViewBag.Clients as IEnumerable<IPRO.Entities.Client>) ?? Enumerable.Empty<IPRO.Entities.Client>();
    var selected = ViewBag.SelectedTemplate as IPRO.Entities.ELetterTemplate;
    var agentNow = ViewBag.AgentNow as DateTime? ?? DateTime.Now;
    var scheduledMinValue = agentNow.ToString("yyyy-MM-ddTHH:mm");
    var scheduledDefaultValue = agentNow.AddHours(1).ToString("yyyy-MM-ddTHH:mm");
}

<div class="d-flex justify-content-between align-items-start mb-4">
  <div>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-2"><li class="breadcrumb-item"><a href="/portal/ELetters">E-Letters</a></li><li class="breadcrumb-item active">Write</li></ol>
    </nav>
    <h2 class="fw-bold mb-1"><i class="fas fa-envelope-open-text me-2 text-primary"></i>Write a Letter</h2>
    <div class="text-muted">Start from a ready-written letter, make it yours, and send it personalized to each client.</div>
  </div>
</div>

<form asp-action="Create" method="post">
  @Html.AntiForgeryToken()
  <input type="hidden" name="templateKey" id="templateKey" value="@(selected?.Key)" />
  <div class="row g-4">
    <div class="col-lg-7">

      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-0 pt-4 px-4">
          <h5 class="fw-bold mb-1">Start from</h5>
          <div class="text-muted small">Picking a different one replaces the subject and body below.</div>
        </div>
        <div class="card-body p-4">
          <div class="template-grid">
            @foreach (var template in templates)
            {
              <button type="button" class="template-choice @(template.Key == selected?.Key ? "is-selected" : "")"
                      data-key="@template.Key"
                      data-subject="@template.Subject"
                      data-body="@template.Body">
                <span class="template-name">@template.Name</span>
                <span class="template-desc">@template.Description</span>
              </button>
            }
          </div>
        </div>
      </div>

      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-0 pt-4 px-4">
          <h5 class="fw-bold mb-1">The letter</h5>
        </div>
        <div class="card-body p-4">
          <div class="mb-3">
            <label class="form-label fw-semibold">Email subject</label>
            <input id="subjectInput" name="subject" class="form-control" maxlength="200" value="@(selected?.Subject)" required />
          </div>
          <div class="mb-2">
            <label class="form-label fw-semibold">Letter body</label>
            <textarea id="bodyInput" name="body" class="form-control" rows="16" required>@(selected?.Body)</textarea>
          </div>
          <div class="merge-help">
            <div class="small fw-semibold mb-2">Insert a personalized field <span class="text-muted fw-normal">— click to add at your cursor</span></div>
            <div class="d-flex flex-wrap gap-2">
              @foreach (var field in mergeFields)
              {
                <button type="button" class="btn btn-sm btn-outline-secondary merge-chip" data-token="@field.Token" title="@field.Description">@field.Token</button>
              }
            </div>
          </div>
        </div>
      </div>

      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-0 pt-4 px-4">
          <h5 class="fw-bold mb-1">Clients</h5>
          <div class="text-muted small">Each person gets their own copy, with their name filled in.</div>
        </div>
        <div class="card-body p-4">
          @if (!clients.Any())
          {
            <div class="alert alert-info mb-0">None of your clients have an email address on file yet.</div>
          }
          else
          {
            <input id="clientSearch" type="text" class="form-control mb-3" placeholder="Search clients by name or email..." />
            <div class="d-flex gap-3 mb-2">
              <button type="button" id="selectAllClients" class="btn btn-sm btn-link p-0">Select all</button>
              <button type="button" id="clearAllClients" class="btn btn-sm btn-link p-0">Clear all</button>
            </div>
            <div class="client-checklist border rounded-3 p-2">
              @foreach (var client in clients)
              {
                var name = $"{client.FirstName} {client.LastName}".Trim();
                <div class="form-check client-row" data-search="@($"{name} {client.Email}".ToLowerInvariant())">
                  <input class="form-check-input client-check" type="checkbox" name="clientIds" value="@client.Id" id="client_@client.Id" data-name="@name" />
                  <label class="form-check-label" for="client_@client.Id">@name <span class="text-muted small">@client.Email</span></label>
                </div>
              }
            </div>
          }
        </div>
      </div>

      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 pt-4 px-4">
          <h5 class="fw-bold mb-1">Timing</h5>
        </div>
        <div class="card-body p-4">
          <div class="row g-3">
            <div class="col-md-6">
              <div class="timing-option">
                <input class="form-check-input" type="radio" name="sendNow" id="sendNow" value="true" checked />
                <label class="form-check-label" for="sendNow"><strong>Send now</strong><span>Queued for the next send cycle.</span></label>
              </div>
            </div>
            <div class="col-md-6">
              <div class="timing-option">
                <input class="form-check-input" type="radio" name="sendNow" id="sendLater" value="false" />
                <label class="form-check-label" for="sendLater"><strong>Schedule for later</strong><span>Pick a date and time.</span></label>
              </div>
            </div>
          </div>
          <div class="mt-3">
            <label class="form-label fw-semibold">Scheduled date &amp; time</label>
            <input id="scheduledAtInput" name="scheduledAt" type="datetime-local" class="form-control" value="@scheduledDefaultValue" min="@scheduledMinValue" disabled />
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="card border-0 shadow-sm sticky-top" style="top: 90px;">
        <div class="card-header bg-white border-0 pt-4 px-4">
          <h5 class="fw-bold mb-1"><i class="fas fa-eye me-2 text-primary"></i>Preview</h5>
          <div id="previewNote" class="text-muted small">Select a client below to see their name filled in.</div>
        </div>
        <div class="card-body p-3">
          <iframe id="letterPreview" title="Letter preview" style="width:100%;height:520px;border:1px solid #e2e8f0;border-radius:8px;"></iframe>
          <button type="submit" class="btn btn-primary btn-lg w-100 mt-3"><i class="fas fa-paper-plane me-2"></i>Send Letter</button>
        </div>
      </div>
    </div>
  </div>
</form>

<style>
  .template-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 12px; }
  .template-choice { display: flex; flex-direction: column; gap: 4px; padding: 14px 16px; border: 2px solid #e2e8f0; border-radius: 12px; background: #fff; cursor: pointer; text-align: left; transition: border-color .15s, background .15s; }
  .template-choice:hover { border-color: #93c5fd; }
  .template-choice.is-selected { border-color: #1457d9; background: #eef4ff; }
  .template-name { font-weight: 700; font-size: 14px; color: #0f172a; }
  .template-desc { font-size: 12px; color: #64748b; line-height: 1.4; }
  .merge-help { border: 1px solid #dbe5f2; border-radius: 10px; padding: 14px 16px; background: #f7faff; }
  .merge-chip { font-family: ui-monospace, Consolas, monospace; font-size: 12px; }
  #bodyInput { font-family: ui-monospace, Consolas, monospace; font-size: 13.5px; line-height: 1.6; }
  .client-checklist { max-height: 280px; overflow-y: auto; }
  .client-row { padding: 6px 8px; border-radius: 6px; }
  .client-row:hover { background: #f8fafc; }
  .timing-option { border: 1px solid #dbe5f2; border-radius: 12px; padding: 16px 18px; background: #fff; display: grid; grid-template-columns: auto minmax(0,1fr); column-gap: 12px; row-gap: 4px; align-items: start; }
  .timing-option label { display: flex; flex-direction: column; gap: 2px; }
  .timing-option span { color: #64748b; font-size: .9rem; }
</style>

<script nonce="@Context.GetCspNonce()">
(function () {
  var subjectInput = document.getElementById('subjectInput');
  var bodyInput = document.getElementById('bodyInput');
  var templateKey = document.getElementById('templateKey');
  var preview = document.getElementById('letterPreview');
  var previewNote = document.getElementById('previewNote');

  // The preview resolves merge fields against the first selected client, so the agent sees a
  // real name rather than the raw token. Falls back to showing the tokens when nobody's picked.
  function firstSelectedClient() {
    return document.querySelector('.client-check:checked');
  }

  function refreshPreview() {
    var chosen = firstSelectedClient();
    var params = new URLSearchParams({ body: bodyInput.value });
    if (chosen) {
      params.set('sampleClientId', chosen.value);
      previewNote.textContent = 'Previewing as ' + chosen.dataset.name + '.';
    } else {
      previewNote.textContent = 'Select a client below to see their name filled in.';
    }
    preview.src = '/portal/ELetters/PreviewLetter?' + params.toString();
  }

  var debounceTimer;
  function debouncedRefresh() {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(refreshPreview, 400);
  }
  bodyInput.addEventListener('input', debouncedRefresh);

  document.querySelectorAll('.template-choice').forEach(function (button) {
    button.addEventListener('click', function () {
      document.querySelectorAll('.template-choice').forEach(function (b) { b.classList.remove('is-selected'); });
      button.classList.add('is-selected');
      templateKey.value = button.dataset.key;
      subjectInput.value = button.dataset.subject;
      bodyInput.value = button.dataset.body;
      refreshPreview();
    });
  });

  document.querySelectorAll('.merge-chip').forEach(function (chip) {
    chip.addEventListener('click', function () {
      var token = chip.dataset.token;
      var start = bodyInput.selectionStart;
      var end = bodyInput.selectionEnd;
      bodyInput.value = bodyInput.value.slice(0, start) + token + bodyInput.value.slice(end);
      bodyInput.focus();
      bodyInput.selectionStart = bodyInput.selectionEnd = start + token.length;
      debouncedRefresh();
    });
  });

  var sendNow = document.getElementById('sendNow');
  var sendLater = document.getElementById('sendLater');
  var scheduledAt = document.getElementById('scheduledAtInput');
  function syncScheduledInput() { scheduledAt.disabled = sendNow.checked; }
  sendNow.addEventListener('change', syncScheduledInput);
  sendLater.addEventListener('change', syncScheduledInput);

  document.querySelectorAll('.client-check').forEach(function (cb) {
    cb.addEventListener('change', debouncedRefresh);
  });

  var search = document.getElementById('clientSearch');
  if (search) {
    search.addEventListener('input', function () {
      var term = search.value.trim().toLowerCase();
      document.querySelectorAll('.client-row').forEach(function (row) {
        row.style.display = row.dataset.search.includes(term) ? '' : 'none';
      });
    });
  }
  var selectAll = document.getElementById('selectAllClients');
  var clearAll = document.getElementById('clearAllClients');
  if (selectAll) selectAll.addEventListener('click', function () {
    document.querySelectorAll('.client-row:not([style*="none"]) input[type=checkbox]').forEach(function (cb) { cb.checked = true; });
    debouncedRefresh();
  });
  if (clearAll) clearAll.addEventListener('click', function () {
    document.querySelectorAll('.client-checklist input[type=checkbox]').forEach(function (cb) { cb.checked = false; });
    debouncedRefresh();
  });

  refreshPreview();
})();
</script>
