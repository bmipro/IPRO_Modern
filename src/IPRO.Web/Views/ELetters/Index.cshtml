@model IEnumerable<IPRO.Entities.ELetter>
@{
    ViewData["Title"] = "E-Letters";
    var agentTimeZone = ViewBag.AgentTimeZone as string ?? IPRO.Web.Infrastructure.AgentTimeZoneHelper.DefaultTimeZone;

    string StatusClass(string status) => status switch
    {
        IPRO.Entities.ELetterStatuses.Sent => "bg-success-subtle text-success",
        IPRO.Entities.ELetterStatuses.Sending => "bg-info-subtle text-info",
        IPRO.Entities.ELetterStatuses.Failed => "bg-danger-subtle text-danger",
        _ => "bg-warning-subtle text-warning-emphasis"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-0"><i class="fas fa-envelope-open-text me-2 text-primary"></i>E-Letters</h2>
    <small class="text-muted">Personalized letters on your letterhead — addressed to each client by name.</small>
  </div>
  <a href="/portal/ELetters/Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Write a Letter</a>
</div>

@if (!Model.Any())
{
  <div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5">
      <i class="fas fa-envelope-open-text fa-3x text-muted opacity-25 mb-3 d-block"></i>
      <h5 class="fw-bold">No letters sent yet</h5>
      <p class="text-muted">Start from a ready-written letter, edit the wording, and send it to your clients.</p>
      <a href="/portal/ELetters/Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Write a Letter</a>
    </div>
  </div>
}
else
{
  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Subject</th>
            <th>Started from</th>
            <th>Recipients</th>
            <th>Status</th>
            <th>Scheduled / Sent</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var letter in Model)
          {
            var templates = ViewBag.Templates as IDictionary<string, IPRO.Entities.ELetterTemplate>;
            IPRO.Entities.ELetterTemplate? template = null;
            templates?.TryGetValue(letter.TemplateKey ?? string.Empty, out template);
            <tr>
              <td class="fw-semibold">@letter.Subject</td>
              <td class="small text-muted">@(template?.Name ?? "Blank letter")</td>
              <td>@letter.TotalSent / @letter.TotalRecipients sent</td>
              <td><span class="badge @StatusClass(letter.Status)">@letter.Status</span></td>
              <td class="text-nowrap small text-muted">
                @if (letter.SentAt.HasValue)
                {
                  @IPRO.Web.Infrastructure.AgentTimeZoneHelper.FromUtc(letter.SentAt.Value, agentTimeZone).ToString("MMM d, yyyy h:mm tt")
                }
                else
                {
                  @IPRO.Web.Infrastructure.AgentTimeZoneHelper.FromUtc(letter.ScheduledAt, agentTimeZone).ToString("MMM d, yyyy h:mm tt")
                }
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
}
