@model List<IPRO.Entities.PortalAppointmentRequest>
@{
    ViewData["Title"] = "Portal Requests";
    var status = (string)(ViewBag.Status ?? "pending");
    var agentTimeZone = ViewBag.AgentTimeZone as string ?? IPRO.Web.Infrastructure.AgentTimeZoneHelper.DefaultTimeZone;
    var appointmentTimes = ViewBag.AppointmentTimes as IReadOnlyDictionary<int, DateTime>;
    string FilterClass(string value) => status == value ? "btn-primary" : "btn-outline-secondary";
}

<div class="mb-4">
  <h2 class="fw-bold mb-1"><i class="fas fa-calendar-check me-2 text-primary"></i>Portal Requests</h2>
  <div class="text-muted">Appointment requests submitted by clients through your client portal.</div>
</div>

<div class="btn-group mb-3" role="group">
  <a class="btn @FilterClass("pending")" href="/portal/PortalRequests?status=pending">Pending</a>
  <a class="btn @FilterClass("scheduled")" href="/portal/PortalRequests?status=scheduled">Scheduled</a>
  <a class="btn @FilterClass("declined")" href="/portal/PortalRequests?status=declined">Declined</a>
  <a class="btn @FilterClass("all")" href="/portal/PortalRequests?status=all">All</a>
</div>

<div class="card border-0 shadow-sm">
  <div class="list-group list-group-flush">
    @if (!Model.Any())
    {
      <div class="text-center text-muted py-4">No requests here.</div>
    }
    @foreach (var request in Model)
    {
      <div class="list-group-item d-flex justify-content-between align-items-center">
        <div>
          <div class="fw-bold">@request.Client.FirstName @request.Client.LastName</div>
          <div class="small text-muted">@request.Notes</div>
          <div class="small text-muted">
            Requested @IPRO.Web.Infrastructure.AgentTimeZoneHelper.FromUtc(request.CreatedAt, agentTimeZone).ToString("MMM d, yyyy")
            @(request.PreferredDate.HasValue ? $"— preferred {request.PreferredDate.Value:MMM d, yyyy}" : "")
          </div>
        </div>
        @if (request.Status == IPRO.Entities.PortalAppointmentRequestStatus.Pending)
        {
          <div class="d-flex align-items-start gap-2">
            @* 606: the box starts at 9:00 AM on the preferred day. It started at 12:00 AM, so typing "2" kept AM and
               the owner's test appointment went to the client for 2:00 AM. The line under it says the time in
               words as it is typed, and a time from 9:00 PM to 7:00 AM is asked about before the client is emailed. *@
            <form asp-action="Schedule" method="post" data-schedule-form>
              @Html.AntiForgeryToken()
              <input type="hidden" name="id" value="@request.Id" />
              <div class="d-flex align-items-center gap-2">
                <input type="datetime-local" name="scheduledAt" class="form-control form-control-sm" style="width:auto;"
                       value="@(request.PreferredDate?.Date.AddHours(9).ToString("yyyy-MM-ddTHH:mm"))" required
                       aria-label="Appointment date and time" aria-describedby="schedule-when-@(request.Id)" />
                <button type="submit" class="btn btn-sm btn-success">Schedule</button>
              </div>
              @* width 0 with min-width 100%: the line wraps under the box and button instead of widening the row. *@
              <div id="schedule-when-@(request.Id)" class="small text-muted mt-1" style="width:0;min-width:100%;" data-schedule-when aria-live="polite"></div>
            </form>
            <form asp-action="Decline" method="post">
              @Html.AntiForgeryToken()
              <input type="hidden" name="id" value="@request.Id" />
              <button type="submit" class="btn btn-sm btn-outline-danger">Decline</button>
            </form>
          </div>
        }
        else if (request.Status == IPRO.Entities.PortalAppointmentRequestStatus.Scheduled)
        {
          var currentTime = IPRO.Web.Infrastructure.PortalAppointmentTimes.For(request, appointmentTimes);
          <span class="badge bg-success-subtle text-success">
            Scheduled @(currentTime.HasValue ? currentTime.Value.ToString("MMM d, yyyy 'at' h:mm tt") : "")
          </span>
        }
        else
        {
          <span class="badge bg-danger-subtle text-danger">@request.Status</span>
        }
      </div>
    }
  </div>
</div>

@section Scripts {
<script nonce="@Context.GetCspNonce()">
// 606: the chosen time in words under each Schedule box, and a question before an appointment from 9:00 PM
// to 7:00 AM goes to the client (the owner meant 2:00 PM, typed 2, and the box kept AM).
(function () {
  document.querySelectorAll('[data-schedule-form]').forEach(function (form) {
    var input = form.querySelector('input[name="scheduledAt"]');
    var line = form.querySelector('[data-schedule-when]');
    if (!input || !line) return;

    function chosen() {
      if (!input.value) return null;
      var d = new Date(input.value);   // "yyyy-MM-ddTHH:mm" from the box reads as local time
      return isNaN(d.getTime()) ? null : d;
    }
    function words(d) {
      return d.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' }) + ' at ' +
             d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
    }
    function outsideHours(d) {
      var minutes = d.getHours() * 60 + d.getMinutes();
      return minutes < 7 * 60 || minutes > 21 * 60;   // 7:00 AM and 9:00 PM themselves are fine
    }
    function paint() {
      var d = chosen();
      var odd = !!d && outsideHours(d);
      line.textContent = !d ? '' : odd
        ? words(d) + ': outside 7:00 AM to 9:00 PM. Is that the hour you meant?'
        : words(d);
      line.classList.toggle('text-muted', !odd);
      line.classList.toggle('text-danger', odd);
      line.classList.toggle('fw-semibold', odd);
    }

    input.addEventListener('input', paint);
    input.addEventListener('change', paint);
    paint();

    form.addEventListener('submit', function (event) {
      var d = chosen();
      if (d && outsideHours(d) &&
          !confirm('Schedule this appointment for ' + words(d) + '? That is outside 7:00 AM to 9:00 PM, and the client is emailed this time.')) {
        event.preventDefault();
      }
    });
  });
})();
</script>
}
