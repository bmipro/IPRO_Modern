@model IPRO.Web.Models.WebsiteBuilderOpenViewModel
@using IPRO.Web.Middleware
@{
    ViewData["Title"] = "Opening the new builder";
}
@* 585: carries the one-time pass to the builder in a form post (never in an address, so it is in no
   history, log or referrer). The form sends itself; the button is there if scripts are off. *@
<div class="card border-0 shadow-sm mx-auto" style="max-width: 40rem;">
  <div class="card-body p-4">
    <h2 class="h5 fw-bold mb-2"><i class="fas fa-wand-magic-sparkles me-2 text-primary"></i>Opening the new builder (Beta)</h2>
    <p class="mb-3">Your website is being opened in the new builder. This takes a few seconds. Nothing on your website changes until you send it back and it is published.</p>
    <form id="openBuilderForm" method="post" action="@Model.Action">
      <input type="hidden" name="pass" value="@Model.Pass" />
      <button type="submit" class="btn btn-primary"><i class="fas fa-arrow-right me-1"></i>Open the builder</button>
    </form>
  </div>
</div>
<script nonce="@Context.GetCspNonce()">document.getElementById("openBuilderForm").submit();</script>
