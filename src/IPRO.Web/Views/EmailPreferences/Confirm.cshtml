@{
    Layout = null;
    // 678 (audit 2026-11-24 D-4, double opt-in): the page the confirmation email's button opens. It asks; the press
    // confirms (POST), so a mail gateway opening the link confirms nothing.
    var invalid = ViewBag.Invalid as bool? == true;
    var token = ViewBag.Token as string ?? "";
    var business = ViewBag.Business as string ?? "the business";
    var kind = ViewBag.Kind as string ?? IPRO.Entities.EmailSignupKinds.Newsletter;
    var isArticles = kind == IPRO.Entities.EmailSignupKinds.DidYouKnow;
    var outcome = ViewBag.Outcome as string;
    var alreadyConfirmed = ViewBag.AlreadyConfirmed as bool? == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Confirm</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    body { min-height: 100vh; display: grid; place-items: center; background: #f1f5f9; margin: 0; padding: 24px; }
    .panel { max-width: 540px; width: 100%; background: #fff; border-radius: 14px;
             box-shadow: 0 10px 40px rgba(15, 23, 42, .08); padding: 36px 32px; }
  </style>
</head>
<body>
  <main class="panel">
    @if (invalid)
    {
      <h1 class="h4 fw-bold mb-2">This link no longer works</h1>
      <p class="text-muted mb-0">It may be more than a week old, or it was broken by your email app. To sign up, use the form on the website again.</p>
    }
    else if (outcome == "Subscribed")
    {
      <h1 class="h4 fw-bold mb-2">You are subscribed</h1>
      <p class="text-muted mb-0">Thank you. You will receive <strong>@business</strong>'s newsletter. Every email has a link to unsubscribe.</p>
    }
    else if (outcome == "ArticlesOnTheirWay")
    {
      <h1 class="h4 fw-bold mb-2">Confirmed</h1>
      <p class="text-muted mb-0">Thank you. The article(s) you asked for from <strong>@business</strong> are on their way, one at a time over the next little while.</p>
    }
    else if (outcome == "OptedOutNoArticles")
    {
      <h1 class="h4 fw-bold mb-2">Confirmed</h1>
      <p class="text-muted mb-0">You unsubscribed from <strong>@business</strong>'s emails earlier, so the articles cannot be sent. To hear from them again, use the link to your email preferences in one of their emails, or ask them.</p>
    }
    else if (outcome == "Gone")
    {
      <h1 class="h4 fw-bold mb-2">This link no longer works</h1>
      <p class="text-muted mb-0">The sign-up it was for has since been removed. To sign up, use the form on the website again.</p>
    }
    else if (alreadyConfirmed || outcome == "AlreadyConfirmed")
    {
      <h1 class="h4 fw-bold mb-2">Already confirmed</h1>
      <p class="text-muted mb-0">There is nothing more to do.</p>
    }
    else
    {
      <h1 class="h4 fw-bold mb-2">@(isArticles ? "Send me the articles" : "Confirm your subscription")</h1>
      <p class="text-muted">
        @if (isArticles)
        {
          <text>Press the button to receive the article(s) you asked for from <strong>@business</strong>.</text>
        }
        else
        {
          <text>Press the button to receive <strong>@business</strong>'s newsletter. You can unsubscribe at any time.</text>
        }
      </p>
      <form method="post" action="/email-preferences/confirm" class="mt-3">
        <input type="hidden" name="t" value="@token" />
        <button type="submit" class="btn btn-primary">@(isArticles ? "Yes, send me the articles" : "Yes, subscribe me")</button>
      </form>
      <p class="text-muted small mt-4 mb-0">If you did not sign up, close this page: nothing is sent.</p>
    }
  </main>
</body>
</html>
