@{
    Layout = null;
    var invalid = ViewBag.Invalid as bool? == true;
    var token = ViewBag.Token as string ?? "";
    var email = ViewBag.Email as string ?? "";
    var agentName = ViewBag.AgentName as string ?? "your adviser";
    var agentCompany = ViewBag.AgentCompany as string ?? "";
    var allowGreetings = ViewBag.AllowGreetings as bool? == true;
    var isOptedOut = ViewBag.IsOptedOut as bool? == true;
    var message = ViewBag.Message as string;
}
@* Standalone page: recipients are clients, not agents, and most arrive from a phone mail client.
   No portal chrome, no nav, nothing to sign in to. *@
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  @* Nothing here should be indexed -- it is addressed to one person and carries their token. *@
  <meta name="robots" content="noindex,nofollow" />
  <title>Email preferences</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" rel="stylesheet" />
  <style>
    body { min-height: 100vh; display: grid; place-items: center; background: #f1f5f9; margin: 0; padding: 24px; }
    .panel { max-width: 540px; width: 100%; background: #fff; border-radius: 14px;
             box-shadow: 0 10px 40px rgba(15, 23, 42, .08); padding: 36px 32px; }
    .tick { width: 56px; height: 56px; border-radius: 50%; background: #dcfce7; color: #16a34a;
            display: grid; place-items: center; font-size: 26px; margin-bottom: 18px; }
    .choice { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 18px 20px; }
  </style>
</head>
<body>
  <div class="panel">
    @if (invalid)
    {
      <h1 class="h4 fw-bold mb-2">This link has expired</h1>
      <p class="text-muted mb-0">
        We couldn't find these email preferences. The link may have been broken by your email app, or
        the account may since have been closed. If you're still receiving unwanted email, replying to
        the message and asking to be removed will always work.
      </p>
    }
    else
    {
      <div class="tick"><i class="fas fa-check"></i></div>

      <h1 class="h4 fw-bold mb-2">You've been unsubscribed</h1>
      <p class="text-muted">
        @if (!string.IsNullOrWhiteSpace(email))
        {
          <text><strong>@email</strong> will no longer receive marketing emails from </text>
        }
        else
        {
          <text>You will no longer receive marketing emails from </text>
        }
        <strong>@agentName</strong>@(string.IsNullOrWhiteSpace(agentCompany) ? "" : $" at {agentCompany}").
        No further action is needed.
      </p>

      @if (!string.IsNullOrWhiteSpace(message))
      {
        <div class="alert alert-success py-2 px-3 small">@message</div>
      }

      @* The one deliberate choice. Unticked by default -- the unsubscribe has already taken full
         effect, and anything still arriving afterwards has to be something the person actively asked
         for on this page. *@
      <form method="post" action="/email-preferences/save" class="choice mt-4">
        <input type="hidden" name="token" value="@token" />

        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="allowGreetings" value="true"
                 id="allowGreetings" @(allowGreetings ? "checked" : "") />
          <label class="form-check-label" for="allowGreetings">
            <strong>Still send me birthday and anniversary greetings</strong>
            <div class="text-muted small mt-1">
              Just the personal ones. No newsletters, no marketing, nothing else.
            </div>
          </label>
        </div>

        <button type="submit" class="btn btn-primary btn-sm mt-3">Save preference</button>
      </form>

      @if (isOptedOut)
      {
        <form method="post" action="/email-preferences/save" class="mt-3">
          <input type="hidden" name="token" value="@token" />
          <input type="hidden" name="resubscribeAll" value="true" />
          <button type="submit" class="btn btn-link btn-sm text-muted p-0">
            Changed your mind? Resubscribe to everything
          </button>
        </form>
      }

      <hr class="my-4" />
      <p class="text-muted small mb-0">
        This only affects marketing emails sent through IPRO. @agentName can still contact you
        directly, and anything to do with your account or appointments will still reach you.
      </p>
    }
  </div>
</body>
</html>
