@*
  535: the full-screen viewer and the slideshow controls, once per page that has a gallery, for all three
  shells (it replaced three copies of an open-and-close-only lightbox). The shell passes its prefix for the
  backdrop colour it had before. The viewer walks the photos of the gallery that was clicked: arrows,
  the keyboard (left, right, Escape) and a swipe on a phone; the caption and "3 / 12" show under the photo.
*@
@{
    var prefix = ViewData["GalleryPrefix"] as string ?? "mp";
}
<div class="site-lightbox site-lightbox--@prefix" id="site-lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
  <div class="site-lightbox__count" aria-live="polite"></div>
  <button type="button" class="site-lightbox__close" aria-label="Close">&times;</button>
  <button type="button" class="site-lightbox__prev" aria-label="Previous photo">&#8249;</button>
  <figure><img src="" alt="" /><figcaption hidden></figcaption></figure>
  <button type="button" class="site-lightbox__next" aria-label="Next photo">&#8250;</button>
</div>
<style>
  .site-gallery__cell { margin: 0; }
  .site-gallery__item { display: block; width: 100%; padding: 0; border: 0; background: none; color: inherit; cursor: zoom-in; }
  .site-gallery__item:focus-visible { outline: 3px solid var(--site-theme, #1457d9); outline-offset: 3px; }
  /* height:auto: the width/height attributes reserve the photo's shape while it loads, but as a fixed
     height they would override each layout's own shape (the grid's 4:3, the masonry's natural one). */
  .site-gallery__item img { display: block; height: auto; }
  .site-gallery figcaption { margin-top: 8px; font-size: 13px; line-height: 1.45; color: var(--muted, #5e6b80); }
  .site-gallery--carousel .site-gallery__cell { flex: 0 0 auto; }
  .site-gallery--masonry { column-count: 3; column-gap: 16px; margin-top: 24px; }
  .site-gallery--masonry .site-gallery__cell { break-inside: avoid; margin: 0 0 16px; }
  .site-gallery--masonry img { width: 100%; height: auto; }
  .site-slideshow { margin-top: 24px; }
  .site-slideshow__stage { position: relative; }
  .site-slideshow__slide { display: none; margin: 0; }
  .site-slideshow__slide.is-current { display: block; }
  /* Every slide keeps one height so the page never jumps; the photo is centred in it at its own shape, on the
     page's own background (535a: a dark stage showed as black bars beside a narrow photo). The image box is the
     photo itself, so a shell's rounded corners or frame line wrap the photo, not the empty sides. */
  /* 85vw: on a phone a 68vh frame is taller than a landscape photo is wide, which left a large empty gap. */
  .site-slideshow__slide .site-gallery__item { display: flex; align-items: center; justify-content: center; height: min(68vh, 560px, 85vw); }
  .site-slideshow__slide img { width: auto; height: auto; max-width: 100%; max-height: 100%; }
  .site-slideshow__slide figcaption { margin-top: 10px; text-align: center; font-size: 14px; color: var(--muted, #5e6b80); }
  .site-slideshow__thumbs { position: relative; overflow-x: auto; margin-top: 12px; padding: 2px 0 6px; scrollbar-width: thin; }
  .site-slideshow__thumbs-row { display: flex; gap: 8px; width: max-content; margin: 0 auto; }
  .site-slideshow__thumb { flex: 0 0 auto; width: 64px; height: 64px; padding: 0; border: 2px solid transparent; border-radius: 4px; background: none; cursor: pointer; opacity: .65; transition: opacity .15s, border-color .15s; }
  .site-slideshow__thumb img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 2px; }
  .site-slideshow__thumb:hover { opacity: 1; }
  .site-slideshow__thumb:focus-visible { opacity: 1; outline: 3px solid var(--site-theme, #1457d9); outline-offset: 2px; }
  .site-slideshow__thumb.is-current { opacity: 1; border-color: var(--site-theme, #172033); }
  .site-slideshow__prev, .site-slideshow__next { position: absolute; top: calc(min(68vh, 560px, 85vw) / 2); transform: translateY(-50%); width: 44px; height: 44px; border: 0; border-radius: 50%; background: rgba(255,255,255,.9); color: #172033; font-size: 26px; line-height: 1; cursor: pointer; box-shadow: 0 4px 14px rgba(0,0,0,.25); }
  .site-slideshow__prev { left: 12px; }
  .site-slideshow__next { right: 12px; }
  .site-slideshow__count { margin-top: 8px; text-align: center; font-size: 13px; color: var(--muted, #5e6b80); }
  .site-lightbox { position: fixed; inset: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 56px 76px; background: rgba(7,20,47,.92); }
  .site-lightbox--cp { background: rgba(14,33,66,.92); }
  .site-lightbox--ep { background: rgba(33,30,26,.94); }
  .site-lightbox[hidden] { display: none; }
  .site-lightbox figure { margin: 0; display: flex; flex-direction: column; align-items: center; max-width: 100%; }
  .site-lightbox img { max-width: 100%; max-height: calc(100vh - 150px); object-fit: contain; border-radius: 6px; box-shadow: 0 24px 70px rgba(0,0,0,.5); }
  .site-lightbox figcaption { margin-top: 12px; max-width: 70ch; color: #fff; font-size: 15px; line-height: 1.5; text-align: center; }
  .site-lightbox__close, .site-lightbox__prev, .site-lightbox__next { position: absolute; width: 44px; height: 44px; border: 0; border-radius: 50%; background: rgba(255,255,255,.14); color: #fff; font-size: 26px; line-height: 1; cursor: pointer; }
  .site-lightbox__close:hover, .site-lightbox__prev:hover, .site-lightbox__next:hover { background: rgba(255,255,255,.26); }
  .site-lightbox__close { top: 18px; right: 22px; font-size: 24px; }
  .site-lightbox__prev { left: 18px; top: 50%; transform: translateY(-50%); }
  .site-lightbox__next { right: 18px; top: 50%; transform: translateY(-50%); }
  .site-lightbox.is-single .site-lightbox__prev, .site-lightbox.is-single .site-lightbox__next { display: none; }
  .site-lightbox__count { position: absolute; top: 30px; left: 0; right: 0; text-align: center; color: rgba(255,255,255,.8); font-size: 13px; pointer-events: none; }
  html.site-lightbox-open { overflow: hidden; }
  @@media (max-width: 820px) { .site-gallery--masonry { column-count: 2; } }
  @@media (max-width: 640px) { .site-slideshow__thumb { width: 52px; height: 52px; } }
  @@media (prefers-reduced-motion: reduce) { .site-slideshow__thumb { transition: none; } }
  @@media (max-width: 640px) {
    .site-lightbox { padding: 64px 12px 84px; }
    .site-lightbox__prev, .site-lightbox__next { top: auto; bottom: 20px; transform: none; }
    .site-lightbox__prev { left: calc(50% - 56px); }
    .site-lightbox__next { right: calc(50% - 56px); }
  }
</style>
<script nonce="@Context.GetCspNonce()">
(function () {
  var box = document.getElementById('site-lightbox');
  if (!box) return;
  var img = box.querySelector('img');
  var caption = box.querySelector('figcaption');
  var counter = box.querySelector('.site-lightbox__count');
  var items = [];
  var index = 0;
  var opener = null;

  function swipe(el, onNext, onPrevious) {
    var startX = null, startY = null;
    el.addEventListener('touchstart', function (e) {
      if (e.touches.length !== 1) { startX = null; return; }
      startX = e.touches[0].clientX; startY = e.touches[0].clientY;
    }, { passive: true });
    el.addEventListener('touchend', function (e) {
      if (startX === null) return;
      var dx = e.changedTouches[0].clientX - startX, dy = e.changedTouches[0].clientY - startY;
      startX = null;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) { if (dx < 0) onNext(); else onPrevious(); }
    }, { passive: true });
  }

  function show(i) {
    index = (i + items.length) % items.length;
    var item = items[index];
    var text = item.getAttribute('data-caption') || '';
    img.src = item.getAttribute('data-full');
    img.alt = text;
    caption.textContent = text;
    caption.hidden = text.length === 0;
    counter.textContent = items.length > 1 ? (index + 1) + ' / ' + items.length : '';
    box.classList.toggle('is-single', items.length < 2);
    if (items.length > 1) {
      new Image().src = items[(index + 1) % items.length].getAttribute('data-full');
      new Image().src = items[(index - 1 + items.length) % items.length].getAttribute('data-full');
    }
  }

  function open(item) {
    var gallery = item.closest('[data-gallery]');
    items = Array.prototype.slice.call((gallery || document).querySelectorAll('.site-gallery__item'));
    opener = item;
    show(Math.max(0, items.indexOf(item)));
    box.hidden = false;
    document.documentElement.classList.add('site-lightbox-open');
    box.querySelector('.site-lightbox__close').focus();
  }

  function close() {
    box.hidden = true;
    img.src = '';
    document.documentElement.classList.remove('site-lightbox-open');
    if (opener) opener.focus();
  }

  document.addEventListener('click', function (e) {
    var item = e.target.closest ? e.target.closest('.site-gallery__item') : null;
    if (item) { e.preventDefault(); open(item); }
  });
  box.querySelector('.site-lightbox__close').addEventListener('click', close);
  box.querySelector('.site-lightbox__prev').addEventListener('click', function () { show(index - 1); });
  box.querySelector('.site-lightbox__next').addEventListener('click', function () { show(index + 1); });
  box.addEventListener('click', function (e) { if (e.target === box) close(); });
  document.addEventListener('keydown', function (e) {
    if (box.hidden) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowLeft' && items.length > 1) show(index - 1);
    else if (e.key === 'ArrowRight' && items.length > 1) show(index + 1);
  });
  swipe(box, function () { if (items.length > 1) show(index + 1); }, function () { if (items.length > 1) show(index - 1); });

  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll('.site-slideshow').forEach(function (root) {
    var slides = root.querySelectorAll('.site-slideshow__slide');
    if (slides.length < 2) return;
    var current = 0;
    var count = root.querySelector('.site-slideshow__count');
    // 535a: the thumbnail row. The current thumbnail is marked and kept in view as the arrows or a swipe move on.
    var thumbs = root.querySelectorAll('.site-slideshow__thumb');
    var strip = root.querySelector('.site-slideshow__thumbs');
    function go(i) {
      slides[current].classList.remove('is-current');
      if (thumbs[current]) { thumbs[current].classList.remove('is-current'); thumbs[current].removeAttribute('aria-current'); }
      current = (i + slides.length) % slides.length;
      slides[current].classList.add('is-current');
      if (thumbs[current]) {
        thumbs[current].classList.add('is-current');
        thumbs[current].setAttribute('aria-current', 'true');
        if (strip && strip.scrollWidth > strip.clientWidth) {
          var thumb = thumbs[current];
          strip.scrollTo({ left: Math.max(0, thumb.offsetLeft - (strip.clientWidth - thumb.offsetWidth) / 2), behavior: reduceMotion ? 'auto' : 'smooth' });
        }
      }
      if (count) count.textContent = (current + 1) + ' / ' + slides.length;
    }
    thumbs.forEach(function (thumb, i) { thumb.addEventListener('click', function () { go(i); }); });
    root.querySelector('.site-slideshow__prev').addEventListener('click', function () { go(current - 1); });
    root.querySelector('.site-slideshow__next').addEventListener('click', function () { go(current + 1); });
    swipe(root.querySelector('.site-slideshow__stage'), function () { go(current + 1); }, function () { go(current - 1); });
  });
})();
</script>
