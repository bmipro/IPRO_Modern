@model IPRO.Web.Models.CalculatorBlockViewModel
@{
    var kind = IPRO.Entities.CalculatorKinds.Normalize(Model.CalculatorKind);
    var fieldId = $"calc-{Model.BlockId}";
}
<div class="calc-block" data-calculator-kind="@kind" id="@fieldId">
  <div class="calc-fields">
    @switch (kind)
    {
        case IPRO.Entities.CalculatorKinds.MortgagePayment:
            <label><span>Home price</span><input data-field="price" type="number" step="1000" value="500000" /></label>
            <label><span>Down payment</span><input data-field="downPayment" type="number" step="1000" value="100000" /></label>
            <label><span>Interest rate (%)</span><input data-field="rate" type="number" step="0.01" value="5.5" /></label>
            <label><span>Amortization (years)</span><input data-field="years" type="number" step="1" value="25" /></label>
            break;
        case IPRO.Entities.CalculatorKinds.Refinance:
            <label><span>Current loan balance</span><input data-field="currentBalance" type="number" step="1000" value="350000" /></label>
            <label><span>Current rate (%)</span><input data-field="currentRate" type="number" step="0.01" value="6.5" /></label>
            <label><span>Years remaining</span><input data-field="yearsRemaining" type="number" step="1" value="20" /></label>
            <label><span>New rate (%)</span><input data-field="newRate" type="number" step="0.01" value="5.25" /></label>
            <label><span>New term (years)</span><input data-field="newYears" type="number" step="1" value="25" /></label>
            <label><span>Closing costs</span><input data-field="closingCosts" type="number" step="100" value="3000" /></label>
            break;
        case IPRO.Entities.CalculatorKinds.RentVsBuy:
            <label><span>Home price</span><input data-field="price" type="number" step="1000" value="500000" /></label>
            <label><span>Down payment</span><input data-field="downPayment" type="number" step="1000" value="100000" /></label>
            <label><span>Mortgage rate (%)</span><input data-field="rate" type="number" step="0.01" value="5.5" /></label>
            <label><span>Amortization (years)</span><input data-field="years" type="number" step="1" value="25" /></label>
            <label><span>Property tax rate (%/yr)</span><input data-field="propertyTaxRate" type="number" step="0.01" value="1.0" /></label>
            <label><span>Home insurance rate (%/yr)</span><input data-field="insuranceRate" type="number" step="0.01" value="0.35" /></label>
            <label><span>Comparable monthly rent</span><input data-field="monthlyRent" type="number" step="10" value="2200" /></label>
            <label><span>Investment return, if renting (%/yr)</span><input data-field="investReturn" type="number" step="0.01" value="6" /></label>
            <label><span>Home appreciation (%/yr)</span><input data-field="appreciationRate" type="number" step="0.01" value="3" /></label>
            break;
        case IPRO.Entities.CalculatorKinds.Retirement:
            <label><span>Starting balance</span><input data-field="startBalance" type="number" step="100" value="20000" /></label>
            <label><span>Monthly contribution</span><input data-field="monthlyContribution" type="number" step="10" value="500" /></label>
            <label><span>Years until retirement</span><input data-field="yearsToRetirement" type="number" step="1" value="25" /></label>
            <label><span>Pre-retirement annual return (%)</span><input data-field="preReturn" type="number" step="0.01" value="6.5" /></label>
            <label><span>Post-retirement annual return (%)</span><input data-field="postReturn" type="number" step="0.01" value="5" /></label>
            <label><span>Annual inflation (%)</span><input data-field="inflation" type="number" step="0.01" value="2.5" /></label>
            <label><span>Annual contribution increase (%)</span><input data-field="contributionIncrease" type="number" step="0.01" value="2" /></label>
            <label><span>Desired monthly withdrawal (today's dollars)</span><input data-field="desiredMonthlyWithdrawal" type="number" step="50" value="3000" /></label>
            break;
        case IPRO.Entities.CalculatorKinds.TaxAdvantageComparison:
            <label><span>Annual contribution (pre-tax dollars)</span><input data-field="annualContribution" type="number" step="100" value="6000" /></label>
            <label><span>Years until withdrawal</span><input data-field="years" type="number" step="1" value="25" /></label>
            <label><span>Expected annual growth (%)</span><input data-field="growthRate" type="number" step="0.01" value="6" /></label>
            <label><span>Your tax rate now (%)</span><input data-field="currentTaxRate" type="number" step="0.1" value="30" /></label>
            <label><span>Your expected tax rate at withdrawal (%)</span><input data-field="futureTaxRate" type="number" step="0.1" value="25" /></label>
            break;
        case IPRO.Entities.CalculatorKinds.LoanAmortization:
            <label><span>Loan amount</span><input data-field="loanAmount" type="number" step="1000" value="400000" /></label>
            <label><span>Interest rate (%)</span><input data-field="rate" type="number" step="0.01" value="5.5" /></label>
            <label><span>Term (months)</span><input data-field="months" type="number" step="1" value="300" /></label>
            break;
        case IPRO.Entities.CalculatorKinds.Apr:
            <label><span>Loan amount</span><input data-field="loanAmount" type="number" step="1000" value="400000" /></label>
            <label><span>Interest rate (%)</span><input data-field="rate" type="number" step="0.01" value="5.5" /></label>
            <label><span>Term (years)</span><input data-field="years" type="number" step="1" value="25" /></label>
            <label><span>Origination fee (%)</span><input data-field="originationPercent" type="number" step="0.01" value="0.5" /></label>
            <label><span>Points paid (%)</span><input data-field="pointsPercent" type="number" step="0.01" value="0" /></label>
            <label><span>Other fees</span><input data-field="otherFees" type="number" step="50" value="1500" /></label>
            break;
        case IPRO.Entities.CalculatorKinds.Affordability:
            <label><span>Gross annual household income</span><input data-field="annualIncome" type="number" step="1000" value="120000" /></label>
            <label><span>Monthly debt payments (loans, cards, leases)</span><input data-field="monthlyDebts" type="number" step="50" value="500" /></label>
            <label><span>Down payment saved</span><input data-field="downPayment" type="number" step="1000" value="60000" /></label>
            <label><span>Mortgage rate (%)</span><input data-field="rate" type="number" step="0.01" value="5.5" /></label>
            <label><span>Amortization (years)</span><input data-field="years" type="number" step="1" value="25" /></label>
            <label><span>Property tax + heating (% of home value / yr)</span><input data-field="carryPercent" type="number" step="0.05" value="1.3" /></label>
            break;
        case IPRO.Entities.CalculatorKinds.BiWeeklyPayments:
            <label><span>Mortgage amount</span><input data-field="loanAmount" type="number" step="1000" value="400000" /></label>
            <label><span>Interest rate (%)</span><input data-field="rate" type="number" step="0.01" value="5.5" /></label>
            <label><span>Amortization (years)</span><input data-field="years" type="number" step="1" value="25" /></label>
            break;
        case IPRO.Entities.CalculatorKinds.MortgagePrepayment:
            <label><span>Current mortgage balance</span><input data-field="balance" type="number" step="1000" value="350000" /></label>
            <label><span>Interest rate (%)</span><input data-field="rate" type="number" step="0.01" value="5.5" /></label>
            <label><span>Years remaining</span><input data-field="yearsRemaining" type="number" step="1" value="20" /></label>
            <label><span>Extra payment each month</span><input data-field="extraMonthly" type="number" step="25" value="200" /></label>
            <label><span>One-time lump sum this year</span><input data-field="lumpSum" type="number" step="500" value="0" /></label>
            break;
        case IPRO.Entities.CalculatorKinds.LandTransferTax:
            <label><span>Purchase price</span><input data-field="price" type="number" step="1000" value="600000" /></label>
            <label><span>Province</span>
              <select data-field-text="province">
                <option value="ON">Ontario</option>
                <option value="ON-TOR">Ontario -- Toronto (adds municipal LTT)</option>
                <option value="BC">British Columbia</option>
                <option value="AB">Alberta</option>
                <option value="SK">Saskatchewan</option>
                <option value="MB">Manitoba</option>
                <option value="QC">Quebec (typical municipal brackets)</option>
                <option value="NB">New Brunswick</option>
                <option value="NS">Nova Scotia (Halifax)</option>
                <option value="PE">Prince Edward Island</option>
                <option value="NL">Newfoundland and Labrador</option>
              </select>
            </label>
            break;
        case IPRO.Entities.CalculatorKinds.SavingsGrowth:
            <label><span>Starting amount</span><input data-field="startAmount" type="number" step="100" value="10000" /></label>
            <label><span>Monthly deposit</span><input data-field="monthlyDeposit" type="number" step="10" value="400" /></label>
            <label><span>Expected annual return (%)</span><input data-field="rate" type="number" step="0.01" value="5" /></label>
            <label><span>Years</span><input data-field="years" type="number" step="1" value="15" /></label>
            <label><span>Annual inflation (%)</span><input data-field="inflation" type="number" step="0.01" value="2.5" /></label>
            break;
        case IPRO.Entities.CalculatorKinds.SavingsGoal:
            <label><span>Goal amount (today's dollars)</span><input data-field="goal" type="number" step="1000" value="1000000" /></label>
            <label><span>Starting amount</span><input data-field="startAmount" type="number" step="100" value="25000" /></label>
            <label><span>Monthly deposit</span><input data-field="monthlyDeposit" type="number" step="10" value="750" /></label>
            <label><span>Expected annual return (%)</span><input data-field="rate" type="number" step="0.01" value="6" /></label>
            <label><span>Annual inflation (%)</span><input data-field="inflation" type="number" step="0.01" value="2.5" /></label>
            break;
        case IPRO.Entities.CalculatorKinds.AfterTaxReturn:
            <label><span>Interest / return rate (%)</span><input data-field="rate" type="number" step="0.01" value="5" /></label>
            <label><span>Your marginal tax rate (%)</span><input data-field="taxRate" type="number" step="0.1" value="35" /></label>
            <label><span>Annual inflation (%)</span><input data-field="inflation" type="number" step="0.01" value="2.5" /></label>
            break;
    }
  </div>
  <button type="button" class="calc-run"><i class="fas fa-calculator"></i> Calculate</button>
  <div class="calc-results" hidden></div>
</div>
@if (ViewBag.CalculatorScriptRendered != true)
{
    ViewBag.CalculatorScriptRendered = true;
    <script nonce="@Context.GetCspNonce()">
    (function () {
      if (window.__iproCalcWired) return;
      window.__iproCalcWired = true;

      function num(el) { var v = parseFloat(el.value); return isNaN(v) ? 0 : v; }
      function fmtMoney(n) {
        var sign = n < 0 ? '-' : '';
        return sign + '$' + Math.abs(n).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      }
      // Canadian mortgages compound semi-annually by convention regardless of payment frequency --
      // this converts a nominal annual rate into the equivalent effective monthly rate.
      function monthlyRateFromAnnual(ratePercent) {
        var semiAnnual = ratePercent / 100 / 2;
        return Math.pow(1 + semiAnnual, 1 / 6) - 1;
      }
      function paymentFor(principal, ratePercent, numMonths) {
        if (principal <= 0 || numMonths <= 0) return 0;
        var i = monthlyRateFromAnnual(ratePercent);
        if (i <= 0) return principal / numMonths;
        var f = Math.pow(1 + i, numMonths);
        return principal * i * f / (f - 1);
      }
      function futureValueLumpSum(pv, rate, n) { return pv * Math.pow(1 + rate, n); }
      function futureValueAnnuity(payment, rate, n) { return rate <= 0 ? payment * n : payment * (Math.pow(1 + rate, n) - 1) / rate; }

      var calculators = {};

      calculators.MortgagePayment = function (v, out) {
        var loan = Math.max(0, v.price - v.downPayment);
        var months = v.years * 12;
        var payment = paymentFor(loan, v.rate, months);
        var totalPaid = payment * months;
        out.innerHTML =
          '<div class="calc-result-row"><span>Loan amount</span><strong>' + fmtMoney(loan) + '</strong></div>' +
          '<div class="calc-result-row"><span>Monthly payment</span><strong>' + fmtMoney(payment) + '</strong></div>' +
          '<div class="calc-result-row"><span>Estimated accelerated bi-weekly</span><strong>' + fmtMoney(payment / 2) + '</strong></div>' +
          '<div class="calc-result-row"><span>Total paid over ' + v.years + ' years</span><strong>' + fmtMoney(totalPaid) + '</strong></div>' +
          '<div class="calc-result-row"><span>Total interest</span><strong>' + fmtMoney(totalPaid - loan) + '</strong></div>' +
          '<p class="calc-note">Compounds semi-annually, the standard convention for Canadian mortgages. Does not include property tax, insurance, or condo fees.</p>';
      };

      calculators.Refinance = function (v, out) {
        var currentPayment = paymentFor(v.currentBalance, v.currentRate, v.yearsRemaining * 12);
        var newPayment = paymentFor(v.currentBalance, v.newRate, v.newYears * 12);
        var monthlySavings = currentPayment - newPayment;
        var breakEvenMonths = monthlySavings > 0 ? (v.closingCosts / monthlySavings) : null;
        var currentTotalInterest = currentPayment * v.yearsRemaining * 12 - v.currentBalance;
        var newTotalInterest = newPayment * v.newYears * 12 - v.currentBalance;
        out.innerHTML =
          '<div class="calc-result-row"><span>Current payment</span><strong>' + fmtMoney(currentPayment) + '</strong></div>' +
          '<div class="calc-result-row"><span>New payment</span><strong>' + fmtMoney(newPayment) + '</strong></div>' +
          '<div class="calc-result-row"><span>Monthly savings</span><strong>' + fmtMoney(monthlySavings) + '</strong></div>' +
          '<div class="calc-result-row"><span>Months to break even on closing costs</span><strong>' + (breakEvenMonths != null ? Math.ceil(breakEvenMonths) + ' months' : 'N/A -- new payment is not lower') + '</strong></div>' +
          '<div class="calc-result-row"><span>Remaining interest, current loan</span><strong>' + fmtMoney(currentTotalInterest) + '</strong></div>' +
          '<div class="calc-result-row"><span>Total interest, new loan</span><strong>' + fmtMoney(newTotalInterest) + '</strong></div>' +
          '<p class="calc-note">Simplified comparison -- does not include mortgage default insurance premiums, which vary by lender and down payment size.</p>';
      };

      calculators.RentVsBuy = function (v, out) {
        var loan = Math.max(0, v.price - v.downPayment);
        var months = v.years * 12;
        var monthlyPI = paymentFor(loan, v.rate, months);
        var monthlyTax = v.price * v.propertyTaxRate / 100 / 12;
        var monthlyIns = v.price * v.insuranceRate / 100 / 12;
        var monthlyOwn = monthlyPI + monthlyTax + monthlyIns;
        var monthlyDiff = monthlyOwn - v.monthlyRent;
        var investMonthlyRate = v.investReturn / 100 / 12;
        var investedDownPayment = futureValueLumpSum(v.downPayment, investMonthlyRate, months);
        var investedDifference = monthlyDiff > 0 ? futureValueAnnuity(monthlyDiff, investMonthlyRate, months) : 0;
        var rentingNetWorth = investedDownPayment + investedDifference;
        var homeValueThen = v.price * Math.pow(1 + v.appreciationRate / 100, v.years);
        var i = monthlyRateFromAnnual(v.rate);
        var remainingBalance = loan > 0 ? Math.max(0, loan * Math.pow(1 + i, months) - monthlyPI * ((Math.pow(1 + i, months) - 1) / (i || 1))) : 0;
        var buyingNetWorth = homeValueThen - remainingBalance;
        out.innerHTML =
          '<div class="calc-result-row"><span>Monthly cost of owning (P&amp;I + tax + insurance)</span><strong>' + fmtMoney(monthlyOwn) + '</strong></div>' +
          '<div class="calc-result-row"><span>Monthly rent</span><strong>' + fmtMoney(v.monthlyRent) + '</strong></div>' +
          '<div class="calc-result-row"><span>' + (monthlyDiff >= 0 ? 'Renting is cheaper by' : 'Owning is cheaper by') + ' (per month)</span><strong>' + fmtMoney(Math.abs(monthlyDiff)) + '</strong></div>' +
          '<div class="calc-result-row"><span>Est. net worth after ' + v.years + ' years, renting + investing</span><strong>' + fmtMoney(rentingNetWorth) + '</strong></div>' +
          '<div class="calc-result-row"><span>Est. net worth after ' + v.years + ' years, buying (home equity)</span><strong>' + fmtMoney(buyingNetWorth) + '</strong></div>' +
          '<p class="calc-note">Assumes the down payment and any monthly savings from renting are invested at the return rate entered, and the home appreciates at the rate entered. Does not include maintenance, condo/HOA fees, selling costs, or tax differences.</p>';
      };

      calculators.Retirement = function (v, out) {
        var balance = v.startBalance;
        var contribution = v.monthlyContribution;
        var preMonthly = v.preReturn / 100 / 12;
        var inflation = v.inflation / 100;
        var contribIncrease = v.contributionIncrease / 100;
        for (var y = 0; y < v.yearsToRetirement; y++) {
          for (var m = 0; m < 12; m++) { balance = balance * (1 + preMonthly) + contribution; }
          contribution = contribution * (1 + contribIncrease);
        }
        var withdrawal = v.desiredMonthlyWithdrawal * Math.pow(1 + inflation, v.yearsToRetirement);
        var postMonthly = v.postReturn / 100 / 12;
        var yearsLasting = 0;
        var runningBalance = balance;
        var lastsIndefinitely = false;
        while (runningBalance > 0 && yearsLasting < 100) {
          var annualWithdrawal = withdrawal * 12;
          var annualGrowth = runningBalance * postMonthly * 12;
          if (yearsLasting > 0 && annualGrowth >= annualWithdrawal) { lastsIndefinitely = true; break; }
          for (var mm = 0; mm < 12 && runningBalance > 0; mm++) {
            runningBalance = runningBalance * (1 + postMonthly) - withdrawal;
          }
          withdrawal = withdrawal * (1 + inflation);
          yearsLasting++;
        }
        out.innerHTML =
          '<div class="calc-result-row"><span>Balance at retirement</span><strong>' + fmtMoney(balance) + '</strong></div>' +
          '<div class="calc-result-row"><span>Required monthly withdrawal at retirement</span><strong>' + fmtMoney(withdrawal) + '</strong></div>' +
          '<div class="calc-result-row"><span>Your savings will last</span><strong>' + (lastsIndefinitely ? 'Indefinitely -- growth outpaces withdrawals' : (yearsLasting >= 100 ? '100+ years' : yearsLasting + ' years')) + '</strong></div>' +
          '<p class="calc-note">The withdrawal amount grows with inflation each year to preserve today\'s purchasing power. Estimates only, not guarantees.</p>';
      };

      calculators.TaxAdvantageComparison = function (v, out) {
        var growth = v.growthRate / 100;
        var afterTaxContribution = v.annualContribution * (1 - v.currentTaxRate / 100);
        var taxFreeBalance = 0;
        var deferredBalance = 0;
        for (var y = 0; y < v.years; y++) {
          taxFreeBalance = taxFreeBalance * (1 + growth) + afterTaxContribution;
          deferredBalance = deferredBalance * (1 + growth) + v.annualContribution;
        }
        var deferredNet = deferredBalance * (1 - v.futureTaxRate / 100);
        var better = taxFreeBalance > deferredNet ? 'tax-free' : (deferredNet > taxFreeBalance ? 'tax-deferred' : null);
        out.innerHTML =
          '<div class="calc-result-row"><span>Tax-deferred account, after-tax value</span><strong>' + fmtMoney(deferredNet) + '</strong></div>' +
          '<div class="calc-result-row"><span>Tax-free account, after-tax value</span><strong>' + fmtMoney(taxFreeBalance) + '</strong></div>' +
          '<div class="calc-result-row"><span>Based on your numbers</span><strong>' + (better ? ('the ' + better + ' account leaves you further ahead') : 'both leave you in the same after-tax position') + '</strong></div>' +
          '<p class="calc-note">A tax-deferred account (e.g. RRSP, Traditional IRA) and a tax-free account (e.g. TFSA, Roth IRA) end up equal if your tax rate never changes -- the deferred account wins if your rate is lower at withdrawal, the tax-free account wins if it\'s higher. Does not account for contribution limits; consult a tax professional for your specific situation.</p>';
      };

      calculators.LoanAmortization = function (v, out) {
        var months = Math.max(1, Math.round(v.months));
        var payment = paymentFor(v.loanAmount, v.rate, months);
        var monthlyRate = monthlyRateFromAnnual(v.rate);
        var balance = v.loanAmount;
        var totalInterest = 0;
        var capped = months > 360;
        var showMonths = capped ? 360 : months;
        var rows = '';
        for (var m = 1; m <= showMonths; m++) {
          var interest = balance * monthlyRate;
          var principal = Math.min(payment - interest, balance);
          balance = Math.max(0, balance - principal);
          totalInterest += interest;
          rows += '<tr><td>' + m + '</td><td>' + fmtMoney(payment) + '</td><td>' + fmtMoney(interest) + '</td><td>' + fmtMoney(principal) + '</td><td>' + fmtMoney(balance) + '</td></tr>';
        }
        out.innerHTML =
          '<div class="calc-result-row"><span>Monthly payment</span><strong>' + fmtMoney(payment) + '</strong></div>' +
          '<div class="calc-result-row"><span>Total interest' + (capped ? ' (first 360 months)' : '') + '</span><strong>' + fmtMoney(totalInterest) + '</strong></div>' +
          (capped ? '<p class="calc-note">Schedule shown for the first 360 months (30 years).</p>' : '') +
          '<div class="calc-table-wrap"><table class="calc-table"><thead><tr><th>#</th><th>Payment</th><th>Interest</th><th>Principal</th><th>Balance</th></tr></thead><tbody>' + rows + '</tbody></table></div>';
      };

      calculators.Apr = function (v, out) {
        var months = v.years * 12;
        var basePayment = paymentFor(v.loanAmount, v.rate, months);
        var originationCost = v.loanAmount * v.originationPercent / 100;
        var pointsCost = v.loanAmount * v.pointsPercent / 100;
        var totalFees = originationCost + pointsCost + v.otherFees;
        var effectiveLoan = v.loanAmount + totalFees;
        var paymentWithFees = paymentFor(effectiveLoan, v.rate, months);
        var trialRate = v.rate;
        var trialPayment = basePayment;
        var iterations = 0;
        while (trialPayment < paymentWithFees && iterations < 2000) {
          trialRate += 0.01;
          trialPayment = paymentFor(v.loanAmount, trialRate, months);
          iterations++;
        }
        out.innerHTML =
          '<div class="calc-result-row"><span>Total closing costs</span><strong>' + fmtMoney(totalFees) + '</strong></div>' +
          '<div class="calc-result-row"><span>Monthly payment</span><strong>' + fmtMoney(basePayment) + '</strong></div>' +
          '<div class="calc-result-row"><span>Annual Percentage Rate (APR)</span><strong>' + trialRate.toFixed(3) + '%</strong></div>' +
          '<p class="calc-note">APR reflects the true cost of the loan once fees are included, and is always at or above the stated interest rate.</p>';
      };

      calculators.Affordability = function (v, out) {
        // CMHC-style stress ratios: housing costs within 39% of gross income (GDS), housing + all
        // other debt within 44% (TDS). The binding cap is whichever is lower.
        var monthlyIncome = v.annualIncome / 12;
        var gdsCap = monthlyIncome * 0.39;
        var tdsCap = monthlyIncome * 0.44 - v.monthlyDebts;
        var housingCap = Math.min(gdsCap, tdsCap);
        if (housingCap <= 0) {
          out.innerHTML = '<p class="calc-note">Based on these numbers, monthly debt payments already use up the lending ratios -- reducing debts will do more than a bigger down payment.</p>';
          return;
        }
        var months = v.years * 12;
        var i = monthlyRateFromAnnual(v.rate);
        var annuityFactor = i <= 0 ? months : (1 - Math.pow(1 + i, -months)) / i;
        // Carrying costs scale with the (unknown) home value, so iterate to convergence -- same
        // fixed-point approach as the cal1 original.
        var house = 0, loan = 0, carryingMonthly = 0;
        for (var it = 0; it < 30; it++) {
          carryingMonthly = house * v.carryPercent / 100 / 12;
          var availableForPI = Math.max(0, housingCap - carryingMonthly);
          loan = availableForPI * annuityFactor;
          house = loan + v.downPayment;
        }
        var binding = gdsCap <= tdsCap ? 'income (GDS 39%)' : 'income minus debts (TDS 44%)';
        out.innerHTML =
          '<div class="calc-result-row"><span>Estimated maximum home price</span><strong>' + fmtMoney(house) + '</strong></div>' +
          '<div class="calc-result-row"><span>Mortgage amount</span><strong>' + fmtMoney(loan) + '</strong></div>' +
          '<div class="calc-result-row"><span>Monthly principal &amp; interest</span><strong>' + fmtMoney(Math.max(0, housingCap - carryingMonthly)) + '</strong></div>' +
          '<div class="calc-result-row"><span>Monthly property tax &amp; heating allowance</span><strong>' + fmtMoney(carryingMonthly) + '</strong></div>' +
          '<div class="calc-result-row"><span>Limiting factor</span><strong>' + binding + '</strong></div>' +
          '<p class="calc-note">Uses standard Canadian lending ratios (39% GDS / 44% TDS) at the rate entered. Lenders must also test you at a higher stress-test rate, and mortgage default insurance applies below 20% down -- treat this as a planning estimate, not a pre-approval.</p>';
      };

      calculators.BiWeeklyPayments = function (v, out) {
        var months = v.years * 12;
        var monthlyPayment = paymentFor(v.loanAmount, v.rate, months);
        var monthlyInterest = monthlyPayment * months - v.loanAmount;
        // Accelerated bi-weekly: half the monthly payment every two weeks = 26 half-payments, i.e.
        // one extra monthly payment per year. Per-period rate keeps semi-annual compounding.
        var biweeklyPayment = monthlyPayment / 2;
        var biweeklyRate = Math.pow(1 + v.rate / 200, 2 / 26) - 1;
        var balance = v.loanAmount, totalInterest = 0, periods = 0;
        while (balance > 0 && periods < 26 * 100) {
          var interest = balance * biweeklyRate;
          totalInterest += interest;
          balance = balance + interest - Math.min(biweeklyPayment, balance + interest);
          periods++;
        }
        var payoffYears = periods / 26;
        out.innerHTML =
          '<div class="calc-result-row"><span>Monthly payment</span><strong>' + fmtMoney(monthlyPayment) + '</strong></div>' +
          '<div class="calc-result-row"><span>Accelerated bi-weekly payment</span><strong>' + fmtMoney(biweeklyPayment) + '</strong></div>' +
          '<div class="calc-result-row"><span>Paid off in</span><strong>' + payoffYears.toFixed(1) + ' years instead of ' + v.years + '</strong></div>' +
          '<div class="calc-result-row"><span>Interest, monthly schedule</span><strong>' + fmtMoney(monthlyInterest) + '</strong></div>' +
          '<div class="calc-result-row"><span>Interest, accelerated bi-weekly</span><strong>' + fmtMoney(totalInterest) + '</strong></div>' +
          '<div class="calc-result-row"><span>Interest saved</span><strong>' + fmtMoney(Math.max(0, monthlyInterest - totalInterest)) + '</strong></div>' +
          '<p class="calc-note">Accelerated bi-weekly means paying half the monthly amount every two weeks -- 26 half-payments works out to one extra monthly payment a year, which is what shortens the mortgage.</p>';
      };

      calculators.MortgagePrepayment = function (v, out) {
        var months = v.yearsRemaining * 12;
        var payment = paymentFor(v.balance, v.rate, months);
        var i = monthlyRateFromAnnual(v.rate);
        function simulate(extra, lump) {
          var bal = Math.max(0, v.balance - lump), interestTotal = 0, m = 0;
          while (bal > 0 && m < 1200) {
            var interest = bal * i;
            interestTotal += interest;
            bal = bal + interest - Math.min(payment + extra, bal + interest);
            m++;
          }
          return { interest: interestTotal, months: m };
        }
        var baseline = simulate(0, 0);
        var scenario = simulate(v.extraMonthly, v.lumpSum);
        var monthsSaved = baseline.months - scenario.months;
        out.innerHTML =
          '<div class="calc-result-row"><span>Current payment</span><strong>' + fmtMoney(payment) + '</strong></div>' +
          '<div class="calc-result-row"><span>Interest without prepaying</span><strong>' + fmtMoney(baseline.interest) + '</strong></div>' +
          '<div class="calc-result-row"><span>Interest with prepayments</span><strong>' + fmtMoney(scenario.interest) + '</strong></div>' +
          '<div class="calc-result-row"><span>Interest saved</span><strong>' + fmtMoney(Math.max(0, baseline.interest - scenario.interest)) + '</strong></div>' +
          '<div class="calc-result-row"><span>Mortgage-free sooner by</span><strong>' + Math.floor(monthsSaved / 12) + ' years ' + (monthsSaved % 12) + ' months</strong></div>' +
          '<p class="calc-note">Assumes the lump sum is applied immediately and the extra amount is paid every month. Most Canadian lenders cap annual prepayments (often 10-20% of the original principal) -- check your mortgage\'s prepayment privileges.</p>';
      };

      calculators.LandTransferTax = function (v, out) {
        // Marginal brackets: [upper bound, rate] applied to the slice below each bound.
        function brackets(price, table) {
          var tax = 0, prev = 0;
          for (var b = 0; b < table.length; b++) {
            var upper = Math.min(price, table[b][0]);
            if (upper > prev) tax += (upper - prev) * table[b][1];
            prev = table[b][0];
            if (price <= prev) break;
          }
          return tax;
        }
        var p = v.price;
        var ontario = [[55000, 0.005], [250000, 0.01], [400000, 0.015], [2000000, 0.02], [Infinity, 0.025]];
        var rules = {
          'ON':     { tax: brackets(p, ontario), label: 'Ontario land transfer tax' },
          'ON-TOR': { tax: brackets(p, ontario) * 2, label: 'Ontario + Toronto municipal land transfer tax' },
          'BC':     { tax: brackets(p, [[200000, 0.01], [2000000, 0.02], [3000000, 0.03], [Infinity, 0.05]]), label: 'BC property transfer tax' },
          'AB':     { tax: 50 + Math.ceil(p / 5000) * 5, label: 'Alberta land title transfer fee (no transfer tax)' },
          'SK':     { tax: p * 0.004, label: 'Saskatchewan title transfer fee' },
          'MB':     { tax: brackets(p, [[30000, 0], [90000, 0.005], [150000, 0.01], [200000, 0.015], [Infinity, 0.02]]), label: 'Manitoba land transfer tax' },
          'QC':     { tax: brackets(p, [[58900, 0.005], [294600, 0.01], [Infinity, 0.015]]), label: 'Quebec transfer duties ("welcome tax", typical brackets)' },
          'NB':     { tax: p * 0.01, label: 'New Brunswick real property transfer tax' },
          'NS':     { tax: p * 0.015, label: 'Halifax deed transfer tax (other NS municipalities vary)' },
          'PE':     { tax: p * 0.01, label: 'PEI real property transfer tax' },
          'NL':     { tax: 100 + Math.max(0, p - 500) * 0.004, label: 'Newfoundland and Labrador registration fee' }
        };
        var rule = rules[v.province] || rules.ON;
        out.innerHTML =
          '<div class="calc-result-row"><span>' + rule.label + '</span><strong>' + fmtMoney(rule.tax) + '</strong></div>' +
          '<div class="calc-result-row"><span>Effective rate</span><strong>' + (p > 0 ? (rule.tax / p * 100).toFixed(2) : '0.00') + '%</strong></div>' +
          '<p class="calc-note">Estimate only. First-time-buyer rebates, non-resident surtaxes, Toronto\'s additional tiers above $3M, and municipal variations are not included, and provinces adjust these rates and brackets -- confirm the exact amount with your lawyer or notary before closing.</p>';
      };

      calculators.SavingsGrowth = function (v, out) {
        var monthlyRate = v.rate / 100 / 12;
        var months = v.years * 12;
        var balance = v.startAmount;
        for (var m = 0; m < months; m++) { balance = balance * (1 + monthlyRate) + v.monthlyDeposit; }
        var contributed = v.startAmount + v.monthlyDeposit * months;
        var todaysDollars = balance / Math.pow(1 + v.inflation / 100, v.years);
        out.innerHTML =
          '<div class="calc-result-row"><span>Balance after ' + v.years + ' years</span><strong>' + fmtMoney(balance) + '</strong></div>' +
          '<div class="calc-result-row"><span>Total contributed</span><strong>' + fmtMoney(contributed) + '</strong></div>' +
          '<div class="calc-result-row"><span>Growth earned</span><strong>' + fmtMoney(balance - contributed) + '</strong></div>' +
          '<div class="calc-result-row"><span>In today\'s dollars</span><strong>' + fmtMoney(todaysDollars) + '</strong></div>' +
          '<p class="calc-note">Deposits are made monthly and returns compound monthly. Estimates only -- actual returns vary year to year.</p>';
      };

      calculators.SavingsGoal = function (v, out) {
        var monthlyRate = v.rate / 100 / 12;
        var inflation = v.inflation / 100;
        var balance = v.startAmount;
        var nominalYears = null, realYears = null;
        for (var y = 1; y <= 100 && (nominalYears === null || realYears === null); y++) {
          for (var m = 0; m < 12; m++) { balance = balance * (1 + monthlyRate) + v.monthlyDeposit; }
          if (nominalYears === null && balance >= v.goal) nominalYears = y;
          if (realYears === null && balance >= v.goal * Math.pow(1 + inflation, y)) realYears = y;
        }
        out.innerHTML =
          '<div class="calc-result-row"><span>Reach ' + fmtMoney(v.goal) + ' on paper</span><strong>' + (nominalYears !== null ? 'in about ' + nominalYears + ' years' : 'not within 100 years') + '</strong></div>' +
          '<div class="calc-result-row"><span>Reach the same buying power (inflation-adjusted)</span><strong>' + (realYears !== null ? 'in about ' + realYears + ' years' : 'not within 100 years') + '</strong></div>' +
          '<div class="calc-result-row"><span>Balance after ' + (realYears || nominalYears || 100) + ' years</span><strong>' + fmtMoney(balance) + '</strong></div>' +
          '<p class="calc-note">The second figure is the honest one: at ' + v.inflation + '% inflation, hitting the number and hitting the buying power are different milestones.</p>';
      };

      calculators.AfterTaxReturn = function (v, out) {
        var afterTax = v.rate * (1 - v.taxRate / 100);
        var real = ((1 + afterTax / 100) / (1 + v.inflation / 100) - 1) * 100;
        out.innerHTML =
          '<div class="calc-result-row"><span>Stated rate</span><strong>' + v.rate.toFixed(2) + '%</strong></div>' +
          '<div class="calc-result-row"><span>After-tax return</span><strong>' + afterTax.toFixed(2) + '%</strong></div>' +
          '<div class="calc-result-row"><span>Real return after tax and inflation</span><strong>' + real.toFixed(2) + '%</strong></div>' +
          '<p class="calc-note">Assumes the return is fully taxed as interest income at your marginal rate. Canadian dividends and capital gains are taxed more favourably, and returns inside a TFSA or RRSP are not taxed this way at all.</p>';
      };

      function collectInputs(root) {
        var values = {};
        root.querySelectorAll('[data-field]').forEach(function (el) { values[el.getAttribute('data-field')] = num(el); });
        root.querySelectorAll('[data-field-text]').forEach(function (el) { values[el.getAttribute('data-field-text')] = el.value; });
        return values;
      }

      document.addEventListener('click', function (event) {
        var button = event.target.closest('.calc-run');
        if (!button) return;
        var block = button.closest('.calc-block');
        if (!block) return;
        var kind = block.getAttribute('data-calculator-kind');
        var fn = calculators[kind];
        var out = block.querySelector('.calc-results');
        if (!fn || !out) return;
        out.hidden = false;
        fn(collectInputs(block), out);
      });
    })();
    </script>
}
<style>
  .calc-block { width: 100%; }
  .calc-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 18px; }
  .calc-fields label { display: grid; gap: 6px; font: 700 13px/1.4 Arial, sans-serif; color: inherit; }
  .calc-fields input, .calc-fields select { width: 100%; padding: 11px 12px; border: 1px solid #cbd5e1; border-radius: 6px; background: #fff; color: #17223a; font: 400 16px/1.4 Arial, sans-serif; } /* 16px, not 15: mobile Safari zooms the page on focus for any control under 16px and does not zoom back out (2026-08-31 mobile sweep). */
  .calc-fields input:focus, .calc-fields select:focus { outline: 3px solid color-mix(in srgb, var(--site-theme, #1457d9) 20%, transparent); border-color: var(--site-theme, #1457d9); }
  .calc-run { display: inline-flex; align-items: center; gap: 8px; min-height: 46px; padding: 0 20px; border: 0; border-radius: var(--button-radius, 6px); background: var(--site-theme, #1457d9); color: #fff; font: 800 14px Arial, sans-serif; cursor: pointer; }
  .calc-results { margin-top: 20px; padding-top: 18px; border-top: 1px solid #e3eaf3; display: grid; gap: 10px; }
  .calc-result-row { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; font: 400 14px/1.4 Arial, sans-serif; color: #45526b; }
  .calc-result-row strong { font: 800 16px Arial, sans-serif; color: #0c1933; }
  .calc-result-row .calc-hint { font-size: 12px; color: #8a93a6; }
  .calc-note { margin: 4px 0 0; font: 400 12.5px/1.5 Arial, sans-serif; color: #8a93a6; }
  .calc-table-wrap { overflow-x: auto; max-height: 420px; overflow-y: auto; border: 1px solid #e3eaf3; border-radius: 6px; }
  .calc-table { width: 100%; border-collapse: collapse; font: 400 13px/1.4 Arial, sans-serif; }
  .calc-table th, .calc-table td { padding: 8px 12px; text-align: right; border-bottom: 1px solid #eef2f7; white-space: nowrap; }
  .calc-table th:first-child, .calc-table td:first-child { text-align: left; }
  .calc-table thead th { position: sticky; top: 0; background: #f8fbff; font-weight: 800; color: #45526b; }
  @@media (max-width: 640px) { .calc-fields { grid-template-columns: 1fr; } }
</style>
