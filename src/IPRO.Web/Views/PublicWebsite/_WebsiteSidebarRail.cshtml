@model IPRO.Web.Models.PublicWebsiteViewModel
@{
    var website = Model.Website;
    var agent = website.AgentUser;
    // Designation belongs in the name -- "Ms. Raniah Motamed", not a line below it.
    var fullName = IPRO.Entities.AgentNameFormatter.FullName(agent);
}
<aside class="site-sidebar-rail">
  @if (!string.IsNullOrWhiteSpace(website.LogoUrl))
  {
    <img class="site-sidebar-rail__logo" src="@website.LogoUrl" alt="@website.SiteTitle" />
  }
  @if (!string.IsNullOrWhiteSpace(agent.PhotoUrl))
  {
    <img class="site-sidebar-rail__photo" src="@agent.PhotoUrl" alt="@fullName" />
  }
  @if (!string.IsNullOrWhiteSpace(fullName))
  {
    <div class="site-sidebar-rail__name">@fullName</div>
  }
  @if (!string.IsNullOrWhiteSpace(agent.CompanyName))
  {
    <div class="site-sidebar-rail__meta">@agent.CompanyName</div>
  }
  @if (!string.IsNullOrWhiteSpace(agent.Phone) || !string.IsNullOrWhiteSpace(agent.Email))
  {
    <div class="site-sidebar-rail__contact">
      @if (!string.IsNullOrWhiteSpace(agent.Phone))
      {
        <a href="tel:@agent.Phone"><i class="fas fa-phone me-2"></i>@agent.Phone</a>
      }
      @if (!string.IsNullOrWhiteSpace(agent.Email))
      {
        <a href="mailto:@agent.Email"><i class="fas fa-envelope me-2"></i>@agent.Email</a>
      }
    </div>
  }
</aside>
