@model IPRO.Web.Models.PublicWebsiteViewModel
@using System.Text.Json
@{
    var website = Model.Website;
    var agent = website.AgentUser;
    var page = Model.CurrentPage;
    var siteName = IPRO.Web.Infrastructure.PublicSeoText.SiteName(website);
    // A 404 must not describe itself as the site's home page. Without this the tab reads as the
    // site name, the canonical points at "/", and robots says index,follow -- so every mistyped or
    // stale URL is offered to search engines as a real page.
    var isPageNotFound = Model.PageNotFound;

    // 554: what the owner typed, else the business's own name and the page's own words -- a starter
    // value nobody touched ("Home", "Home - professional service and support.") counts as not
    // written. The rule lives in PublicSeoText, which the page editor's hints read too.
    var pageTitle = IPRO.Web.Infrastructure.PublicSeoText.Title(page, siteName, isPageNotFound);
    var description = IPRO.Web.Infrastructure.PublicSeoText.Description(page, website, isPageNotFound);
    var publicPath = page == null || page.IsHomePage ? "/" : $"/{page.Slug.Trim('/')}";
    // Canonical origin comes from the controller (custom domain when fully bound, else the
    // request host) so a site reachable on both its subdomain and its custom domain names ONE
    // host to search engines instead of competing with itself. Previews leave it empty.
    var origin = !string.IsNullOrWhiteSpace(Model.CanonicalOrigin)
        ? Model.CanonicalOrigin
        : $"{Context.Request.Scheme}://{Context.Request.Host}";
    var canonicalUrl = origin + publicPath;
    var imagePath = page?.Blocks.OrderBy(b => b.SortOrder).Select(b => b.ImageUrl).FirstOrDefault(url => !string.IsNullOrWhiteSpace(url));
    imagePath = string.IsNullOrWhiteSpace(imagePath) ? website.LogoUrl : imagePath;
    var imageUrl = string.IsNullOrWhiteSpace(imagePath)
        ? string.Empty
        : Uri.TryCreate(imagePath, UriKind.Absolute, out var absoluteImage)
            ? absoluteImage.ToString()
            : origin + (imagePath.StartsWith('/') ? imagePath : "/" + imagePath);
    var structuredData = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "ProfessionalService",
        ["name"] = siteName,
        ["url"] = canonicalUrl,
        ["description"] = description,
        ["email"] = agent.Email,
        ["telephone"] = agent.Phone,
        ["image"] = string.IsNullOrWhiteSpace(imageUrl) ? null : imageUrl,
        ["address"] = new Dictionary<string, object?>
        {
            ["@type"] = "PostalAddress",
            ["streetAddress"] = agent.CompanyAddress,
            ["addressLocality"] = agent.City,
            ["addressRegion"] = agent.Province,
            ["postalCode"] = agent.PostalCode,
            ["addressCountry"] = agent.Country
        }
    };
}
<title>@pageTitle</title>
<meta name="description" content="@description" />
<meta name="robots" content="@(isPageNotFound ? "noindex,follow" : ViewBag.IsTemplatePreview == true || ViewBag.IsProspectPreview == true ? "noindex,nofollow" : "index,follow,max-image-preview:large")" />
@* A 404 declares no canonical and no social card: canonicalUrl resolves to "/" when there is no
   current page, which would tell search engines and link unfurlers that this missing URL is the
   site's home page. The 404 status is the primary signal; noindex above is the belt to its braces. *@
@if (!isPageNotFound)
{
<link rel="canonical" href="@canonicalUrl" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="@siteName" />
<meta property="og:title" content="@pageTitle" />
<meta property="og:description" content="@description" />
<meta property="og:url" content="@canonicalUrl" />
@if (!string.IsNullOrWhiteSpace(imageUrl))
{
  <meta property="og:image" content="@imageUrl" />
}
<meta name="twitter:card" content="@(string.IsNullOrWhiteSpace(imageUrl) ? "summary" : "summary_large_image")" />
<meta name="twitter:title" content="@pageTitle" />
<meta name="twitter:description" content="@description" />
@if (!string.IsNullOrWhiteSpace(imageUrl))
{
  <meta name="twitter:image" content="@imageUrl" />
}
<script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(structuredData, new JsonSerializerOptions { DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull }))</script>
}
