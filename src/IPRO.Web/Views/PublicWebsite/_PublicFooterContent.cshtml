@model IPRO.Web.Models.PublicWebsiteViewModel
@{
    var website = Model.Website;
    var agent = website.AgentUser;
    var footer = IPRO.Entities.WebsiteFooterSettings.FromJson(website.FooterSettingsJson);
    var fallbackName = string.IsNullOrWhiteSpace(website.SiteTitle)
        ? (string.IsNullOrWhiteSpace(agent.CompanyName) ? $"{agent.FirstName} {agent.LastName}".Trim() : agent.CompanyName)
        : website.SiteTitle;
    var copyrightName = string.IsNullOrWhiteSpace(footer.CopyrightText) ? fallbackName : footer.CopyrightText;
    var agentLoginUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/Account/Login";
    // 579: the statement link, except in a preview: those are drawn on the platform's own host, where
    // /accessibility is iPro's statement, not this site's. 585: a look at a Template Builder package
    // keeps the site's links in the look (LookLinks), and shows the site's statement there, so its
    // footer is the live one, the statement link included.
    var inLook = ViewBag.LookLinks is IPRO.Web.Infrastructure.LookLinks;
    var isPreview = !inLook && (ViewBag.IsTemplatePreview == true || ViewBag.IsUnsavedPreview == true || ViewBag.IsProspectPreview == true);
    var linkStatement = !isPreview && !IPRO.Web.Infrastructure.AccessibilityStatement.IsLinked(footer.LegalLinks);
    // 465: the icon map is shared with the Social links block (SocialPlatformIcons).
}
<div class="public-footer__copyright">&copy; @DateTime.UtcNow.Year @copyrightName</div>
@if (!string.IsNullOrWhiteSpace(footer.Phone) || !string.IsNullOrWhiteSpace(footer.Email) || !string.IsNullOrWhiteSpace(footer.Address))
{
  <div class="public-footer__contact">
    @if (!string.IsNullOrWhiteSpace(footer.Phone))
    {
      <a href="tel:@footer.Phone"><i class="fas fa-phone"></i><span>@footer.Phone</span></a>
    }
    @if (!string.IsNullOrWhiteSpace(footer.Email))
    {
      <a href="mailto:@footer.Email"><i class="fas fa-envelope"></i><span>@footer.Email</span></a>
    }
    @if (!string.IsNullOrWhiteSpace(footer.Address))
    {
      <span><i class="fas fa-location-dot"></i><span>@footer.Address</span></span>
    }
  </div>
}
@* 556: the week in as few lines as it takes; nothing until hours are set.
   557: and only when the owner ticked "Also show the hours in the footer". *@
@if (footer.Hours.IsSet && footer.Hours.ShowInFooter)
{
  <div class="public-footer__hours" lang="@IPRO.Web.Infrastructure.SiteLanguageMarkup.EnglishInSiteParts(ViewData)"><i class="fas fa-clock" aria-hidden="true"></i><span class="visually-hidden">Hours: </span>@foreach (var line in footer.Hours.Lines()) { <span>@line</span> }</div>
}
@if (footer.SocialLinks.Any())
{
  <div class="public-footer__social">
    @foreach (var link in footer.SocialLinks.OrderBy(l => l.SortOrder))
    {
      <a href="@link.Url" target="_blank" rel="noopener noreferrer" aria-label="@IPRO.Web.Infrastructure.SocialPlatformIcons.Label(link.Platform)"><i class="@IPRO.Web.Infrastructure.SocialPlatformIcons.IconClass(link.Platform)" aria-hidden="true"></i></a>
    }
  </div>
}
@* 579: every site links its accessibility statement, last among the legal links, in the website's
   language; not a second time when the owner already links one of their own. *@
@if (footer.LegalLinks.Any() || linkStatement)
{
<div class="public-footer__legal">
  @foreach (var link in footer.LegalLinks.OrderBy(l => l.SortOrder))
  {
    <a href="@link.Url">@link.Label</a>
  }
  @if (linkStatement)
  {
    <a href="@IPRO.Web.Infrastructure.AccessibilityStatement.Path" aria-current="@(Model.AccessibilityStatement ? "page" : null)">@IPRO.Web.Infrastructure.AccessibilityStatement.LinkText(IPRO.Web.Infrastructure.SiteLanguageMarkup.Site(ViewData))</a>
  }
</div>
}
@if (footer.ShowDisclaimer && !string.IsNullOrWhiteSpace(footer.DisclaimerText))
{
  <div class="public-footer__disclaimer">@footer.DisclaimerText</div>
}
@* 525: the platform's line, last and tiny; the link goes to the brand for this adviser's business.
   534: the agent-login arrow follows it (the owner's placement; it used to end the social row). *@
<div class="public-footer__powered"><span lang="@IPRO.Web.Infrastructure.SiteLanguageMarkup.EnglishInSiteParts(ViewData)">Powered by <a href="@IPRO.Entities.PoweredBy.BrandUrl(agent.BusinessType)" title="@IPRO.Entities.PoweredBy.BrandName(agent.BusinessType)">@IPRO.Entities.PoweredBy.Label</a><a class="public-footer__agent-login" href="@agentLoginUrl" aria-label="Agent login" title="Agent login"><i class="fas fa-arrow-right-to-bracket" aria-hidden="true"></i></a></span></div>
<style>
  .public-footer__hours { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 14px; }
  .public-footer__hours i { color: var(--site-theme, #1457d9); }
  .public-footer__hours span { white-space: nowrap; }
  .public-footer__powered { margin-top: 10px; font-size: 11px; letter-spacing: .02em; color: var(--muted, #5b6472); } /* 578: readable on every design (it was 2.5 to 3.7:1) */
  .public-footer__powered a { color: inherit; text-decoration: none; font-weight: 600; }
  .public-footer__powered a:hover { text-decoration: underline; }
  .public-footer__powered .public-footer__agent-login { margin-left: 6px; padding: 2px 4px; font-size: 12px; }
  .public-footer__powered .public-footer__agent-login:hover { text-decoration: none; color: var(--site-theme-ink, var(--site-theme, #1457d9)); }
</style>
