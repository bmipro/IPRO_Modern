@model IPRO.Web.Models.PublicFormBlockData
@{
    Layout = null;
    var website = ViewBag.Website as IPRO.Entities.AgentWebsite;
    var agent = website?.AgentUser ?? ViewBag.Agent as IPRO.Entities.AgentUser;
    var siteTitle = !string.IsNullOrWhiteSpace(website?.SiteTitle)
        ? website!.SiteTitle
        : agent != null ? $"{agent.FirstName} {agent.LastName}".Trim() : "Your Website";
    var theme = string.IsNullOrWhiteSpace(website?.ThemeColor) ? "#1457d9" : website!.ThemeColor;
    var isPreview = ViewBag.IsFormPreview == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>@Model.Title - @siteTitle</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" rel="stylesheet" />
  <style>
    :root { --site-theme: @theme; }
    body { background: #f1f5f9; font-family: Arial, sans-serif; color: #17223a; }
    .standalone-form-header { display: flex; align-items: center; gap: 12px; padding: 20px 0; }
    .standalone-form-header img { height: 40px; width: auto; }
    .standalone-form-header span { font-weight: 800; font-size: 18px; }
    .standalone-form-card { background: #fff; border-radius: 10px; box-shadow: 0 4px 20px rgba(15,23,42,.08); padding: 32px; }
    .standalone-form-title { font-weight: 800; font-size: 24px; margin-bottom: 4px; }
    .standalone-form-preview-banner { background: #fef3c7; color: #92400e; border: 1px solid #fcd34d; border-radius: 8px; padding: 10px 16px; font-weight: 700; font-size: 14px; margin-bottom: 16px; }
  </style>
</head>
<body>
  <div class="container" style="max-width:680px;">
    @if (isPreview)
    {
      <div class="standalone-form-preview-banner mt-4"><i class="fas fa-eye me-1"></i>Preview only — this is how visitors will see this form. Nothing you submit here is saved as a real lead unless your website is published.</div>
    }
    <div class="standalone-form-header">
      @if (!string.IsNullOrWhiteSpace(website?.LogoUrl))
      {
        <img src="@website!.LogoUrl" alt="@siteTitle" />
      }
      <span>@siteTitle</span>
    </div>
    <div class="standalone-form-card mb-5">
      <div class="standalone-form-title">@Model.Title</div>
      @await Html.PartialAsync("_WebsiteCustomForm", Model)
    </div>
  </div>
</body>
</html>
