@model IPRO.Web.Models.WebsiteLeadFormViewModel
@using Microsoft.AspNetCore.DataProtection
@inject Microsoft.AspNetCore.DataProtection.IDataProtectionProvider DataProtectionProvider
@{
    var isNewsletter = Model.SubmissionType == IPRO.Entities.WebsiteLeadTypes.Newsletter;
    var isLeadMagnet = Model.SubmissionType == IPRO.Entities.WebsiteLeadTypes.LeadMagnet;
    var isDidYouKnow = Model.SubmissionType == IPRO.Entities.WebsiteLeadTypes.DidYouKnow;
    var showFullFields = !isNewsletter && !isLeadMagnet && !isDidYouKnow;
    var showLastName = showFullFields || isDidYouKnow;
    // Preview (WebsitePages/Preview and PreviewUnsaved) renders this same partial under the portal's
    // own host (app.iproadvisers.com), which never resolves to a real agent site -- submitting for
    // real here always 404s. Disable submission and say so, rather than let it fail silently.
    var isPreview = ViewBag.IsTemplatePreview == true || ViewBag.IsUnsavedPreview == true;
    var formId = $"website-lead-{Guid.NewGuid():N}";
    var submitted = Context.Request.Query["submitted"].ToString();
    var dlToken = Context.Request.Query["dl"].ToString();
    var expectedResult = Model.SubmissionType.ToLowerInvariant();
    var captchaLeft = Random.Shared.Next(2, 10);
    var captchaRight = Random.Shared.Next(2, 10);
    var publicReturnPath = Context.Items.TryGetValue("IproPublicPath", out var originalPath) && originalPath is string { Length: > 0 } originalPathValue
        ? originalPathValue
        : Context.Request.Path.ToString();
    var captchaToken = DataProtectionProvider
        .CreateProtector("IPRO.Web.PublicWebsite.Captcha.v1")
        .Protect($"{captchaLeft + captchaRight}|{DateTimeOffset.UtcNow.ToUnixTimeSeconds()}");
}
<div class="website-lead-form-shell@(isDidYouKnow ? " dyk-form-panel" : null)" id="@(isDidYouKnow ? $"dyk-form-{Model.DidYouKnowBlockId}" : null)" hidden="@(isDidYouKnow && submitted != expectedResult ? "hidden" : null)">
  @if (submitted == expectedResult)
  {
    @if (isLeadMagnet && !string.IsNullOrEmpty(dlToken))
    {
      <div class="website-lead-success" role="status">
        <i class="fas fa-circle-check"></i> Thanks! Your download is ready.
        <div class="mt-2"><a class="website-lead-submit" href="/PublicWebsite/DownloadLeadMagnet?token=@Uri.EscapeDataString(dlToken)"><i class="fas fa-download"></i> Download Now</a></div>
      </div>
    }
    else
    {
      <div class="website-lead-success" role="status"><i class="fas fa-circle-check"></i> @(isNewsletter ? "You are subscribed. Thank you for staying connected." : isLeadMagnet ? "Thanks! Check your details and try again if the download link didn't appear." : isDidYouKnow ? "Thanks! We're emailing you the full article(s) -- they'll land in your inbox one at a time over the next little while." : "Thank you. Your message was sent to the adviser.")</div>
    }
    <script nonce="@Context.GetCspNonce()">(function(){var u=new URL(location.href);u.searchParams.delete('submitted');u.searchParams.delete('dl');history.replaceState(null,'',u.pathname+u.search+u.hash);})();</script>
  }
  else
  {
    @if (TempData["PublicFormError"] is string formError)
    {
      <div class="website-lead-error" role="alert">@formError</div>
    }
    @if (isPreview)
    {
      <div class="website-lead-preview-note" role="note"><i class="fas fa-circle-info"></i> Preview only -- this form can't be submitted here. Test it on your live site.</div>
    }
    @if (isDidYouKnow)
    {
      <button type="button" class="dyk-back-link" data-dyk-show="dyk-cards-@Model.DidYouKnowBlockId" data-dyk-hide="dyk-form-@Model.DidYouKnowBlockId"><i class="fas fa-arrow-left"></i> Back to articles</button>
      <p class="dyk-form-intro">Enter your details below and we'll email you the full article(s) shortly.</p>
    }
    <form id="@formId" method="post" action="/PublicWebsite/SubmitLead" class="website-lead-form">
      @Html.AntiForgeryToken()
      <input type="hidden" name="SubmissionType" value="@Model.SubmissionType" />
      <input type="hidden" name="PageId" value="@Model.PageId" />
      <input type="hidden" name="ReturnPath" value="@publicReturnPath" />
      <input type="hidden" name="FormStartedAt" value="@DateTimeOffset.UtcNow.ToUnixTimeSeconds()" />
      <input type="hidden" name="CaptchaToken" value="@captchaToken" />
      @if (isLeadMagnet)
      {
        <input type="hidden" name="LeadMagnetBlockId" value="@Model.LeadMagnetBlockId" />
      }
      @if (isDidYouKnow)
      {
        <input type="hidden" name="DidYouKnowBlockId" value="@Model.DidYouKnowBlockId" />
      }
      <div class="website-lead-honeypot" aria-hidden="true"><label>Leave this field blank<input name="HoneypotField" tabindex="-1" autocomplete="off" /></label></div>
      <div class="website-lead-grid">
        <label><span>First name *</span><input name="FirstName" maxlength="80" autocomplete="given-name" required /></label>
        @if (showLastName)
        {
          <label><span>Last name</span><input name="LastName" maxlength="80" autocomplete="family-name" /></label>
        }
        <label><span>Email *</span><input type="email" name="Email" maxlength="200" autocomplete="email" required /></label>
        @if (showFullFields)
        {
          <label><span>Phone</span><input name="Phone" maxlength="40" autocomplete="tel" /></label>
          <label class="website-lead-full"><span>How can we help?</span><textarea name="Message" maxlength="4000" rows="4"></textarea></label>
        }
      </div>
      <label class="website-lead-captcha">
        <span>Security check *</span>
        <span class="website-lead-captcha-row">
          <span class="website-lead-captcha-question">What is @captchaLeft + @captchaRight?</span>
          <input name="CaptchaAnswer" inputmode="numeric" pattern="[0-9]*" maxlength="3" autocomplete="off" required />
        </span>
      </label>
      <label class="website-lead-consent"><input type="checkbox" name="ConsentGiven" value="true" required /><span>@(isNewsletter ? "I agree to receive newsletters and understand I can unsubscribe later." : isLeadMagnet ? "I agree that this adviser may use my information to follow up about this download." : isDidYouKnow ? "I agree to receive these articles by email and understand I can unsubscribe later." : "I agree that this adviser may use my information to respond to this request.")</span></label>
      <button type="submit" class="website-lead-submit" disabled="@(isPreview ? "disabled" : null)" title="@(isPreview ? "Disabled in preview -- test on your live site" : null)"><i class="fas @(isNewsletter ? "fa-envelope" : isLeadMagnet ? "fa-download" : isDidYouKnow ? "fa-envelope" : "fa-paper-plane")"></i> @(isNewsletter ? "Subscribe" : isLeadMagnet ? "Get the Download" : isDidYouKnow ? "Email Me the Article(s)" : "Send message")</button>
    </form>
  }
</div>
@if (isDidYouKnow)
{
  <script nonce="@Context.GetCspNonce()">
  (function () {
    if (window.__dykWired) return;
    window.__dykWired = true;
    document.addEventListener('click', function (event) {
      var trigger = event.target.closest('[data-dyk-show]');
      if (!trigger) return;
      event.preventDefault();
      var showEl = document.getElementById(trigger.getAttribute('data-dyk-show'));
      var hideEl = document.getElementById(trigger.getAttribute('data-dyk-hide'));
      if (hideEl) hideEl.hidden = true;
      if (showEl) {
        showEl.hidden = false;
        showEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  })();
  </script>
}
<style>
  .website-lead-form-shell{width:100%;}
  .website-lead-form{display:grid;gap:16px;}
  .website-lead-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  .website-lead-form label{display:grid;gap:6px;font:700 13px/1.4 Arial,sans-serif;color:inherit;}
  .website-lead-form input:not([type=checkbox]),.website-lead-form textarea{width:100%;padding:11px 12px;border:1px solid #cbd5e1;border-radius:6px;background:#fff;color:#17223a;font:400 15px/1.4 Arial,sans-serif;}
  .website-lead-form input:focus,.website-lead-form textarea:focus{outline:3px solid color-mix(in srgb,var(--site-theme,#1457d9) 20%,transparent);border-color:var(--site-theme,#1457d9);}
  .website-lead-full{grid-column:1/-1;}
  .website-lead-captcha-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
  .website-lead-captcha-question{display:inline-flex;align-items:center;min-height:42px;padding:0 14px;border-radius:6px;background:color-mix(in srgb,var(--site-theme,#1457d9) 10%,#fff);border:1px solid color-mix(in srgb,var(--site-theme,#1457d9) 30%,#cbd5e1);font:800 14px Arial,sans-serif;color:#17223a;}
  .website-lead-captcha input{max-width:110px;}
  .website-lead-consent{display:flex!important;grid-template-columns:auto 1fr!important;align-items:start;gap:9px!important;font-weight:400!important;}
  .website-lead-consent input{margin-top:3px;}
  .website-lead-submit{justify-self:start;display:inline-flex;align-items:center;gap:8px;min-height:46px;padding:0 20px;border:0;border-radius:var(--button-radius,6px);background:var(--site-theme,#1457d9);color:#fff;font:800 14px Arial,sans-serif;}
  .website-lead-submit:disabled{opacity:.55;cursor:not-allowed;}
  .website-lead-preview-note{padding:10px 14px;margin-bottom:2px;border-radius:6px;background:#fef9c3;color:#854d0e;border:1px solid #fde68a;font:700 13px/1.5 Arial,sans-serif;}
  .website-lead-success,.website-lead-error{padding:14px;border-radius:6px;font:700 14px/1.5 Arial,sans-serif;}
  .website-lead-success{background:#dcfce7;color:#166534;border:1px solid #86efac;}
  .website-lead-error{margin-bottom:12px;background:#fee2e2;color:#991b1b;border:1px solid #fca5a5;}
  .website-lead-honeypot{position:absolute!important;left:-10000px!important;width:1px!important;height:1px!important;overflow:hidden!important;}
  .dyk-back-link{display:inline-flex;align-items:center;gap:6px;margin-bottom:14px;padding:0;border:0;background:none;font:700 13px Arial,sans-serif;color:var(--muted,#5e6b80);cursor:pointer;}
  .dyk-back-link:hover{color:var(--site-theme,#1457d9);}
  .dyk-form-intro{margin:0 0 16px;font:400 14px/1.5 Arial,sans-serif;color:var(--muted,#5e6b80);}
  @@media(max-width:640px){.website-lead-grid{grid-template-columns:1fr}.website-lead-full{grid-column:auto}}
</style>
