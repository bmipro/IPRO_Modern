@model IPRO.Web.Models.LeadFormEmbedViewModel
@{
    // 646: the contact form a professional who keeps their own website places on it -- as a link, or inside one of
    // their pages. Plain on purpose (no script, a white page, the visitor's own font size), so it sits in any site.
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Contact @Model.BusinessName</title>
  <style>
    body { margin: 0; background: #fff; color: #172033; font-family: "Segoe UI", Roboto, Arial, sans-serif; font-size: 16px; line-height: 1.45; }
    .lead-form { max-width: 640px; margin: 0 auto; padding: 18px 16px 24px; }
    h1 { margin: 0 0 14px; font-size: 21px; }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 14px; }
    .full { grid-column: 1 / -1; }
    label { display: flex; flex-direction: column; gap: 5px; font-weight: 600; font-size: 15px; }
    input, textarea { font: inherit; font-size: 16px; padding: 10px 12px; border: 1px solid #b8c3d6; border-radius: 8px; background: #fff; color: #172033; }
    input:focus-visible, textarea:focus-visible, button:focus-visible { outline: 3px solid #1457d9; outline-offset: 2px; }
    .check { flex-direction: row; align-items: flex-start; gap: 10px; font-weight: 400; margin-top: 14px; }
    .check input { margin-top: 4px; width: 18px; height: 18px; }
    .sum { margin-top: 14px; max-width: 260px; }
    .problems { margin: 0 0 14px; padding: 12px 14px; border: 1px solid #f1b8b8; border-radius: 8px; background: #fff5f5; color: #8a1c1c; }
    .problems ul { margin: 6px 0 0; padding-left: 20px; }
    .honeypot { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
    button { margin-top: 16px; padding: 12px 22px; border: 0; border-radius: 999px; background: #1457d9; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
    .sent { padding: 22px 16px; text-align: center; }
    .sent h1 { margin-bottom: 8px; }
    @@media (max-width: 520px) { .grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <div class="lead-form">
    @if (Model.Sent)
    {
      <div class="sent" role="status">
        <h1>Thank you</h1>
        <p>Your message was sent to @Model.BusinessName. They will reply to the email address you gave.</p>
      </div>
    }
    else
    {
      <h1>Contact @Model.BusinessName</h1>
      @if (Model.Problems.Count > 0)
      {
        <div class="problems" role="alert">
          @Model.Problems[0]
          @if (Model.Problems.Count > 1)
          {
            <ul>
              @foreach (var problem in Model.Problems.Skip(1))
              {
                <li>@problem</li>
              }
            </ul>
          }
        </div>
      }
      <form method="post" action="/PublicWebsite/LeadForm/@Model.FormKey">
        <input type="hidden" name="FormStartedAt" value="@Model.FormStartedAt" />
        <input type="hidden" name="CaptchaToken" value="@Model.CaptchaToken" />
        <div class="honeypot" aria-hidden="true"><label>Leave this field blank<input name="HoneypotField" tabindex="-1" autocomplete="off" /></label></div>
        <div class="grid">
          <label>First name *<input name="FirstName" value="@Model.FirstName" maxlength="80" autocomplete="given-name" required /></label>
          <label>Last name<input name="LastName" value="@Model.LastName" maxlength="80" autocomplete="family-name" /></label>
          <label>Email *<input type="email" name="Email" value="@Model.Email" maxlength="200" autocomplete="email" required /></label>
          <label>Phone<input name="Phone" value="@Model.Phone" maxlength="40" autocomplete="tel" /></label>
          <label class="full">How can we help?<textarea name="Message" maxlength="4000" rows="4">@Model.Message</textarea></label>
        </div>
        <label class="sum">Security check: what is @Model.CaptchaLeft + @Model.CaptchaRight? *<input name="CaptchaAnswer" inputmode="numeric" pattern="[0-9]*" maxlength="3" autocomplete="off" required /></label>
        <label class="check"><input type="checkbox" name="ConsentGiven" value="true" checked="@(Model.ConsentGiven ? "checked" : null)" required /><span>I agree that @Model.BusinessName may use my information to respond to this request.</span></label>
        <button type="submit">Send message</button>
      </form>
    }
  </div>
</body>
</html>
