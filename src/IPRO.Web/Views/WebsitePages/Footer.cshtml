@model IPRO.Web.Models.WebsiteFooterViewModel
@{
  ViewData["Title"] = "Footer";
  var platformLabels = new Dictionary<string, string>
  {
    ["facebook"] = "Facebook",
    ["linkedin"] = "LinkedIn",
    ["instagram"] = "Instagram",
    ["twitter-x"] = "Twitter / X",
    ["youtube"] = "YouTube",
    ["other"] = "Other"
  };
}
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
  <div><div class="small text-muted mb-1"><a href="/portal/Website">My Website</a> / Footer</div><h2 class="fw-bold mb-1"><i class="fas fa-shoe-prints me-2 text-primary"></i>Footer</h2><div class="text-muted">Copyright, contact details, hours, social links, and legal links shown at the bottom of every page.</div></div>
  <div class="d-flex gap-2"><a href="/portal/WebsitePages/Navigation" class="btn btn-outline-secondary"><i class="fas fa-bars-staggered me-1"></i>Header & Menu</a><a href="/portal/Website" class="btn btn-outline-primary"><i class="fas fa-arrow-left me-1"></i>Website Settings</a></div>
</div>

<form method="post" action="/portal/WebsitePages/SaveFooter" class="card border-0 shadow-sm mb-4">
  @Html.AntiForgeryToken()
  <div class="card-body p-4">
    <div class="mb-4"><h4 class="fw-bold mb-1">Copyright & Contact</h4><div class="text-muted small">Leave a field blank to omit it from the footer.</div></div>
    <div class="row g-3">
      <div class="col-md-6"><label class="form-label fw-semibold">Copyright Text</label><input name="copyrightText" value="@Model.Footer.CopyrightText" class="form-control" placeholder="Your Company Name" /></div>
      <div class="col-md-3"><label class="form-label fw-semibold">Phone</label><input name="phone" value="@Model.Footer.Phone" class="form-control" placeholder="(555) 123-4567" /></div>
      <div class="col-md-3"><label class="form-label fw-semibold">Email</label><input name="email" type="email" value="@Model.Footer.Email" class="form-control" placeholder="you@example.com" /></div>
      <div class="col-md-12"><label class="form-label fw-semibold">Address</label><input name="address" value="@Model.Footer.Address" class="form-control" placeholder="123 Main Street, City, Province" /></div>
      <div class="col-12">
        <div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" id="showDisclaimer" name="showDisclaimer" value="true" checked="@Model.Footer.ShowDisclaimer"><label class="form-check-label fw-semibold" for="showDisclaimer">Show disclaimer</label></div>
        <textarea name="disclaimerText" class="form-control" rows="2" placeholder="Optional disclaimer text shown in the footer.">@Model.Footer.DisclaimerText</textarea>
      </div>
    </div>
  </div>
  <div class="card-footer bg-white border-0 px-4 pb-4"><button class="btn btn-primary"><i class="fas fa-save me-1"></i>Save Footer</button></div>
</form>

@* 556: opening hours, entered once and shown across the site. A day without both times is closed. *@
<form method="post" action="/portal/WebsitePages/SaveHours" class="card border-0 shadow-sm mb-4" id="hours">
  @Html.AntiForgeryToken()
  <div class="card-body p-4">
    <div class="mb-3"><h4 class="fw-bold mb-1">Hours</h4><div class="text-muted small">Enter them once. They show at the bottom of every page, on your contact and "about us" cards, as an "Open now" line under the first button of a page, and to search engines. Leave every day unticked to show no hours.</div></div>
    <div class="hours-grid">
      @foreach (var day in IPRO.Entities.WebsiteBusinessHours.WeekOrder)
      {
        var key = (int)day;
        var row = Model.Footer.Hours.For(day);
        <div class="hours-row">
          <div class="form-check hours-row__day"><input class="form-check-input js-hours-open" type="checkbox" id="open_@key" name="open_@key" value="true" checked="@row.IsOpen" /><label class="form-check-label fw-semibold" for="open_@key">@day</label></div>
          <div class="hours-row__times">
            <label class="visually-hidden" for="opens_@key">@day opens at</label>
            <input type="time" class="form-control" id="opens_@key" name="opens_@key" value="@row.Opens" />
            <span class="text-muted">to</span>
            <label class="visually-hidden" for="closes_@key">@day closes at</label>
            <input type="time" class="form-control" id="closes_@key" name="closes_@key" value="@row.Closes" />
            <span class="hours-row__closed text-muted small">Closed</span>
          </div>
        </div>
      }
    </div>
    <div class="mt-2"><button type="button" class="btn btn-sm btn-outline-secondary" id="hoursCopy"><i class="fas fa-copy me-1"></i>Use the first open day's times for every open day</button></div>
    <div class="form-text">A closing time earlier than the opening time runs past midnight (6:00 PM to 2:00 AM).</div>
    <div class="row g-3 mt-1">
      <div class="col-md-7"><label class="form-label fw-semibold" for="hoursNote">Note (optional)</label><input id="hoursNote" name="hoursNote" value="@Model.Footer.Hours.Note" maxlength="@IPRO.Entities.WebsiteBusinessHours.NoteMaxLength" class="form-control" placeholder="Closed on statutory holidays" /><div class="form-text">One line shown under the hours: a holiday closing, a lunch break, "by appointment".</div></div>
      <div class="col-md-5"><label class="form-label fw-semibold" for="businessKind">Kind of business</label><select id="businessKind" name="businessKind" class="form-select">@foreach (var kind in IPRO.Entities.WebsiteBusinessKinds.Options) { <option value="@kind.Value" selected="@(kind.Value == Model.Footer.BusinessKind)">@kind.Label</option> }</select><div class="form-text">Not shown on the site. It tells search engines what you are, so your hours can appear in the right kind of result.</div></div>
    </div>
  </div>
  <div class="card-footer bg-white border-0 px-4 pb-4"><button class="btn btn-primary"><i class="fas fa-save me-1"></i>Save Hours</button></div>
</form>
<style>
  .hours-grid { display: grid; gap: 8px; max-width: 560px; }
  .hours-row { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; }
  .hours-row__day { flex: 0 0 130px; margin: 0; }
  .hours-row__times { display: flex; align-items: center; gap: 8px; flex: 1 1 260px; }
  .hours-row__times input[type="time"] { max-width: 150px; }
  .hours-row__closed { display: none; }
  .hours-row.is-closed .hours-row__times input, .hours-row.is-closed .hours-row__times span:not(.hours-row__closed) { display: none; }
  .hours-row.is-closed .hours-row__closed { display: inline; }
</style>
<script nonce="@Context.GetCspNonce()">
  (function () {
    var rows = Array.prototype.slice.call(document.querySelectorAll('.hours-row'));
    function sync(row) { row.classList.toggle('is-closed', !row.querySelector('.js-hours-open').checked); }
    rows.forEach(function (row) {
      sync(row);
      row.querySelector('.js-hours-open').addEventListener('change', function () { sync(row); });
    });
    var copy = document.getElementById('hoursCopy');
    if (copy) copy.addEventListener('click', function () {
      var open = rows.filter(function (row) { return row.querySelector('.js-hours-open').checked; });
      if (!open.length) return;
      var times = open[0].querySelectorAll('input[type="time"]');
      open.slice(1).forEach(function (row) {
        var own = row.querySelectorAll('input[type="time"]');
        own[0].value = times[0].value; own[1].value = times[1].value;
      });
    });
  })();
</script>

<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-4">
    <h4 class="fw-bold mb-1">Social Links</h4><div class="text-muted small mb-3">Add links to your social media profiles.</div>
    <form method="post" action="/portal/WebsitePages/AddSocialLink" class="row g-2 align-items-end mb-3">
      @Html.AntiForgeryToken()
      <div class="col-md-4"><label class="form-label small fw-semibold">Platform</label><select name="platform" class="form-select">@foreach (var platform in platformLabels) { <option value="@platform.Key">@platform.Value</option> }</select></div>
      <div class="col-md-6"><label class="form-label small fw-semibold">Profile URL</label><input name="url" type="url" class="form-control" placeholder="https://facebook.com/yourpage" required /></div>
      <div class="col-md-2"><button class="btn btn-primary w-100"><i class="fas fa-plus me-1"></i>Add</button></div>
    </form>
    @foreach (var link in Model.Footer.SocialLinks.OrderBy(l => l.SortOrder))
    {
      <div class="d-flex align-items-center justify-content-between gap-3 border-top py-3">
        <div><strong>@(platformLabels.TryGetValue(link.Platform, out var label) ? label : link.Platform)</strong><div class="small text-muted text-break">@link.Url</div></div>
        <form method="post" action="/portal/WebsitePages/DeleteSocialLink">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@link.Id" /><button class="js-confirm-submit btn btn-sm btn-outline-danger" data-confirm-message="Remove this social link?"><i class="fas fa-trash"></i></button></form>
      </div>
    }
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-4">
    <h4 class="fw-bold mb-1">Legal Links</h4><div class="text-muted small mb-3">Add links such as Privacy Policy or Terms of Service — either one of your own pages, or a complete external URL.</div>
    <form method="post" action="/portal/WebsitePages/AddLegalLink" class="row g-2 align-items-end mb-3" id="legalLinkForm">
      @Html.AntiForgeryToken()
      <div class="col-md-4"><label class="form-label small fw-semibold">Label</label><input name="label" class="form-control" placeholder="Privacy Policy" required /></div>
      <div class="col-md-4">
        <label class="form-label small fw-semibold">Link to</label>
        <select id="legalLinkPageId" class="form-select">
          <option value="">Custom URL&hellip;</option>
          @foreach (var sitePage in Model.Pages)
          {
            var path = sitePage.IsHomePage ? "/" : $"/{sitePage.Slug.Trim('/')}";
            <option value="@path">@sitePage.Title@(sitePage.ShowInNavigation ? "" : " (hidden from menu)")</option>
          }
        </select>
      </div>
      <div class="col-md-4"><label class="form-label small fw-semibold">URL</label><input name="url" id="legalLinkUrl" type="text" class="form-control" placeholder="https://example.com/privacy" required /></div>
      <div class="col-12"><button class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add</button></div>
    </form>
    @foreach (var link in Model.Footer.LegalLinks.OrderBy(l => l.SortOrder))
    {
      <div class="d-flex align-items-center justify-content-between gap-3 border-top py-3">
        <div><strong>@link.Label</strong><div class="small text-muted text-break">@link.Url</div></div>
        <form method="post" action="/portal/WebsitePages/DeleteLegalLink">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@link.Id" /><button class="js-confirm-submit btn btn-sm btn-outline-danger" data-confirm-message="Remove this legal link?"><i class="fas fa-trash"></i></button></form>
      </div>
    }
  </div>
</div>

@* 492 (audit M-6 residual): every inline script needs the CSP nonce or a strict browser drops it silently. *@
<script nonce="@Context.GetCspNonce()">
  (function () {
    var pageSelect = document.getElementById('legalLinkPageId');
    var urlInput = document.getElementById('legalLinkUrl');
    if (!pageSelect || !urlInput) return;
    pageSelect.addEventListener('change', function () {
      if (pageSelect.value) {
        urlInput.value = pageSelect.value;
        urlInput.readOnly = true;
      } else {
        urlInput.value = '';
        urlInput.readOnly = false;
        urlInput.focus();
      }
    });
  })();
</script>
