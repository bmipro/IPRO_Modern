@model IPRO.Web.Models.WebsitePageEditViewModel
@{
    var sitePage = Model.Page;
    var isNew = sitePage.Id == 0;
    ViewData["Title"] = isNew ? "Create Website Page" : $"Edit {sitePage.Title}";
    // 554: the two search boxes show what the OWNER wrote. A starter value nobody touched is not used on
    // the public page (PublicSeoText), so it is not shown as if it were: the box is empty and its grey
    // text is what a search result shows today. Saved empty, the starter value is gone for good.
    var ownSearchTitle = IPRO.Web.Infrastructure.PublicSeoText.HasOwnTitle(sitePage) ? sitePage.MetaTitle : string.Empty;
    var ownSearchDescription = IPRO.Web.Infrastructure.PublicSeoText.HasOwnDescription(sitePage) ? sitePage.MetaDescription : string.Empty;
}
@functions {
    private static string StripHtml(string? html) => string.IsNullOrWhiteSpace(html) ? "" : System.Text.RegularExpressions.Regex.Replace(html, "<[^>]+>", " ").Trim();

    private static string ImageKey(string? value)
    {
        var text = value?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(text))
        {
            return string.Empty;
        }

        if (System.Uri.TryCreate(text, System.UriKind.Absolute, out var uri) &&
            (uri.Scheme == System.Uri.UriSchemeHttp || uri.Scheme == System.Uri.UriSchemeHttps))
        {
            return uri.GetLeftPart(System.UriPartial.Path).TrimEnd('/').ToLowerInvariant();
        }

        return text.TrimEnd('/').ToLowerInvariant();
    }

    private static bool SameImageUrl(string? left, string? right) =>
        !string.IsNullOrWhiteSpace(left) &&
        !string.IsNullOrWhiteSpace(right) &&
        ImageKey(left) == ImageKey(right);
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
  <div>
    <div class="small text-muted mb-1"><a href="/portal/Website">My Website</a> / <a href="/portal/WebsitePages">Pages</a> / @(isNew ? "Create" : "Edit")</div>
    <h2 class="fw-bold mb-1"><i class="fas fa-file-pen me-2 text-primary"></i>@ViewData["Title"]</h2>
    <div class="text-muted">Page settings control navigation and search details. Content blocks build the page itself.</div>
  </div>
  <div class="d-flex gap-2">
    @if (!isNew)
    {
      <a href="/portal/WebsitePages/Preview/@sitePage.Id" target="_blank" class="btn btn-primary"><i class="fas fa-eye me-1"></i>Preview Page</a>
    }
    <a href="/portal/WebsitePages" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>All Pages</a>
  </div>
</div>
@if (!isNew)
{
  @if (sitePage.IsPublished)
  {
    <div class="alert alert-warning small mb-4"><i class="fas fa-triangle-exclamation me-1"></i><strong>This page is live.</strong> <strong>Save Block</strong> on any block below goes live immediately — there is no draft/staging step. Use <strong>Preview without Saving</strong> on a block to check a change safely before committing to it. The <strong>Preview Page</strong> button above shows the page exactly as currently saved (i.e. what's live right now).</div>
  }
  else
  {
    <div class="alert alert-light border small mb-4"><i class="fas fa-circle-info me-1 text-primary"></i>This page is a draft, not visible to real visitors yet. <strong>Preview without Saving</strong> on a block checks your current changes instantly; <strong>Preview Page</strong> above shows the page exactly as currently saved.</div>
  }
}

<form method="post" action="/portal/WebsitePages/SavePage" class="card border-0 shadow-sm mb-4">
  @Html.AntiForgeryToken()
  <input type="hidden" name="id" value="@sitePage.Id" />
  <div class="card-body p-4">
    <h5 class="fw-bold mb-3">Page Settings</h5>
    <div class="row g-3">
      <div class="col-md-6"><label class="form-label fw-semibold">Page Title</label><input name="title" value="@sitePage.Title" class="form-control" required /></div>
      <div class="col-md-6"><label class="form-label fw-semibold">Page Address</label><div class="input-group"><span class="input-group-text">/</span><input name="slug" value="@sitePage.Slug" class="form-control" placeholder="services" /></div></div>
                <div class="col-md-6"><label class="form-label fw-semibold">Navigation Label</label><input name="navigationLabel" value="@sitePage.NavigationLabel" class="form-control" placeholder="Defaults to page title" /></div>
                <div class="col-md-6"><label class="form-label fw-semibold">Parent Menu</label><select name="parentPageId" class="form-select"><option value="">Top level</option>@foreach (var parent in Model.AvailableParents){<option value="@parent.Id" selected="@(sitePage.ParentPageId == parent.Id)">@parent.NavigationLabel</option>}</select></div>
                @if (isNew)
                {
                    <div class="col-12">
                        <label class="form-label fw-semibold" for="starterPreset">Start page with</label>
                        <select class="form-select" id="starterPreset" name="starterPreset">
                            @foreach (var preset in Model.StarterPresets)
                            {
                                <option value="@preset.Key">@preset.Name - @preset.Description</option>
                            }
                        </select>
                        <div class="form-text">This adds editable starter sections. You can change, reorder, or delete them afterwards.</div>
                    </div>
                }
      <div class="col-md-6"><label class="form-label fw-semibold">Browser/SEO Title</label><input name="metaTitle" value="@ownSearchTitle" placeholder="@Model.SearchTitle" class="form-control" /></div>
      <div class="col-md-6"><label class="form-label fw-semibold">Search Description</label><input name="metaDescription" value="@ownSearchDescription" placeholder="@Model.SearchDescription" maxlength="320" class="form-control" /></div>
      @if (!isNew)
      {
        <div class="col-12"><div class="form-text mt-0">Left empty, a search result shows the grey text: your business name and this page's own opening words. Type your own to change it.</div></div>
      }
      @* 553: closed unless the page has some. Most pages never had another address; a page that
         replaces one on the adviser's previous website needs exactly this and nothing else. *@
      <div class="col-12">
        <details @(string.IsNullOrWhiteSpace(sitePage.OldAddresses) ? "" : "open")>
          <summary class="fw-semibold">Old addresses for this page <span class="text-muted fw-normal">— moved here from another website?</span></summary>
          <textarea name="oldAddresses" rows="3" class="form-control mt-2" aria-label="Old addresses for this page" placeholder="about-us&#10;services/tax-planning.html">@sitePage.OldAddresses</textarea>
          <div class="form-text">
            The addresses this page had on your previous website, one per line. Paste the whole
            address or only the part after the domain name. Visitors, bookmarks and search results
            that still use one are sent to this page.
          </div>
        </details>
      </div>
      <div class="col-12 d-flex flex-wrap gap-4">
        <div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="showInNavigation" value="true" checked="@sitePage.ShowInNavigation" /><label class="form-check-label fw-semibold">Show in navigation</label></div>
        <div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="isPublished" value="true" checked="@sitePage.IsPublished" /><label class="form-check-label fw-semibold">Published</label></div>
        <div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="isHomePage" value="true" checked="@sitePage.IsHomePage" /><label class="form-check-label fw-semibold">Use as home page</label></div>
      </div>
    </div>
  </div>
  <div class="card-footer bg-white border-0 px-4 pb-4"><button class="btn btn-primary"><i class="fas fa-save me-1"></i>Save Page Settings</button></div>
</form>

@if (!isNew)
{
  <form id="applyImageToBlockForm" method="post" action='@Url.Action("ApplyImageToBlock", "WebsitePages")' class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="pageId" value="@sitePage.Id" />
    <input type="hidden" name="blockId" value="" />
    <input type="hidden" name="imageUrl" value="" />
  </form>
  <section class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
      <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
        <div><h4 class="fw-bold mb-1"><i class="fas fa-images me-2 text-primary"></i>Image Library</h4><div class="text-muted small">Upload an image once, then select it in a Hero or Text block on this page. Blog and Article blocks use each article's own cover image (set under <a href="/portal/Articles">Articles</a>) &mdash; this library does not affect them.</div></div>
        <form method="post" action="/portal/WebsitePages/UploadImage" enctype="multipart/form-data" class="d-flex flex-wrap align-items-end gap-2">
          @Html.AntiForgeryToken()
          <input type="hidden" name="pageId" value="@sitePage.Id" />
          <div><label class="form-label small fw-semibold mb-1">JPG, PNG, GIF, or WebP (maximum 8 MB)</label><input type="file" name="image" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp,image/jpeg,image/png,image/gif,image/webp" required /></div>
          <button class="btn btn-primary"><i class="fas fa-upload me-1"></i>Upload Image</button>
        </form>
      </div>
      @{
        // Only Hero and Text blocks actually render a block's ImageUrl on the public site --
        // every other block type (Contact Form, Testimonials, Reviews, etc.) ignores it, so
        // offering them here would silently save an image that never appears anywhere.
        var imageDestinationBlocks = sitePage.Blocks
            .Where(b => b.BlockType == IPRO.Entities.WebsiteBlockTypes.Hero || b.BlockType == IPRO.Entities.WebsiteBlockTypes.Text)
            .OrderByDescending(b => b.BlockType == IPRO.Entities.WebsiteBlockTypes.Hero)
            .ThenBy(b => b.SortOrder)
            .ToList();
      }
      @if (imageDestinationBlocks.Any())
      {
        <div class="image-library-toolbar mb-3">
          <div>
            <label for="uploadedImageTarget" class="form-label small fw-semibold mb-1">Apply uploaded image to</label>
            <select id="uploadedImageTarget" class="form-select form-select-sm">
              @foreach (var targetBlock in imageDestinationBlocks)
              {
                <option value="@targetBlock.Id">@IPRO.Entities.WebsiteBlockTypes.DisplayName(targetBlock.BlockType) - @(string.IsNullOrWhiteSpace(targetBlock.Heading) ? "Untitled block" : targetBlock.Heading)</option>
              }
            </select>
          </div>
          <div id="uploadedImageStatus" class="small text-muted" role="status">Choose a destination, then click <strong>Use this image</strong>. It saves to that block immediately.</div>
        </div>
      }
      else
      {
        <div class="small text-muted mb-3"><strong>Nothing on this page uses library images yet</strong> &mdash; add a Hero or Text block to apply one. Images shown by a Blog or Article block come from the article itself, not from here.</div>
      }
      @if (Model.MediaAssets.Any())
      {
        <div class="row g-3">
          @foreach (var asset in Model.MediaAssets)
          {
            @* 449: a picker, not a gallery -- six across on a desktop, 4:3 thumbnails, actions in one row. *@
            <div class="col-4 col-md-3 col-lg-2">
              <div class="border rounded p-2 h-100 d-flex flex-column">
                <img src="@asset.BlobUrl" alt="" class="w-100 rounded mb-1" style="aspect-ratio:4/3;object-fit:cover" />
                <div class="small text-truncate mb-1" title="@asset.OriginalFileName">@asset.OriginalFileName</div>
                <div class="d-flex gap-1 mt-auto">
                  @if (imageDestinationBlocks.Any())
                  {
                    <button type="button" class="btn btn-sm btn-outline-primary flex-fill uploaded-image-choice" data-image-url="@asset.BlobUrl" data-image-name="@asset.OriginalFileName" title="Use this image"><i class="fas fa-check me-1"></i>Use</button>
                  }
                  <form method="post" action="/portal/WebsitePages/DeleteImage/@asset.Id" class="d-inline">
                    @Html.AntiForgeryToken()<input type="hidden" name="pageId" value="@sitePage.Id" /><button class="js-confirm-submit btn btn-sm btn-outline-danger" data-confirm-message="Remove this image from the library and any content blocks using it?" title="Remove from library"><i class="fas fa-trash"></i><span class="visually-hidden">Remove</span></button>
                  </form>
                </div>
              </div>
            </div>
          }
        </div>
      }
      else
      {
        <div class="border rounded p-4 text-center text-muted"><i class="fas fa-image me-2"></i>No website images uploaded yet.</div>
      }
      <details class="starter-banner-library mt-4">
        <summary><i class="fas fa-wand-magic-sparkles me-2 text-primary"></i><strong>Browse shared starter banners</strong><span class="text-muted ms-2">@Model.StarterBanners.Count reusable images</span></summary>
        @if (imageDestinationBlocks.Any())
        {
          <div class="starter-banner-toolbar mt-3">
            <div>
              <label for="starterBannerTarget" class="form-label small fw-semibold mb-1">Apply selected banner to</label>
              <select id="starterBannerTarget" class="form-select form-select-sm">
                @foreach (var targetBlock in imageDestinationBlocks)
                {
                  <option value="@targetBlock.Id">@IPRO.Entities.WebsiteBlockTypes.DisplayName(targetBlock.BlockType) - @(string.IsNullOrWhiteSpace(targetBlock.Heading) ? "Untitled block" : targetBlock.Heading)</option>
                }
              </select>
            </div>
            <div id="starterBannerStatus" class="small text-muted" role="status">Choose a destination, then click a banner below. It saves to that block immediately.</div>
          </div>
        }
        else
        {
          <div class="alert alert-info mt-3 mb-0">Add a Hero or Text block to this page first, then you can apply a starter banner to it.</div>
        }
        <div class="starter-banner-grid mt-3">
          @foreach (var banner in Model.StarterBanners)
          {
            <button type="button" class="starter-banner-choice" data-banner-url="@banner.Url" data-banner-name="@banner.Name" disabled="@(!imageDestinationBlocks.Any())">
              <img src="@banner.Url" alt="@banner.Name" loading="lazy" />
              <span class="starter-banner-caption"><strong>@banner.Name</strong><span>@banner.Category</span></span>
              <span class="starter-banner-use"><i class="fas fa-check me-1"></i>Use this banner</span>
            </button>
          }
        </div>
      </details>
    </div>
  </section>

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div><h4 class="fw-bold mb-1">Content Blocks</h4><div class="text-muted small">Blocks appear from top to bottom in this order.</div></div>
    <form method="post" action="/portal/WebsitePages/AddBlock" class="d-flex gap-2">
      @Html.AntiForgeryToken()<input type="hidden" name="pageId" value="@sitePage.Id" />
      <select name="blockType" class="form-select">
        @foreach (var type in Model.BlockTypes){<option value="@type">@IPRO.Entities.WebsiteBlockTypes.DisplayName(type)</option>}
      </select>
      <button class="btn btn-primary text-nowrap"><i class="fas fa-plus me-1"></i>Add Block</button>
    </form>
  </div>

  @foreach (var block in sitePage.Blocks.OrderBy(b => b.SortOrder))
  {
    var heroSettings = IPRO.Entities.WebsiteHeroSettings.FromJson(block.SettingsJson);
    <section class="card border-0 shadow-sm mb-3">
      <div class="card-header bg-white d-flex justify-content-between align-items-center gap-3 py-3">
        <div><span class="badge bg-primary-subtle text-primary me-2">@IPRO.Entities.WebsiteBlockTypes.DisplayName(block.BlockType)</span><span class="fw-bold">@(string.IsNullOrWhiteSpace(block.Heading) ? "Untitled block" : block.Heading)</span></div>
        <div class="d-flex gap-1">
          <a href="/portal/SocialPosts/Create?topic=@Uri.EscapeDataString(block.Heading ?? "")&seedBody=@Uri.EscapeDataString(StripHtml(block.Body))" class="btn btn-sm btn-outline-secondary" title="Share to Social"><i class="fas fa-share-nodes"></i></a>
          <form method="post" action="/portal/WebsitePages/MoveBlock/@block.Id"><input type="hidden" name="direction" value="up" />@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-secondary" title="Move up"><i class="fas fa-arrow-up"></i></button></form>
          <form method="post" action="/portal/WebsitePages/MoveBlock/@block.Id"><input type="hidden" name="direction" value="down" />@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-secondary" title="Move down"><i class="fas fa-arrow-down"></i></button></form>
          <form method="post" action="/portal/WebsitePages/DeleteBlock/@block.Id">@Html.AntiForgeryToken()<button class="js-confirm-submit btn btn-sm btn-outline-danger" title="Remove" data-confirm-message="Remove this content block?"><i class="fas fa-trash"></i></button></form>
        </div>
      </div>
      <form method="post" action="/portal/WebsitePages/UpdateBlock" class="card-body p-4">
        @Html.AntiForgeryToken()<input type="hidden" name="id" value="@block.Id" />
        <div class="row g-3">
          <div class="col-md-6"><label class="form-label fw-semibold">Heading</label><input name="heading" value="@block.Heading" class="form-control" /></div>
          <div class="col-md-6"><label class="form-label fw-semibold">Supporting Line</label><input name="subheading" value="@block.Subheading" class="form-control" /></div>
          <div class="col-12"><label class="form-label fw-semibold">@(block.BlockType is IPRO.Entities.WebsiteBlockTypes.Services ? "Items (one per line)" : block.BlockType is IPRO.Entities.WebsiteBlockTypes.PriceList ? "Introduction (optional)" : "Body")</label><textarea name="body" class="form-control" rows="@(block.BlockType is IPRO.Entities.WebsiteBlockTypes.PriceList ? 2 : 4)">@block.Body</textarea></div>
          @if (block.BlockType is IPRO.Entities.WebsiteBlockTypes.Hero or IPRO.Entities.WebsiteBlockTypes.Text)
          {
          <div class="col-md-6">
            <label class="form-label fw-semibold">Image <span class="text-muted fw-normal">(optional)</span></label>
            <select name="imageUrl" class="form-select" data-block-id="@block.Id">
              <option value="" selected="@(string.IsNullOrWhiteSpace(block.ImageUrl) ? "selected" : null)">No image</option>
              @if (!string.IsNullOrWhiteSpace(block.ImageUrl) && !Model.MediaAssets.Any(a => SameImageUrl(a.BlobUrl, block.ImageUrl)) && !Model.StarterBanners.Any(a => SameImageUrl(a.Url, block.ImageUrl)))
              {
                <option value="@block.ImageUrl" selected>Current external image</option>
              }
              @foreach (var category in Model.StarterBanners.GroupBy(b => b.Category))
              {
                <optgroup label="Starter: @category.Key">
                  @foreach (var banner in category)
                  {
                    <option value="@banner.Url" selected="@(SameImageUrl(banner.Url, block.ImageUrl) ? "selected" : null)">@banner.Name</option>
                  }
                </optgroup>
              }
              @if (Model.MediaAssets.Any())
              {
                <optgroup label="My uploaded images">
                  @foreach (var asset in Model.MediaAssets)
                  {
                    <option value="@asset.BlobUrl" selected="@(SameImageUrl(asset.BlobUrl, block.ImageUrl) ? "selected" : null)">@asset.OriginalFileName</option>
                  }
                </optgroup>
              }
            </select>
            <img src="@block.ImageUrl" alt="" class="rounded mt-2 block-image-preview @(string.IsNullOrWhiteSpace(block.ImageUrl) ? "d-none" : "")" style="width:180px;height:74px;object-fit:cover" />
          </div>
          }
          @if (block.BlockType is IPRO.Entities.WebsiteBlockTypes.Hero or IPRO.Entities.WebsiteBlockTypes.CallToAction or IPRO.Entities.WebsiteBlockTypes.Reviews or IPRO.Entities.WebsiteBlockTypes.Text or IPRO.Entities.WebsiteBlockTypes.PriceList)
          {
          <div class="col-md-3"><label class="form-label fw-semibold">Button Text</label><input name="buttonText" value="@block.ButtonText" class="form-control" placeholder="@(block.BlockType == IPRO.Entities.WebsiteBlockTypes.PriceList ? "Call to order" : null)" /></div>
          <div class="col-md-3"><label class="form-label fw-semibold">Button Link</label><input name="buttonUrl" value="@block.ButtonUrl" class="form-control" placeholder="@(block.BlockType == IPRO.Entities.WebsiteBlockTypes.PriceList ? "tel:4165551234" : "/contact")" />@if (block.BlockType == IPRO.Entities.WebsiteBlockTypes.PriceList){<div class="form-text">A page (/contact), a web address, tel: and a number to call, or mailto: and an email address.</div>}</div>
          }
          @if (block.BlockType is IPRO.Entities.WebsiteBlockTypes.Services or IPRO.Entities.WebsiteBlockTypes.CallToAction or IPRO.Entities.WebsiteBlockTypes.Text or IPRO.Entities.WebsiteBlockTypes.Reviews or IPRO.Entities.WebsiteBlockTypes.TestimonialForm or IPRO.Entities.WebsiteBlockTypes.Maps or IPRO.Entities.WebsiteBlockTypes.Gallery or IPRO.Entities.WebsiteBlockTypes.SocialLinks or IPRO.Entities.WebsiteBlockTypes.PriceList)
          {
            <div class="col-md-4">
              <label class="form-label fw-semibold">Layout</label>
              <select name="layoutVariant" class="form-select">
                <option value="" selected="@(string.IsNullOrEmpty(block.LayoutVariant) ? "selected" : null)">Match template default</option>
                @if (block.BlockType == IPRO.Entities.WebsiteBlockTypes.Services)
                {
                  <option value="cards" selected="@(block.LayoutVariant == "cards" ? "selected" : null)">Cards</option>
                  <option value="list" selected="@(block.LayoutVariant == "list" ? "selected" : null)">List</option>
                  <option value="icons" selected="@(block.LayoutVariant == "icons" ? "selected" : null)">Icons</option>
                }
                else if (block.BlockType == IPRO.Entities.WebsiteBlockTypes.CallToAction)
                {
                  <option value="banner" selected="@(block.LayoutVariant == "banner" ? "selected" : null)">Banner</option>
                  <option value="card" selected="@(block.LayoutVariant == "card" ? "selected" : null)">Card</option>
                  <option value="split" selected="@(block.LayoutVariant == "split" ? "selected" : null)">Split</option>
                }
                else if (block.BlockType == IPRO.Entities.WebsiteBlockTypes.Text)
                {
                  <option value="image-left" selected="@(block.LayoutVariant == "image-left" ? "selected" : null)">Image on the left</option>
                  <option value="image-right" selected="@(block.LayoutVariant == "image-right" ? "selected" : null)">Image on the right</option>
                }
                else if (block.BlockType == IPRO.Entities.WebsiteBlockTypes.Reviews)
                {
                  <option value="badge" selected="@(block.LayoutVariant == "badge" ? "selected" : null)">Badge (centered card)</option>
                  <option value="banner" selected="@(block.LayoutVariant == "banner" ? "selected" : null)">Banner (full-width, colored)</option>
                }
                else if (block.BlockType == IPRO.Entities.WebsiteBlockTypes.SocialLinks)
                {
                  <option value="icons" selected="@(block.LayoutVariant == "icons" || string.IsNullOrEmpty(block.LayoutVariant) ? "selected" : null)">Icons only</option>
                  <option value="labels" selected="@(block.LayoutVariant == "labels" ? "selected" : null)">Icons with names</option>
                }
                else if (block.BlockType == IPRO.Entities.WebsiteBlockTypes.TestimonialForm)
                {
                  <option value="list" selected="@(block.LayoutVariant == "list" ? "selected" : null)">List</option>
                  <option value="grid" selected="@(block.LayoutVariant == "grid" ? "selected" : null)">Grid</option>
                }
                else if (block.BlockType == IPRO.Entities.WebsiteBlockTypes.Maps)
                {
                  <option value="full" selected="@(block.LayoutVariant == "full" ? "selected" : null)">Full width</option>
                  <option value="narrow" selected="@(block.LayoutVariant == "narrow" ? "selected" : null)">Narrow (centered)</option>
                }
                else if (block.BlockType == IPRO.Entities.WebsiteBlockTypes.Gallery)
                {
                  <option value="grid" selected="@(block.LayoutVariant == "grid" ? "selected" : null)">Grid</option>
                  <option value="carousel" selected="@(block.LayoutVariant == "carousel" ? "selected" : null)">Carousel (scrolling row)</option>
                  <option value="masonry" selected="@(block.LayoutVariant == "masonry" ? "selected" : null)">Masonry (each photo keeps its shape)</option>
                  <option value="slideshow" selected="@(block.LayoutVariant == "slideshow" ? "selected" : null)">Slideshow (one large photo at a time)</option>
                }
                else if (block.BlockType == IPRO.Entities.WebsiteBlockTypes.PriceList)
                {
                  <option value="list" selected="@(block.LayoutVariant == "list" ? "selected" : null)">List (name, dotted line, price)</option>
                  <option value="cards" selected="@(block.LayoutVariant == "cards" ? "selected" : null)">Cards (a photo for each item)</option>
                  <option value="compact" selected="@(block.LayoutVariant == "compact" ? "selected" : null)">Compact (two columns, for long lists)</option>
                }
              </select>
              <div class="form-text">Changes how this block's items are arranged. Leave as default to match your template's usual style.@(block.BlockType == IPRO.Entities.WebsiteBlockTypes.Text ? " Only affects blocks with an image selected." : "")@(block.BlockType == IPRO.Entities.WebsiteBlockTypes.TestimonialForm ? " Only affects approved testimonials shown below the form." : "")</div>
            </div>
          }
          @if (block.BlockType == IPRO.Entities.WebsiteBlockTypes.Hero)
          {
            <div class="col-12"><div class="banner-controls"><div class="d-flex align-items-center gap-2 mb-3"><i class="fas fa-panorama text-primary"></i><strong>Banner Presentation</strong><span class="small text-muted">Changes layout only; your content stays intact.</span></div><div class="row g-3">
