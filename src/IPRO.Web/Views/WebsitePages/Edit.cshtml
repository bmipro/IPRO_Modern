                <select name="articleId" class="form-select">
                  <option value="0">Choose an article...</option>
                  @foreach (var article in Model.AvailableArticles)
                  {
                    <option value="@article.Id" selected="@(articleContentSettings.ArticleId == article.Id ? "selected" : null)">@article.Title (@(article.IsPublished ? "Published" : "Draft"))</option>
