              <label class="form-label fw-semibold">Map Height</label>
              <select name="mapHeight" class="form-select">
                <option value="compact" selected="@(mapSettings.Height == "compact" ? "selected" : null)">Compact</option>
                <option value="standard" selected="@(mapSettings.Height == "standard" ? "selected" : null)">Standard</option>
                <option value="tall" selected="@(mapSettings.Height == "tall" ? "selected" : null)">Tall</option>
              </select>
            </div>
