              <label class="form-label fw-semibold">What it lists</label>
              <select name="priceListKind" class="form-select">
                <option value="prices" selected="@(priceList.Kind != IPRO.Entities.PriceListKinds.Menu ? "selected" : null)">Products or services</option>
                <option value="menu" selected="@(priceList.Kind == IPRO.Entities.PriceListKinds.Menu ? "selected" : null)">Food and drink (a menu)</option>
              </select>
              <div class="form-text">Tells search engines what kind of list this is. It does not change how the list looks.</div>
            </div>
            <div class="col-12">
              @* 549: the list. The script below draws the sections and items from priceListJson and writes them
                 back into it as you type, so Save and Preview post exactly what you see. *@
              <div class="price-list-editor" data-price-list data-images="@System.Text.Json.JsonSerializer.Serialize(priceListImages)">
                <input type="hidden" name="priceListJson" value="@priceList.ToJson()" />
                <div class="pl-sections"></div>
                <button type="button" class="btn btn-sm btn-outline-primary" data-pl-add-section><i class="fas fa-plus me-1"></i>Add a section</button>
                <div class="form-text mt-2">Write prices the way you say them: "$4.25", "$3.50 / $3.75 / $4.10", "$12 a dozen", "from $150". An item without a price shows without one. Photos come from your uploaded images (Images, above). Untick "Available" to show an item as not available right now instead of removing it.</div>
              </div>
            </div>
          }
          @if (block.BlockType == IPRO.Entities.WebsiteBlockTypes.Maps)
          {
            var mapSettings = IPRO.Entities.WebsiteMapSettings.FromJson(block.SettingsJson);
