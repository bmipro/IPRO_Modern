              <div class="form-text">Your newest published articles appear automatically &mdash; write them under <a href="/portal/Articles">Articles</a>. Visitors click a post to read it in full on this page. Post images come from each article's own cover image (set when editing the article) &mdash; the page Image Library above does not affect this block.</div>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Cover images</label>
              <select name="blogShowImages" class="form-select">
                <option value="true" selected="@(blogSettings.ShowImages ? "selected" : null)">Show images in the list</option>
                <option value="false" selected="@(!blogSettings.ShowImages ? "selected" : null)">Titles and summaries only</option>
              </select>
            </div>
          }
          @if (block.BlockType == IPRO.Entities.WebsiteBlockTypes.ArticleContent)
