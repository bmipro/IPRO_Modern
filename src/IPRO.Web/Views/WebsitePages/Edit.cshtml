              <div class="form-check form-check-inline"><input class="form-check-input" type="checkbox" id="showAgentPhoto_@block.Id" name="showAgentPhoto" value="true" checked="@agentInfoSettings.ShowPhoto" /><label class="form-check-label" for="showAgentPhoto_@block.Id">Photo</label></div><input type="hidden" name="showAgentPhoto" value="false" />
              <div class="form-check form-check-inline"><input class="form-check-input" type="checkbox" id="showAgentDesignation_@block.Id" name="showAgentDesignation" value="true" checked="@agentInfoSettings.ShowDesignation" /><label class="form-check-label" for="showAgentDesignation_@block.Id">Designation / Company</label></div><input type="hidden" name="showAgentDesignation" value="false" />
              <div class="form-check form-check-inline"><input class="form-check-input" type="checkbox" id="showAgentAddress_@block.Id" name="showAgentAddress" value="true" checked="@agentInfoSettings.ShowAddress" /><label class="form-check-label" for="showAgentAddress_@block.Id">Full Address</label></div><input type="hidden" name="showAgentAddress" value="false" />
              <div class="form-check form-check-inline"><input class="form-check-input" type="checkbox" id="showAgentPhone_@block.Id" name="showAgentPhone" value="true" checked="@agentInfoSettings.ShowPhone" /><label class="form-check-label" for="showAgentPhone_@block.Id">Phone</label></div><input type="hidden" name="showAgentPhone" value="false" />
              <div class="form-check form-check-inline"><input class="form-check-input" type="checkbox" id="showAgentEmail_@block.Id" name="showAgentEmail" value="true" checked="@agentInfoSettings.ShowEmail" /><label class="form-check-label" for="showAgentEmail_@block.Id">Email</label></div><input type="hidden" name="showAgentEmail" value="false" />
              <div class="form-text">Pulled from your Profile — update your photo, address, or phone there. Heading/subheading/body above are optional supporting text for this card.</div>
              <div class="form-text"><i class="fas fa-clock me-1"></i>Your opening hours show on this card when you have set them. Enter them, or switch them off here, under <a href="/portal/Website#hours">My Website &gt; Business hours</a>.</div>
            </div>
