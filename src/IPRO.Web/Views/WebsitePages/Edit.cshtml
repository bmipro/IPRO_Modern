              <div class="form-text">Paste any YouTube video, watch, or share link. @(string.IsNullOrWhiteSpace(videoSettings.BuildEmbedUrl()) && !string.IsNullOrWhiteSpace(videoSettings.VideoUrl) ? "That link doesn't look like a valid YouTube video -- nothing will show on your site until it's fixed." : "")</div>
            </div>
