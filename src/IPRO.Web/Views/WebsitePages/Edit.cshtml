          <div class="col-12 d-flex justify-content-between align-items-center"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="isVisible" value="true" checked="@block.IsVisible" /><label class="form-check-label">Visible</label></div><div class="d-flex gap-2"><button type="submit" formaction="/portal/WebsitePages/PreviewUnsaved" formtarget="_blank" class="btn btn-primary"><i class="fas fa-eye me-1"></i>Preview without Saving</button><button type="submit" class="btn btn-outline-primary"><i class="fas fa-save me-1"></i>Save Block</button></div></div>
        </div>
      </form>
      @if (block.BlockType == IPRO.Entities.WebsiteBlockTypes.Gallery)
      {
        var gallerySettings = IPRO.Entities.WebsiteGallerySettings.FromJson(block.SettingsJson);
        var storageAccess = ViewBag.StorageAccess as IPRO.Business.Interfaces.PackageFeatureAccess;
        var storageUsedMb = (double)(ViewBag.StorageUsedMb ?? 0.0);
        var storageLimitMb = IPRO.Web.Infrastructure.AgentStorageUsage.DisplayLimitMb(storageAccess?.LimitValue);   @* M10 *@
        var storageUsedPct = storageLimitMb > 0 ? Math.Min(100.0, storageUsedMb / storageLimitMb * 100.0) : 0;
        var storageBarClass = storageUsedPct >= 90 ? "bg-danger" : storageUsedPct >= 70 ? "bg-warning" : "bg-primary";
        <div class="px-4 pb-4">
          <div class="border rounded-3 p-3 mb-3" style="background:#f7faff">
            <div class="d-flex justify-content-between align-items-center small mb-1">
              <span class="fw-semibold">Storage used (shared with your Documents)</span>
              <span class="text-muted">@storageUsedMb MB of @storageLimitMb MB</span>
            </div>
            <div class="progress" style="height:8px"><div class="progress-bar @storageBarClass" style="width:@storageUsedPct.ToString("0.0")%"></div></div>
          </div>
          @if (gallerySettings.Images.Any())
          {
            var captionFormId = $"gallery-captions-{block.Id}";
            var photoCount = gallerySettings.Images.Count;
            @* 535: one form holds every caption (its inputs sit in the cards through form=""), so the arrow
               and Remove forms beside them are never nested inside it. *@
            <form method="post" action="/portal/WebsitePages/SaveGalleryCaptions" id="@captionFormId">
              @Html.AntiForgeryToken()
              <input type="hidden" name="blockId" value="@block.Id" />
            </form>
            <div class="row g-3 mb-2">
              @for (var photoIndex = 0; photoIndex < photoCount; photoIndex++)
              {
                var galleryImage = gallerySettings.Images[photoIndex];
                <div class="col-6 col-md-4 col-xl-3">
                  <div class="border rounded p-2 h-100 d-flex flex-column gap-2">
                    <img src="@galleryImage.TileUrl" alt="" class="w-100 rounded" style="aspect-ratio:4/3;object-fit:cover" />
                    <input type="hidden" name="urls" value="@galleryImage.Url" form="@captionFormId" />
                    <input type="text" name="captions" value="@galleryImage.Caption" maxlength="@IPRO.Entities.WebsiteGalleryImage.CaptionMaxLength" class="form-control form-control-sm" placeholder="Caption (optional)" aria-label="Caption for photo @(photoIndex + 1)" form="@captionFormId" />
                    <div class="d-flex gap-1 mt-auto">
                      <form method="post" action="/portal/WebsitePages/MoveGalleryImage">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="blockId" value="@block.Id" />
                        <input type="hidden" name="url" value="@galleryImage.Url" />
                        <input type="hidden" name="direction" value="-1" />
                        <button class="btn btn-sm btn-outline-secondary" title="Move earlier" aria-label="Move photo @(photoIndex + 1) earlier" disabled="@(photoIndex == 0 ? "disabled" : null)"><i class="fas fa-arrow-left"></i></button>
                      </form>
                      <form method="post" action="/portal/WebsitePages/MoveGalleryImage">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="blockId" value="@block.Id" />
                        <input type="hidden" name="url" value="@galleryImage.Url" />
                        <input type="hidden" name="direction" value="1" />
                        <button class="btn btn-sm btn-outline-secondary" title="Move later" aria-label="Move photo @(photoIndex + 1) later" disabled="@(photoIndex == photoCount - 1 ? "disabled" : null)"><i class="fas fa-arrow-right"></i></button>
                      </form>
                      <form method="post" action="/portal/WebsitePages/DeleteGalleryImage" class="flex-fill">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="blockId" value="@block.Id" />
                        <input type="hidden" name="url" value="@galleryImage.Url" />
                        <button class="js-confirm-submit btn btn-sm btn-outline-danger w-100" data-confirm-message="Remove this photo from the gallery?"><i class="fas fa-trash me-1"></i>Remove</button>
                      </form>
                    </div>
                  </div>
                </div>
              }
            </div>
            <button type="submit" form="@captionFormId" class="btn btn-sm btn-outline-primary mb-3"><i class="fas fa-save me-1"></i>Save captions</button>
          }
          else
          {
            <div class="border rounded p-4 text-center text-muted mb-3"><i class="fas fa-images me-2"></i>No photos in this gallery yet.</div>
          }
          <form method="post" action="/portal/WebsitePages/UploadGalleryImages" enctype="multipart/form-data" class="d-flex flex-wrap align-items-end gap-2 js-gallery-upload">
            @Html.AntiForgeryToken()
            <input type="hidden" name="blockId" value="@block.Id" />
            <div><label class="form-label small fw-semibold mb-1">Add photos: up to @IPRO.Web.Controllers.WebsitePagesController.GalleryBatchMax at a time (JPG, PNG, GIF, or WebP, 15 MB each)</label><input type="file" name="images" multiple class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp,image/jpeg,image/png,image/gif,image/webp" required /></div>
            <button class="btn btn-primary"><i class="fas fa-upload me-1"></i>Add Photos</button>
          </form>
          <div class="form-text">Each photo is resized for the web (1600 pixels on its long side, with a smaller copy for the grid), and its camera details, location included, are removed. The original file is not kept.</div>
        </div>
      }
    </section>
  }
}
