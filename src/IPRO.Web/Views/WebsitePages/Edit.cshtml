<script nonce="@Context.GetCspNonce()">
document.querySelectorAll('select[name="imageUrl"]').forEach(select => {
  select.addEventListener('change', () => {
    const preview = select.parentElement.querySelector('.block-image-preview');
    if (!preview) return;
    preview.src = select.value;
    preview.classList.toggle('d-none', !select.value);
  });
});

function setStatusLabelMessage(status, label, suffix) {
  // label comes from an uploaded file's name (button.dataset.imageName/bannerName) - never trust it
  // as HTML. Building the <strong> via DOM APIs and .textContent keeps it as plain text no matter
  // what characters the filename contains, instead of parsing it as markup via innerHTML.
  if (!status) return;
  status.textContent = '';
  const strong = document.createElement('strong');
  strong.textContent = label;
  status.append(strong, ` ${suffix}`);
}

function chooseBlockImage(select, url, label) {
  if (!select) return false;

  const normalized = (url || '').trim();
  if (normalized && !Array.from(select.options).some(option => option.value === normalized)) {
    select.add(new Option(label || 'Selected image', normalized, true, true));
  }

  Array.from(select.options).forEach(option => {
    option.selected = option.value === normalized;
  });
  select.value = normalized;
  select.dispatchEvent(new Event('change', { bubbles: true }));
  return true;
}

async function submitBlockImage(targetPickerId, imageUrl, button) {
  const targetPicker = document.getElementById(targetPickerId);
  const form = document.getElementById('applyImageToBlockForm');
  const status = document.getElementById(targetPickerId === 'starterBannerTarget' ? 'starterBannerStatus' : 'uploadedImageStatus');
  if (!targetPicker || !form) return false;

  if (!targetPicker.value) {
    alert('Choose a destination block first.');
    return false;
  }

  const selectedImageUrl = (imageUrl || '').trim();
  if (!selectedImageUrl) {
    alert('Choose an image first.');
    return false;
  }

  const imageSelect = document.querySelector(`select[name="imageUrl"][data-block-id="${targetPicker.value}"]`);
  const label = button?.dataset.bannerName || button?.dataset.imageName || 'Selected image';
  const previousValue = imageSelect ? imageSelect.value : '';
  chooseBlockImage(imageSelect, selectedImageUrl, label);

  const pageId = form.querySelector('input[name="pageId"]')?.value || '';
  const blockId = targetPicker.value;
  const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
  const body = new URLSearchParams();
  body.set('pageId', pageId);
  body.set('blockId', blockId);
  body.set('imageUrl', selectedImageUrl);
  body.set('__RequestVerificationToken', token);

  const originalHtml = button?.innerHTML || '';
  if (button) {
    button.disabled = true;
    button.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Saving...';
  }

  try {
    const response = await fetch(form.action, {
      method: 'POST',
      body,
      credentials: 'same-origin',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
        'RequestVerificationToken': token
      }
    });

    if (response.ok) {
      setStatusLabelMessage(status, label, 'saved to this block.');
      if (button) {
        button.disabled = false;
        button.innerHTML = originalHtml;
      }
      return true;
    }
  } catch (error) {
    console.error('Image apply failed', error);
  }

  // The save failed: roll back the optimistic selection so the UI matches what's actually persisted.
  chooseBlockImage(imageSelect, previousValue, 'Previous image');
  if (status) {
    status.textContent = 'The image could not be saved. Refresh this page and try again.';
  }
  if (button) {
    button.disabled = false;
    button.innerHTML = originalHtml;
  }
  return false;
}

document.querySelectorAll('.starter-banner-choice').forEach(button => {
  button.addEventListener('click', event => {
    event.preventDefault();
    event.stopPropagation();
    const targetPicker = document.getElementById('starterBannerTarget');
    const status = document.getElementById('starterBannerStatus');
    if (!targetPicker) return;

    const imageSelect = document.querySelector(`select[name="imageUrl"][data-block-id="${targetPicker.value}"]`);
    if (!imageSelect) {
      if (status) status.textContent = 'That destination block could not be found. Refresh this page and try again.';
      return;
    }

    chooseBlockImage(imageSelect, button.dataset.bannerUrl || '', button.dataset.bannerName || 'Selected starter banner');
    document.querySelectorAll('.starter-banner-choice').forEach(choice => choice.classList.remove('is-selected'));
    button.classList.add('is-selected');

    setStatusLabelMessage(status, button.dataset.bannerName, 'is being saved to the selected block.');
    void submitBlockImage('starterBannerTarget', button.dataset.bannerUrl || '', button);
  });
});

document.querySelectorAll('.uploaded-image-choice').forEach(button => {
  button.addEventListener('click', event => {
    event.preventDefault();
    event.stopPropagation();
    const targetPicker = document.getElementById('uploadedImageTarget');
    const status = document.getElementById('uploadedImageStatus');
    if (!targetPicker) return;

    const imageSelect = document.querySelector(`select[name="imageUrl"][data-block-id="${targetPicker.value}"]`);
    if (!imageSelect) {
      if (status) status.textContent = 'That destination block could not be found. Refresh this page and try again.';
      return;
    }

    chooseBlockImage(imageSelect, button.dataset.imageUrl || '', button.dataset.imageName || 'Selected image');
    document.querySelectorAll('.uploaded-image-choice').forEach(choice => {
      choice.classList.remove('btn-primary');
      choice.classList.add('btn-outline-primary');
    });
    button.classList.remove('btn-outline-primary');
    button.classList.add('btn-primary');

    setStatusLabelMessage(status, button.dataset.imageName, 'is being saved to the selected block.');
    void submitBlockImage('uploadedImageTarget', button.dataset.imageUrl || '', button);
  });
});

// 535: the server takes at most @IPRO.Web.Controllers.WebsitePagesController.GalleryBatchMax photos and 100 MB in one upload; say so
// before a long upload is refused at the end of it.
document.querySelectorAll('form.js-gallery-upload').forEach(form => {
  form.addEventListener('submit', event => {
    const input = form.querySelector('input[type="file"]');
    const files = input && input.files ? Array.from(input.files) : [];
    const total = files.reduce((sum, file) => sum + file.size, 0);
    if (total > @IPRO.Web.Controllers.WebsitePagesController.GalleryBatchMaxBytes) {
      event.preventDefault();
      alert('These photos add up to more than 100 MB. Add them in smaller groups.');
      return;
    }
    const button = form.querySelector('button');
    if (button) {
      button.disabled = true;
      button.textContent = files.length > 1 ? `Uploading ${files.length} photos...` : 'Uploading...';
    }
  });
});

// 549: the price list editor. The list lives in the hidden priceListJson field; its sections and items
// are drawn from it on load and written back into it on every change, so Save and Preview post exactly
// what the agent sees. Text goes in through .value and textContent only, never as HTML.
document.querySelectorAll('[data-price-list]').forEach(root => {
  const field = root.querySelector('input[name="priceListJson"]');
  const holder = root.querySelector('.pl-sections');
  let images = [];
  try { images = JSON.parse(root.dataset.images || '[]'); } catch (e) { images = []; }
  let data = {};
  try { data = JSON.parse(field.value || '{}'); } catch (e) { data = {}; }

  const make = (tag, className) => { const el = document.createElement(tag); if (className) el.className = className; return el; };
  const cell = (className, ...children) => { const div = make('div', className); div.append(...children); return div; };

  function textInput(name, value, label, placeholder, maxLength) {
    const input = make('input', 'form-control form-control-sm');
    input.dataset.plField = name;
    input.value = value || '';
    input.placeholder = placeholder;
    input.maxLength = maxLength;
    input.setAttribute('aria-label', label);
    return input;
  }

  function photoSelect(current, label) {
    const select = make('select', 'form-select form-select-sm');
    select.dataset.plField = 'ImageUrl';
    select.setAttribute('aria-label', label);
    select.add(new Option('No photo', ''));
    images.forEach(image => select.add(new Option(image.name, image.url)));
    if (current && !images.some(image => image.url === current)) select.add(new Option('Current photo', current));
    select.value = current || '';
    return select;
  }

  function iconButton(icon, title, action) {
    const button = make('button', 'btn btn-sm btn-outline-secondary');
    button.type = 'button';
    button.title = title;
    button.setAttribute('aria-label', title);
    button.dataset.plAction = action;
    button.append(make('i', 'fas ' + icon));
    return button;
  }

  function itemRow(item) {
    item = item || {};
    const available = make('input', 'form-check-input m-0');
    available.type = 'checkbox';
    available.dataset.plField = 'Available';
    available.checked = item.Available !== false;
    const availableLabel = make('label', 'small d-inline-flex align-items-center gap-1 mb-0');
    availableLabel.append(available, document.createTextNode('Available'));
    const buttons = cell('btn-group', iconButton('fa-arrow-up', 'Move item up', 'item-up'), iconButton('fa-arrow-down', 'Move item down', 'item-down'), iconButton('fa-trash', 'Remove item', 'item-remove'));
    return cell('pl-edit-item row g-2 align-items-center',
      cell('col-md-4', textInput('Name', item.Name, 'Item name', 'Item name, e.g. Baguette', 120)),
      cell('col-md-2', textInput('Price', item.Price, 'Price', 'Price, e.g. $4.25', 60)),
      cell('col-md-2', textInput('Badge', item.Badge, 'Badge', 'Badge (optional)', 30)),
      cell('col-md-4', photoSelect(item.ImageUrl, 'Item photo')),
      cell('col-md-8', textInput('Description', item.Description, 'Description', 'A short description (optional)', 300)),
      cell('col-md-2', availableLabel),
      cell('col-md-2 text-md-end', buttons));
  }

  function sectionCard(section) {
    section = section || {};
    const head = cell('pl-edit-section-head',
      cell('small fw-semibold text-muted', document.createTextNode('Section')),
      cell('btn-group', iconButton('fa-arrow-up', 'Move section up', 'section-up'), iconButton('fa-arrow-down', 'Move section down', 'section-down'), iconButton('fa-trash', 'Remove section', 'section-remove')));
    const fields = cell('pl-edit-section-fields row g-2',
      cell('col-md-4', textInput('Title', section.Title, 'Section title', 'Section title, e.g. Breads', 100)),
      cell('col-md-5', textInput('Note', section.Note, 'Section note', 'A note under the section (optional)', 300)),
      cell('col-md-3', photoSelect(section.ImageUrl, 'Section photo')));
    const items = make('div', 'pl-edit-items');
    (Array.isArray(section.Items) ? section.Items : []).forEach(item => items.append(itemRow(item)));
    const addItem = make('button', 'btn btn-sm btn-link px-0 mt-2');
    addItem.type = 'button';
    addItem.dataset.plAction = 'add-item';
    addItem.append(make('i', 'fas fa-plus me-1'), document.createTextNode('Add an item'));
    return cell('pl-edit-section', head, fields, items, addItem);
  }

  function write() {
    const sections = [];
    holder.querySelectorAll(':scope > .pl-edit-section').forEach(card => {
      const fields = card.querySelector(':scope > .pl-edit-section-fields');
      const sectionValue = name => fields.querySelector('[data-pl-field="' + name + '"]').value;
      const items = [];
      card.querySelectorAll(':scope > .pl-edit-items > .pl-edit-item').forEach(row => {
        const itemValue = name => row.querySelector('[data-pl-field="' + name + '"]').value;
        items.push({
          Name: itemValue('Name'), Price: itemValue('Price'), Description: itemValue('Description'),
          Badge: itemValue('Badge'), ImageUrl: itemValue('ImageUrl'),
          Available: row.querySelector('[data-pl-field="Available"]').checked
        });
      });
      sections.push({ Title: sectionValue('Title'), Note: sectionValue('Note'), ImageUrl: sectionValue('ImageUrl'), Items: items });
    });
    field.value = JSON.stringify({ Kind: data.Kind || 'prices', Sections: sections });
  }

  (Array.isArray(data.Sections) ? data.Sections : []).forEach(section => holder.append(sectionCard(section)));

  root.addEventListener('click', event => {
    const button = event.target.closest('[data-pl-action], [data-pl-add-section]');
    if (!button || !root.contains(button)) return;
    if (button.hasAttribute('data-pl-add-section')) {
      const card = sectionCard({ Items: [{}] });
      holder.append(card);
      card.querySelector('[data-pl-field="Title"]').focus();
      write();
      return;
    }
    const action = button.dataset.plAction;
    const row = button.closest('.pl-edit-item');
    const card = button.closest('.pl-edit-section');
    if (action === 'add-item') {
      const added = itemRow({});
      card.querySelector('.pl-edit-items').append(added);
      added.querySelector('[data-pl-field="Name"]').focus();
    } else if (action === 'item-up' && row.previousElementSibling) {
      row.parentElement.insertBefore(row, row.previousElementSibling);
    } else if (action === 'item-down' && row.nextElementSibling) {
      row.parentElement.insertBefore(row.nextElementSibling, row);
    } else if (action === 'item-remove') {
      row.remove();
    } else if (action === 'section-up' && card.previousElementSibling) {
      holder.insertBefore(card, card.previousElementSibling);
    } else if (action === 'section-down' && card.nextElementSibling) {
      holder.insertBefore(card.nextElementSibling, card);
    } else if (action === 'section-remove' && confirm('Remove this section and all its items?')) {
      card.remove();
    }
    write();
  });
  root.addEventListener('input', write);
  root.addEventListener('change', write);
  const form = root.closest('form');
  if (form) form.addEventListener('submit', write);
});
</script>
