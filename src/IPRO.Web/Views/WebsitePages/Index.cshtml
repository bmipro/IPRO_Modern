@model IEnumerable<IPRO.Entities.WebsitePage>
@{
    ViewData["Title"] = "Website Pages";
    var allPages = Model.ToList();
    // Tree order with a depth, so a sub-page is visibly a sub-page. A flat list made a third-level
    // article page look identical to a top-level one, which is unreadable once sections exist.
    var byParent = allPages.ToLookup(p => p.ParentPageId);
    var pages = new List<(IPRO.Entities.WebsitePage Page, int Depth)>();
    foreach (var top in byParent[(int?)null].OrderBy(p => p.SortOrder))
    {
        pages.Add((top, 1));
        foreach (var child in byParent[top.Id].OrderBy(p => p.SortOrder))
        {
            pages.Add((child, 2));
            foreach (var grandchild in byParent[child.Id].OrderBy(p => p.SortOrder))
            {
                pages.Add((grandchild, 3));
            }
        }
    }
    foreach (var stray in allPages.Where(p => pages.All(o => o.Page.Id != p.Id)).OrderBy(p => p.SortOrder))
    {
        pages.Add((stray, 3));
    }
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
  <div>
    <div class="small text-muted mb-1"><a href="/portal/Website">My Website</a> / Pages</div>
    <h2 class="fw-bold mb-1"><i class="fas fa-file-lines me-2 text-primary"></i>Website Pages</h2>
    <div class="text-muted">Manage page content, navigation order, and publishing without changing your template.</div>
  </div>
  <div class="d-flex gap-2"><a href="/portal/WebsitePages/Navigation" class="btn btn-outline-primary"><i class="fas fa-bars-staggered me-1"></i>Header & Menu</a><a href="/portal/WebsitePages/Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>New Page</a></div>
</div>

<div class="card border-0 shadow-sm">
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead>
        <tr><th style="width:90px">Order</th><th>Page</th><th>URL</th><th>Navigation</th><th>Status</th><th class="text-end">Actions</th></tr>
      </thead>
      <tbody>
      @foreach (var (sitePage, depth) in pages)
      {
        <tr>
          <td>
            <div class="btn-group btn-group-sm">
              <form method="post" action="/portal/WebsitePages/MovePage/@sitePage.Id"><input type="hidden" name="direction" value="up" />@Html.AntiForgeryToken()<button class="btn btn-outline-secondary" title="Move up"><i class="fas fa-arrow-up"></i></button></form>
              <form method="post" action="/portal/WebsitePages/MovePage/@sitePage.Id"><input type="hidden" name="direction" value="down" />@Html.AntiForgeryToken()<button class="btn btn-outline-secondary" title="Move down"><i class="fas fa-arrow-down"></i></button></form>
            </div>
          </td>
          <td style="padding-left:@((depth - 1) * 28 + 12)px">
            <div class="fw-bold">@(depth > 1 ? Html.Raw("<span class=\"text-muted me-1\">&#8627;</span>") : null)@sitePage.Title @(sitePage.IsHomePage ? Html.Raw("<span class=\"badge bg-primary ms-1\">Home</span>") : "")</div>
            <div class="small text-muted">@sitePage.Blocks.Count content block(s)</div>
          </td>
          <td><code>/@(sitePage.IsHomePage ? "" : sitePage.Slug)</code></td>
          <td>@(sitePage.ShowInNavigation ? sitePage.NavigationLabel : "Hidden")</td>
          <td><span class="badge @(sitePage.IsPublished ? "bg-success" : "bg-secondary")">@(sitePage.IsPublished ? "Published" : "Draft")</span></td>
          <td class="text-end">
            <div class="d-flex flex-wrap justify-content-end gap-1">
              <a href="/portal/WebsitePages/Edit/@sitePage.Id" class="btn btn-sm btn-outline-primary"><i class="fas fa-pen me-1"></i>Edit</a>
              <a href="/portal/WebsitePages/Preview/@sitePage.Id" target="_blank" class="btn btn-sm btn-outline-secondary"><i class="fas fa-eye me-1"></i>Preview</a>
              <form method="post" action="/portal/WebsitePages/Duplicate/@sitePage.Id">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-secondary"><i class="fas fa-copy me-1"></i>Duplicate</button></form>
              @if (!sitePage.IsHomePage)
              {
                <form method="post" action="/portal/WebsitePages/Delete/@sitePage.Id" onsubmit="return confirm('Delete @sitePage.Title and all of its content blocks?');">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger" title="Delete"><i class="fas fa-trash"></i></button></form>
              }
            </div>
          </td>
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>

<div class="alert alert-light border mt-3 mb-0">
  <i class="fas fa-circle-info me-2 text-primary"></i>Changing templates will not remove or rewrite these pages. Your content and navigation remain intact.
</div>
