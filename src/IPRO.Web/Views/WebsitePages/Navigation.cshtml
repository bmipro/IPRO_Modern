@model IPRO.Web.Models.WebsiteNavigationViewModel
@{
  ViewData["Title"] = "Header & Navigation";
  var byParent = Model.Pages.ToLookup(p => p.ParentPageId);
  // Depth-first so every page sits directly beneath its own parent. Listing all parents and then all
  // children (the old ordering) reads as nonsense once there are three levels. Explicit rather than
  // recursive because the nav is hard-capped at three tiers anyway.
  var ordered = new List<(IPRO.Entities.WebsitePage Page, int Depth)>();
  foreach (var top in byParent[(int?)null].OrderBy(p => p.SortOrder))
  {
    ordered.Add((top, 1));
    foreach (var child in byParent[top.Id].OrderBy(p => p.SortOrder))
    {
      ordered.Add((child, 2));
      foreach (var grandchild in byParent[child.Id].OrderBy(p => p.SortOrder))
      {
        ordered.Add((grandchild, 3));
      }
    }
  }
  // Safety net: anything parented deeper than the cap (only reachable from older data) still has to
  // be listed, or it would be stranded with no way to move it back into range.
  foreach (var stray in Model.Pages.Where(p => ordered.All(o => o.Page.Id != p.Id)).OrderBy(p => p.SortOrder))
  {
    ordered.Add((stray, 3));
  }
  var parentCandidates = ordered.Where(o => o.Depth <= 2).ToList();
  IEnumerable<int> DescendantsOf(int id) => byParent[id].Select(c => c.Id)
      .Concat(byParent[id].SelectMany(c => byParent[c.Id].Select(g => g.Id)));
}
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
  <div><div class="small text-muted mb-1"><a href="/portal/Website">My Website</a> / Structure</div><h2 class="fw-bold mb-1"><i class="fas fa-bars-staggered me-2 text-primary"></i>Header & Navigation</h2><div class="text-muted">Shape the first thing visitors see and keep your menu easy to understand.</div></div>
  <div class="d-flex gap-2"><a href="/portal/WebsitePages" class="btn btn-outline-secondary"><i class="fas fa-file-lines me-1"></i>Pages</a><a href="/portal/Website" class="btn btn-outline-primary"><i class="fas fa-arrow-left me-1"></i>Website Settings</a></div>
</div>

<form method="post" action="/portal/WebsitePages/SaveHeader" class="card border-0 shadow-sm mb-4">
  @Html.AntiForgeryToken()
  <div class="card-body p-4">
    <div class="mb-4"><h4 class="fw-bold mb-1">Header and Logo</h4><div class="text-muted small">Logo artwork is uploaded from Website Settings. These controls determine how it appears.</div></div>
    <div class="row g-3">
      <div class="col-md-4"><label for="f-style" class="form-label fw-semibold">Header Style</label><select id="f-style" name="style" class="form-select"><option value="standard" selected="@(Model.Header.Style=="standard")">Standard</option><option value="compact" selected="@(Model.Header.Style=="compact")">Compact</option><option value="transparent" selected="@(Model.Header.Style=="transparent")">Transparent over banner</option></select></div>
      <div class="col-md-4"><div id="logoPositionLabel" class="form-label fw-semibold">Logo Position</div><div class="btn-group w-100" role="group" aria-labelledby="logoPositionLabel"><input type="radio" class="btn-check" name="logoPosition" id="logoLeft" value="left" checked="@(Model.Header.LogoPosition!="center")"><label class="btn btn-outline-secondary" for="logoLeft"><i class="fas fa-align-left me-1"></i>Left</label><input type="radio" class="btn-check" name="logoPosition" id="logoCenter" value="center" checked="@(Model.Header.LogoPosition=="center")"><label class="btn btn-outline-secondary" for="logoCenter"><i class="fas fa-align-center me-1"></i>Center</label></div></div>
      <div class="col-md-4"><label for="f-logoSize" class="form-label fw-semibold">Logo Size</label><select id="f-logoSize" name="logoSize" class="form-select"><option value="small" selected="@(Model.Header.LogoSize=="small")">Small</option><option value="medium" selected="@(Model.Header.LogoSize=="medium")">Medium</option><option value="large" selected="@(Model.Header.LogoSize=="large")">Large</option></select></div>
      <div class="col-md-4"><label for="f-buttonText" class="form-label fw-semibold">Header Button</label><input id="f-buttonText" name="buttonText" value="@Model.Header.ButtonText" class="form-control" placeholder="Book a Consultation" /></div>
      <div class="col-md-4"><label for="f-buttonUrl" class="form-label fw-semibold">Button Link</label><input id="f-buttonUrl" name="buttonUrl" value="@Model.Header.ButtonUrl" class="form-control" placeholder="/contact or https://..." /></div>
      <div class="col-md-4 d-flex flex-column justify-content-end gap-2 pb-1">
        <div class="form-check form-switch"><input id="f-sticky" class="form-check-input" type="checkbox" name="sticky" value="true" checked="@Model.Header.Sticky"><label for="f-sticky" class="form-check-label">Keep header visible while scrolling</label></div>
        <div class="d-flex gap-4"><div class="form-check form-switch"><input id="f-showPhone" class="form-check-input" type="checkbox" name="showPhone" value="true" checked="@Model.Header.ShowPhone"><label for="f-showPhone" class="form-check-label">Phone</label></div><div class="form-check form-switch"><input id="f-showEmail" class="form-check-input" type="checkbox" name="showEmail" value="true" checked="@Model.Header.ShowEmail"><label for="f-showEmail" class="form-check-label">Email</label></div></div>
      </div>
    </div>
  </div>
  <div class="card-footer bg-white border-0 px-4 pb-4"><button class="btn btn-primary"><i class="fas fa-save me-1"></i>Save Header</button></div>
</form>

@* 528: the announcement bar across the top of every page of the site. *@
@{
  var bar = Model.Header.Announcement;
  var previewPage = Model.Pages.FirstOrDefault(p => p.IsHomePage) ?? Model.Pages.FirstOrDefault();
}
<div class="card border-0 shadow-sm mb-4" id="announcement-bar">
  <div class="card-body p-4">
    <div class="mb-3"><h4 class="fw-bold mb-1">Announcement Bar</h4><div class="text-muted small">One line across the top of every page of your website, for news such as holiday hours, a seminar or an offer.</div></div>
    @if (Model.AnnouncementAccess?.IsIncluded != true)
    {
      <p class="text-muted small mb-0">@(Model.AnnouncementAccess?.UpgradeMessage ?? "The announcement bar is not included in your package.")</p>
    }
    else
    {
      <form method="post" action="/portal/WebsitePages/SaveAnnouncement">
        @Html.AntiForgeryToken()
        <div class="row g-3">
          <div class="col-12">
            <div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="enabled" value="true" id="barEnabled" checked="@bar.Enabled"><label class="form-check-label fw-semibold" for="barEnabled">Show the announcement bar</label></div>
          </div>
          <div class="col-12">
            <label class="form-label fw-semibold" for="barMessage">Message</label>
            <input id="barMessage" name="message" value="@bar.Message" class="form-control" maxlength="@IPRO.Entities.WebsiteAnnouncementBar.MaxMessageLength" placeholder="Our office is closed December 24 to January 2." />
            <div class="form-text">Plain text, up to @IPRO.Entities.WebsiteAnnouncementBar.MaxMessageLength characters.</div>
          </div>
          <div class="col-md-4">
            <label class="form-label fw-semibold" for="barLinkText">Link text <span class="text-muted fw-normal">(optional)</span></label>
            <input id="barLinkText" name="linkText" value="@bar.LinkText" class="form-control" maxlength="@IPRO.Entities.WebsiteAnnouncementBar.MaxLinkTextLength" placeholder="Book now" />
          </div>
          <div class="col-md-8">
            <label class="form-label fw-semibold" for="barLinkUrl">Link</label>
            <input id="barLinkUrl" name="linkUrl" value="@bar.LinkUrl" class="form-control" maxlength="@IPRO.Entities.WebsiteAnnouncementBar.MaxLinkUrlLength" placeholder="/contact or https://..." />
          </div>
          <div class="col-md-4">
            <label class="form-label fw-semibold" for="barStyle">Colour</label>
            <select id="barStyle" name="style" class="form-select">
              <option value="theme" selected="@(bar.Style=="theme")">Your theme colour</option>
              <option value="dark" selected="@(bar.Style=="dark")">Dark</option>
              <option value="light" selected="@(bar.Style=="light")">Light</option>
            </select>
            <div class="form-text">The text colour follows, so it is always easy to read.</div>
          </div>
          <div class="col-md-8 d-flex align-items-start pt-md-4">
            <div class="form-check form-switch mt-md-2"><input class="form-check-input" type="checkbox" name="dismissible" value="true" id="barDismissible" checked="@bar.Dismissible"><label class="form-check-label" for="barDismissible">Visitors can close it (it stays closed in their browser for @IPRO.Entities.WebsiteAnnouncementBar.DismissDays days, or until you change the message)</label></div>
          </div>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-4">
          <button class="btn btn-primary"><i class="fas fa-save me-1"></i>Save Announcement Bar</button>
          @if (previewPage != null)
          {
            <a class="btn btn-outline-secondary" href="/portal/WebsitePages/Preview/@previewPage.Id" target="_blank" rel="noopener"><i class="fas fa-eye me-1"></i>Preview (after saving)</a>
          }
        </div>
      </form>
    }
  </div>
</div>

@* 529: the promotional pop-up, written and switched on and off here by the adviser (the owner, 2026-11-19). *@
@{
  var popup = Model.Header.Popup;
}
<div class="card border-0 shadow-sm mb-4" id="popup">
  <div class="card-body p-4">
    <div class="mb-3"><h4 class="fw-bold mb-1">Pop-Up</h4><div class="text-muted small">A short message that opens over your website: it invites visitors to join your newsletter, or sends them to a page such as a seminar or an offer.</div></div>
    @if (Model.PopupAccess?.IsIncluded != true)
    {
      <p class="text-muted small mb-0">@(Model.PopupAccess?.UpgradeMessage ?? "The pop-up is not included in your package.")</p>
    }
    else
    {
      // The answer to a save is said here, where the page returns to (#popup), and the status line under it
      // always says whether the pop-up shows on the website and, if not, what it still needs.
      if (TempData[IPRO.Web.Controllers.WebsitePagesController.PopupSavedKey] is string popupSaved)
      {
        var savedTone = TempData[IPRO.Web.Controllers.WebsitePagesController.PopupSavedToneKey] as string == "warning" ? "warning" : "success";
        <div class="alert alert-@savedTone py-2 mb-2" role="status"><i class="fas @(savedTone == "warning" ? "fa-exclamation-triangle" : "fa-check") me-2"></i>@popupSaved</div>
      }
      if (popup.IsShown)
      {
        <p class="popup-status popup-status--on" id="popupStatus"><i class="fas fa-circle-check" aria-hidden="true"></i><span><strong>On your website now:</strong> showing @(popup.HomePageOnly ? "on your home page" : "on every page"), @popup.OpensWhen.</span></p>
      }
      else if (popup.MissingPart.Length > 0)
      {
        <p class="popup-status popup-status--missing" id="popupStatus"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i><span><strong>On your website now:</strong> not showing yet, @popup.MissingPart.</span></p>
      }
      else
      {
        <p class="popup-status popup-status--off" id="popupStatus"><i class="fas fa-circle-minus" aria-hidden="true"></i><span><strong>On your website now:</strong> not showing (switched off).</span></p>
      }
      <form method="post" action="/portal/WebsitePages/SavePopup">
        @Html.AntiForgeryToken()
        <div class="row g-3">
          <div class="col-12">
            <div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="Enabled" value="true" id="popupEnabled" checked="@popup.Enabled"><label class="form-check-label fw-semibold" for="popupEnabled">Show the pop-up on my website</label></div>
          </div>
          <div class="col-12">
            <label class="form-label fw-semibold" for="popupHeadline">Headline</label>
            <input id="popupHeadline" name="Headline" value="@popup.Headline" class="form-control" maxlength="@IPRO.Entities.WebsitePopup.MaxHeadlineLength" placeholder="Join our mailing list" />
            <div class="form-text">Needed for the pop-up to show: the large words at its top. Up to @IPRO.Entities.WebsitePopup.MaxHeadlineLength characters.</div>
          </div>
          <div class="col-12">
            <label class="form-label fw-semibold" for="popupText">Text <span class="text-muted fw-normal">(optional)</span></label>
            <textarea id="popupText" name="Text" class="form-control" rows="3" maxlength="@IPRO.Entities.WebsitePopup.MaxTextLength" placeholder="Tips and news a few times a year. We respect your privacy.">@popup.Text</textarea>
            <div class="form-text">Plain text, up to @IPRO.Entities.WebsitePopup.MaxTextLength characters. Press Enter to start a new paragraph.</div>
          </div>
          <div class="col-12">
            <fieldset>
              <legend class="form-label fw-semibold fs-6 mb-2">Picture <span class="text-muted fw-normal">(optional)</span></legend>
              @if (Model.Pictures.Count == 0)
              {
                <div class="form-text mt-0">Your image library has no pictures yet. Upload one in any page's editor (<a href="/portal/WebsitePages">Pages</a>, then Edit, then Image Library) and choose it here.</div>
              }
              else
              {
                <div class="popup-pictures">
                  <label class="popup-picture popup-picture--none"><input class="form-check-input" type="radio" name="ImageAssetId" value="" checked="@(popup.ImageAssetId == null)"><span>No picture</span></label>
                  @foreach (var picture in Model.Pictures)
                  {
                    <label class="popup-picture" title="@picture.OriginalFileName"><input class="form-check-input" type="radio" name="ImageAssetId" value="@picture.Id" checked="@(popup.ImageAssetId == picture.Id)"><img src="@picture.BlobUrl" alt="" loading="lazy" /><span class="text-truncate">@picture.OriginalFileName</span></label>
                  }
                </div>
                <div class="form-text">The picture's description in your media library is read to visitors who cannot see it. On phones the pop-up is a small bar and shows no picture.</div>
              }
            </fieldset>
          </div>
          <div class="col-md-6">
            <fieldset>
              <legend class="form-label fw-semibold fs-6 mb-2">What it offers</legend>
              <div class="form-check"><input class="form-check-input" type="radio" name="Action" value="signup" id="popupSignup" checked="@popup.IsSignup"><label class="form-check-label" for="popupSignup">Your newsletter sign-up: name, email, a consent box and a security question. Sign-ups go to your contacts and your newsletter list.</label></div>
              <div class="form-check mt-1"><input class="form-check-input" type="radio" name="Action" value="buttons" id="popupButtons" checked="@(!popup.IsSignup)"><label class="form-check-label" for="popupButtons">One or two buttons that link to a page</label></div>
            </fieldset>
          </div>
          <div class="col-md-6">
            <fieldset>
              <legend class="form-label fw-semibold fs-6 mb-2">Layout</legend>
              <div class="form-check"><input class="form-check-input" type="radio" name="Layout" value="card" id="popupCard" checked="@(popup.Layout == "card")"><label class="form-check-label" for="popupCard">A card in the middle of the screen (the page behind is dimmed)</label></div>
              <div class="form-check mt-1"><input class="form-check-input" type="radio" name="Layout" value="corner" id="popupCorner" checked="@(popup.Layout == "corner")"><label class="form-check-label" for="popupCorner">A box in the bottom corner</label></div>
              <div class="form-check mt-1"><input class="form-check-input" type="radio" name="Layout" value="bar" id="popupBar" checked="@(popup.Layout == "bar")"><label class="form-check-label" for="popupBar">A bar along the bottom</label></div>
              <div class="form-text">On phones it is always a small bar along the bottom, so it never covers the page.</div>
            </fieldset>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-semibold" for="popupButton1Text">First button</label>
            <input id="popupButton1Text" name="Button1Text" value="@popup.Button1Text" class="form-control" maxlength="@IPRO.Entities.WebsitePopup.MaxButtonTextLength" placeholder="Book a seat" />
          </div>
          <div class="col-md-3">
            <label class="form-label fw-semibold" for="popupButton1Url">Its link</label>
            <input id="popupButton1Url" name="Button1Url" value="@popup.Button1Url" class="form-control" maxlength="@IPRO.Entities.WebsiteAnnouncementBar.MaxLinkUrlLength" placeholder="/seminars or https://..." />
          </div>
          <div class="col-md-3">
            <label class="form-label fw-semibold" for="popupButton2Text">Second button <span class="text-muted fw-normal">(optional)</span></label>
            <input id="popupButton2Text" name="Button2Text" value="@popup.Button2Text" class="form-control" maxlength="@IPRO.Entities.WebsitePopup.MaxButtonTextLength" placeholder="Call us" />
          </div>
          <div class="col-md-3">
            <label class="form-label fw-semibold" for="popupButton2Url">Its link</label>
            <input id="popupButton2Url" name="Button2Url" value="@popup.Button2Url" class="form-control" maxlength="@IPRO.Entities.WebsiteAnnouncementBar.MaxLinkUrlLength" placeholder="/contact" />
          </div>
          <div class="col-12 mt-0"><div class="form-text">The buttons are used only when the pop-up offers buttons. A link is a page of your site, such as /contact, or a full address starting with https://.</div></div>
          <div class="col-md-4">
            <label class="form-label fw-semibold" for="popupTrigger">When it opens</label>
            <select id="popupTrigger" name="Trigger" class="form-select">
              <option value="delay" selected="@(popup.Trigger == "delay")">After a few seconds</option>
              <option value="scroll" selected="@(popup.Trigger == "scroll")">When the visitor has scrolled part of the page</option>
              <option value="exit" selected="@(popup.Trigger == "exit")">When the visitor is about to leave the page</option>
            </select>
            <div class="form-text">"About to leave" works with a mouse; on phones and tablets it opens halfway down the page instead.</div>
          </div>
          <div class="col-md-2">
            <label class="form-label fw-semibold" for="popupDelay">Seconds to wait</label>
            <input id="popupDelay" name="DelaySeconds" type="number" min="0" max="@IPRO.Entities.WebsitePopup.MaxDelaySeconds" value="@popup.DelaySeconds" class="form-control" />
          </div>
          <div class="col-md-2">
            <label class="form-label fw-semibold" for="popupScroll">How far down</label>
            <select id="popupScroll" name="ScrollPercent" class="form-select">
              @foreach (var percent in IPRO.Entities.WebsitePopup.ScrollPercents)
              {
                <option value="@percent" selected="@(popup.ScrollPercent == percent)">@percent%</option>
              }
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label fw-semibold" for="popupPages">Where</label>
            <select id="popupPages" name="Pages" class="form-select">
              <option value="home" selected="@popup.HomePageOnly">On my home page only</option>
              <option value="all" selected="@(!popup.HomePageOnly)">On every page</option>
            </select>
          </div>
          <div class="col-md-4">
            <label class="form-label fw-semibold" for="popupRepeat">After a visitor closes it, show it again after</label>
            <select id="popupRepeat" name="RepeatDays" class="form-select">
              @foreach (var days in IPRO.Entities.WebsitePopup.RepeatChoices)
              {
                <option value="@days" selected="@(popup.RepeatDays == days)">@days @(days == 1 ? "day" : "days")</option>
              }
            </select>
          </div>
          <div class="col-md-8 d-flex align-items-end">
            <div class="form-text">A visitor who signs up through it is not asked again. When you change what it says, it shows again to visitors who closed it.</div>
          </div>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-4">
          <button class="btn btn-primary"><i class="fas fa-save me-1"></i>Save Pop-Up</button>
          @if (previewPage != null)
          {
            <a class="btn btn-outline-secondary" href="/portal/WebsitePages/Preview/@(previewPage.Id)?popup=true" target="_blank" rel="noopener"><i class="fas fa-eye me-1"></i>Preview (after saving)</a>
          }
        </div>
      </form>
    }
  </div>
</div>

<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-4">
    <div class="d-flex justify-content-between gap-3 mb-3"><div><h4 class="fw-bold mb-1">Website Menu</h4><div class="text-muted small">Rename links, nest items up to three levels deep, hide items, and use the arrows to control order.</div></div><span class="badge bg-primary-subtle text-primary align-self-start">@Model.Pages.Count pages</span></div>
    <div class="navigation-list">
      @foreach (var (menuPage, depth) in ordered)
      {
        var blocked = DescendantsOf(menuPage.Id).ToHashSet();
        var hasChildren = byParent[menuPage.Id].Any();
        <form method="post" action="/portal/WebsitePages/SaveNavigationItem" class="navigation-row depth-@depth">
          @Html.AntiForgeryToken()<input type="hidden" name="id" value="@menuPage.Id" />
          <div class="navigation-order"><button type="submit" formaction="/portal/WebsitePages/MoveNavigationItem/@menuPage.Id" name="direction" value="up" class="btn btn-sm btn-outline-secondary" title="Move up"><i class="fas fa-arrow-up"></i></button><button type="submit" formaction="/portal/WebsitePages/MoveNavigationItem/@menuPage.Id" name="direction" value="down" class="btn btn-sm btn-outline-secondary" title="Move down"><i class="fas fa-arrow-down"></i></button></div>
          <div><label for="f-navigationLabel-@menuPage.Id" class="form-label small text-muted mb-1">Menu label</label><input id="f-navigationLabel-@menuPage.Id" name="navigationLabel" value="@menuPage.NavigationLabel" class="form-control" /></div>
          <div><label for="f-parentPageId-@menuPage.Id" class="form-label small text-muted mb-1">Placement</label><select id="f-parentPageId-@menuPage.Id" name="parentPageId" class="form-select"><option value="">Top level</option>@foreach(var candidate in parentCandidates.Where(c => c.Page.Id != menuPage.Id && !blocked.Contains(c.Page.Id) && (c.Depth == 1 || !hasChildren))){<option value="@candidate.Page.Id" selected="@(menuPage.ParentPageId==candidate.Page.Id)">@(candidate.Depth == 1 ? "Under " : "· · Under ")@candidate.Page.NavigationLabel</option>}</select></div>
          <div class="navigation-meta"><span class="small text-muted">/@(menuPage.IsHomePage?"":menuPage.Slug)</span><div class="form-check form-switch"><input id="f-showInNavigation-@menuPage.Id" class="form-check-input" type="checkbox" name="showInNavigation" value="true" checked="@menuPage.ShowInNavigation"><label for="f-showInNavigation-@menuPage.Id" class="form-check-label small">Visible</label></div></div>
          <button class="btn btn-outline-primary"><i class="fas fa-check me-1"></i>Save</button>
        </form>
      }
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-4">
    <h4 class="fw-bold mb-1">External Links</h4><div class="text-muted small mb-3">Add a link to a booking system, partner site, or another trusted destination.</div>
    <form method="post" action="/portal/WebsitePages/AddCustomLink" class="row g-2 align-items-end mb-3">@Html.AntiForgeryToken()<div class="col-md-4"><label for="f-label" class="form-label small fw-semibold">Label</label><input id="f-label" name="label" class="form-control" placeholder="Client Login" required /></div><div class="col-md-6"><label for="f-url" class="form-label small fw-semibold">Complete URL</label><input id="f-url" name="url" type="url" class="form-control" placeholder="https://example.com" required /></div><div class="col-md-2"><button class="btn btn-primary w-100"><i class="fas fa-plus me-1"></i>Add Link</button></div></form>
    @foreach(var link in Model.Header.CustomLinks.OrderBy(l=>l.SortOrder)){<div class="d-flex align-items-center justify-content-between gap-3 border-top py-3"><div><strong>@link.Label</strong><div class="small text-muted text-break">@link.Url</div></div><form method="post" action="/portal/WebsitePages/DeleteCustomLink">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@link.Id" /><button aria-label="Remove external link" class="js-confirm-submit btn btn-sm btn-outline-danger" data-confirm-message="Remove this external link?"><i class="fas fa-trash" aria-hidden="true"></i></button></form></div>}
  </div>
</div>

@* 529: a switched-on pop-up needs a headline, so the browser asks for one at the Headline box before saving. *@
<script nonce="@Context.GetCspNonce()">
(() => {
  const on = document.getElementById('popupEnabled'), headline = document.getElementById('popupHeadline');
  if (!on || !headline) return;
  const sync = () => { headline.required = on.checked; };
  on.addEventListener('change', sync);
  sync();
})();
</script>

