@model List<IPRO.Entities.BillingRule>
@inject Microsoft.Extensions.Configuration.IConfiguration HomeSeoConfig
@using IPRO.Entities
@{
    ViewData["Title"] = "IPRO Advisers";
    Layout = null;
    // The marketing front door had a bare head -- title only -- while the agent sites it sells
    // carry a full SEO head (_PublicSeoHead.cshtml). Canonical comes from App:BaseUrl so test
    // hosts pointed at this app (e.g. 4ipro.com) defer to the real front door instead of
    // competing with it; the placeholder guard mirrors Program.cs's base-URL fallback.
    var configuredBase = HomeSeoConfig["App:BaseUrl"];
    var seoOrigin = !string.IsNullOrWhiteSpace(configuredBase) && !configuredBase.Contains("yourdomain", StringComparison.OrdinalIgnoreCase)
        ? configuredBase.TrimEnd('/')
        : $"{Context.Request.Scheme}://{Context.Request.Host}";
    var seoDescription = "Website, client records, follow-ups and newsletters for Canadian insurance, financial, accounting and mortgage professionals — one system, one login, one bill.";
}
@* ---------------------------------------------------------------------------
   Navy + aqua marketing front door, ported from DOCS/marketing-site-prototype/
   concept02-navy.html on 2026-08-17. The CSS and the static markup are the
   prototype's, copied verbatim; everything that carries live data is Razor.

   The previous blue Bootstrap page is kept at
   DOCS/marketing-site-prototype/homepage-blue-2026-08-16.cshtml.

   WHAT IS LIVE HERE, and must stay live if this page is edited again:
     - the package table renders from Model (BillingRule), including the setup-fee
       waiver via IsSetupFeeWaivedOn -- the same call that decides the PayPal charge
     - the comparison rows render from package.Features, not a hand-written list
     - ?package= is carried into /Account/Register and /Preview
     - the hero portal mock reads ViewBag.HeroInsight (shared with /Preview)
     - the demo address reads ViewBag.TemporaryRootDomain
     - /terms and /privacy exist now; the prototype's note that they 404 is stale
   --------------------------------------------------------------------------- *@
<!DOCTYPE html>
