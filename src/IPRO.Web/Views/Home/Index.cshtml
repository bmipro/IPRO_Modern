#ipro-concept-two .i2-journey-track { display: grid; grid-template-columns: repeat(5, 1fr); position: relative; }
#ipro-concept-two .i2-journey-track::before { content: ""; position: absolute; left: 8%; right: 8%; top: 23px; height: 2px; background: rgba(255,255,255,.22); }
#ipro-concept-two .i2-journey-step { position: relative; padding: 0 18px; text-align: center; }
#ipro-concept-two .i2-journey-icon { width: 48px; height: 48px; margin: 0 auto 16px; display: grid; place-items: center; border-radius: 50%; background: #ffffff; color: #173b55; position: relative; z-index: 1; }
#ipro-concept-two .i2-journey-step:nth-child(3) .i2-journey-icon { background: var(--ipro2-coral); color: #ffffff; }
#ipro-concept-two .i2-journey-step h3 { margin: 0 0 7px; color: #ffffff; font-size: .95rem; font-weight: 500; }
#ipro-concept-two .i2-journey-step p { margin: 0; color: var(--ipro2-dark-muted); font-size: .72rem; line-height: 1.55; }

#ipro-concept-two .i2-story { display: grid; grid-template-columns: .8fr 1.2fr; gap: 56px; align-items: center; }
#ipro-concept-two .i2-story-points { border-top: 1px solid var(--ipro2-line); }
#ipro-concept-two .i2-story-point { display: grid; grid-template-columns: 44px 1fr; gap: 14px; padding: 18px 0; border-bottom: 1px solid var(--ipro2-line); }
#ipro-concept-two .i2-story-point i { color: var(--ipro2-coral); }
#ipro-concept-two .i2-story-point h3 { margin: 0 0 5px; color: var(--ipro2-navy); font-size: .96rem; font-weight: 500; }
#ipro-concept-two .i2-story-point p { margin: 0; color: var(--ipro2-muted); font-size: .8rem; line-height: 1.55; }
/* "Your move:" clause - what the reader does next, set apart from what already exists. */
#ipro-concept-two .i2-story-point em { display: block; margin-top: 5px; font-style: normal; color: var(--ipro2-aqua); font-weight: 500; }

#ipro-concept-two .i2-plan-table-wrap { overflow-x: auto; border-top: 1px solid var(--ipro2-line); }
#ipro-concept-two .i2-plan-table { width: 100%; min-width: 720px; border-collapse: collapse; background: var(--ipro2-paper); }
#ipro-concept-two .i2-plan-table th,
#ipro-concept-two .i2-plan-table td { padding: 14px 13px; text-align: center; border-bottom: 1px solid var(--ipro2-line); font-size: .8rem; }
#ipro-concept-two .i2-plan-table th:first-child,
#ipro-concept-two .i2-plan-table td:first-child { text-align: left; width: 34%; color: var(--ipro2-muted); }
#ipro-concept-two .i2-plan-table thead th { color: var(--ipro2-navy); vertical-align: top; }
#ipro-concept-two .i2-plan-name { display: block; font-size: 1rem; font-weight: 500; }
#ipro-concept-two .i2-plan-price { display: block; margin-top: 5px; color: var(--ipro2-coral); font-size: 1.55rem; font-weight: 500; }
#ipro-concept-two .i2-plan-price small { color: var(--ipro2-muted); font-size: .65rem; }
#ipro-concept-two .i2-plan-annual { display: block; margin-top: 4px; color: var(--ipro2-muted); font-size: .68rem; font-weight: 400; }
#ipro-concept-two .i2-plan-table .i2-featured { background: var(--ipro2-coral-soft); }
#ipro-concept-two .i2-plan-table i { color: var(--ipro2-aqua); }
#ipro-concept-two .i2-plan-table td:not(:first-child) > svg { display: inline-block !important; margin: 0 !important; vertical-align: middle; }
#ipro-concept-two .i2-plan-count { font-weight: 500; color: var(--ipro2-navy); }
#ipro-concept-two .i2-fee-was { color: var(--ipro2-muted); text-decoration: line-through; }
#ipro-concept-two .i2-fee-now { color: var(--ipro2-navy); font-weight: 500; }
#ipro-concept-two .i2-fee-note { display: block; margin-top: 3px; color: var(--ipro2-aqua); font-size: .62rem; font-weight: 500; letter-spacing: .07em; text-transform: uppercase; }
#ipro-concept-two .i2-plan-note { margin: 16px 0 0; color: var(--ipro2-muted); font-size: .75rem; }
@* Collapsible pricing (owner request 2026-08-28): the comparison table is the longest thing
   on the page. Collapsed, it shows the package headers (names, prices, setup fee -- the actual
   pricing), the first six feature rows, and the CTA row; the toggle reveals the rest. The
   :not(:last-child) exemption is the CTA row -- Get started must never be hidden. *@
#ipro-concept-two .i2-plan-table.i2-collapsed tbody tr:nth-child(n+7):not(:last-child) { display: none; }
#ipro-concept-two .i2-pricing-toggle { display: block; margin: 18px auto 0; cursor: pointer; background: none; }
#ipro-concept-two .i2-pricing-footer { margin-top: 14px; display: flex; justify-content: space-between; align-items: center; gap: 18px; color: var(--ipro2-muted); font-size: .8rem; }

#ipro-concept-two .i2-trust { background: var(--ipro2-paper-soft); }
#ipro-concept-two .i2-trust-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 58px; align-items: start; }
#ipro-concept-two .i2-founder { padding: 30px 0; border-top: 3px solid var(--ipro2-coral); border-bottom: 1px solid var(--ipro2-line); }
#ipro-concept-two .i2-founder-line { display: flex; gap: 18px; align-items: center; }
#ipro-concept-two .i2-founder-avatar { width: 62px; height: 62px; border-radius: 50%; display: grid; place-items: center; background: var(--ipro2-navy-solid); color: #ffffff; font-weight: 500; flex: none; }
#ipro-concept-two .i2-founder h3 { margin: 0 0 4px; color: var(--ipro2-navy); font-size: 1rem; font-weight: 500; }
#ipro-concept-two .i2-founder small { color: var(--ipro2-muted); }
#ipro-concept-two .i2-founder > p { color: var(--ipro2-muted); line-height: 1.65; margin: 20px 0 0; }
#ipro-concept-two .i2-trust-items { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 28px; }
#ipro-concept-two .i2-trust-item { padding: 22px 0; border-top: 1px solid var(--ipro2-line); }
#ipro-concept-two .i2-trust-item i { color: var(--ipro2-aqua); }
#ipro-concept-two .i2-trust-item h3 { margin: 9px 0 5px; color: var(--ipro2-navy); font-size: .94rem; font-weight: 500; }
#ipro-concept-two .i2-trust-item p { margin: 0; color: var(--ipro2-muted); font-size: .78rem; line-height: 1.55; }

#ipro-concept-two .i2-contact { background: var(--ipro2-paper); }
#ipro-concept-two .i2-contact-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 58px; align-items: start; }
#ipro-concept-two .i2-contact-list { display: grid; gap: 13px; margin-top: 24px; }
#ipro-concept-two .i2-contact-item { display: flex; gap: 10px; align-items: flex-start; }
#ipro-concept-two .i2-contact-item i { color: var(--ipro2-coral); flex: none; margin-top: 2px; }
#ipro-concept-two .i2-contact-item b { display: block; color: var(--ipro2-navy); font-size: .84rem; font-weight: 500; }
#ipro-concept-two .i2-contact-item span { display: block; color: var(--ipro2-muted); font-size: .74rem; margin-top: 2px; }
#ipro-concept-two .i2-form { border-left: 3px solid var(--ipro2-aqua); padding-left: 28px; display: grid; gap: 15px; }
#ipro-concept-two .i2-field-pair { display: grid; grid-template-columns: repeat(2, 1fr); gap: 13px; }
#ipro-concept-two .i2-field { display: grid; gap: 6px; }
#ipro-concept-two .i2-field label { font-size: .74rem; color: var(--ipro2-ink); font-weight: 500; }
#ipro-concept-two .i2-field input,
#ipro-concept-two .i2-field select,
#ipro-concept-two .i2-field textarea { width: 100%; min-height: 44px; background: var(--ipro2-bg); color: var(--ipro2-ink); border: 1px solid var(--ipro2-line); border-radius: 3px; padding: 10px 11px; }
#ipro-concept-two .i2-field textarea { min-height: 96px; resize: vertical; }
#ipro-concept-two .i2-form .i2-action { justify-self: start; }

#ipro-concept-two .i2-footer { background: var(--ipro2-navy-solid); color: #c6d5df; padding: 42px 0 24px; }
#ipro-concept-two .i2-footer-grid { display: grid; grid-template-columns: 1.5fr repeat(3, 1fr); gap: 32px; }
#ipro-concept-two .i2-footer-logo { display: block; width: 150px; height: auto; margin-bottom: 14px; filter: brightness(0) invert(1); }
#ipro-concept-two .i2-footer-brand p { max-width: 32ch; font-size: .75rem; line-height: 1.6; margin: 0; }
#ipro-concept-two .i2-footer-social { display: flex; gap: 14px; margin-top: 16px; }
#ipro-concept-two .i2-footer-social a { color: #c6d5df; display: inline-flex; transition: color .15s; }
#ipro-concept-two .i2-footer-social a:hover { color: #ffffff; }
#ipro-concept-two .i2-footer-social svg { width: 20px; height: 20px; }
#ipro-concept-two .i2-footer h3 { margin: 0 0 12px; color: #ffffff; font-size: .72rem; font-weight: 500; text-transform: uppercase; letter-spacing: .08em; }
#ipro-concept-two .i2-footer-links { display: grid; gap: 8px; }
#ipro-concept-two .i2-footer-links a { font-size: .74rem; text-decoration: none; }
#ipro-concept-two .i2-footer-bottom { margin-top: 30px; padding-top: 18px; border-top: 1px solid rgba(255,255,255,.14); display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: .68rem; }

@@media (max-width: 920px) {
  #ipro-concept-two .i2-nav a:not(.i2-action) { display: none; }
  #ipro-concept-two .i2-hero-grid { grid-template-columns: 1fr; }
  #ipro-concept-two .i2-hero-copy { max-width: 650px; }
  #ipro-concept-two .i2-command { max-width: 720px; }
  #ipro-concept-two .i2-start-layout { grid-template-columns: 1fr; }
  #ipro-concept-two .i2-start-tabs { display: grid; grid-template-columns: repeat(4, 1fr); border-left: 1px solid var(--ipro2-line); }
  #ipro-concept-two .i2-start-tab { grid-template-columns: 1fr; text-align: center; border-right: 1px solid var(--ipro2-line); padding: 10px 6px; }
  #ipro-concept-two .i2-start-tab span:first-child,
  #ipro-concept-two .i2-start-tab i { display: none; }
  #ipro-concept-two .i2-start-tab[aria-pressed="true"] { padding-left: 6px; }
  #ipro-concept-two .i2-story,
  #ipro-concept-two .i2-trust-grid,
  #ipro-concept-two .i2-contact-grid { grid-template-columns: 1fr; }
  #ipro-concept-two .i2-footer-grid { grid-template-columns: repeat(2, 1fr); }
}
@@media (max-width: 700px) {
  #ipro-concept-two .i2-wrap { width: min(100% - 28px, 1120px); }
  #ipro-concept-two .i2-header-row { min-height: 62px; }
  #ipro-concept-two .i2-logo-img { width: 124px; }
  #ipro-concept-two .i2-logo-chip { padding: 7px 11px 8px; }
  #ipro-concept-two .i2-nav { gap: 10px; }
  #ipro-concept-two .i2-nav .i2-action { min-height: 40px; padding: 0 12px; font-size: .75rem; }
  #ipro-concept-two .i2-hero-grid { padding: 52px 0; gap: 36px; }
  #ipro-concept-two .i2-hero h1 { font-size: 2.25rem; }
  #ipro-concept-two .i2-command-body { grid-template-columns: 96px 1fr; min-height: 390px; }
  #ipro-concept-two .i2-command-nav { padding: 12px 6px; }
  #ipro-concept-two .i2-command-nav strong { padding-left: 5px; }
  #ipro-concept-two .i2-command-tab { font-size: .56rem; padding: 7px 5px; }
  #ipro-concept-two .i2-command-content { padding: 12px; }
  #ipro-concept-two .i2-command-stats { grid-template-columns: 1fr; }
  #ipro-concept-two .i2-command-stat:nth-child(n+2) { display: none; }
  #ipro-concept-two .i2-week { gap: 4px; padding: 9px; }
  #ipro-concept-two .i2-chip { font-size: .48rem; padding: 4px; }
  #ipro-concept-two .i2-siteblock { grid-template-columns: 1fr; }
  #ipro-concept-two .i2-proof-row { grid-template-columns: repeat(2, 1fr); }
  #ipro-concept-two .i2-proof-item { border-bottom: 1px solid var(--ipro2-line); }
  #ipro-concept-two .i2-section { padding: 58px 0; }
  #ipro-concept-two .i2-heading h2,
  #ipro-concept-two .i2-story-copy h2,
  #ipro-concept-two .i2-contact-copy h2 { font-size: 1.7rem; }
  #ipro-concept-two .i2-start-tabs { grid-template-columns: repeat(2, 1fr); }
  #ipro-concept-two .i2-start-stage { grid-template-columns: 1fr; }
  #ipro-concept-two .i2-start-copy { padding: 30px 24px; }
  #ipro-concept-two .i2-site { margin: 0 18px 18px; }
  #ipro-concept-two .i2-site-nav a { display: none; }
  #ipro-concept-two .i2-site-services { grid-template-columns: 1fr; }
  #ipro-concept-two .i2-journey-track { grid-template-columns: 1fr; gap: 18px; }
  #ipro-concept-two .i2-journey-track::before { left: 23px; right: auto; top: 20px; bottom: 20px; width: 2px; height: auto; }
  #ipro-concept-two .i2-journey-step { display: grid; grid-template-columns: 48px 1fr; gap: 15px; text-align: left; padding: 0; }
  #ipro-concept-two .i2-journey-icon { margin: 0; }
  #ipro-concept-two .i2-journey-step h3 { margin-top: 2px; }
  #ipro-concept-two .i2-pricing-footer { align-items: flex-start; flex-direction: column; }
  #ipro-concept-two .i2-trust-items,
  #ipro-concept-two .i2-field-pair,
  #ipro-concept-two .i2-footer-grid { grid-template-columns: 1fr; }
}
@@media (max-width: 420px) {
  #ipro-concept-two .i2-hero-actions { flex-direction: column; }
  #ipro-concept-two .i2-hero-actions .i2-action,
  #ipro-concept-two .i2-hero-actions .i2-action-outline { width: 100%; }
  #ipro-concept-two .i2-command-body { grid-template-columns: 1fr; }
  #ipro-concept-two .i2-command-nav { display: none; }
  #ipro-concept-two .i2-cards { grid-template-columns: 1fr; }
  #ipro-concept-two .i2-proof-row { grid-template-columns: 1fr; }
  #ipro-concept-two .i2-proof-item { border-right: 0; }
}

/* --- Added by the Razor port: elements the prototype rendered as static copy. --- */
#ipro-concept-two .i2-plan-limit { font-weight: 650; color: var(--ipro2-ink); font-size: .82rem; }
#ipro-concept-two .i2-plan-no { color: var(--ipro2-muted); }
#ipro-concept-two .i2-plan-preview { display: inline-block; margin-top: .5rem; font-size: .78rem; color: var(--ipro2-aqua); text-decoration: none; }
#ipro-concept-two .i2-plan-preview:hover { text-decoration: underline; }
#ipro-concept-two .i2-plan-empty { text-align: center; color: var(--ipro2-muted); }
#ipro-concept-two .i2-plan-table td .i2-action { margin-bottom: .25rem; }
#ipro-concept-two .i2-site-url { margin-left: 8px; font-style: normal; font-size: .58rem; letter-spacing: .01em; color: #7c8a94; background: #ffffff; border: 1px solid #dfe7ec; border-radius: 999px; padding: 2px 9px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
</style>
</head>
<body>

<div id="ipro-concept-two">
  <div class="i2-page">
    <header class="i2-header">
      <div class="i2-wrap i2-header-row">
        <a class="i2-logo" href="#i2-top" aria-label="IPRO Advisers home"><span class="i2-logo-chip"><img class="i2-logo-img" src="/images/ipro-advisers-logo.png" alt="IPRO Advisers"></span></a>
        <nav class="i2-nav" aria-label="Main navigation">
          <a href="#i2-start">Solutions</a><a href="#i2-platform">Platform</a><a href="#i2-pricing">Pricing</a><a href="#i2-trust">About</a><a href="#i2-contact">Contact</a><a href="/Account/Login">Sign in</a>
          <a class="i2-action" href="/Preview">Build my preview <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="arrow-right" aria-hidden="true" class="lucide lucide-arrow-right"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a>
        </nav>
      </div>
    </header>

    <main>
      <section class="i2-hero" id="i2-top">
        <div class="i2-wrap i2-hero-grid">
          <div class="i2-hero-copy">
            <p class="i2-label">One subscription. The website that wins the enquiry and the system that keeps the client.</p>
            <h1>Be the ONE they find first.</h1>
            <p>Your website, client records, follow-ups and newsletters run on one system, from one login, on one bill. It arrives already written for your market.</p>
            <div class="i2-hero-actions"><a class="i2-action" href="/Preview">See it before I sign up <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="arrow-right" aria-hidden="true" class="lucide lucide-arrow-right"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><a class="i2-action-outline" href="#i2-start">Pick my market</a></div>
            <div class="i2-hero-meta"><span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="check-circle-2" aria-hidden="true" class="lucide lucide-check-circle-2"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>No credit card</span><span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="check-circle-2" aria-hidden="true" class="lucide lucide-check-circle-2"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>Cancel anytime</span><span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="map-pin" aria-hidden="true" class="lucide lucide-map-pin"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg>Canadian since 2014</span></div>
          </div>

          <!-- Interactive portal mock: the sidebar items are real buttons that swap the panel. -->
          <div class="i2-command" aria-label="IPRO agent portal preview">
            <div class="i2-command-bar"><div class="i2-window-dots"><span></span><span></span><span></span></div><span>app.iproadvisers.com</span><span>Michael Tran</span></div>
            <div class="i2-command-body">
              <aside class="i2-command-nav">
                <strong>IPRO portal</strong>
                <div class="i2-command-tabs" role="tablist" aria-label="Portal sections" aria-orientation="vertical">
                  <button class="i2-command-tab i2-selected" type="button" role="tab" id="i2-tab-dashboard" aria-controls="i2-panel-dashboard" aria-selected="true" tabindex="0" data-i2-panel="dashboard"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="layout-dashboard" aria-hidden="true" class="lucide lucide-layout-dashboard"><rect width="7" height="9" x="3" y="3" rx="1"></rect><rect width="7" height="5" x="14" y="3" rx="1"></rect><rect width="7" height="9" x="14" y="12" rx="1"></rect><rect width="7" height="5" x="3" y="16" rx="1"></rect></svg>Dashboard</button>
                  <button class="i2-command-tab" type="button" role="tab" id="i2-tab-clients" aria-controls="i2-panel-clients" aria-selected="false" tabindex="-1" data-i2-panel="clients"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="users" aria-hidden="true" class="lucide lucide-users"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg>Clients</button>
                  <button class="i2-command-tab" type="button" role="tab" id="i2-tab-followups" aria-controls="i2-panel-followups" aria-selected="false" tabindex="-1" data-i2-panel="followups"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="list-checks" aria-hidden="true" class="lucide lucide-list-checks"><path d="M13 5h8"></path><path d="M13 12h8"></path><path d="M13 19h8"></path><path d="m3 17 2 2 4-4"></path><path d="m3 7 2 2 4-4"></path></svg>Follow-ups</button>
