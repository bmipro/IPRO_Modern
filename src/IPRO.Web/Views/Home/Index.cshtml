  --ipro2-line: light-dark(#d4ddd6, #33434f);
  --ipro2-navy: light-dark(#173b55, #deedf5);
  --ipro2-navy-solid: #173b55;
  --ipro2-aqua: light-dark(#087d83, #5bd4d3);
  --ipro2-aqua-solid: #087d83;
  --ipro2-coral: light-dark(#d06a35, #f09461);
  --ipro2-coral-soft: light-dark(#f9e9df, #44291e);
