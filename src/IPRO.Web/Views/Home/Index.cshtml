@* The portal mock and the market picker are the prototype's own script, unchanged
   except for the CSP nonce. SecurityHeadersMiddleware sets script-src 'self' 'nonce-...',
   so an un-nonced inline script here would simply not run. *@
<script nonce="@Context.GetCspNonce()">
(function () {
  var root = document.getElementById('ipro-concept-two');
  if (!root) return;

  /* ---- Business-type switcher: exactly four editions. ---- */
  var CHECK = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="check" aria-hidden="true" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"></path></svg>';
  var options = {
    advice: { label: 'Insurance / Financial edition', title: 'Built for advisers who manage relationships, not transactions.', copy: 'Present your advice clearly, capture qualified enquiries, and keep every policy review, renewal and client life event on a schedule instead of in your head.', points: ['Insurance and planning pages with an article library', 'Enquiry forms linked to the client record', 'Policy review, renewal and life-event reminders'], brand: 'Cedar Advisory Group', siteLabel: 'Insurance and financial advice', headline: 'Advice that keeps pace with your life.', siteCopy: 'Clear guidance on protection, retirement and investments, with regular reviews when circumstances change.', services: ['Life insurance', 'Retirement', 'Reviews'] },
    accounting: { label: 'Accounting edition', title: 'A credible accounting practice, already structured.', copy: 'Launch with accounting, bookkeeping and tax pages, then connect every enquiry to the client and follow-up tools behind them.', points: ['Accounting pages and article library', 'Lead forms connected to your CRM', 'Deadline and renewal follow-ups'], brand: 'Northline Accounting', siteLabel: 'Accounting and tax services', headline: 'Clear numbers. Better business decisions.', siteCopy: 'Practical accounting, bookkeeping and tax support for owners who want to understand what comes next.', services: ['Accounting', 'Bookkeeping', 'Tax planning'] },
    mortgage: { label: 'Mortgage edition', title: 'Turn more mortgage enquiries into organised conversations.', copy: 'Explain purchase, renewal and refinancing options clearly, then keep every borrower enquiry and next action in one place.', points: ['Mortgage-specific service pages', 'Borrower enquiries added as prospects', 'Application and renewal follow-ups'], brand: 'Harbour Mortgage Advice', siteLabel: 'Mortgage guidance', headline: 'A clear path to the right mortgage.', siteCopy: 'Straightforward help with purchases, renewals, refinancing and investment properties.', services: ['Purchases', 'Renewals', 'Refinancing'] },
    generic: { label: 'Generic edition', title: 'The flexible starting point for any professional-service business.', copy: 'Start from a neutral, professional website and adapt the pages, language and services to the work you actually do, with the same CRM, marketing and follow-up tools underneath.', points: ['Customisable business website', 'Lead capture and client records', 'Newsletters, scheduling and campaigns'], brand: 'Your Business Name', siteLabel: 'Professional services', headline: 'Turn more interest into lasting business.', siteCopy: 'A clear online presence and practical tools to manage leads, clients and the work that follows.', services: ['Your services', 'Client support', 'Resources'] }
  };
  function setMarket(key) {
    var item = options[key];
    if (!item) return;
    root.querySelector('#i2-market-label').textContent = item.label;
    root.querySelector('#i2-market-title').textContent = item.title;
    root.querySelector('#i2-market-copy').textContent = item.copy;
    root.querySelectorAll('#i2-market-list li').forEach(function (node, index) { node.innerHTML = CHECK + item.points[index]; });
    root.querySelector('#i2-site-brand').textContent = item.brand;
    root.querySelector('#i2-site-label').textContent = item.siteLabel;
    root.querySelector('#i2-site-headline').textContent = item.headline;
    root.querySelector('#i2-site-copy').textContent = item.siteCopy;
    root.querySelector('#i2-service-one').textContent = item.services[0];
    root.querySelector('#i2-service-two').textContent = item.services[1];
    root.querySelector('#i2-service-three').textContent = item.services[2];
  }
  /* ---- Collapsible pricing: reveal the hidden feature rows, flip the label. ---- */
  var planTable = root.querySelector('#i2-plan-table');
  var planToggle = root.querySelector('#i2-pricing-toggle');
  if (planTable && planToggle) {
    planToggle.addEventListener('click', function () {
      var collapsed = planTable.classList.toggle('i2-collapsed');
      planToggle.setAttribute('aria-expanded', String(!collapsed));
      planToggle.textContent = collapsed ? planToggle.getAttribute('data-more') : 'Show less';
      if (collapsed) { planTable.scrollIntoView({ block: 'nearest' }); }
    });
  }

  root.querySelectorAll('.i2-start-tab').forEach(function (button) {
    button.addEventListener('click', function () {
      root.querySelectorAll('.i2-start-tab').forEach(function (peer) { peer.setAttribute('aria-pressed', 'false'); });
      button.setAttribute('aria-pressed', 'true');
      setMarket(button.getAttribute('data-i2-market'));
    });
  });

  /* ---- Hero portal mock: clickable sidebar tabs swap the main panel. ---- */
  var portalTabs = Array.prototype.slice.call(root.querySelectorAll('.i2-command-tab'));
  var portalPanels = Array.prototype.slice.call(root.querySelectorAll('.i2-panel'));
  function showPanel(key, moveFocus) {
    portalTabs.forEach(function (tab) {
      var on = tab.getAttribute('data-i2-panel') === key;
      tab.setAttribute('aria-selected', on ? 'true' : 'false');
      tab.setAttribute('tabindex', on ? '0' : '-1');
      tab.classList.toggle('i2-selected', on);
      if (on && moveFocus) tab.focus();
    });
    portalPanels.forEach(function (panel) {
      panel.classList.toggle('i2-panel-active', panel.getAttribute('data-i2-panel') === key);
    });
  }
  portalTabs.forEach(function (tab, index) {
    tab.addEventListener('click', function () { showPanel(tab.getAttribute('data-i2-panel'), false); });
    tab.addEventListener('keydown', function (event) {
      var step = 0;
      if (event.key === 'ArrowDown' || event.key === 'ArrowRight') step = 1;
      else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') step = -1;
      else if (event.key === 'Home') step = -index;
      else if (event.key === 'End') step = portalTabs.length - 1 - index;
      else return;
      event.preventDefault();
      var next = portalTabs[(index + step + portalTabs.length) % portalTabs.length];
      showPanel(next.getAttribute('data-i2-panel'), true);
    });
  });
})();
</script>
</body>
</html>
