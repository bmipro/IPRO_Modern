@model List<IPRO.Entities.BillingRule>
@{
    ViewData["Title"] = "IPRO Advisers";
    Layout = null;
}
<!DOCTYPE html>
<html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>IPRO Advisers - Website, CRM &amp; Marketing for Growing Businesses</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" rel="stylesheet"/>
<style>
  body{color:#1e293b;}
  .ipro-hero{background:linear-gradient(135deg,#1a3a6b 0%,#2563eb 100%);color:#fff;}
  .ipro-nav{background:rgba(255,255,255,0.08);}
  .brand-icon{color:#fff;}
  .feature-card{border:none;border-radius:16px;box-shadow:0 8px 24px rgba(15,23,42,0.06);height:100%;}
  .feature-icon{width:52px;height:52px;border-radius:12px;background:#eff6ff;color:#2563eb;display:flex;align-items:center;justify-content:center;font-size:1.4rem;}
  .price-card{border:none;border-radius:16px;box-shadow:0 8px 24px rgba(15,23,42,0.08);height:100%;display:flex;flex-direction:column;}
  .price-card.featured{box-shadow:0 0 0 2px #2563eb,0 16px 40px rgba(37,99,235,0.22);border:none;position:relative;}
  .price-card.featured::before{content:"";position:absolute;top:0;left:16px;right:16px;height:3px;background:#a9812f;border-radius:0 0 3px 3px;}
  .price-amount{font-size:2.5rem;font-weight:800;color:#1a3a6b;font-variant-numeric:tabular-nums;}
  .section-eyebrow{letter-spacing:.08em;font-weight:700;font-size:.8rem;color:#2563eb;text-transform:uppercase;}
  h1,h2,h3,h4,h5{font-family:Georgia,"Iowan Old Style","Palatino Linotype",serif;}
  .badge-plain{background:#eef2f8;color:#64748b;font-weight:700;font-size:.68rem;letter-spacing:.03em;text-transform:uppercase;}
  .badge-featured{background:#f4ead2;color:#a9812f;font-weight:700;font-size:.68rem;letter-spacing:.03em;text-transform:uppercase;}
  .price-limits{border-top:1px solid #eef1f6;border-bottom:1px solid #eef1f6;padding:12px 0;margin:10px 0 14px;}
  .price-limits li{padding:2px 0;}
  .preview-plan-link{display:block;text-align:center;font-size:.82rem;font-weight:700;color:#2563eb;text-decoration:none;margin-top:10px;}
  .preview-plan-link:hover{text-decoration:underline;}
  .tier-stack{display:flex;flex-direction:column;gap:14px;}
  .tier-row{background:#fff;border:1px solid #e5e9f2;border-radius:16px;padding:26px 28px;box-shadow:0 8px 24px rgba(15,23,42,0.05);}
  .tier-row.tier-gold{margin-left:3%;}
  .tier-row.tier-platinum{margin-left:6%;box-shadow:0 0 0 1px #2563eb,0 12px 28px rgba(37,99,235,.16);position:relative;}
  .tier-row.tier-platinum::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:#a9812f;border-radius:16px 16px 0 0;}
  .tier-row.tier-broker{margin-left:9%;}
  .tier-icon-wrap{width:36px;height:36px;border-radius:10px;background:#eff6ff;color:#2563eb;display:flex;align-items:center;justify-content:center;flex:none;font-size:1rem;}
  .tier-row.tier-platinum .tier-icon-wrap{background:#f4ead2;color:#a9812f;}
  .tier-badge-pill{margin-left:auto;font-size:.68rem;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:#2563eb;background:#eff6ff;padding:5px 12px;border-radius:999px;white-space:nowrap;}
  .tier-row.tier-platinum .tier-badge-pill{color:#a9812f;background:#f4ead2;}
  .tier-feature-item{font-size:.92rem;color:#475569;display:flex;gap:8px;align-items:flex-start;padding:4px 0;}
  .tier-feature-item i{color:#16a34a;margin-top:4px;flex:none;font-size:.8rem;}
  .tier-feature-item b{color:#1e293b;}
  .tier-note{font-size:.82rem;color:#64748b;margin-top:16px;padding-top:16px;border-top:1px solid #eef1f6;}
</style></head>
<body>

<div class="ipro-hero">
  <nav class="navbar navbar-expand ipro-nav py-3">
    <div class="container d-flex justify-content-between align-items-center">
      <span class="fw-bold fs-4"><i class="fas fa-shield-alt me-2"></i>IPRO Advisers</span>
      <div>
        <a href="/Account/Login" class="btn btn-outline-light me-2">Sign In</a>
        <a href="/Account/Register" class="btn btn-light fw-semibold">Get Started</a>
      </div>
    </div>
  </nav>

  <div class="container py-5 text-center">
    <div class="row justify-content-center">
      <div class="col-lg-9">
        <h1 class="fw-bold display-5 mb-3">A business growth platform for advisers and small businesses</h1>
        <p class="fs-5 mb-4" style="color:#dbeafe;">A website, CRM, email campaigns, client follow-ups, billing, a client portal, and automation — all in one place, built for insurance, mortgage, and financial advisers.</p>
        <a href="/Preview" class="btn btn-light btn-lg fw-semibold px-4 me-2"><i class="fas fa-wand-magic-sparkles me-2"></i>See Your Website in 30 Seconds</a>
        <a href="/Account/Register" class="btn btn-outline-light btn-lg px-4 me-2">Start Your Free Account</a>
        <a href="#pricing" class="btn btn-outline-light btn-lg px-4">See Pricing</a>
      </div>
    </div>
  </div>
</div>

<div class="container py-5">
  <div class="text-center mb-5">
    <div class="section-eyebrow mb-2">What's included</div>
    <h2 class="fw-bold">Honestly tiered, not a flat feature dump</h2>
    <p class="text-muted mt-2 mb-0">What you actually gain at each step up — every plan starts strong, Platinum runs your whole business.</p>
  </div>
  <div class="tier-stack">
    <div class="tier-row">
      <div class="d-flex align-items-center gap-3 mb-3">
        <span class="tier-icon-wrap"><i class="fas fa-table-cells"></i></span>
        <div><div class="fw-bold">On every plan</div><div class="text-muted small">Including Silver, from day one</div></div>
      </div>
      <div class="row g-1">
        <div class="col-md-6"><div class="tier-feature-item"><i class="fas fa-check"></i>Instant website, pre-populated for your vertical</div></div>
        <div class="col-md-6"><div class="tier-feature-item"><i class="fas fa-check"></i>Lead capture &amp; automatic prospect manager</div></div>
        <div class="col-md-6"><div class="tier-feature-item"><i class="fas fa-check"></i>Calendar / scheduler + email &amp; SMS reminders</div></div>
        <div class="col-md-6"><div class="tier-feature-item"><i class="fas fa-check"></i>Newsletters &amp; automated marketing campaigns</div></div>
        <div class="col-md-6"><div class="tier-feature-item"><i class="fas fa-check"></i>Testimonials, polls, custom forms, lead magnets</div></div>
        <div class="col-md-6"><div class="tier-feature-item"><i class="fas fa-check"></i>Built-in SEO tools &amp; social integration</div></div>
      </div>
      <div class="tier-note">Silver caps at 500 clients / 2 domains / 50&nbsp;MB storage — everything above is unlimited on every other tier.</div>
    </div>

    <div class="tier-row tier-gold">
      <div class="d-flex align-items-center gap-3 mb-3">
        <span class="tier-icon-wrap"><i class="fas fa-star"></i></span>
        <div><div class="fw-bold">Gold adds</div><div class="text-muted small">Campaign &amp; brand polish</div></div>
        <span class="tier-badge-pill">+6 tools</span>
      </div>
      <div class="row g-1">
        <div class="col-md-6"><div class="tier-feature-item"><i class="fas fa-check"></i>Pre-designed e-cards &amp; e-letters</div></div>
        <div class="col-md-6"><div class="tier-feature-item"><i class="fas fa-check"></i>Rotating homepage banner</div></div>
        <div class="col-md-6"><div class="tier-feature-item"><i class="fas fa-check"></i>Coupon manager</div></div>
        <div class="col-md-6"><div class="tier-feature-item"><i class="fas fa-check"></i>Mail merge</div></div>
        <div class="col-md-6"><div class="tier-feature-item"><i class="fas fa-check"></i>Printable client mailing labels</div></div>
        <div class="col-md-6"><div class="tier-feature-item"><i class="fas fa-check"></i>Unlimited clients, domains &amp; 500&nbsp;MB storage</div></div>
      </div>
    </div>

    <div class="tier-row tier-platinum">
      <div class="d-flex align-items-center gap-3 mb-3">
        <span class="tier-icon-wrap"><i class="fas fa-shield-halved"></i></span>
        <div><div class="fw-bold">Platinum adds</div><div class="text-muted small">The real differentiator</div></div>
        <span class="tier-badge-pill">Runs your day</span>
      </div>
      <div class="row g-1">
        <div class="col-md-6"><div class="tier-feature-item"><i class="fas fa-check"></i><span><b>AI Daily Assistant</b> — who to call today, and why</span></div></div>
        <div class="col-md-6"><div class="tier-feature-item"><i class="fas fa-check"></i><span><b>Client Portal</b> — login, messages, documents, appointments</span></div></div>
        <div class="col-md-6"><div class="tier-feature-item"><i class="fas fa-check"></i><span><b>Client invoicing &amp; estimates</b></span></div></div>
        <div class="col-md-6"><div class="tier-feature-item"><i class="fas fa-check"></i>Life-event reminders (birthdays, renewals, anniversaries)</div></div>
        <div class="col-md-6"><div class="tier-feature-item"><i class="fas fa-check"></i>One managed blog post/month, written for you</div></div>
        <div class="col-md-6"><div class="tier-feature-item"><i class="fas fa-check"></i>Managed SEO across every page + PayPal integration</div></div>
      </div>
      <div class="tier-note">This is the plan behind the AI Daily Assistant you'll see in your 30-second preview — the one that tells you who to call today, and why.</div>
    </div>

    <div class="tier-row tier-broker">
      <div class="d-flex align-items-center gap-3 mb-3">
        <span class="tier-icon-wrap"><i class="fas fa-users"></i></span>
        <div><div class="fw-bold">Broker Package adds</div><div class="text-muted small">For teams &amp; brokerages</div></div>
        <span class="tier-badge-pill">Custom</span>
      </div>
      <div class="row g-1">
        <div class="col-md-6"><div class="tier-feature-item"><i class="fas fa-check"></i>Designated support contact</div></div>
        <div class="col-md-6"><div class="tier-feature-item"><i class="fas fa-check"></i>Custom team / multi-agent pricing — contact us</div></div>
      </div>
    </div>
  </div>
</div>

<div class="bg-light py-5" id="pricing">
  <div class="container">
    <div class="text-center mb-5">
      <div class="section-eyebrow mb-2">Pricing</div>
      <h2 class="fw-bold">Simple plans that grow with you</h2>
    </div>
    @if (Model.Any())
    {
      // Union of every feature code across the loaded packages, in a stable order, so the
      // comparison table has one row per feature regardless of which package(s) include it.
      var allFeatures = Model
        .SelectMany(p => p.Features)
        .GroupBy(f => f.FeatureCode)
        .Select(g => g.OrderBy(f => f.SortOrder).First())
        .OrderBy(f => f.SortOrder)
        .ToList();
      Func<string, string> badgeFor = name => name switch
      {
        "IPro Silver" => "Just getting started",
        "IPro Gold" => "Most flexible",
        "IPro Platinum" => "Most complete",
        "Broker Package" => "For teams",
        _ => "Plan"
      };

      <div class="row g-4 justify-content-center">
        @foreach (var package in Model)
        {
          // Platinum, not Gold, is the featured tier -- it's the only one that includes the AI
          // Daily Assistant, Client Portal, and Client Invoicing, which is what the rest of the
          // site (including the /Preview flow) is actually selling.
          var isFeatured = package.PackageName == "IPro Platinum";
          var clientsLabel = package.Features.FirstOrDefault(f => f.FeatureCode == PackageFeatureCodes.Contacts)?.LimitLabel;
          var domainsLabel = package.Features.FirstOrDefault(f => f.FeatureCode == PackageFeatureCodes.MultiDomainSupport)?.LimitLabel;
          var storageLabel = package.Features.FirstOrDefault(f => f.FeatureCode == PackageFeatureCodes.FileUploadCapacity)?.LimitLabel;
          <div class="col-md-6 col-lg-4">
            <div class="card price-card p-4 @(isFeatured ? "featured" : "")">
              <div class="badge @(isFeatured ? "badge-featured" : "badge-plain") align-self-start mb-2">@badgeFor(package.PackageName)</div>
              <h4 class="fw-bold">@package.PackageName</h4>
              @if (!string.IsNullOrWhiteSpace(package.Description))
              {
                <p class="text-muted small">@package.Description</p>
              }
              <div class="my-3">
                @if (package.MonthlyPrice > 0)
                {
                  <span class="price-amount">$@package.MonthlyPrice.ToString("N0")</span><span class="text-muted">/month</span>
                }
                else
                {
                  <span class="price-amount">Contact Us</span>
                }
              </div>
              @if (package.AnnualPrice > 0)
              {
                <p class="text-muted small mb-1">or $@package.AnnualPrice.ToString("N0")/year</p>
              }
              @if (package.SetupFee > 0)
              {
                <p class="text-muted small mb-3">+ $@package.SetupFee.ToString("N0") one-time setup</p>
              }
              @if (clientsLabel != null || domainsLabel != null || storageLabel != null)
              {
                <ul class="list-unstyled small text-muted price-limits mb-0">
                  @if (clientsLabel != null) { <li><b class="text-dark">@clientsLabel</b> clients</li> }
                  @if (domainsLabel != null) { <li><b class="text-dark">@domainsLabel</b> domains</li> }
                  @if (storageLabel != null) { <li><b class="text-dark">@storageLabel</b> storage</li> }
                </ul>
              }
              <a href="/Account/Register" class="btn @(isFeatured ? "btn-primary" : "btn-outline-primary") w-100 fw-semibold mt-auto">Get Started</a>
              <a href="/Preview?package=@Uri.EscapeDataString(package.PackageName)" class="preview-plan-link">See a live @package.PackageName site in 30s <i class="fas fa-arrow-right ms-1 small"></i></a>
            </div>
          </div>
        }
      </div>

      @if (allFeatures.Any())
      {
        <div class="text-center mt-4">
          <button class="btn btn-link fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#compareFeatures" aria-expanded="false" aria-controls="compareFeatures">
            Compare all features <i class="fas fa-chevron-down ms-1 small"></i>
          </button>
        </div>
        <div class="collapse mt-3" id="compareFeatures">
          <div class="table-responsive bg-white rounded-4 shadow-sm p-2">
            <table class="table table-borderless align-middle mb-0">
              <thead>
                <tr>
                  <th class="text-muted small text-uppercase">Feature</th>
                  @foreach (var package in Model)
                  {
                    <th class="text-center">@package.PackageName</th>
                  }
                </tr>
              </thead>
              <tbody>
                @foreach (var feature in allFeatures)
                {
                  <tr>
                    <td class="small">@feature.FeatureName</td>
                    @foreach (var package in Model)
                    {
                      var match = package.Features.FirstOrDefault(f => f.FeatureCode == feature.FeatureCode);
                      <td class="text-center">
                        @if (match != null && match.IsIncluded)
                        {
                          <i class="fas fa-check text-success"></i>
                          @if (!string.IsNullOrWhiteSpace(match.LimitLabel))
                          {
                            <div class="small text-muted">@match.LimitLabel</div>
                          }
                        }
                        else
                        {
                          <i class="fas fa-minus text-muted opacity-50"></i>
                        }
                      </td>
                    }
                  </tr>
                }
              </tbody>
            </table>
          </div>
        </div>
      }
    }
    else
    {
      <p class="text-center text-muted">Pricing is being updated — <a href="/Account/Register">start your registration</a> and we'll follow up with plan details.</p>
    }
  </div>
</div>

<div class="ipro-hero py-5">
  <div class="container text-center">
    <h3 class="fw-bold mb-3">Ready to grow your business?</h3>
    <a href="/Account/Register" class="btn btn-light btn-lg fw-semibold px-5 me-2">Start Your Free Account</a>
    <a href="/Preview" class="btn btn-outline-light btn-lg px-5"><i class="fas fa-wand-magic-sparkles me-2"></i>Haven't seen your site yet? Preview it</a>
  </div>
</div>

<footer class="py-4 bg-white border-top">
  <div class="container d-flex flex-wrap justify-content-between align-items-center small text-muted">
    <span>&copy; @DateTime.UtcNow.Year IPRO Advisers</span>
    <span><a href="/Account/Login" class="text-muted me-3">Sign In</a><a href="/Account/Register" class="text-muted">Register</a></span>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
