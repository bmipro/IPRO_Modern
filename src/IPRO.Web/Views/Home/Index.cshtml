<title>IPRO Advisers - Website, CRM &amp; Marketing for Growing Businesses</title>
<meta name="description" content="@seoDescription"/>
<link rel="canonical" href="@(seoOrigin)/"/>
<meta property="og:type" content="website"/>
<meta property="og:site_name" content="IPRO Advisers"/>
<meta property="og:title" content="IPRO Advisers — Website, CRM &amp; Marketing for Growing Businesses"/>
<meta property="og:description" content="@seoDescription"/>
<meta property="og:url" content="@(seoOrigin)/"/>
<meta property="og:image" content="@(seoOrigin)/images/ipro-advisers-logo.png"/>
