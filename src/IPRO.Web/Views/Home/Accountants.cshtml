@model List<IPRO.Entities.BillingRule>
@inject Microsoft.Extensions.Configuration.IConfiguration AccountantsSeoConfig
@{
    // 478 (2026-09-11): the accountants landing page, from the designer's package
    // (accountants-page-v2-font-revision). The designer's markup and copy are kept as delivered;
    // the four slots -- header, footer, pricing table, preview -- are the platform's.
    ViewData["Title"] = "Websites and Client Management for Accountants in Canada | IPRO Advisers";
    Layout = null;
    var configuredBase = AccountantsSeoConfig["App:BaseUrl"];
    var seoOrigin = !string.IsNullOrWhiteSpace(configuredBase) && !configuredBase.Contains("yourdomain", StringComparison.OrdinalIgnoreCase)
        ? configuredBase.TrimEnd('/')
        : "https://app.iproadvisers.com";
    var rootDomain = ViewBag.TemporaryRootDomain as string ?? "247advisers.com";
    var now = DateTime.UtcNow;
    static string Money(decimal amount) => amount % 1 == 0 ? amount.ToString("N0") : amount.ToString("N2");
}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Websites and Client Management for Accountants in Canada | IPRO Advisers</title>
  <meta name="description" content="A professional website, client portal, follow-ups, documents, and newsletters for Canadian accountants and bookkeepers.">
  <link rel="canonical" href="@seoOrigin/accountants">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Websites and Client Management for Accountants in Canada | IPRO Advisers">
  <meta property="og:description" content="A professional website, client portal, follow-ups, documents, and newsletters for Canadian accountants and bookkeepers.">
  <meta property="og:url" content="@seoOrigin/accountants">
  <link rel="icon" href="/favicon.ico">
  <link rel="stylesheet" href="/css/accountants-page.css" asp-append-version="true">
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>

  @* Slot: HEADER -- the platform's brand and entry points, in the designer's header. *@
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label="IPRO Advisers home">
        <img class="platform-logo" src="/images/ipro-advisers-logo.png" alt="IPRO Advisers">
      </a>
      <nav class="main-nav" aria-label="Main navigation">
        <a href="#built-for-accountants">Built for accountants</a>
        <a href="#see-it">See it</a>
        <a href="#pricing">Pricing</a>
        <a class="nav-signin" href="/Account/Login">Sign in</a>
        <a class="nav-register" href="/Account/Register?businessType=Accountants">Register</a>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">IPRO for accountants and bookkeepers</p>
          <h1>The practice accountants want to find, trust, and stay with.</h1>
          <p class="hero-subline">A professional website, client portal, follow-ups, and newsletters for Canadian accounting practices.</p>
          <div class="button-row">
            <a class="btn btn-primary" href="/Account/Register?businessType=Accountants">Register</a>
            <a class="btn btn-secondary" href="/Preview/Show?businessType=Accountants">See an accountant's site</a>
          </div>
          <p class="hero-note">Try the product before you register with <a href="/Preview">the preview</a>.</p>
        </div>
        <div class="device-stage" aria-label="An accountant's starter site shown on a laptop and a phone">
          <div class="laptop device-shadow">
            <div class="device-bar"><span></span><span></span><span></span><b>yourname.@rootDomain</b></div>
            <div class="site-screen">
              <div class="preview-nav"><strong>Your Practice</strong><span>About</span><span>Services</span><span>Resources</span><span>Contact</span></div>
              <div class="preview-hero"><small>ACCOUNTING FOR REAL LIFE</small><h2>Clear advice for the decisions ahead.</h2><p>Tax preparation, bookkeeping, and planning for people and growing businesses.</p><button type="button" tabindex="-1" aria-hidden="true">Request a meeting</button></div>
              <div class="preview-columns"><div><b>Personal tax</b><span>Know what to bring and what to expect.</span></div><div><b>Bookkeeping</b><span>Keep the numbers ready for decisions.</span></div><div><b>Resources</b><span>Useful answers before your first meeting.</span></div></div>
            </div>
          </div>
          <div class="phone device-shadow">
            <div class="phone-speaker"></div>
            <div class="phone-screen">
              <div class="phone-brand">Your Practice</div>
              <small>ACCOUNTING FOR REAL LIFE</small>
              <h3>Clear advice for the decisions ahead.</h3>
              <a href="/Preview/Show?businessType=Accountants">Request a meeting</a>
              <div class="phone-line"></div><div class="phone-line short"></div><div class="phone-line"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="built-for-accountants" class="section section-light">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Built for the work behind the work</p>
          <h2>Everything your practice needs to stay visible and organized.</h2>
        </div>
        <div class="row benefit-grid">
          <article class="col-lg-3 benefit">
            <img src="/images/accountants/icon-website.svg" alt="">
            <h3>Start with a ready site</h3>
            <p>Accountant starter pages and a Resources section are already written for the questions clients ask first.</p>
          </article>
          <article class="col-lg-3 benefit">
            <img src="/images/accountants/icon-portal.svg" alt="">
            <h3>Keep documents together</h3>
            <p>Clients upload slips and documents, then message your team from the same place.</p>
          </article>
          <article class="col-lg-3 benefit">
            <img src="/images/accountants/icon-followups.svg" alt="">
            <h3>Make follow-ups visible</h3>
            <p>Reminders and follow-ups turn tax season into a list you can work through.</p>
          </article>
          <article class="col-lg-3 benefit">
            <img src="/images/accountants/icon-newsletter.svg" alt="">
            <h3>Stay in touch simply</h3>
            <p>Send newsletters and Did you know teasers from the same articles, in your own name.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="see-it" class="section section-white">
      <div class="container see-grid">
        <div class="preview-frame">
          @* Slot: PREVIEW -- the live accountant starter site, the same one Register hands out. *@
          <div class="preview-shell">
            <div class="preview-toolbar"><span class="toolbar-dot"></span><span class="toolbar-dot"></span><span class="toolbar-dot"></span><span class="toolbar-address">yourname.@rootDomain</span></div>
            <iframe class="preview-live" src="/Preview/Site?businessType=Accountants" title="Preview of the accountant starter site" loading="lazy" referrerpolicy="same-origin"></iframe>
          </div>
        </div>
        <div class="see-copy">
          <p class="eyebrow">See it before you register</p>
          <h2>A site that understands accounting from day one.</h2>
          <p>Every new account starts with this site, already written for accountants. Change anything.</p>
          <a class="text-link" href="/Preview/Show?businessType=Accountants">See an accountant's site <span aria-hidden="true">-&gt;</span></a>
        </div>
      </div>
    </section>

    <section class="section section-blue">
      <div class="container">
        <div class="section-heading centered">
          <p class="eyebrow">A simple start</p>
          <h2>How it works</h2>
        </div>
        <div class="row steps-grid">
          <article class="col-lg-4 step"><span class="step-number">01</span><h3>Register</h3><p>Complete the short registration form for your practice.</p></article>
          <article class="col-lg-4 step"><span class="step-number">02</span><h3>Your site is live</h3><p>Your site starts at <strong>yourname.@rootDomain</strong>.</p></article>
          <article class="col-lg-4 step"><span class="step-number">03</span><h3>Point your domain</h3><p>Use your own domain when you are ready.</p></article>
        </div>
      </div>
    </section>

    <section id="pricing" class="section section-light">
      <div class="container pricing-layout">
        <div class="section-heading">
          <p class="eyebrow">Choose your level of support</p>
          <h2>Pricing that grows with the relationship.</h2>
          <p>Start with the package that fits your practice. Move up when your client management needs grow.</p>
        </div>
        <div>
          @* Slot: PRICING_TABLE -- the live packages, the same rows the platform home shows. *@
          <div class="pricing-cards">
            @foreach (var package in Model)
            {
              var setupFeeDue = package.SetupFee > 0 && !(package.SetupFeeWaived || (package.SetupFeeWaivedUntil.HasValue && package.SetupFeeWaivedUntil.Value > now));
              var included = package.Features.Where(f => f.IsIncluded).OrderBy(f => f.SortOrder).Take(6).ToList();
              <article class="pricing-card">
                <h3>@package.PackageName</h3>
                <p class="price">$@Money(package.MonthlyPrice) <small>per month</small></p>
                <p class="price-note">
                  @if (package.AnnualPrice > 0) { <text>or $@Money(package.AnnualPrice) per year. </text> }
                  @if (setupFeeDue) { <text>One-time setup fee $@Money(package.SetupFee). </text> }
                  Canadian dollars before applicable tax.
                </p>
                @if (included.Count > 0)
                {
                  <ul>
                    @foreach (var feature in included)
                    {
                      <li>@feature.FeatureName@(string.IsNullOrWhiteSpace(feature.LimitLabel) ? "" : $" ({feature.LimitLabel})")</li>
                    }
                  </ul>
                }
                <a class="btn btn-primary" href="/Account/Register?businessType=Accountants&amp;package=@Uri.EscapeDataString(package.PackageName)">Register with @package.PackageName</a>
              </article>
            }
          </div>
          <p class="pricing-more">Every feature, package by package: <a href="/#i2-pricing">compare the full table</a>.</p>
        </div>
      </div>
    </section>

    <section class="trust-band">
      <div class="container trust-grid">
        <div><p class="eyebrow">A Canadian service for Canadian practices</p><h2>One provider. One login. One number to call.</h2></div>
        <div class="trust-points"><p><strong>Canadian</strong><span>Data stored in Canada in Azure Canada East.</span></p><p><strong>Protected</strong><span>Nightly backups keep your work recoverable.</span></p><p><strong>Supported</strong><span>Send a support ticket from inside the product.</span></p></div>
      </div>
    </section>

    <section class="section final-cta">
      <div class="container centered">
        <p class="eyebrow">Ready to see your practice online?</p>
        <h2>Start with a website built for accountants.</h2>
        <div class="button-row centered-row">
          <a class="btn btn-primary" href="/Account/Register?businessType=Accountants">Register</a>
          <a class="btn btn-secondary" href="/Preview">Try the preview</a>
        </div>
      </div>
    </section>
  </main>

  @* Slot: FOOTER -- the platform's footer line and legal links. *@
  <footer class="site-footer">
    <div class="container footer-inner">
      <span>IPRO Advisers</span>
      <span>Websites and client management for professional practices.</span>
      <nav class="footer-links" aria-label="Footer"><a href="/">IPRO Advisers home</a><a href="/Home/Terms">Terms</a><a href="/Home/Privacy">Privacy</a><a href="/Account/Login">Sign in</a></nav>
    </div>
  </footer>
</body>
</html>
