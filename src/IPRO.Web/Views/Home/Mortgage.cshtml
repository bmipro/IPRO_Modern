@model List<IPRO.Entities.BillingRule>
@inject Microsoft.Extensions.Configuration.IConfiguration MortgageSeoConfig
@{
    // 478 (2026-09-11): the mortgage landing page, from the designer's package (mortgage-page-v1,
    // the one with the corrected four-column footer). The designer's markup and copy are kept as
    // delivered; the four slots -- header, footer, pricing table, preview -- are the platform's,
    // the footer and the pricing cards through the partials every vertical page shares.
    ViewData["Title"] = "Websites and Client Management for Mortgage Advisers in Canada | IPRO Advisers";
    ViewData["BusinessType"] = "Mortgage";
    Layout = null;
    var configuredBase = MortgageSeoConfig["App:BaseUrl"];
    var seoOrigin = !string.IsNullOrWhiteSpace(configuredBase) && !configuredBase.Contains("yourdomain", StringComparison.OrdinalIgnoreCase)
        ? configuredBase.TrimEnd('/')
        : "https://app.iproadvisers.com";
    var rootDomain = ViewBag.TemporaryRootDomain as string ?? "247advisers.com";
}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Websites and Client Management for Mortgage Advisers in Canada | IPRO Advisers</title>
  <meta name="description" content="A professional website, client portal, document workflow, follow-ups, and newsletters for Canadian mortgage advisers and brokers.">
  <link rel="canonical" href="@seoOrigin/mortgage">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Websites and Client Management for Mortgage Advisers in Canada | IPRO Advisers">
  <meta property="og:description" content="A professional website, client portal, document workflow, follow-ups, and newsletters for Canadian mortgage advisers and brokers.">
  <meta property="og:url" content="@seoOrigin/mortgage">
  <link rel="icon" href="/favicon.ico">
  <link rel="stylesheet" href="/css/landing-page.css" asp-append-version="true">
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>

  @* Slot: HEADER -- the platform's brand and entry points, in the designer's header. *@
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label="IPRO Advisers home">
        <img class="platform-logo" src="/images/ipro-advisers-logo.png" alt="IPRO Advisers">
      </a>
      <nav class="main-nav" aria-label="Main navigation">
        <a href="#built-for-mortgage-advisers">Built for mortgage advisers</a>
        <a href="#see-it">See it</a>
        <a href="#pricing">Pricing</a>
        <a class="nav-signin" href="/Account/Login">Sign in</a>
        <a class="nav-register" href="/Account/Register?businessType=Mortgage">Register</a>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">IPRO for mortgage advisers and brokers</p>
          <h1>The mortgage practice clients find, trust, and return.</h1>
          <p class="hero-subline">A professional website, client portal, document workflow, follow-ups, and newsletters for Canadian mortgage practices.</p>
          <div class="button-row">
            <a class="btn btn-primary" href="/Account/Register?businessType=Mortgage">Register</a>
            <a class="btn btn-secondary" href="/Preview/Show?businessType=Mortgage">See a mortgage adviser's site</a>
          </div>
          <p class="hero-note">Try the product before you register with <a href="/Preview">the preview</a>.</p>
        </div>
        <div class="device-stage" aria-label="A mortgage adviser's starter site shown on a laptop and a phone">
          <div class="laptop device-shadow">
            <div class="device-bar"><span></span><span></span><span></span><b>yourname.@rootDomain</b></div>
            <div class="site-screen">
              <div class="preview-nav"><strong>Your Practice</strong><span>About</span><span>Solutions</span><span>Resources</span><span>Contact</span></div>
              <div class="preview-hero"><small>MORTGAGE ADVICE FOR REAL LIFE</small><h2>Clear advice for the move ahead.</h2><p>Purchase, refinance, and renewal guidance with a process you can understand.</p><button type="button" tabindex="-1" aria-hidden="true">Request a meeting</button></div>
              <div class="preview-columns"><div><b>Buy a home</b><span>Know what to prepare before you apply.</span></div><div><b>Refinance</b><span>See the options for your next decision.</span></div><div><b>Resources</b><span>Useful answers before your first meeting.</span></div></div>
            </div>
          </div>
          <div class="phone device-shadow">
            <div class="phone-speaker"></div>
            <div class="phone-screen">
              <div class="phone-brand">Your Practice</div>
              <small>MORTGAGE ADVICE FOR REAL LIFE</small>
              <h3>Clear advice for the move ahead.</h3>
              <a href="/Preview/Show?businessType=Mortgage">Request a meeting</a>
              <div class="phone-line"></div><div class="phone-line short"></div><div class="phone-line"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="built-for-mortgage-advisers" class="section section-light">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Built for the work behind the deal</p>
          <h2>Stay visible and organized through every deal.</h2>
        </div>
        <div class="row benefit-grid">
          <article class="col-lg-3 benefit">
            <img src="/images/landing/icon-website.svg" alt="">
            <h3>Start with a ready site</h3>
            <p>Mortgage starter pages, resources, and calculator links are ready for the questions clients ask first.</p>
          </article>
          <article class="col-lg-3 benefit">
            <img src="/images/landing/icon-portal.svg" alt="">
            <h3>Keep documents together</h3>
            <p>Clients upload statements and documents, then message your team from the same place.</p>
          </article>
          <article class="col-lg-3 benefit">
            <img src="/images/landing/icon-followups.svg" alt="">
            <h3>Make every next step visible</h3>
            <p>Reminders and follow-ups keep applications, renewals, and client questions moving.</p>
          </article>
          <article class="col-lg-3 benefit">
            <img src="/images/landing/icon-newsletter.svg" alt="">
            <h3>Stay in touch simply</h3>
            <p>Send newsletters and Did you know teasers from the same articles, in your own name.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="see-it" class="section section-white">
      <div class="container see-grid">
        <div class="preview-frame">
          @* Slot: PREVIEW -- the live mortgage starter site, the same one Register hands out. *@
          <div class="preview-shell">
            <div class="preview-toolbar"><span class="toolbar-dot"></span><span class="toolbar-dot"></span><span class="toolbar-dot"></span><span class="toolbar-address">yourname.@rootDomain</span></div>
            <iframe class="preview-live" src="/Preview/Site?businessType=Mortgage" title="Preview of the mortgage adviser starter site" loading="lazy" referrerpolicy="same-origin"></iframe>
          </div>
        </div>
        <div class="see-copy">
          <p class="eyebrow">See it before you register</p>
          <h2>A site that understands mortgages from day one.</h2>
          <p>Every new account starts with this site, already written for mortgage advisers. Change anything.</p>
          <a class="text-link" href="/Preview/Show?businessType=Mortgage">See a mortgage adviser's site <span aria-hidden="true">-&gt;</span></a>
        </div>
      </div>
    </section>

    <section class="section section-blue">
      <div class="container">
        <div class="section-heading centered">
          <p class="eyebrow">A simple start</p>
          <h2>How it works</h2>
        </div>
        <div class="row steps-grid">
          <article class="col-lg-4 step"><span class="step-number">01</span><h3>Register</h3><p>Complete the short registration form for your practice.</p></article>
          <article class="col-lg-4 step"><span class="step-number">02</span><h3>Your site is live</h3><p>Your site starts at <strong>yourname.@rootDomain</strong>.</p></article>
          <article class="col-lg-4 step"><span class="step-number">03</span><h3>Point your domain</h3><p>Use your own domain when you are ready.</p></article>
        </div>
      </div>
    </section>

    <section id="pricing" class="section section-light">
      <div class="container pricing-layout">
        <div class="section-heading">
          <p class="eyebrow">Choose your level of support</p>
          <h2>Pricing that grows with the relationship.</h2>
          <p>Start with the package that fits your practice. Move up when your client management needs grow.</p>
        </div>
        <div>
          @* Slot: PRICING_TABLE -- the live packages, the same rows the platform home shows. *@
          <partial name="_LandingPricing" model="Model" />
        </div>
      </div>
    </section>

    <section class="trust-band">
      <div class="container trust-grid">
        <div><p class="eyebrow">A Canadian service for Canadian practices</p><h2>One provider. One login. One number to call.</h2></div>
        <div class="trust-points"><p><strong>Canadian</strong><span>Data stored in Canada in Azure Canada East.</span></p><p><strong>Protected</strong><span>Nightly backups keep your work recoverable.</span></p><p><strong>Supported</strong><span>Send a support ticket from inside the product.</span></p></div>
      </div>
    </section>

    <section class="section final-cta">
      <div class="container centered">
        <p class="eyebrow">Ready to see your practice online?</p>
        <h2>Start with a website built for mortgage advisers.</h2>
        <div class="button-row centered-row">
          <a class="btn btn-primary" href="/Account/Register?businessType=Mortgage">Register</a>
          <a class="btn btn-secondary" href="/Preview">Try the preview</a>
        </div>
      </div>
    </section>
  </main>

  @* Slot: FOOTER -- the footer every vertical page shares. *@
  <partial name="_LandingFooter" />
</body>
</html>
