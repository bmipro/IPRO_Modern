@using Microsoft.EntityFrameworkCore
@inject IPRO.DataAccess.IPRODbContext Db
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Client Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" rel="stylesheet"/>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark" style="background:#0f7a52;">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="/ClientPortal"><i class="fas fa-user-shield me-2"></i>Client Portal</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMain">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" href="/ClientPortal"><i class="fas fa-home me-1"></i>Dashboard</a></li>
                <li class="nav-item"><a class="nav-link" href="/ClientPortalMessages"><i class="fas fa-comments me-1"></i>Messages</a></li>
                <li class="nav-item"><a class="nav-link" href="/ClientPortalDocuments"><i class="fas fa-folder me-1"></i>Documents</a></li>
                <li class="nav-item"><a class="nav-link" href="/ClientPortalAppointments"><i class="fas fa-calendar-alt me-1"></i>Appointments</a></li>
                <li class="nav-item"><a class="nav-link" href="/ClientPortal/Invoices"><i class="fas fa-file-invoice-dollar me-1"></i>Invoices</a></li>
                <li class="nav-item"><a class="nav-link" href="/ClientPortalProfile"><i class="fas fa-id-card me-1"></i>My Information</a></li>
                <li class="nav-item"><a class="nav-link" href="/ClientPortalPreferences"><i class="fas fa-bell me-1"></i>Preferences</a></li>
            </ul>
            <ul class="navbar-nav">
                <li class="nav-item">
                    <form asp-controller="ClientPortalAccount" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link nav-link"><i class="fas fa-sign-out-alt me-1"></i>Logout</button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</nav>
<div class="container-fluid py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @RenderBody()
</div>
@{
    // 526: the platform's line under every client-portal page; the link goes to the brand for the
    // client's adviser's business. Read here, once per page, so the seven portal controllers need
    // nothing. A visitor without a client claim (never the case behind this layout) gets the default.
    string? portalBusinessType = null;
    if (int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var portalClientId))
    {
        portalBusinessType = await Db.Clients.AsNoTracking()
            .Where(c => c.Id == portalClientId)
            .Select(c => c.AgentUser.BusinessType)
            .FirstOrDefaultAsync();
    }
}
<footer id="portal-footer" class="container-fluid pb-4 text-muted" style="font-size:11px;opacity:.85">
    Powered by <a href="@IPRO.Entities.PoweredBy.BrandUrl(portalBusinessType)" title="@IPRO.Entities.PoweredBy.BrandName(portalBusinessType)" class="fw-semibold text-reset text-decoration-none">@IPRO.Entities.PoweredBy.Label</a>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script nonce="@Context.GetCspNonce()">
// Same shared confirm-before-submit as the agent portal's _Layout: buttons with
// class="js-confirm-submit" and a data-confirm-message. Inline onsubmit handlers are
// silently dropped by CSP, so this is the only confirm mechanism that actually runs.
document.addEventListener('submit', event => {
    const submitter = event.submitter;
    if (submitter && submitter.classList.contains('js-confirm-submit')) {
        const message = submitter.dataset.confirmMessage || 'Are you sure?';
        if (!confirm(message)) {
            event.preventDefault();
        }
    }
});
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
