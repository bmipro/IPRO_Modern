@model string
@{
    var editorId = ViewData["EditorId"]?.ToString() ?? "richEditor";
    var fieldName = ViewData["FieldName"]?.ToString() ?? "Content";
    var height = ViewData["Height"]?.ToString() ?? "400";
    var toolbarMode = ViewData["Toolbar"]?.ToString() ?? "full";
    var visualId = $"{editorId}-visual";
    var toolbarId = $"{editorId}-toolbar";
    var sourceId = $"{editorId}-source";
    var showFullToolbar = toolbarMode == "full";
    // 637: the editing area needs a name a screen reader says ("Content, edit text"). The caller's visible
    // label names it when the caller gives that label an id (LabelId); otherwise a short Label is used.
    var labelId = ViewData["LabelId"]?.ToString();
    var label = ViewData["Label"]?.ToString() ?? "Text";
}

<div class="ipro-rich-editor" data-editor-root="@editorId">
    <div id="@toolbarId" class="ipro-rich-toolbar" role="toolbar" aria-label="Rich text editor toolbar">
        <button type="button" data-command="bold" title="Bold" aria-label="Bold"><i class="fas fa-bold" aria-hidden="true"></i></button>
        <button type="button" data-command="italic" title="Italic" aria-label="Italic"><i class="fas fa-italic" aria-hidden="true"></i></button>
        <button type="button" data-command="underline" title="Underline" aria-label="Underline"><i class="fas fa-underline" aria-hidden="true"></i></button>
        <span class="ipro-toolbar-separator"></span>
        <button type="button" data-command="insertUnorderedList" title="Bulleted list" aria-label="Bulleted list"><i class="fas fa-list-ul" aria-hidden="true"></i></button>
        <button type="button" data-command="insertOrderedList" title="Numbered list" aria-label="Numbered list"><i class="fas fa-list-ol" aria-hidden="true"></i></button>
        @if (showFullToolbar)
        {
            @* 637: headings, so a long article has a structure a screen reader can move through (Heading,
               Subheading, and back to Normal text). *@
            <span class="ipro-toolbar-separator"></span>
            <button type="button" data-command="formatBlock" data-value="h2" title="Heading" aria-label="Heading"><span class="ipro-toolbar-text" aria-hidden="true">H2</span></button>
            <button type="button" data-command="formatBlock" data-value="h3" title="Subheading" aria-label="Subheading"><span class="ipro-toolbar-text" aria-hidden="true">H3</span></button>
            <button type="button" data-command="formatBlock" data-value="p" title="Normal text" aria-label="Normal text"><i class="fas fa-paragraph" aria-hidden="true"></i></button>
            <span class="ipro-toolbar-separator"></span>
            <button type="button" data-command="justifyLeft" title="Align left" aria-label="Align left"><i class="fas fa-align-left" aria-hidden="true"></i></button>
            <button type="button" data-command="justifyCenter" title="Align center" aria-label="Align center"><i class="fas fa-align-center" aria-hidden="true"></i></button>
            <button type="button" data-command="justifyRight" title="Align right" aria-label="Align right"><i class="fas fa-align-right" aria-hidden="true"></i></button>
            <span class="ipro-toolbar-separator"></span>
            <button type="button" data-command="createLink" title="Insert link" aria-label="Insert link"><i class="fas fa-link" aria-hidden="true"></i></button>
            <button type="button" data-command="removeFormat" title="Clear formatting" aria-label="Clear formatting"><i class="fas fa-eraser" aria-hidden="true"></i></button>
        }
        <span class="ipro-toolbar-spacer"></span>
        <button type="button" data-command="toggleSource" title="HTML source" aria-label="HTML source"><i class="fas fa-code" aria-hidden="true"></i></button>
    </div>
    <div id="@visualId" class="ipro-rich-surface" contenteditable="true" role="textbox" aria-multiline="true" aria-labelledby="@labelId" aria-label="@(labelId == null ? label : null)" style="min-height:@(height)px">@Html.Raw(IPRO.Business.Services.HtmlContentSanitizer.Sanitize(Model ?? string.Empty))</div>
    <textarea id="@sourceId" class="form-control ipro-rich-source d-none" rows="10" aria-label="@(labelId == null ? label : "Text") as HTML">@Model</textarea>
    <textarea id="@editorId" name="@fieldName" class="d-none" data-custom-rich-editor="true">@Model</textarea>
</div>

<style>
    .ipro-rich-editor {
        border: 1px solid #d5deea;
        border-radius: 12px;
        overflow: hidden;
        background: #fff;
        box-shadow: inset 0 1px 0 rgba(15, 23, 42, .03);
    }
    .ipro-rich-toolbar {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 8px;
        border-bottom: 1px solid #e5eaf2;
        background: #f8fafc;
    }
    .ipro-rich-toolbar button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 32px;
        border: 1px solid transparent;
        border-radius: 7px;
        background: transparent;
        color: #334155;
    }
    .ipro-rich-toolbar button:hover,
    .ipro-rich-toolbar button.active {
        border-color: #c9d8ef;
        background: #eaf2ff;
        color: #0d6efd;
    }
    .ipro-toolbar-separator {
        width: 1px;
        height: 24px;
        margin: 0 4px;
        background: #dbe3ef;
    }
    .ipro-toolbar-text {
        font-weight: 700;
        font-size: .8rem;
    }
    .ipro-toolbar-spacer {
        flex: 1;
    }
    .ipro-rich-surface {
        padding: 16px;
        outline: none;
        overflow: auto;
        line-height: 1.55;
        color: #172033;
    }
    .ipro-rich-surface:focus {
        box-shadow: inset 0 0 0 3px rgba(13, 110, 253, .12);
    }
    .ipro-rich-surface p {
        margin: 0 0 .85rem;
    }
    .ipro-rich-source {
        border: 0;
        border-radius: 0;
        min-height: 220px;
        font-family: Consolas, "Courier New", monospace;
        font-size: .9rem;
    }
</style>

<script nonce="@Context.GetCspNonce()">
(function () {
    const hidden = document.getElementById('@editorId');
    const visual = document.getElementById('@visualId');
    const source = document.getElementById('@sourceId');
    const toolbar = document.getElementById('@toolbarId');
    if (!hidden || !visual || !source || !toolbar) return;

    function syncFromVisual() {
        hidden.value = visual.innerHTML.trim();
        source.value = hidden.value;
    }

    function syncFromSource() {
        hidden.value = source.value.trim();
        visual.innerHTML = hidden.value;
    }

    function toggleSource() {
        if (source.classList.contains('d-none')) {
            syncFromVisual();
            visual.classList.add('d-none');
            source.classList.remove('d-none');
        } else {
            syncFromSource();
            source.classList.add('d-none');
            visual.classList.remove('d-none');
            visual.focus();
        }
    }

    toolbar.addEventListener('click', function (event) {
        const button = event.target.closest('button[data-command]');
        if (!button) return;

        event.preventDefault();
        const command = button.dataset.command;
        if (command === 'toggleSource') {
            toggleSource();
            return;
        }

        if (!source.classList.contains('d-none')) {
            syncFromSource();
            source.classList.add('d-none');
            visual.classList.remove('d-none');
        }

        visual.focus();
        if (command === 'formatBlock') {
            document.execCommand(command, false, button.dataset.value);
        } else if (command === 'createLink') {
            const url = prompt('Enter the link URL');
            if (url) document.execCommand(command, false, url);
        } else {
            document.execCommand(command, false, null);
        }
        syncFromVisual();
    });

    visual.addEventListener('input', syncFromVisual);
    source.addEventListener('input', syncFromSource);

    document.addEventListener('submit', function (event) {
        const form = event.target;
        if (!form || !form.contains(hidden)) return;

        if (source.classList.contains('d-none')) {
            syncFromVisual();
        } else {
            syncFromSource();
        }
    }, true);
})();
</script>
