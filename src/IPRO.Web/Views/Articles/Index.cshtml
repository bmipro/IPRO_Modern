@model IEnumerable<IPRO.Entities.Article>
@{
    ViewData["Title"] = "Articles";
}

<div class="d-flex gap-2 mb-3">
  <a href="/Newsletter" class="btn btn-sm btn-outline-secondary">Newsletters</a>
  <a href="/Articles" class="btn btn-sm btn-success">Articles</a>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold mb-0"><i class="fas fa-file-lines me-2 text-success"></i>Articles</h2>
    <small class="text-muted">@Model.Count() reusable article@(Model.Count() == 1 ? "" : "s") — write once, use in newsletters, drip campaigns, and the Did You Know website block.</small>
  </div>
  <a href="/Articles/Create" class="btn btn-success"><i class="fas fa-plus me-1"></i>New Article</a>
</div>

@if (!Model.Any())
{
  <div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5">
      <i class="fas fa-file-lines fa-3x text-muted opacity-25 mb-3 d-block"></i>
      <h5 class="fw-bold">No articles yet</h5>
      <p class="text-muted">Write reusable article content here, then pull it into a Drip Campaign step to power your website's Did You Know block.</p>
      <a href="/Articles/Create" class="btn btn-success"><i class="fas fa-plus me-1"></i>New Article</a>
    </div>
  </div>
}
else
{
  <div class="row g-3">
  @foreach (var article in Model)
  {
    <div class="col-md-6 col-xl-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-start mb-2">
            <span class="badge rounded-pill @(article.IsPublished ? "bg-success" : "bg-secondary")">@(article.IsPublished ? "Published" : "Draft")</span>
            <small class="text-muted">Updated @article.UpdatedAt.ToString("MMM d, yyyy")</small>
          </div>
          <h6 class="fw-bold mb-1">@article.Title</h6>
          @if (!string.IsNullOrWhiteSpace(article.Summary))
          {
            <small class="text-muted">@article.Summary</small>
          }
        </div>
        <div class="card-footer bg-white border-0 px-4 pb-3 d-flex flex-wrap gap-2">
          <a href="/Articles/Edit/@article.Id" class="btn btn-sm btn-outline-primary flex-grow-1"><i class="fas fa-edit me-1"></i>Edit</a>
          <form asp-action="Delete" asp-route-id="@article.Id" method="post" class="flex-grow-1">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-outline-danger w-100"><i class="fas fa-trash me-1"></i>Delete</button>
          </form>
        </div>
      </div>
    </div>
  }
  </div>
}
