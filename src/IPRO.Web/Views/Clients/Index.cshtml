@model IEnumerable<IPRO.Entities.Client>
@{
    ViewData["Title"] = "My Clients";
    DateTime Local(DateTime utc) => IPRO.Web.Infrastructure.AgentTimeZoneHelper.FromUtc(utc, ViewBag.AgentTimeZone as string);   // 588: in the adviser's zone
    var accountTypes = (ViewBag.AccountTypes as IEnumerable<IPRO.Entities.ClientCategory>) ?? Enumerable.Empty<IPRO.Entities.ClientCategory>();
    var selectedAccountTypeId = ViewBag.AccountTypeId as int?;
    var selectedNewsletter = ViewBag.Newsletter as string;
    var contactLimit = ViewBag.ContactLimit as IPRO.Web.Models.ContactLimitStatus;
    var importAccess = ViewBag.ImportAccess as IPRO.Business.Interfaces.PackageFeatureAccess;
    var importIsLocked = importAccess != null && !importAccess.IsIncluded;
    string ImportLockAttributes()
    {
        if (!importIsLocked || importAccess == null)
        {
            return "";
        }

        return $"data-upgrade-lock=\"true\" data-upgrade-title=\"{importAccess.FeatureName}\" data-upgrade-message=\"{importAccess.UpgradeMessage}\"";
    }

    // 651: one page of the list at a time; the page links keep the search and the filters.
    var searchText = ViewBag.Search as string;
    var currentPage = ViewBag.Page as int? ?? 1;
    var pageCount = ViewBag.PageCount as int? ?? 1;
    var matchingCount = ViewBag.MatchingCount as int? ?? 0;
    var pageSize = ViewBag.PageSize as int? ?? 50;
    var firstShown = (currentPage - 1) * pageSize + 1;
    var lastShown = Math.Min(currentPage * pageSize, matchingCount);
    string PageUrl(int target)
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(searchText)) parts.Add("search=" + Uri.EscapeDataString(searchText));
        if (selectedAccountTypeId.HasValue) parts.Add("accountTypeId=" + selectedAccountTypeId.Value);
        if (!string.IsNullOrEmpty(selectedNewsletter)) parts.Add("newsletter=" + Uri.EscapeDataString(selectedNewsletter));
        if (target > 1) parts.Add("page=" + target);
        return "/portal/Clients" + (parts.Count > 0 ? "?" + string.Join("&", parts) : "");
    }
    // The first page, the last, and two either side of this one; null marks a gap.
    var pagerItems = new List<int?>();
    {
        var shown = new SortedSet<int> { 1, pageCount };
        for (var i = currentPage - 2; i <= currentPage + 2; i++)
        {
            if (i >= 1 && i <= pageCount) shown.Add(i);
        }
        int? previous = null;
        foreach (var i in shown)
        {
            if (previous.HasValue && i > previous.Value + 1) pagerItems.Add(null);
            pagerItems.Add(i);
            previous = i;
        }
    }
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h2 class="fw-bold mb-0"><i class="fas fa-users me-2 text-primary"></i>My Clients</h2>
        <small class="text-muted">@ViewBag.TotalCount total contacts</small>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (contactLimit?.CanAdd == false)
        {
            <button type="button" class="btn btn-primary" disabled title="@contactLimit.Message"><i class="fas fa-user-plus me-1"></i>Add Client</button>
        }
        else
        {
            <a href="/portal/Clients/Create" class="btn btn-primary"><i class="fas fa-user-plus me-1"></i>Add Client</a>
        }
        <a href="/portal/Clients/AccountTypes" class="btn btn-outline-primary"><i class="fas fa-tags me-1"></i>Account Types</a>
        <a href="/portal/Clients/RecycleBin" class="btn btn-outline-secondary"><i class="fas fa-trash-can-arrow-up me-1"></i>Recently Deleted</a>
        @if (importIsLocked)
        {
            <button type="button" class="btn btn-outline-secondary" @Html.Raw(ImportLockAttributes())><i class="fas fa-file-import me-1"></i>Import CSV</button>
        }
        else
        {
            <button class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#importModal" @(contactLimit?.CanAdd == false ? "disabled" : "")><i class="fas fa-file-import me-1"></i>Import CSV</button>
        }
        <a href="/portal/Clients/ExportCsv" class="btn btn-outline-success"><i class="fas fa-download me-1"></i>Export</a>
    </div>
</div>

@if (contactLimit != null)
{
    <div class="alert @(contactLimit.CanAdd ? "alert-info" : "alert-warning") border-0 shadow-sm d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <div class="fw-semibold"><i class="fas fa-address-book me-2"></i>Contact usage</div>
            <div class="small">
                @contactLimit.CurrentCount.ToString("N0") of @contactLimit.LimitLabel contacts used
                @if (!string.IsNullOrWhiteSpace(contactLimit.PackageName))
                {
                    <span>on @contactLimit.PackageName</span>
                }
            </div>
            @if (!contactLimit.CanAdd)
            {
                <div class="small mt-1">@contactLimit.Message</div>
            }
        </div>
        @if (!contactLimit.IsUnlimited)
        {
            <a href="/Billing" class="btn btn-sm @(contactLimit.CanAdd ? "btn-outline-primary" : "btn-warning")">Upgrade Package</a>
        }
    </div>
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body p-3">
        <form method="get" class="row g-2">
            <div class="col-lg-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0" placeholder="Search name, company, email, phone, city, or account type..."/>
                </div>
            </div>
            <div class="col-lg-3">
                <select name="accountTypeId" class="form-select">
                    <option value="">All account types</option>
                    @foreach (var type in accountTypes)
                    {
                        <option value="@type.Id" selected="@(selectedAccountTypeId == type.Id)">@type.Name</option>
                    }
                </select>
            </div>
            <div class="col-lg-2">
                <select name="newsletter" class="form-select">
                    <option value="">All newsletter</option>
                    <option value="yes" selected="@(selectedNewsletter == "yes")">Subscribed</option>
                    <option value="no" selected="@(selectedNewsletter == "no")">Not subscribed</option>
                </select>
            </div>
            <div class="col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                @if (!string.IsNullOrEmpty(ViewBag.Search as string) || selectedAccountTypeId.HasValue || !string.IsNullOrEmpty(selectedNewsletter))
                {
                    <a href="/portal/Clients" class="btn btn-outline-secondary"><i class="fas fa-times"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr><th>Name</th><th>Email</th><th>Phone</th><th>City</th><th>Account Types</th><th>Newsletter</th><th>Added</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>
                        <div class="fw-semibold">@c.FirstName @c.LastName</div>
                        @if (!string.IsNullOrWhiteSpace(c.CompanyName))
                        {
                            <small class="text-muted">@c.CompanyName</small>
                        }
                    </td>
                    <td><a href="mailto:@c.Email" class="text-decoration-none text-muted small">@c.Email</a></td>
                    <td><small class="text-muted">@(!string.IsNullOrWhiteSpace(c.CellPhone) ? c.CellPhone : (!string.IsNullOrWhiteSpace(c.Phone) ? c.Phone : "-"))</small></td>
                    <td><small class="text-muted">@(!string.IsNullOrWhiteSpace(c.City) ? c.City : "-")</small></td>
                    <td>
                        @if (c.Categories.Any())
                        {
                            <div class="d-flex flex-wrap gap-1">
                            @foreach (var category in c.Categories.OrderBy(x => x.Name).Take(3))
                            {
                                <span class="badge bg-primary-subtle text-primary rounded-pill">@category.Name</span>
                            }
                            @if (c.Categories.Count > 3)
                            {
                                <span class="badge bg-light text-muted rounded-pill">+@(c.Categories.Count - 3)</span>
                            }
                            </div>
                        }
                        else
                        {
                            <small class="text-muted">-</small>
                        }
                    </td>
                    <td>
                        @if (c.IsNewsletterSubscribed)
                        {
                            <span class="badge bg-success-subtle text-success rounded-pill"><i class="fas fa-check me-1"></i>Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-light text-muted rounded-pill">No</span>
                        }
                    </td>
                    <td><small class="text-muted">@Local(c.CreatedAt).ToString("MMM d, yyyy")</small></td>
                    <td>
                        <div class="d-flex gap-1">
                            <a href="/portal/Clients/Details/@c.Id" class="btn btn-sm btn-outline-primary" title="View"><i class="fas fa-eye"></i></a>
                            <a href="/portal/Clients/Edit/@c.Id" class="btn btn-sm btn-outline-secondary" title="Edit"><i class="fas fa-edit"></i></a>
                            <button type="submit" form="clientDeleteForm" formaction="@Url.Action("Delete", new { id = c.Id })" class="btn btn-sm btn-outline-danger js-confirm-submit" title="Delete" data-confirm-message="Delete @c.FirstName @c.LastName?"><i class="fas fa-trash"></i></button>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center py-5 text-muted">
                        <i class="fas fa-users fa-3x d-block mb-3 opacity-25"></i>
                        No clients found. <a href="/portal/Clients/Create">Add a client</a> or
                        @if (importIsLocked)
                        {
                            <button type="button" class="btn btn-link p-0 align-baseline" @Html.Raw(ImportLockAttributes())>import from CSV</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-link p-0 align-baseline" data-bs-toggle="modal" data-bs-target="#importModal">import from CSV</button>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@* 651: one form and one anti-forgery token for every Delete button on the page; each button names this
   form and gives its own client's address. *@
<form id="clientDeleteForm" method="post" class="d-none">@Html.AntiForgeryToken()</form>

@if (pageCount > 1)
{
    <nav aria-label="Client list pages" class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
        <small class="text-muted">Showing @firstShown.ToString("N0")&ndash;@lastShown.ToString("N0") of @matchingCount.ToString("N0")</small>
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(currentPage <= 1 ? "disabled" : "")"><a class="page-link" href="@PageUrl(currentPage - 1)">Previous</a></li>
            @foreach (var item in pagerItems)
            {
                if (item == null)
                {
                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                }
                else
                {
                    <li class="page-item @(item == currentPage ? "active" : "")"><a class="page-link" href="@PageUrl(item.Value)" aria-current="@(item == currentPage ? "page" : null)">@item</a></li>
                }
            }
            <li class="page-item @(currentPage >= pageCount ? "disabled" : "")"><a class="page-link" href="@PageUrl(currentPage + 1)">Next</a></li>
        </ul>
    </nav>
}

<div class="modal fade" id="importModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold"><i class="fas fa-file-csv me-2 text-success"></i>Import Contacts</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Upload a CSV file. Required columns: <strong>First Name</strong>, <strong>Last Name</strong>, and <strong>Email</strong>. Duplicate emails are skipped.</p>
                @if (contactLimit != null && !contactLimit.IsUnlimited)
                {
                    <div class="alert alert-light border small">
                        You can import up to @contactLimit.Remaining.ToString("N0") more contact@(contactLimit.Remaining == 1 ? "" : "s") with your current package.
                    </div>
                }
                <form asp-action="ImportCsv" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold">CSV File</label>
                        <input type="file" name="file" class="form-control" accept=".csv" required/>
                    </div>
                    <button type="submit" class="btn btn-success w-100"><i class="fas fa-upload me-1"></i>Import Now</button>
                </form>
            </div>
        </div>
    </div>
</div>
