@model IPRO.Billing.ReferralProgram.AdviserView
@using IPRO.Billing
@using IPRO.Entities
@{
    ViewData["Title"] = "Refer a Friend";
    var agent = ViewBag.Agent as AgentUser;
    var settings = Model.Settings;
    var gift = ReferralProgram.Money(settings.FriendGiftAmount);
    var reward = ReferralProgram.Money(settings.ReferrerRewardAmount);
    var running = settings.Enabled && !Model.Code.IsPaused;
    // Shared from the adviser's own email app: iPro never emails the friend (no CASL exposure).
    var senderName = agent == null ? "" : $"{agent.FirstName} {agent.LastName}".Trim();
    var mailSubject = $"A {gift} gift for you";
    var mailBody = $"Hi,\n\nI run my business on iPro: my website, client follow-ups, newsletters and more. If you sign up with my link, you get {gift} off:\n\n{Model.Link}\n\n{senderName}";
    var mailto = $"mailto:?subject={Uri.EscapeDataString(mailSubject)}&body={Uri.EscapeDataString(mailBody)}";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
  <div>
    <h2 class="fw-bold mb-1"><i class="fas fa-gift me-2 text-primary"></i>Refer a Friend</h2>
    <div class="text-muted">Give @gift, Get @reward.</div>
  </div>
  <a href="/portal/Account/Profile" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>My Profile</a>
</div>

@if (!settings.Enabled)
{
  <div class="alert alert-light border mb-4"><i class="fas fa-circle-pause me-2 text-muted"></i>Refer a Friend is not running right now. Referrals you already made are still followed below.</div>
}
else if (Model.Code.IsPaused)
{
  <div class="alert alert-warning mb-4"><i class="fas fa-circle-pause me-2"></i>Your referral link is paused. Please contact support if you think this is a mistake. Referrals you already made are still followed below.</div>
}

<div class="row g-4">
  <div class="col-lg-7">
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body p-4">
        <h5 class="fw-bold mb-2">Your link</h5>
        <p class="text-muted mb-3">Anyone who could use iPro -- a colleague, another business you know -- gets @gift off when they sign up with your link. When they stay, you get @reward back on what you pay iPro.</p>
        @if (running)
        {
          <div class="input-group mb-2">
            <input type="text" id="referralLink" class="form-control" value="@Model.Link" readonly aria-label="Your referral link" />
            <button type="button" class="btn btn-primary" id="copyReferralLink"><i class="fas fa-copy me-1"></i>Copy</button>
          </div>
          <div id="copyReferralResult" class="small text-success mb-3" role="status"></div>
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <a class="btn btn-outline-primary" href="@mailto"><i class="fas fa-envelope me-1"></i>Share by email</a>
            <span class="small text-muted">Opens your own email app with the link in a ready-made note.</span>
          </div>
          <p class="small text-muted mt-3 mb-0">Your code is <strong>@Model.Code.Code</strong>; a friend can also type it in the sign-up's Promotion Code box.</p>
        }
        else
        {
          <p class="mb-0 text-muted">Your link appears here while Refer a Friend is running.</p>
        }
      </div>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <h5 class="fw-bold mb-3">Your referrals</h5>
        @if (Model.Referrals.Count == 0)
        {
          <p class="text-muted mb-0">No referrals yet. Share your link to start.</p>
        }
        else
        {
          <div class="table-responsive">
            <table class="table align-middle mb-0">
              <thead><tr><th>Friend</th><th>Signed up</th><th>Where it stands</th><th class="text-end">Your reward</th></tr></thead>
              <tbody>
              @foreach (var r in Model.Referrals)
              {
                var closed = r.Stage is ReferralStages.NotEarned or ReferralStages.Voided;
                <tr>
                  <td>@r.FriendName</td>
                  <td class="text-nowrap">@r.SignedUpAt.ToString("MMM d, yyyy")</td>
                  <td>@ReferralProgram.AdviserStatus(r)</td>
                  <td class="text-end text-nowrap">
                    @if (r.Stage == ReferralStages.Paid)
                    {
                      <span>@ReferralProgram.Money(r.RewardGross)</span>
                      <a class="d-block small" href="/portal/ReferAFriend/CreditNote/@r.Id">Credit note @r.CreditNoteNumber</a>
                    }
                    else if (closed)
                    {
                      <span class="text-muted">-</span>
                    }
                    else
                    {
                      <span>@ReferralProgram.Money(r.RewardAmount) + tax</span>
                    }
                  </td>
                </tr>
              }
              </tbody>
            </table>
          </div>
        }
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card border-0 shadow-sm mb-4 text-center">
      <div class="card-body p-4">
        <div class="display-6 fw-bold text-primary">@Model.ReferredCount</div>
        <div class="text-muted mb-2">@(Model.ReferredCount == 1 ? "friend referred" : "friends referred")</div>
        <div class="fs-5">You have referred @Model.ReferredCount and earned @ReferralProgram.Money(Model.EarnedTotal).</div>
      </div>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <h5 class="fw-bold mb-3">How it works</h5>
        <ol class="ps-3 mb-0">
          <li class="mb-2">Your friend signs up with your link and gets @gift off: it comes off their setup fee, and off their first month when the setup fee is less.</li>
          <li class="mb-2">When they join, we email you to say so and when your @reward is earned: at their second monthly payment, or 30 days after their first payment on a yearly plan.</li>
          <li class="mb-0">Your @reward, plus its tax, comes back to the card or PayPal account you pay iPro with, and we email you the day it does. Each one has a credit note here.</li>
        </ol>
      </div>
    </div>
  </div>
</div>

<script nonce="@Context.GetCspNonce()">
(function () {
  var button = document.getElementById('copyReferralLink');
  var input = document.getElementById('referralLink');
  var result = document.getElementById('copyReferralResult');
  if (!button || !input) return;
  button.addEventListener('click', function () {
    function selected() { input.focus(); input.select(); result.textContent = 'Selected: press Ctrl+C (or Cmd+C) to copy.'; }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(input.value).then(function () { result.textContent = 'Copied.'; }, selected);
    } else {
      selected();
    }
  });
})();
</script>
