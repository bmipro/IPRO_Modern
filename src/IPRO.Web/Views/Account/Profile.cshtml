@model IPRO.Web.Models.AgentProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    var timeZones = (ViewBag.TimeZones as IEnumerable<string>) ?? IPRO.Web.Infrastructure.AgentTimeZoneHelper.Options;
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
  <div>
    <h2 class="fw-bold mb-1"><i class="fas fa-id-card me-2 text-primary"></i>My Profile</h2>
    <div class="text-muted">Keep your contact, company, and billing address details current.</div>
  </div>
  <a href="/portal/Dashboard" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Dashboard</a>
</div>

@if (!ViewData.ModelState.IsValid)
{
  <div class="alert alert-danger">@Html.ValidationSummary()</div>
}

@* These two forms live outside the main Profile form below because HTML does not allow nested <form> elements
   (browsers silently drop a nested form tag, which would submit the file input as part of the outer Profile
   save instead) -- their controls are placed visually inside the Photo card via the form="" attribute. *@
<form id="uploadPhotoForm" asp-controller="Account" asp-action="UploadPhoto" method="post" enctype="multipart/form-data" class="d-none">@Html.AntiForgeryToken()</form>
@if (!string.IsNullOrWhiteSpace(Model.PhotoUrl))
{
  <form id="removePhotoForm" asp-controller="Account" asp-action="RemovePhoto" method="post" class="d-none">@Html.AntiForgeryToken()</form>
}

@{
    // 593: a new login email takes the current password (and a code with two-step sign-in on); a team
    // member cannot change it.
    var emailChangeByTeamMember = ViewBag.EmailChangeByTeamMember as bool? ?? false;
    var emailChangeTwoStepMethod = ViewBag.EmailChangeTwoStepMethod as string;
}
@if (!emailChangeByTeamMember && emailChangeTwoStepMethod == IPRO.Entities.TwoStepMethods.Email)
{
  <form id="emailMeACodeForm" action="/portal/TwoStep/EmailMeACode" method="post" class="d-none">@Html.AntiForgeryToken()<input type="hidden" name="returnTo" value="profile"/></form>
}

<form asp-action="Profile" method="post">
  @Html.AntiForgeryToken()
  <input type="hidden" asp-for="Id" />

  <div class="row g-4">
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4 text-center">
          <h5 class="fw-bold mb-3 text-start">Photo</h5>
          @if (!string.IsNullOrWhiteSpace(Model.PhotoUrl))
          {
            <img src="@Model.PhotoUrl" alt="@Model.FirstName @Model.LastName" class="rounded-circle mb-3" style="width:120px;height:120px;object-fit:cover;" />
          }
          else
          {
            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto mb-3" style="width:120px;height:120px;">
              <i class="fas fa-user text-muted" style="font-size:2.5rem;"></i>
            </div>
          }
          <div class="form-text mb-3">Used on your newsletters and public website. JPG, PNG, GIF, or WebP, up to 8 MB.</div>
          <div class="d-flex flex-column gap-2">
            <input type="file" name="photo" form="uploadPhotoForm" accept=".jpg,.jpeg,.jfif,.jpe,.png,.gif,.webp" class="form-control form-control-sm" required />
            <button type="submit" form="uploadPhotoForm" class="btn btn-sm btn-outline-primary"><i class="fas fa-upload me-1"></i>Upload Photo</button>
          </div>
          @if (!string.IsNullOrWhiteSpace(Model.PhotoUrl))
          {
            <button type="submit" form="removePhotoForm" class="btn btn-sm btn-outline-danger mt-2 js-confirm-submit" data-confirm-message="Remove your profile photo?"><i class="fas fa-trash me-1"></i>Remove Photo</button>
          }
        </div>
      </div>

      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="fw-bold mb-3">Account</h5>
          <div class="mb-3">
            <label class="form-label fw-semibold">Username</label>
            <input asp-for="UserName" class="form-control" readonly />
            <div class="form-text">Usernames are managed by IPRO Admin.</div>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Temporary Website Domain</label>
            <input asp-for="DomainName" class="form-control" readonly />
          </div>
          <div class="mb-0">
            <label class="form-label fw-semibold">Current Package</label>
            <input asp-for="PackageName" class="form-control" readonly />
            <div class="form-text"><a href="/Billing">Manage billing and package changes</a></div>
          </div>
        </div>
      </div>

      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
          <h5 class="fw-bold mb-3">Login Email</h5>
          <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
          @if (emailChangeByTeamMember)
          {
            <input asp-for="Email" type="email" class="form-control" maxlength="200" required readonly />
          }
          else
          {
            <input asp-for="Email" type="email" class="form-control" maxlength="200" required />
          }
          <div class="form-text">Invoices and system messages use this email, and your clients' replies come to it. Password resets and emailed sign-in codes go to it too.</div>
          @if (emailChangeByTeamMember)
          {
            <div class="form-text">Only the account owner can change the login email.</div>
          }
          else
          {
            <label for="CurrentPassword" class="form-label fw-semibold mt-3">Current password <span class="fw-normal text-muted">(only to change the email)</span></label>
            <input id="CurrentPassword" name="CurrentPassword" type="password" class="form-control" autocomplete="current-password" />
            @if (emailChangeTwoStepMethod != null)
            {
              <label for="TwoStepCode" class="form-label fw-semibold mt-3">Two-step code <span class="fw-normal text-muted">(only to change the email)</span></label>
              <input id="TwoStepCode" name="TwoStepCode" type="text" class="form-control" autocomplete="one-time-code" maxlength="20" />
              @if (emailChangeTwoStepMethod == IPRO.Entities.TwoStepMethods.Email)
              {
                <button type="submit" form="emailMeACodeForm" class="btn btn-link px-0">Email me a code</button>
              }
            }
          }
        </div>
      </div>
    </div>

    <div class="col-lg-8">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="fw-bold mb-3">Contact Information</h5>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold">First Name <span class="text-danger">*</span></label>
              <input asp-for="FirstName" class="form-control" maxlength="80" required />
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Last Name <span class="text-danger">*</span></label>
              <input asp-for="LastName" class="form-control" maxlength="80" required />
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Designation</label>
              <input asp-for="Designation" class="form-control" maxlength="80" />
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Business Type <span class="text-danger">*</span></label>
              <select asp-for="BusinessType" class="form-select" required>
                <option value="">Click here</option>
                @* 494: the one list every business-type form shares (StarterBusinessTypes.Offered). *@
                @foreach (var businessTypeOption in IPRO.DataAccess.StarterBusinessTypes.Offered)
                {
                  <option value="@businessTypeOption.Value">@businessTypeOption.Label</option>
                }
              </select>
            </div>
          </div>
        </div>
      </div>

      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="fw-bold mb-3">Company Details</h5>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold">Company Name <span class="text-danger">*</span></label>
              <input asp-for="CompanyName" class="form-control" maxlength="150" required />
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Company Address</label>
              <input asp-for="CompanyAddress" class="form-control" maxlength="200" />
              <div class="form-text">Shown with your company name at the foot of your marketing emails: Canada's anti-spam law asks for a mailing address.</div>
            </div>
            @* 570: asked for where the business's other printed details are; nothing is printed while it is empty. *@
            <div class="col-md-6">
              <label asp-for="TaxRegistrationNumber" class="form-label fw-semibold">GST/HST number</label>
              <input asp-for="TaxRegistrationNumber" class="form-control" maxlength="60" placeholder="123456789 RT0001" autocomplete="off" />
              <div class="form-text">Printed on the invoices and estimates you send to clients. Leave it empty if you are not registered for GST/HST.</div>
            </div>
            <div class="col-md-6 d-none d-md-block"></div>
            <div class="col-md-4">
              <label class="form-label fw-semibold">City <span class="text-danger">*</span></label>
              <input asp-for="City" class="form-control" maxlength="80" required />
            </div>
            <div class="col-md-4">
              <label class="form-label fw-semibold">Province/State <span class="text-danger">*</span></label>
              @* F3 (billing wave 3, 2026-08-25): a free-text box here silently zero-rated all
                 future tax for anything the normalizer didn't recognize ("PEI" cost 15% HST on
                 every charge, with no log). Same dropdown as Register; a legacy/US value the
                 list doesn't contain is preserved as a selectable option so saving the profile
                 never silently rewrites it. *@
              @{
                var provinceOptions = new[] { "Alberta", "British Columbia", "Manitoba", "New Brunswick",
                  "Newfoundland", "Northwest Territories", "Nova Scotia", "Nunavut", "Ontario",
                  "Prince Edward Island", "Quebec", "Saskatchewan", "Yukon Territory" };
              }
              <select asp-for="Province" class="form-select" required>
                @if (!string.IsNullOrWhiteSpace(Model.Province) && !provinceOptions.Contains(Model.Province, StringComparer.OrdinalIgnoreCase))
                {
                  <option value="@Model.Province" selected>@Model.Province</option>
                }
                @foreach (var prov in provinceOptions)
                {
                  <option>@prov</option>
                }
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label fw-semibold">Postal Code <span class="text-danger">*</span></label>
              <input asp-for="PostalCode" class="form-control" maxlength="20" required />
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Country <span class="text-danger">*</span></label>
              <input asp-for="Country" class="form-control" maxlength="80" required />
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Time Zone</label>
              <select asp-for="TimeZone" class="form-select">
                @foreach (var zone in timeZones)
                {
                  <option value="@zone">@zone</option>
                }
              </select>
              <div class="form-text">Schedules and reminders use this time zone.</div>
            </div>
            <div class="col-12">
              <div class="form-check">
                <input asp-for="FollowUpReminderEmails" class="form-check-input" />
                <label asp-for="FollowUpReminderEmails" class="form-check-label fw-semibold">Email me my follow-ups each morning</label>
              </div>
              <div class="form-text">One email around 7 a.m. in your time zone, on days when a follow-up is due or has just become overdue, and every Monday while anything is still overdue.</div>
            </div>
          </div>
        </div>
      </div>

      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="fw-bold mb-3">Phone</h5>
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label fw-semibold">Business Phone <span class="text-danger">*</span></label>
              <input asp-for="Phone" class="form-control" maxlength="40" required />
            </div>
            <div class="col-md-4">
              <label class="form-label fw-semibold">Fax</label>
              <input asp-for="BusinessFax" class="form-control" maxlength="40" />
            </div>
            <div class="col-md-4">
              <label class="form-label fw-semibold">Mobile</label>
              <input asp-for="CellPhone" class="form-control" maxlength="40" />
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Promotion Code</label>
              <input asp-for="PromotionCode" class="form-control" maxlength="80" readonly />
              <div class="form-text">Recorded at sign-up. Contact support if it needs changing.</div>
            </div>
          </div>
        </div>
      </div>

      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="fw-bold mb-3">Client Invoicing</h5>
          <div class="text-muted">How your clients pay your invoices -- PayPal, card, Square, Interac e-Transfer or your own payment page -- is set on the <a href="/portal/Payments">Payments</a> page under Client Invoices.</div>
        </div>
      </div>

      <div class="d-flex justify-content-end gap-2">
        <a href="/portal/Dashboard" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Save Profile</button>
      </div>
    </div>
  </div>
</form>

@{
    // 532: Refer a Friend, just above Calendar Source (the owner: "a button ... just above Calendar Source under
    // agents profile called refer a friend"); it opens its own page.
    var referralSummary = ViewBag.ReferralSummary as IPRO.Billing.ReferralProgram.Summary;
}
@if (referralSummary?.ShowCard == true)
{
  <div class="card border-0 shadow-sm mt-4">
    <div class="card-body p-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
      <div>
        <h5 class="fw-bold mb-1"><i class="fas fa-gift me-2 text-primary"></i>Refer a Friend</h5>
        <div class="text-muted small">Give @IPRO.Billing.ReferralProgram.Money(referralSummary.Gift), Get @IPRO.Billing.ReferralProgram.Money(referralSummary.Reward): anyone you refer gets @IPRO.Billing.ReferralProgram.Money(referralSummary.Gift) off when they sign up, and you get @IPRO.Billing.ReferralProgram.Money(referralSummary.Reward) back when they stay.</div>
        <div class="small mt-1">You have referred @referralSummary.Referred and earned @IPRO.Billing.ReferralProgram.Money(referralSummary.Earned).</div>
      </div>
      <a href="/portal/ReferAFriend" class="btn btn-primary"><i class="fas fa-gift me-1"></i>Refer a Friend</a>
    </div>
  </div>
}

@{
    var googleAccess = ViewBag.GoogleCalendarAccess as IPRO.Business.Interfaces.PackageFeatureAccess;
    var googleConnection = ViewBag.GoogleCalendarConnection as IPRO.Entities.GoogleCalendarConnection;
    var googleIncluded = googleAccess?.IsIncluded == true;
}
<div class="card border-0 shadow-sm mt-4">
  <div class="card-body p-4">
    <h5 class="fw-bold mb-1"><i class="fab fa-google me-2 text-primary"></i>Calendar Source</h5>
    <div class="text-muted small mb-3">By default your Calendar runs on IPRO alone. Connect Google Calendar for a two-way sync: follow-ups you add here appear in Google, and events you add in Google appear here.</div>

    @if (!googleIncluded)
    {
      <div class="alert alert-light border d-flex justify-content-between align-items-center flex-wrap gap-2 mb-0">
        <span><i class="fas fa-lock me-2 text-muted"></i>@(googleAccess?.UpgradeMessage ?? "Google Calendar sync requires a package upgrade.")</span>
        <a href="/Billing" class="btn btn-sm btn-outline-primary">View Packages</a>
      </div>
    }
    else if (googleConnection != null)
    {
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="text-success"><i class="fas fa-circle-check me-2"></i>Connected as <strong>@googleConnection.GoogleAccountEmail</strong></span>
        <form asp-controller="GoogleCalendar" asp-action="Disconnect" method="post">
          @Html.AntiForgeryToken()
          @* js-confirm-submit, not onsubmit=confirm(): CSP's script-src drops inline handlers, which
             made the old confirm silently vanish -- the Disconnect fired with no prompt at all. *@
          <button type="submit" class="btn btn-sm btn-outline-danger js-confirm-submit"
                  data-confirm-message="Disconnect Google Calendar? The events copied in from Google will be removed from your IPRO calendar and syncing stops. Your own follow-ups stay here, and the events already on your Google Calendar stay there.">Disconnect</button>
        </form>
      </div>
    }
    else
    {
      <a asp-controller="GoogleCalendar" asp-action="Connect" class="btn btn-outline-primary"><i class="fab fa-google me-1"></i>Connect Google Calendar</a>
    }
  </div>
</div>
