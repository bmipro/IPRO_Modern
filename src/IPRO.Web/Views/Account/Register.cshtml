@model IPRO.Web.Models.AgentRegistrationViewModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
    // The terms shown here render from Views/Shared/_LegalTerms.cshtml -- the SAME partial /terms
    // publishes. Previously this read a flat wwwroot/content/ipro_agreement.txt that nothing else
    // used, so the text a subscriber accepted could silently diverge from anything we published.
    // One source, both places. Do not reintroduce a second copy.
    var verificationDisplayCode = ViewBag.VerificationCode as string ?? "0000";
    var packages = ((ViewBag.Packages as IEnumerable<IPRO.Entities.BillingRule>) ?? Enumerable.Empty<IPRO.Entities.BillingRule>()).ToList();
    var timeZones = (ViewBag.TimeZones as IEnumerable<string>) ?? IPRO.Web.Infrastructure.AgentTimeZoneHelper.Options;
    var trialPackage = ViewBag.TrialPackage as IPRO.Entities.BillingRule;
    var trialCodeError = ViewBag.TrialCodeError as string;
    // Set when the visitor arrived from a pricing card (?package=): the plan is locked into a
    // summary banner instead of being re-asked in a dropdown.
    var selectedPackage = ViewBag.SelectedPackage as IPRO.Entities.BillingRule;
    var planIsLocked = Model.PlanLocked && selectedPackage != null && trialPackage == null;
}
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>IPRO Advisers Registration</title>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" rel="stylesheet"/>
<style>
:root{
  color-scheme:light;
  --ink:#172033;--muted:#667085;--line:#dbe2ee;--soft:#f6f8fb;
  --blue:#1457d9;--blue2:#0d3f9e;--navy:#0a1c37;
  --blue-soft:#eef4ff;--blue-soft-line:#d7e4fb;
  --gold:#e8ab1f;--gold-soft:#fff6e2;
  --danger:#c9182b;--danger-soft:#fff2f4;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;min-height:100%;background:#eef2f8;color:var(--ink);font-family:"Segoe UI",Roboto,Arial,Helvetica,sans-serif;font-size:15px;}
body:before{
  content:"";position:fixed;inset:0 0 auto 0;height:280px;
  background:
    radial-gradient(900px 420px at 12% -10%,rgba(255,255,255,.10),transparent 60%),
    linear-gradient(115deg,var(--navy) 0%,var(--blue2) 55%,var(--blue) 100%);
  z-index:-1;
}
.page{width:min(1080px,calc(100% - 32px));margin:0 auto 56px;padding-top:44px;}
.shell{background:#fff;border:1px solid rgba(215,222,234,.7);box-shadow:0 30px 80px rgba(10,28,55,.28);border-radius:20px;overflow:hidden;}

.hero{
  position:relative;display:flex;justify-content:space-between;gap:24px;align-items:center;
  padding:36px 38px;border-bottom:1px solid #e2e8f2;overflow:hidden;
  background:
    radial-gradient(520px 220px at 100% -20%,rgba(232,171,31,.14),transparent 65%),
    linear-gradient(180deg,#f3f6fb 0%,#e8edf6 100%);
}
.hero:after{content:"";position:absolute;left:0;right:0;bottom:0;height:4px;background:linear-gradient(90deg,var(--gold),var(--blue),var(--navy));}
.brand-mark{display:flex;align-items:center;justify-content:center;max-width:400px;padding:6px 0;}
.logo{display:block;width:min(340px,100%);height:auto;filter:drop-shadow(0 8px 16px rgba(16,32,51,.16));}
.hero-copy{max-width:380px;text-align:right;}
.eyebrow{display:inline-flex;align-items:center;gap:7px;font-size:12px;font-weight:800;color:var(--blue2);text-transform:uppercase;letter-spacing:.09em;margin-bottom:10px;}
.eyebrow:before{content:"";width:16px;height:2px;background:var(--gold);border-radius:2px;}
.hero h1{font-family:Georgia,Cambria,"Times New Roman",serif;font-size:30px;line-height:1.15;margin:0 0 10px;font-weight:700;color:var(--navy);}
.hint{margin:0;color:var(--muted);font-size:13px;}
.required{color:var(--danger);font-weight:800;}

.validation{margin:24px 38px 0;padding:14px 16px;border:1px solid #f1adb6;background:var(--danger-soft);color:#8a0010;border-radius:10px;font-size:14px;}

form{padding:32px 38px 38px;display:flex;flex-direction:column;gap:22px;}

.field-card{border:1px solid var(--line);background:var(--soft);border-radius:16px;padding:22px 24px 26px;}
.field-card-head{display:flex;align-items:center;gap:12px;margin-bottom:18px;}
.field-card-icon{
  display:flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:10px;
  background:var(--blue-soft);color:var(--blue2);font-size:14px;flex:none;
  box-shadow:inset 0 0 0 1px var(--blue-soft-line);
}
.field-card-head h2{margin:0;font-size:13px;font-weight:800;color:#344054;text-transform:uppercase;letter-spacing:.07em;}

.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 22px;}
.form-row{display:flex;flex-direction:column;gap:7px;margin:0;}
.form-row label{font-size:13px;font-weight:700;color:#26364f;}
input[type=text],input[type=email],input[type=password],select,textarea{width:100%;border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:9px;font:inherit;outline:none;transition:border-color .15s,box-shadow .15s,background .15s;}
input[type=text],input[type=email],input[type=password],select{height:43px;padding:9px 12px;}
input:focus,select:focus,textarea:focus{border-color:#6d96ee;box-shadow:0 0 0 4px rgba(20,87,217,.14);}
select{appearance:auto;}

.agreement-row{grid-column:1/-1;}
.terms-box{border:1px solid var(--line);border-radius:12px;background:#fff;box-shadow:inset 0 2px 10px rgba(16,32,51,.05);overflow:hidden;}
.terms-box-head{display:flex;align-items:center;gap:8px;padding:10px 14px;background:#f4f7fb;border-bottom:1px solid var(--line);font-size:12px;font-weight:800;color:#4a5670;text-transform:uppercase;letter-spacing:.06em;}
.terms-box-head i{color:var(--blue2);}
textarea{height:200px;padding:14px;font-family:Consolas,"Courier New",monospace;font-size:13px;line-height:1.5;white-space:pre-wrap;background:#fbfcff;border:0;border-radius:0;}
textarea:focus{box-shadow:none;}

/* Terms acceptance box. Renders the same _LegalTerms partial that /terms publishes, so the
   styles below re-scope that partial's markup down to fit a 260px scroll pane. */
.terms-box-head .terms-box-open{margin-left:auto;font-size:11px;font-weight:700;color:var(--blue2);text-decoration:none;text-transform:none;letter-spacing:0;}
.terms-box-head .terms-box-open:hover{text-decoration:underline;}
.terms-scroll{height:260px;overflow-y:auto;padding:16px 18px;background:#fbfcff;font-size:13px;line-height:1.6;color:#2b3648;}
.terms-scroll:focus-visible{outline:2px solid var(--blue2);outline-offset:-2px;}
.terms-scroll h1{margin:0 0 4px;font-size:17px;color:var(--navy);font-weight:800;}
.terms-scroll h2{margin:18px 0 6px;font-size:13.5px;color:var(--navy);font-weight:800;padding-top:11px;border-top:1px solid #e7edf5;}
.terms-scroll h2:first-of-type{border-top:0;padding-top:0;}
.terms-scroll h3{margin:12px 0 4px;font-size:12.5px;color:var(--navy);font-weight:700;}
.terms-scroll p{margin:0 0 9px;}
.terms-scroll ul{margin:0 0 9px;padding-left:19px;}
.terms-scroll li{margin-bottom:5px;}
.terms-scroll a{color:var(--blue2);}
.terms-scroll strong{color:#16233a;}
.terms-scroll .lg-org{font-weight:700;margin:0 0 2px;}
.terms-scroll .lg-dates{font-size:11.5px;color:var(--muted);margin:0 0 14px;}
.terms-scroll .lg-callout{background:#eef4fb;border-left:3px solid var(--blue2);padding:9px 12px;border-radius:0 6px 6px 0;margin:0 0 11px;}
.terms-scroll .lg-callout p:last-child{margin-bottom:0;}
.terms-scroll .lg-todo{background:#fef08a;color:#713f12;padding:1px 5px;border-radius:3px;font-weight:700;font-size:.9em;white-space:nowrap;}
.terms-scroll .lg-table-wrap{overflow-x:auto;margin:0 0 11px;}
.terms-scroll table{border-collapse:collapse;width:100%;font-size:12px;}
.terms-scroll th,.terms-scroll td{text-align:left;vertical-align:top;padding:6px 9px;border:1px solid #e2e9f2;}
.terms-scroll th{background:#f4f7fb;font-weight:700;color:var(--navy);}

.verify-row{display:grid;grid-template-columns:minmax(160px,240px) auto 1fr;gap:12px;align-items:end;}
.verify-row label{grid-column:1/-1;}
.verify-code{
  display:inline-flex;align-items:center;gap:7px;min-height:43px;padding:0 16px;border-radius:9px;
  background:linear-gradient(180deg,var(--navy),var(--blue2));color:#fff;
  font-weight:800;font-size:19px;letter-spacing:6px;font-family:Georgia,serif;vertical-align:middle;
  box-shadow:0 8px 18px rgba(13,63,158,.28);
}
.verify-hint{grid-column:1/-1;margin:-4px 0 0;font-size:12.5px;color:var(--muted);}

.terms-check{display:flex;align-items:flex-start;gap:10px;margin-top:14px;font-size:14px;color:#344054;}

.plan-summary-row{grid-column:1/-1;}
.plan-summary{border:1px solid var(--blue-soft-line);background:var(--blue-soft);border-radius:12px;padding:16px 18px;}
.plan-summary-name{font-family:Georgia,Cambria,serif;font-size:20px;font-weight:700;color:var(--navy);}
.plan-summary-price{margin-top:4px;font-size:14px;color:#2c4368;font-weight:600;}
.plan-summary-period{display:flex;gap:22px;flex-wrap:wrap;margin-top:12px;font-size:14px;color:#26364f;}
.plan-summary-period label{display:flex;align-items:center;gap:7px;font-weight:600;cursor:pointer;}
.plan-summary-period input{accent-color:var(--blue);width:16px;height:16px;}
.plan-summary-change{display:inline-block;margin-top:10px;font-size:13px;font-weight:700;color:var(--blue2);}
.terms-check input{width:18px;height:18px;margin-top:1px;accent-color:var(--blue);}

.footer-bar{display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;padding-top:4px;}
.payment{display:flex;align-items:center;gap:10px;color:var(--muted);font-size:12.5px;}
.payment img{display:block;width:140px;height:auto;}
.submit-row{display:flex;align-items:center;gap:18px;}
.submit-button{
  display:inline-flex;align-items:center;gap:10px;min-width:196px;height:48px;padding:0 26px;border:0;border-radius:999px;
  background:linear-gradient(135deg,var(--blue),var(--blue2));color:#fff;font-size:15px;font-weight:800;letter-spacing:.2px;
  box-shadow:0 12px 26px rgba(20,87,217,.3);cursor:pointer;transition:transform .15s,box-shadow .15s,filter .15s;
}
.submit-button:hover{transform:translateY(-1px);box-shadow:0 16px 32px rgba(20,87,217,.36);filter:saturate(1.08);}
.signin{font-size:14px;color:var(--blue2);font-weight:700;text-decoration:none;}
.signin:hover{text-decoration:underline;}

@@media(max-width:760px){
  .page{width:calc(100% - 20px);margin-bottom:24px;padding-top:22px;}
  .shell{border-radius:14px;}
  .hero{display:block;padding:24px 20px;}
  .brand-mark{max-width:none;padding:15px 16px;}
  .hero-copy{text-align:left;margin-top:18px;}
  .hero h1{font-size:23px;}
  form{padding:20px 18px 26px;gap:16px;}
  .field-card{padding:18px 16px 20px;}
  .form-grid{grid-template-columns:1fr;gap:15px;}
  .validation{margin:18px 18px 0;}
  textarea{height:210px;}
  .verify-row{grid-template-columns:1fr auto;}
  .verify-code{justify-content:center;}
  .footer-bar{display:block;}
  .payment{margin-bottom:16px;}
  .submit-row{align-items:stretch;flex-direction:column;}
  .submit-button{width:100%;justify-content:center;}
}
</style>
</head>
<body>
<main class="page">
  <div class="shell">
  <header class="hero">
    <div class="brand-mark">
      <img class="logo" src="/images/ipro-advisers-logo.png" alt="IPRO Advisers"/>
    </div>
    <div class="hero-copy">
      <div class="eyebrow">New account registration</div>
      <h1>Start your IPRO Advisers portal</h1>
      <p class="hint">Fields marked with <span class="required">*</span> are required.</p>
    </div>
  </header>

  @if (!ViewData.ModelState.IsValid)
  {
    <div class="validation">@Html.ValidationSummary()</div>
  }
  @if (trialPackage != null)
  {
    <div class="validation" style="background:var(--blue-soft);border-color:var(--blue-soft-line);color:#244575;">
      You're claiming your invited free trial of <strong>@trialPackage.PackageName</strong>@(trialPackage.TrialDurationDays.HasValue ? $" ({trialPackage.TrialDurationDays} days)" : "").
    </div>
  }
  else if (trialCodeError != null)
  {
    <div class="validation">@trialCodeError You can still register below by choosing one of our regular packages.</div>
  }

  <form asp-action="Register" method="post">
    @Html.AntiForgeryToken()
    @if (!string.IsNullOrWhiteSpace(Model.TrialCode))
    {
      <input type="hidden" asp-for="TrialCode" />
    }

    <div class="field-card">
      <div class="field-card-head"><span class="field-card-icon"><i class="fas fa-user"></i></span><h2>Contact Information</h2></div>
      <div class="form-grid">
        <div class="form-row">
          <label><span class="required">*</span>First Name:</label>
          <input asp-for="FirstName" class="short" maxlength="80" required/>
        </div>
        <div class="form-row">
          <label><span class="required">*</span>Last Name:</label>
          <input asp-for="LastName" class="short" maxlength="80" required/>
        </div>
        @* Designation, fax, mobile and time zone moved to Profile (signup v2): every field here
           costs signups, and none of those four is needed to create the account or bill it. *@
        <div class="form-row">
          <label><span class="required">*</span>Email:</label>
          <input asp-for="Email" type="email" class="short" maxlength="200" required/>
        </div>
        <div class="form-row">
          <label><span class="required">*</span>Choose a Password:</label>
          <input asp-for="Password" type="password" class="short" minlength="8" maxlength="100" autocomplete="new-password" required/>
        </div>
        <div class="form-row">
          <label><span class="required">*</span>Confirm Password:</label>
          <input asp-for="ConfirmPassword" type="password" class="short" minlength="8" maxlength="100" autocomplete="new-password" required/>
        </div>
      </div>
    </div>

    <div class="field-card">
      <div class="field-card-head"><span class="field-card-icon"><i class="fas fa-building"></i></span><h2>Company Details</h2></div>
      <div class="form-grid">
        <div class="form-row">
          <label><span class="required">*</span>Company Name:</label>
          <input asp-for="CompanyName" class="short" maxlength="150" required/>
        </div>
        <div class="form-row">
          <label>Company Address:</label>
          <input asp-for="CompanyAddress" class="short" maxlength="200"/>
        </div>
        <div class="form-row">
          <label><span class="required">*</span>City:</label>
          <input asp-for="City" class="short" maxlength="80" required/>
        </div>
        <div class="form-row">
          <label><span class="required">*</span>Province:</label>
          <select asp-for="Province" class="medium" required>
            <option>Alberta</option>
            <option>British Columbia</option>
            <option>Manitoba</option>
            <option>New Brunswick</option>
            <option>Newfoundland</option>
            <option>Northwest Territories</option>
            <option>Nova Scotia</option>
            <option>Nunavut</option>
            <option>Ontario</option>
            <option>Prince Edward Island</option>
            <option>Quebec</option>
            <option>Saskatchewan</option>
            <option>Yukon Territory</option>
          </select>
        </div>
        <div class="form-row">
          <label><span class="required">*</span>Postal Code:</label>
          <input asp-for="PostalCode" class="short" maxlength="20" required/>
        </div>
        <div class="form-row">
          <label><span class="required">*</span>Country:</label>
          <select asp-for="Country" class="medium" required>
            <option>Canada</option>
            <option>United States</option>
            <option>Other</option>
          </select>
        </div>
        @* Time zone is no longer asked at signup -- it is derived from the province below and can
           be adjusted later on Profile. It still matters: invoice dates print in agent-local time. *@
        <input type="hidden" asp-for="TimeZone" id="TimeZone"/>
      </div>
    </div>

    <div class="field-card">
      <div class="field-card-head"><span class="field-card-icon"><i class="fas fa-phone"></i></span><h2>Phone and Plan</h2></div>
      <div class="form-grid">
        <div class="form-row">
          <label><span class="required">*</span>Business Phone:</label>
          <input asp-for="Phone" class="short" maxlength="40" required/>
        </div>
        <div class="form-row">
          <label><span class="required">*</span>Business Type:</label>
          <select asp-for="BusinessType" class="short" required>
            <option value="">Click here</option>
            <option>Accountants</option>
            <option>Insurance / Financial</option>
            <option>Mortgage</option>
          </select>
        </div>
        @if (trialPackage != null)
        {
          <div class="form-row">
            <label><span class="required">*</span>Package:</label>
            <input type="text" class="short" value="@trialPackage.PackageName (free trial)" readonly/>
            <input type="hidden" asp-for="PackageId" value="@trialPackage.Id" />
          </div>
        }
        else if (planIsLocked)
        {
          @* The visitor already chose on the pricing card; re-asking was one of the three
             package-picks the old funnel forced. Locked summary, changeable via one link. *@
          <div class="form-row plan-summary-row">
            <label>Your plan:</label>
            <div class="plan-summary">
              @{
                var lockedSetup = selectedPackage!.SetupFee > 0
                    ? selectedPackage.IsSetupFeeWaivedOn(DateTime.UtcNow)
                        ? $"setup ${selectedPackage.SetupFee:N0} WAIVED"
                        : $"+ ${selectedPackage.SetupFee:N0} one-time setup"
                    : "no setup fee";
              }
              <div class="plan-summary-name">@selectedPackage.PackageName</div>
              <div class="plan-summary-price">$@selectedPackage.MonthlyPrice.ToString("N0")/month &middot; @lockedSetup &middot; plus applicable taxes</div>
              @if (selectedPackage.AnnualPrice > 0)
              {
                <div class="plan-summary-period">
                  <label><input type="radio" asp-for="BillingPeriodChoice" value="Monthly"/> Monthly &mdash; $@selectedPackage.MonthlyPrice.ToString("N0")/mo</label>
                  <label><input type="radio" asp-for="BillingPeriodChoice" value="Annually"/> Annual &mdash; $@selectedPackage.AnnualPrice.ToString("N0")/yr (two months free)</label>
                </div>
              }
              <a class="plan-summary-change" href="/Account/Register">Change plan</a>
            </div>
            <input type="hidden" asp-for="PackageId" />
            <input type="hidden" asp-for="PlanLocked" />
          </div>
        }
        else
        {
          <div class="form-row">
            <label><span class="required">*</span>Packages:</label>
            <select asp-for="PackageId" id="packageSelect" class="short" required>
              <option value="">Click here</option>
              @foreach (var package in packages)
              {
                // Pre-tax, like every other price in the product. This is the point where the
                // prospect actually commits, so it is the most important place to say so.
                // Setup-fee waiver comes from the package row via the same call PayPal uses, so the
                // picker can't promise a saving the checkout won't honour (or hide one it will).
                var setupLabel = package.SetupFee > 0
                    ? package.IsSetupFeeWaivedOn(DateTime.UtcNow)
                        ? $" + ${package.SetupFee:N0} setup WAIVED"
                        : $" + ${package.SetupFee:N0} setup"
                    : "";
                var priceLabel = package.MonthlyPrice > 0
                    ? $"${package.MonthlyPrice:N0}/mo" + setupLabel + " plus applicable taxes"
                    : "Contact us for pricing";
                <option value="@package.Id">@package.PackageName — @priceLabel</option>
              }
            </select>
          </div>
        }
        @if (trialPackage == null)
        {
          <div class="form-row">
            <label>Promotion Code:</label>
            <span>
              <input asp-for="PromotionCode" id="promoCodeInput" maxlength="60" autocomplete="off" placeholder="Optional" />
              <button type="button" id="applyPromoCodeButton">Apply</button>
              <div id="promoCodeResult" style="margin-top:6px;font-size:0.9em;"></div>
            </span>
          </div>
        }
      </div>
      @if (trialPackage == null)
      {
        <p class="hint" style="margin-top:14px;"><i class="fas fa-lock" style="margin-right:6px;color:var(--blue2);"></i>Next step after this form: secure PayPal checkout for the plan above. Your card details go to PayPal, never to us.</p>
      }
    </div>

    <div class="field-card">
      <div class="field-card-head"><span class="field-card-icon"><i class="fas fa-file-contract"></i></span><h2>Terms and Conditions</h2></div>
      <div class="form-grid">
        @* No separate "Terms and Conditions:" field label here -- the card heading above and the
           box heading below both already say it, and three identical labels stacked is noise. *@
        <div class="form-row agreement-row">
          <div class="terms-box">
            <div class="terms-box-head">
              <i class="fas fa-scroll"></i> Terms and Conditions
              <a href="/terms" target="_blank" rel="noopener" class="terms-box-open">Open in a new tab</a>
            </div>
            <div class="terms-scroll" tabindex="0" role="region" aria-label="Terms and Conditions">
              @await Html.PartialAsync("_LegalTerms")
            </div>
          </div>
        </div>

        <div class="form-row verify-row">
          <label>Verify Code:</label>
          <input type="text" name="verificationCode" class="short" maxlength="4" autocomplete="off" required/>
          <span class="verify-code" aria-label="Verify code @verificationDisplayCode">
            @foreach (var digit in verificationDisplayCode)
            {
              <span>@digit</span>
            }
          </span>
          <p class="verify-hint">Type the 4 digits shown to confirm you're not a robot.</p>
        </div>

        <div class="terms-check" style="grid-column:1/-1;">
          <input type="checkbox" value="true" name="acceptTerms" id="acceptTerms" required/>
          <label for="acceptTerms">
            Yes, I have read and accept the
            <a href="/terms" target="_blank" rel="noopener">Terms of Service</a> and the
            <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a>.
          </label>
        </div>
      </div>
    </div>

    <div class="footer-bar">
      <div class="payment">
        <img src="/images/paypalverified.gif" alt="PayPal Verified"/>
      </div>
      <div class="submit-row">
        <a class="signin" href="/Account/Login">Already registered? Sign in</a>
        <button class="submit-button" type="submit"><i class="fas fa-arrow-right-to-bracket"></i>Submit Registration</button>
      </div>
    </div>
  </form>
  </div>
</main>
<script nonce="@Context.GetCspNonce()">
(function () {
  var button = document.getElementById('applyPromoCodeButton');
  var input = document.getElementById('promoCodeInput');
  // Dropdown mode has #packageSelect; locked-plan mode carries the id in a hidden input instead.
  var packageSelect = document.getElementById('packageSelect') || document.querySelector('input[type=hidden][name=PackageId]');
  var result = document.getElementById('promoCodeResult');
  if (!button || !input || !packageSelect || !result) return;

  button.addEventListener('click', function () {
    var code = input.value.trim();
    var packageId = packageSelect.value;
    if (!code) { result.textContent = ''; return; }
    if (!packageId) { result.style.color = '#b91c1c'; result.textContent = 'Choose a package first.'; return; }

    result.style.color = '#334155';
    result.textContent = 'Checking...';

    fetch('/Account/ValidatePromoCode', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: 'code=' + encodeURIComponent(code) + '&packageId=' + encodeURIComponent(packageId)
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.valid) {
          result.style.color = '#166534';
          result.textContent = data.message;
        } else {
          result.style.color = '#b91c1c';
          result.textContent = data.message || 'That code is not valid for the selected package.';
        }
      })
      .catch(function () {
        result.style.color = '#b91c1c';
        result.textContent = 'Could not check that code right now.';
      });
  });
})();

(function () {
  var provinceSelect = document.getElementById('Province');
  var timeZoneSelect = document.getElementById('TimeZone');
  if (!provinceSelect || !timeZoneSelect) return;

  var provinceTimeZones = {
    'Alberta': '(GMT-07:00) Mountain Time (US & Canada)',
    'British Columbia': '(GMT-08:00) Pacific Time (US & Canada)',
    'Manitoba': '(GMT-06:00) Central Time (US & Canada)',
    'New Brunswick': '(GMT-04:00) Atlantic Time (Canada)',
    'Newfoundland': '(GMT-03:30) Newfoundland',
    'Northwest Territories': '(GMT-07:00) Mountain Time (US & Canada)',
    'Nova Scotia': '(GMT-04:00) Atlantic Time (Canada)',
    'Nunavut': '(GMT-05:00) Eastern Time (US & Canada)',
    'Ontario': '(GMT-05:00) Eastern Time (US & Canada)',
    'Prince Edward Island': '(GMT-04:00) Atlantic Time (Canada)',
    'Quebec': '(GMT-05:00) Eastern Time (US & Canada)',
    'Saskatchewan': '(GMT-06:00) Central Time (US & Canada)',
    'Yukon Territory': '(GMT-07:00) Mountain Time (US & Canada)'
  };

  // TimeZone is a hidden field now (derived, not asked): keep it in step with the province both
  // on load and on change, so invoice dates print in the agent's real local time from day one.
  function syncTimeZone() {
    var mapped = provinceTimeZones[provinceSelect.value];
    if (mapped) timeZoneSelect.value = mapped;
  }
  provinceSelect.addEventListener('change', syncTimeZone);
  syncTimeZone();
})();
</script>
</body>
</html>
