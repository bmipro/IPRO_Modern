@{
    ViewData["Title"] = "See Your Website";
    Layout = null;
    var carriedPackage = ViewBag.CarriedPackage as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>See Your Website in 30 Seconds — IPRO Advisers</title>
<meta name="robots" content="noindex,nofollow"/>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" rel="stylesheet"/>
<style>
  body{background:linear-gradient(135deg,#1a3a6b 0%,#2563eb 100%);min-height:100vh;color:#1e293b;}
  .preview-card{max-width:520px;margin:0 auto;background:#fff;border-radius:20px;box-shadow:0 30px 80px rgba(10,28,55,.28);padding:40px 36px;}
  .preview-eyebrow{letter-spacing:.08em;font-weight:700;font-size:.8rem;color:#2563eb;text-transform:uppercase;}
</style>
</head>
<body class="d-flex align-items-center py-5">
<div class="container">
  <div class="preview-card">
    <div class="text-center mb-4">
      <a href="/" class="text-decoration-none"><img src="/images/ipro-advisers-logo.png" alt="IPRO Advisers" style="height:28px;width:auto;"/></a>
      <div class="preview-eyebrow mt-3 mb-2">See it before you sign up</div>
      <h1 class="h3 fw-bold">Your website, built in 30 seconds</h1>
      <p class="text-muted mb-0">Tell us your name and what you do — we'll show you a real, working preview.</p>
    </div>
    <form method="get" action="/Preview/Show">
      @if (carriedPackage != null)
      {
        <input type="hidden" name="package" value="@carriedPackage" />
        <div class="alert alert-light border small py-2 px-3 mb-3"><i class="fas fa-circle-info me-1 text-primary"></i>Showing you the <strong>@carriedPackage</strong> plan.</div>
      }
      <div class="mb-3">
        <label class="form-label fw-semibold">First name</label>
        <input type="text" name="firstName" class="form-control" maxlength="80" required autofocus/>
      </div>
      <div class="mb-3">
        <label class="form-label fw-semibold">Last name</label>
        <input type="text" name="lastName" class="form-control" maxlength="80" required/>
      </div>
      <div class="mb-3">
        <label class="form-label fw-semibold">Company name</label>
        <input type="text" name="companyName" class="form-control" maxlength="150" placeholder="Optional"/>
      </div>
      <div class="mb-4">
        <label class="form-label fw-semibold">What do you do?</label>
        <select name="businessType" class="form-select" required>
          <option value="">Choose one</option>
          <option>Accountants</option>
          <option>Insurance / Financial</option>
          <option>Mortgage</option>
        </select>
      </div>
      <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold"><i class="fas fa-wand-magic-sparkles me-2"></i>Show Me My Site</button>
    </form>
    <p class="text-center text-muted small mt-4 mb-0">No account needed. Nothing is saved.</p>
  </div>
</div>
</body>
</html>
