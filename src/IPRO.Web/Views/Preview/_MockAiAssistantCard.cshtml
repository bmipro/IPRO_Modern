@model IPRO.Web.Models.ProspectPreviewInput
@{
    var insight = IPRO.Web.Infrastructure.MockDailyInsightCatalog.Get(Model.BusinessType);
}
<div class="card border-0 shadow-sm">
  <div class="card-body p-4">
    <h6 class="fw-bold mb-1"><i class="fas fa-robot me-2 text-primary"></i>AI Daily Assistant</h6>
    <p class="text-muted ai-tier-note mb-3">Included in Platinum &amp; Broker plans.</p>
    <div class="row g-3 mb-3 text-center">
      <div class="col-4"><div class="fs-4 fw-bold text-primary">@insight.NewLeadCount</div><div class="text-muted small">New leads</div></div>
      <div class="col-4"><div class="fs-4 fw-bold text-warning">@insight.StaleLeadCount</div><div class="text-muted small">Leads &gt;24h old</div></div>
      <div class="col-4"><div class="fs-4 fw-bold text-info">@insight.NoFollowUpClientCount</div><div class="text-muted small">No follow-up scheduled</div></div>
    </div>
    <div class="alert alert-light border mb-0">
      <div class="d-flex align-items-start gap-2">
        <i class="fas fa-lightbulb text-warning mt-1"></i>
        <div>
          <div><strong>Suggested next action:</strong> @insight.ActionText</div>
          <div class="text-muted small mt-1"><i class="fas fa-sparkles me-1"></i>@insight.ActionReason</div>
        </div>
      </div>
    </div>
    <p class="text-muted small mt-3 mb-0"><i class="fas fa-circle-info me-1"></i>This is a preview — sign up to see this for your real clients, every morning.</p>
  </div>
</div>
