@{
    var article = (IPRO.Web.Infrastructure.HelpArticle)ViewBag.Article;
    ViewData["Title"] = article.Title;
    var html = (string)ViewBag.Html;
}

<nav aria-label="breadcrumb">
  <ol class="breadcrumb"><li class="breadcrumb-item"><a href="/portal/Support">Support</a></li><li class="breadcrumb-item active">@article.Title</li></ol>
</nav>

<div class="card border-0 shadow-sm">
  <div class="card-body p-4 help-article">
    @Html.Raw(html)
  </div>
</div>

<style>
  .help-article h1 { font-size: 1.6rem; font-weight: 800; margin-bottom: 1rem; }
  .help-article h2 { font-size: 1.25rem; font-weight: 700; margin-top: 1.75rem; margin-bottom: .75rem; }
  .help-article ol, .help-article ul { padding-left: 1.4rem; }
  .help-article li { margin-bottom: .35rem; }
  .help-article p { margin-bottom: .85rem; }
  /* 466: "In this guide" */
  .help-article .help-toc { background: #f4f6fb; border: 1px solid #dce4ef; border-radius: 8px; padding: .9rem 1.1rem; margin: 0 0 1.5rem; }
  .help-article .help-toc__title { font-size: .8rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #64748b; margin-bottom: .4rem; }
  .help-article .help-toc ol { margin: 0; padding-left: 1.3rem; columns: 2; column-gap: 2rem; }
  .help-article .help-toc li { margin-bottom: .2rem; break-inside: avoid; }
  .help-article .help-toc a { text-decoration: none; }
  .help-article .help-toc a:hover { text-decoration: underline; }
  .help-article h2 { scroll-margin-top: 1rem; }
  @@media (max-width: 700px) { .help-article .help-toc ol { columns: 1; } }
</style>
