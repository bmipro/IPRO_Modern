@model IPRO.Web.Models.FormBuilderViewModel
@{
    ViewData["Title"] = "Edit Form";
}

<div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
  <div>
    <h2 class="fw-bold mb-1"><i class="fas fa-rectangle-list me-2 text-primary"></i>Edit Form</h2>
    <div class="text-muted">Add a title and one or more fields. Attach this form to a page later using the Custom Form block.</div>
  </div>
  <a class="btn btn-outline-secondary" href="/Forms/Preview/@Model.Id" target="_blank" rel="noopener"><i class="fas fa-eye me-1"></i>Preview</a>
</div>

<div asp-validation-summary="All" class="alert alert-danger" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

<form asp-action="Edit" method="post" id="formBuilderForm">
  @Html.AntiForgeryToken()
  <input type="hidden" asp-for="Id"/>
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
      <div class="mb-3">
        <label class="form-label small fw-semibold text-muted">Form Title</label>
        <input asp-for="Title" class="form-control" maxlength="200"/>
      </div>
      <div class="mb-3">
        <label class="form-label small fw-semibold text-muted">Description (optional)</label>
        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
      </div>
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label small fw-semibold text-muted">Submit Button Text</label>
          <input asp-for="SubmitButtonText" class="form-control" maxlength="100"/>
        </div>
        <div class="col-md-6">
          <label class="form-label small fw-semibold text-muted">Success Message</label>
          <input asp-for="SuccessMessage" class="form-control" maxlength="500"/>
        </div>
      </div>
    </div>
  </div>

  <div class="alert alert-info d-flex align-items-start gap-2 mb-4">
    <i class="fas fa-circle-info mt-1"></i>
    <div>Every form already starts with <strong>First name, Last name, Email, and Phone</strong> fields shown above your questions, so visitors can be turned into leads. You don't need to add these yourself below.</div>
  </div>

  @await Html.PartialAsync("_FormFieldBuilder", Model.Fields)

  <div class="d-flex gap-2">
    <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk me-1"></i>Save Changes</button>
    <a href="/Forms" class="btn btn-link">Cancel</a>
  </div>
</form>
