@model IEnumerable<IPRO.Entities.WebsiteStarterForm>
@{
    ViewData["Title"] = "Start from a Template";
    var fieldsByForm = (Dictionary<int, List<IPRO.Entities.WebsiteStarterFormField>>)ViewBag.FieldsByForm;
    var groups = Model.GroupBy(f => f.BusinessType);
}

<div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
  <div>
    <h2 class="fw-bold mb-1"><i class="fas fa-shapes me-2 text-primary"></i>Start from a Template</h2>
    <div class="text-muted">Adopt a template as your own form &mdash; use it as-is, or edit it right after. Prefer a blank slate? <a href="/Forms/Create">Build a new form from scratch</a>.</div>
  </div>
  <a class="btn btn-outline-secondary" href="/Forms"><i class="fas fa-arrow-left me-1"></i>Back to Forms</a>
</div>

@if (!Model.Any())
{
  <p class="text-muted">No templates are available right now.</p>
}

@foreach (var group in groups)
{
  <h5 class="fw-bold mb-3">@(group.Key == "All" ? "General" : group.Key)</h5>
  <div class="row g-3 mb-4">
    @foreach (var template in group)
    {
      <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body p-4 d-flex flex-column">
            <h6 class="fw-bold mb-1">@template.Title</h6>
            <p class="text-muted small mb-3">@template.Description</p>
            @if (fieldsByForm.TryGetValue(template.Id, out var fields) && fields.Count > 0)
            {
              <ul class="small text-muted mb-3 ps-3">
                @foreach (var field in fields)
                {
                  <li>@field.Label <span class="text-muted">(@IPRO.Entities.WebsiteFormFieldTypes.DisplayName(field.FieldType))</span></li>
                }
              </ul>
            }
            <form method="post" action="/Forms/AdoptTemplate" class="mt-auto">
              @Html.AntiForgeryToken()
              <input type="hidden" name="starterFormId" value="@template.Id"/>
              <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-check me-1"></i>Use This Template</button>
            </form>
          </div>
        </div>
      </div>
    }
  </div>
}
