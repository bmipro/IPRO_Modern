@model IReadOnlyCollection<IPRO.Entities.WebsiteForm>
@{
    ViewData["Title"] = "Forms";
}

<div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
  <div>
    <h2 class="fw-bold mb-1"><i class="fas fa-rectangle-list me-2 text-primary"></i>Forms</h2>
    <div class="text-muted">Build a custom form once, then attach it to any page with a Custom Form block. Submissions land in your Website Leads inbox.</div>
  </div>
  <a class="btn btn-primary" href="/Forms/Create"><i class="fas fa-plus me-1"></i>New Form</a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-3">
    @if (!Model.Any())
    {
      <p class="text-muted small mb-0">No forms yet. Click <strong>New Form</strong> to build one.</p>
    }
    else
    {
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead>
            <tr class="text-muted small text-uppercase">
              <th>Title</th>
              <th>Description</th>
              <th>Updated</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var form in Model)
            {
              <tr>
                <td>@form.Title</td>
                <td class="small text-muted">@form.Description</td>
                <td class="small text-muted">@form.UpdatedAt.ToString("MMM d, yyyy")</td>
                <td class="text-end">
                  <a class="btn btn-sm btn-outline-secondary" href="/Forms/Edit/@form.Id">Edit</a>
                  <form asp-action="Delete" asp-route-id="@form.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger js-confirm-submit" data-confirm-message="Delete this form? Pages using it in a Custom Form block will stop displaying it."><i class="fas fa-trash"></i></button>
                  </form>
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }
  </div>
</div>
