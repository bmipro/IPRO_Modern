@model IPRO.Web.Models.FormBuilderViewModel
@{
    ViewData["Title"] = "New Form";
}

<div class="mb-4">
  <h2 class="fw-bold mb-1"><i class="fas fa-rectangle-list me-2 text-primary"></i>New Form</h2>
  <div class="text-muted">Add a title and one or more fields. Attach this form to a page later using the Custom Form block.</div>
</div>

<div asp-validation-summary="All" class="alert alert-danger" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

<form asp-action="Create" method="post" id="formBuilderForm">
  @Html.AntiForgeryToken()
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
      <div class="mb-3">
        <label class="form-label small fw-semibold text-muted">Form Title</label>
        <input asp-for="Title" class="form-control" maxlength="200" placeholder="Get a free quote"/>
      </div>
      <div class="mb-3">
        <label class="form-label small fw-semibold text-muted">Description (optional)</label>
        <textarea asp-for="Description" class="form-control" rows="2" placeholder="Tell us a bit about what you need and we'll get back to you."></textarea>
      </div>
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label small fw-semibold text-muted">Submit Button Text</label>
          <input asp-for="SubmitButtonText" class="form-control" maxlength="100" placeholder="Submit"/>
        </div>
        <div class="col-md-6">
          <label class="form-label small fw-semibold text-muted">Success Message</label>
          <input asp-for="SuccessMessage" class="form-control" maxlength="500" placeholder="Thank you. Your response was sent."/>
        </div>
      </div>
    </div>
  </div>

  <div class="alert alert-info d-flex align-items-start gap-2 mb-4">
    <i class="fas fa-circle-info mt-1"></i>
    <div>Every form already starts with <strong>First name, Last name, Email, and Phone</strong> fields shown above your questions, so visitors can be turned into leads. You don't need to add these yourself below.</div>
  </div>

  @await Html.PartialAsync("_FormFieldBuilder", Model.Fields)

  <div class="d-flex gap-2">
    <button type="submit" class="btn btn-primary"><i class="fas fa-floppy-disk me-1"></i>Save Form</button>
    <a href="/portal/Forms" class="btn btn-link">Cancel</a>
  </div>
</form>
