<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Hangfire.AspNetCore" Version="[1.8.23]" />
    <PackageVersion Include="Hangfire.Core" Version="[1.8.23]" />
    <PackageVersion Include="Hangfire.Storage.MySql" Version="[2.1.0-beta]" />
    <PackageVersion Include="AspNetCoreRateLimit" Version="[5.0.0]" />
    <PackageVersion Include="Azure.Communication.Email" Version="[1.0.1]" />
    <!-- 531: Amazon SES (ca-central-1) for email an adviser sends to their own clients. -->
    <PackageVersion Include="AWSSDK.SimpleEmailV2" Version="[4.0.106]" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="[12.19.1]" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="[4.6.0]" />
    <PackageVersion Include="CsvHelper" Version="[30.0.1]" />
    <PackageVersion Include="HtmlSanitizer" Version="9.2.995" />
    <!-- 596 (.NET 10): the ASP.NET Core and Microsoft.Extensions packages that were pinned here are part of
         .NET 10's shared frameworks; each project that uses them has <FrameworkReference Include="Microsoft.AspNetCore.App" />
         and NuGet leaves the packages out. -->
    <!-- 596: the database library stays on the EF Core 8 line. Pomelo has no release for EF Core 10 (not even a
         preview, PomeloFoundation/Pomelo.EntityFrameworkCore.MySql#2007); EF Core 10 waits for one (TODO 596).
         8.0.32 and not less: under C# 14 an array's Contains inside a query binds to MemoryExtensions.Contains,
         which EF Core translates from 8.0.15 (dotnet/efcore#35720) and 8.0.2 did not (ArrayContainsQueries596Tests).
         EF Core and its Relational layer are pinned so Pomelo (it asks for [8.0.13, 8.0.999]) and the tools agree. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="[8.0.32]" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="[8.0.32]" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="[8.0.32]" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="[17.11.1]" />
    <PackageVersion Include="xunit" Version="[2.9.2]" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="[2.8.2]" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="[8.0.32]" />
    <PackageVersion Include="Pomelo.EntityFrameworkCore.MySql" Version="[8.0.3]" />
    <PackageVersion Include="SendGrid" Version="[9.28.1]" />
    <PackageVersion Include="PayPalCheckoutSdk" Version="[1.0.4]" />
    <PackageVersion Include="Markdig" Version="[0.37.0]" />
    <!-- 535: gallery photos resized and stripped of their metadata on upload. SkiaSharp is MIT-licensed
         (Microsoft); the Linux native library comes from the NoDependencies package, since App Service's
         .NET image has no fontconfig and the gallery draws no text. -->
    <PackageVersion Include="SkiaSharp" Version="[4.153.1]" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="[4.153.1]" />
    <PackageVersion Include="Microsoft.ApplicationInsights.AspNetCore" Version="[2.22.0]" />
    <!-- Explicit pins below patch known transitive advisories flagged in the security audit
         (DOCS/SECURITY_AUDIT_2026-07-24.md). DEP-AngleSharp CLOSED 2026-08-20: HtmlSanitizer
         9.2.995 depends on AngleSharp 1.7.1, which carries the sanitizer-bypass fix the old
         exact-pinned [0.17.1] lacked. The "no compatible upgrade exists" deferral is obsolete. -->
    <!-- Newtonsoft.Json arrives only transitively (PayPalCheckoutSdk 1.0.4 asks for 11.0.1), and
         before this pin a transitive package listing showed IPRO.Business,
         IPRO.DataAccess and IPRO.Utility resolving the vulnerable 11.0.1 while IPRO.Web and
         IPRO.Admin happened to float to 13.0.2 because something else in their graph asked higher.
         The 2026-07-24 audit recorded this as "gone entirely". It was not; the check only looked
         at the two app projects, which is exactly where it looks clean (2026-08-17
         reconciliation). Central transitive pinning is on, so this one line forces every project.
         13.0.2 rather than 13.0.3 deliberately: it is what the apps already resolved and what is in
         the local NuGet cache, so offline builds via ops\Start-LocalEnv.ps1 keep working. -->
    <PackageVersion Include="Newtonsoft.Json" Version="[13.0.2]" />
    <!-- 596: the .NET 8 pins of System.Text.Json, System.Security.Cryptography.Xml, System.Formats.Asn1 and
         Microsoft.Extensions.Caching.Memory are gone: .NET 10's shared frameworks carry newer copies of all four,
         and NuGet leaves the packages out of every project that runs on them. -->
  </ItemGroup>
</Project>